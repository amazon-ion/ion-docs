(module ion_semantic_model "/fusion"
  '''
A denotational semantic model of Ion.

TODO
----
Functional:
* SID too large must raise an error. Need new way to test the LST maxid.
* From spec: "$0 is not semantically equivalent to SIDs with unknown text from
  shared symbol tables, so replacing such SIDs with $0 is a destructive operation
  to the semantics of the data."
* Distinguish top and internal continuations, to prove that non-TLV cannot alter
  the environment.
* SST compilation is very weak.
* Catalog construction should reject duplicate keys, so we don't imply anything
  about selection criteria.
* Struct denotations should be order-agnostic. See L.I.S.P. §5.5

Cleanup:
* Remove use of non-functional features in modeled functions
  * if
  * raise


Spec Problems
-------------
* No mention of possible annotations on imports field or its entries.

  '''


  (require
    "/fusion/exception"               // Not functional, should not be needed
    "/fusion/private/record"
    "/fusioncontrib/denotation"
    )

  (provide (all_defined_out))


  (define_model Ion

    (dom Nothing = "No value")

    (dom Ion1_0 = "IVM for Ion 1.0")
    (dom IVM    = (+ Ion1_0) "Ion version markers")

    (dom Unicode = (^ is_string) "Sequence of Unicode code points")
    (dom Sym0    = "The undefined symbol")

    (dom B      = (^ is_bool)      "Booleans")
    (dom I      = (^ is_int)       "Integers")
    (dom D      = (^ is_decimal)   "Decimals")
    (dom F      = (^ is_float)     "Floats")
    (dom T      = (^ is_timestamp) "Timestamps")


    //=============================
    // Safe values cannot contain SIDs.
    // Their 'raw' and 'application' values are the same.

    (dom DotNull = "Sentinel for typed nulls")

    (dom NullNull = (+ DotNull))
    (dom Boolean  = (+ DotNull B))
    (dom Int      = (+ DotNull I))
    (dom String   = (+ DotNull Unicode))

    (dom SafeVal = (+ NullNull Boolean Int String /*decimal float blob clob*/)
      "Values that cannot contain SIDs")


    //=============================
    // Raw-layer Data Types, which can contain unresolved SIDs

    (dom SymTok    = (+ Unicode I))     // "Raw" symbol token
    (dom 'SymTok*' = (** SymTok))

    (dom RSym      = (+ DotNull SymTok))
    (dom RList     = (+ DotNull 'RVal*'))

//  (dom RStruct = (-> SymTok RVal))   // Currently can't recurse in ->
    (dom RField    = (* SymTok RVal))
    (dom 'RField*' = (** RField))
    (dom RStruct   = (+ DotNull 'RField*'))

    // The "raw" data model
    (dom RContent = (+ SafeVal RSym RList RStruct))
    (dom RVal     = (* 'SymTok*' RContent))
    (dom TRVal    = (+ RVal IVM))

    (dom 'RVal*'  = (** RVal))
    (dom 'TRVal*' = (** TRVal))

    (fn rval_annots  ((v RVal) -> 'SymTok*')  (ith v 0))
    (fn rval_content ((v RVal) -> 'RContent') (ith v 1))

    (fn rfield_name  ((f RField) -> SymTok) (ith f 0))
    (fn rfield_value ((f RField) -> RVal)   (ith f 1))


    //=============================
    // Application-layer Data Types

    (dom Symbolic    = (+ Unicode Sym0))  // "Expanded" symbol token
    (dom 'Symbolic*' = (** Symbolic))

    (dom Symbol   = (+ DotNull Symbolic))
    (dom List     = (+ DotNull 'Value*'))

    (dom Field    = (* Symbolic Value))
    (dom 'Field*' = (** Field))
    (dom Struct   = (+ DotNull 'Field*'))

    // The Ion data model, proper
    (dom Content   = (+ SafeVal Symbol List Struct))
    (dom Value     = (* 'Symbolic*' Content))

    (dom 'Value*' = (** Value))

    (fn List_elts  ((v List) -> 'Value*') (lower_to 'Value*' v))

    (fn value_annots  ((v Value) -> 'Symbolic*') (ith v 0))
    (fn value_content ((v Value) -> 'Content')   (ith v 1))

    (fn Field_name  ((f Field) -> Symbolic) (ith f 0))
    (fn Field_value ((f Field) -> Value)    (ith f 1))


    (fn Symbolic_text_matches ((s Symbolic) (t Unicode) -> B)
      (if (element_of s Unicode)
        (=== (eject t) (eject (lower_to Unicode s)))
        false))

    (fn Symbol_text_matches ((s Symbol) (u Unicode) -> B)
      (if (element_of s Symbolic)
        (Symbolic_text_matches (lower_to Symbolic s) u)
        false))

    (fn Value_is_symbol_matching ((v Value) (u Unicode) -> B)
      (if (element_of (value_content v) Symbol)
        (Symbol_text_matches (lower_to Symbol (value_content v)) u)
        false))


    (fn Fields_get1 ((fs 'Field*') (u Unicode) -> 'Value*')  // returns 0 or 1, raises if more
      (if (seq_is_empty fs)
        (seq 'Value*')
        (if (eject (Symbolic_text_matches (Field_name (seq_head fs)) u))
          (if (seq_is_empty (Fields_get1 (seq_tail fs) u))
            (seq 'Value*' (Field_value (seq_head fs)))
            (raise "repeated field"))
          (Fields_get1 (seq_tail fs) u))))

    (fn Struct_get1 ((s Struct) (u Unicode) -> 'Value*')
      (Fields_get1 (lower_to 'Field*' s) u))

    (fn has_first_annot ((v Value) (u Unicode) -> B)
      (if (seq_is_empty (value_annots v)) false
        (Symbolic_text_matches (seq_head (value_annots v)) u)))


    //=======================
    // Environment Management

    (fn system_symbols ((i IVM) -> 'Symbolic*')
      (seq 'Symbolic*'
        (lift_to Symbolic SYM0)
        (lift_to Symbolic (inject_into Unicode "$ion"))
        (lift_to Symbolic (inject_into Unicode "$ion_1_0"))
        (lift_to Symbolic (inject_into Unicode "$ion_symbol_table"))
        (lift_to Symbolic (inject_into Unicode "name"))
        (lift_to Symbolic (inject_into Unicode "version"))
        (lift_to Symbolic (inject_into Unicode "imports"))
        (lift_to Symbolic (inject_into Unicode "symbols"))
        (lift_to Symbolic (inject_into Unicode "max_id"))
        (lift_to Symbolic (inject_into Unicode "$ion_shared_symbol_table"))))


    (dom SharedSymtab    = (* Unicode I 'Symbolic*'))     // name, version, symbols
    (dom 'SharedSymtab?' = (+ Nothing SharedSymtab))

    (fn SST_name    ((s SharedSymtab) -> Unicode)     (ith s 0))
    (fn SST_version ((s SharedSymtab) -> I)           (ith s 1))
    (fn SST_symbols ((s SharedSymtab) -> 'Symbolic*') (ith s 2))

    (fn SST_for_$ion_shared_symbol_table ((s Struct) -> SharedSymtab)
      (tuple SharedSymtab
        (lower_to Unicode (lower_to String (lower_to SafeVal
          (value_content (seq_head (Struct_get1 s "name"))))))
        (lower_to I (lower_to Int (lower_to SafeVal
          (value_content (seq_head (Struct_get1 s "version"))))))
        (declared_symbols s)))


    (dom Catalog      = (** SharedSymtab))

    (fn Catalog_scan ((c Catalog) (n Unicode) (v I) (best 'SharedSymtab?') -> 'SharedSymtab?')
      (if (seq_is_empty c)
        best
        (let [(sst (seq_head c))]
          (if (=== (eject n) (eject (SST_name sst)))
            (if (=== (eject v) (eject (SST_version sst)))
              // Exact match
              (lift_to 'SharedSymtab?' sst)
              (if (or (element_of best Nothing)
                      (< (eject (SST_version (lower_to SharedSymtab best)))
                         (eject (SST_version sst))))
                // Found a new best match
                (Catalog_scan (seq_tail c) n v (lift_to 'SharedSymtab?' sst))
                (Catalog_scan (seq_tail c) n v best)))
            (Catalog_scan (seq_tail c) n v best)))))

    (fn Catalog_lookup ((c Catalog) (name Unicode) (version I) -> 'SharedSymtab?')
      (Catalog_scan c name version (lift_to 'SharedSymtab?' NOTHING)))

    (fn Catalog_extend ((c Catalog) (s SharedSymtab) -> Catalog)
      // TODO reject duplicate key
      (seq_prepend s c))


    (dom LocalSymtab  = (+ 'Symbolic*'))               // imports, symbols
    (dom Environment  = (* Catalog IVM LocalSymtab))

    (fn Environment_cat ((r Environment) -> Catalog)     (ith r 0))
    (fn Environment_ivm ((r Environment) -> IVM)         (ith r 1))
    (fn Environment_lst ((r Environment) -> LocalSymtab) (ith r 2))


    (fn lst_lookup ((lst LocalSymtab) (i I) -> Symbolic)
      (ith (lower_to 'Symbolic*' lst)
        (if (< (eject i) (seq_length (lower_to 'Symbolic*' lst)))
          (eject i)
          0)))

    // Returns Symbolic so it can represent SYM0 when the sid
    // doesn't map to text.
    (fn env_lookup_sid ((e Environment) (i I) -> Symbolic)
      (lst_lookup (Environment_lst e) i))


    (fn expand_SymTok ((r Environment) (s SymTok) -> Symbolic)
      (if (element_of s Unicode)
        (lift_to Symbolic (lower_to Unicode s))
        (env_lookup_sid r (lower_to I s))))

    (fn expand_SymToks ((r Environment) (s 'SymTok*') -> 'Symbolic*')
      (if (seq_is_empty s)
        EMPTY_SYMBOLICS
        (seq_prepend (expand_SymTok  r (seq_head s))
                     (expand_SymToks r (seq_tail s)))))


    // $ion_symbol_table "compilation"

    (fn is_$ion_symbol_table ((v Value) -> B)
      (if (eject (has_first_annot v "$ion_symbol_table"))
        (element_of (value_content v) Struct)
        false))

    (fn symbol_padding ((len I) -> 'Symbolic*')
      (if (=== 0 (eject len))
        EMPTY_SYMBOLICS
        (seq_prepend (lift_to Symbolic SYM0)
          (symbol_padding (- (eject len) 1)))))

    (fn adjust_length ((ss 'Symbolic*') (max I) -> 'Symbolic*')
      (if (=== (seq_length ss) (eject max))
        ss
        (if (< (seq_length ss) (eject max))
          (seq_append ss (symbol_padding (- (eject max) (seq_length ss))))
          (seq_truncate ss (eject max)))))

    (fn compile_import ((name Unicode) (version I) (max I) (c Catalog) -> 'Symbolic*')
      (if (or (=== ""     (eject name))
              (=== "$ion" (eject name)))
        EMPTY_SYMBOLICS
        (let [(found (Catalog_lookup c name version))]
          (if (element_of found Nothing)
            // The Catalog has nothing with this name.
            (if (< (eject max) 0)
              // If max_id is invalid or absent, must have exact match.
              (raise (display_to_string "No exact-match for " (eject name) " @" (eject version)))
              (adjust_length EMPTY_SYMBOLICS max))
            // We found something in the catalog
            (let [(symtab (lower_to SharedSymtab found))]
              (if (=== (eject version) (eject (SST_version symtab)))
                // We have an exact match!
                (if (< (eject max) 0)
                  // No max_id, use as-is
                  (SST_symbols symtab)
                  (adjust_length (SST_symbols symtab) max))
                // Inexact match
                (if (< (eject max) 0)
                  (raise (display_to_string "No exact-match for " (eject name) " @" (eject version)))
                  (adjust_length (SST_symbols symtab) max))))))))

    (fn normalize_name ((vs 'Value*') -> Unicode)             // "" = absent or invalid
      (if (seq_is_empty vs) EMPTY_UNICODE
        (let [(c (value_content (seq_head vs)))]
          (if (and (element_of c String) (not (element_of c DotNull)))
            (lower_to Unicode (lower_to String (lower_to SafeVal c)))
            EMPTY_UNICODE))))

    (fn normalize_version ((vs 'Value*') -> I)                // 1 = absent or invalid
      (if (seq_is_empty vs) 1
        (let [(c (value_content (seq_head vs)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (let [(i (lower_to I (lower_to Int (lower_to SafeVal c))))]
              (if (< (eject i) 1) 1 i))
            1))))

    (fn normalize_max_id ((vs 'Value*') -> I)                // < 0 = absent or invalid
      (if (seq_is_empty vs)
        -1
        (let [(c (value_content (seq_head vs)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (lower_to I (lower_to Int (lower_to SafeVal c)))
            -1))))

    (fn compile_import_struct ((s Struct) (r Environment) -> 'Symbolic*')
      (compile_import (normalize_name    (Struct_get1 s "name"))
                      (normalize_version (Struct_get1 s "version"))
                      (normalize_max_id  (Struct_get1 s "max_id"))
                      (Environment_cat r)))

    (fn compile_imports_elts ((vs 'Value*') (r Environment) -> 'Symbolic*')
      (if (seq_is_empty vs)
        EMPTY_SYMBOLICS
        (seq_append (let [(c (value_content (seq_head vs)))]
                      (if (and (element_of c Struct) (not (element_of c DotNull)))
                        (compile_import_struct (lower_to Struct c) r)
                        EMPTY_SYMBOLICS))
                    (compile_imports_elts (seq_tail vs) r))))

    (fn compile_imports_field ((v Value) (r Environment) -> 'Symbolic*')
      (if (eject (Value_is_symbol_matching v "$ion_symbol_table"))
        (lower_to 'Symbolic*' (Environment_lst r))
        (seq_append
          (system_symbols (Environment_ivm r))
          (let [(c (value_content v))]
            (if (and (element_of c List) (not (element_of c DotNull)))
              (compile_imports_elts (List_elts (lower_to List (value_content v))) r)
              EMPTY_SYMBOLICS)))))

    (fn imported_symbols ((s Struct) (r Environment) -> 'Symbolic*')
      (let [(vals (Struct_get1 s "imports"))]
        (if (seq_is_empty vals)
          (system_symbols (Environment_ivm r))
          (compile_imports_field (seq_head vals) r))))


    (fn compile_symbols_elts ((vs 'Value*') -> 'Symbolic*')
      (if (seq_is_empty vs)
        EMPTY_SYMBOLICS
        (seq_prepend (let [(c (value_content (seq_head vs)))]
                       (lift_to Symbolic
                         (if (and (element_of c String) (not (element_of c DotNull)))
                           (lower_to Unicode (lower_to String (lower_to SafeVal c)))
                           SYM0)))
                     (compile_symbols_elts (seq_tail vs)))))

    (fn declared_symbols ((s Struct) -> 'Symbolic*')
      (let [(vals (Struct_get1 s "symbols"))]
        (if (seq_is_empty vals)
          EMPTY_SYMBOLICS
          (let [(c (value_content (seq_head vals)))]
            (if (element_of c List)
              (compile_symbols_elts (List_elts (lower_to List c)))
              EMPTY_SYMBOLICS)))))


    // LST and Environment construction

    (fn lst_for_ivm ((ivm IVM) -> LocalSymtab)
      (lift_to LocalSymtab (system_symbols ivm)))

    (fn lst_for_$ion_symbol_table ((r Environment) (s Struct) -> LocalSymtab)
      (if (element_of s DotNull)
        (lst_for_$ion_symbol_table r EMPTY_STRUCT)
        (lift_to LocalSymtab
          (seq_append (imported_symbols s r)
                      (declared_symbols s)))))


    (fn initial_env ((c Catalog)-> Environment)
      (tuple Environment
        c
        IVM_1_0
        (lst_for_ivm IVM_1_0)))

    (fn env_for_ivm ((r Environment) (ivm IVM) -> Environment)
      (tuple Environment
        (Environment_cat r)
        ivm
        (lst_for_ivm ivm)))

    (fn env_for_$ion_symbol_table ((r Environment) (s Struct) -> Environment)
      (tuple Environment
        (Environment_cat r)
        (Environment_ivm r)
        (lst_for_$ion_symbol_table r s)))


    //=======================
    // Denotations

    (dom Continuation = (-> Environment 'Value*' 'Value*'))

    (fn k0 Continuation (e v)                      // The bootstrap continuation
      v)


    (fn E ((vr RVal) (r Environment) (k Continuation) -> 'Value*')
      // General value evaluation
      (E_RContent (rval_content vr) r
        (mk_fn CContinuation (c1)
          (k r (seq 'Value*' (tuple Value (expand_SymToks r (rval_annots vr)) c1))))))

    (dom CContinuation = (-> Content 'Value*')
      "Accepts results of value expansion, sans annotations")

    (fn E_RContent ((vr RContent) (r Environment) (k CContinuation) -> 'Value*')
      // General value evaluation
      (if (element_of vr SafeVal)
        (k (lift_to Content (lower_to SafeVal vr)))
        (if (element_of vr RSym)
          (E_RSym (lower_to RSym vr) r k)
          (if (element_of vr RList)
            (E_RList (lower_to RList vr) r k)
            (if (element_of vr RStruct)
              (E_RStruct (lower_to RStruct vr) r k)
              (raise "not implemented"))))))

    (fn E_RSym ((v RSym) (r Environment) (k CContinuation) -> 'Value*')
      (k (lift_to Content (lift_to Symbol
                            (if (element_of v DotNull)
                              (singleton DotNull)
                              (expand_SymTok r (lower_to SymTok v)))))))

    (fn E_RList ((v RList) (r Environment) (k CContinuation) -> 'Value*')
      (if (element_of v DotNull)
        (k (lift_to Content (lift_to List (singleton DotNull))))
        ('E*' (lower_to 'RVal*' v) r
          (mk_fn Continuation (r1 vs1)
            (k (lift_to Content (lift_to List vs1)))))))

    (dom FContinuation = (-> 'Field*' 'Value*'))
    (fn 'E_RField*' ((rfs 'RField*') (r Environment) (k FContinuation) -> 'Value*')
      (if (seq_is_empty rfs)
        (k (seq 'Field*'))
        (E (rfield_value (seq_head rfs)) r
          (mk_fn Continuation (r1 vs1)               // Value(s) from head field
            // TODO Verify that vs1 is singleton?
            ('E_RField*' (seq_tail rfs) r1
              (mk_fn FContinuation (fs2)             // Field* from tail fields
                (k (seq_prepend (tuple Field
                                  (expand_SymTok r1 (rfield_name (seq_head rfs)))
                                  (seq_head vs1))
                     fs2))))))))

    (fn E_RStruct ((v RStruct) (r Environment) (k CContinuation) -> 'Value*')
      (if (element_of v DotNull)
        (k (lift_to Content (lift_to Struct (singleton DotNull))))
        ('E_RField*' (lower_to 'RField*' v) r
          (mk_fn FContinuation (fs1)
            (k (lift_to Content (lift_to Struct fs1)))))))


    (fn 'E*' ((vrs 'RVal*') (r Environment) (k Continuation) -> 'Value*')
      (if (seq_is_empty vrs)
        (k r (seq 'Value*'))
        (E (seq_head vrs) r
          (mk_fn Continuation (r1 vs1)
            ('E*' (seq_tail vrs) r1
              (mk_fn Continuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))


    // Top-level expansion

    (fn TE ((vr TRVal) (r Environment) (k Continuation) -> 'Value*')
      (if (element_of vr IVM)
        (k (env_for_ivm r (lower_to IVM vr)) (seq 'Value*'))
        (E (lower_to RVal vr) r
          (mk_fn Continuation (r1 vs1)
            (if (seq_is_empty vs1)
              (k r1 vs1)
              (if (eject (is_$ion_symbol_table (seq_head vs1)))
                (k (env_for_$ion_symbol_table r1
                     (lower_to Struct (value_content (seq_head vs1))))
                   (seq_tail vs1))                             // TODO what if more than one value?
                // Expand normally
                (k r1 vs1)))))))

    (fn 'TE*' ((vrs 'TRVal*') (r Environment) (k Continuation) -> 'Value*')
      (if (seq_is_empty vrs)
        (k r (seq 'Value*'))
        (TE (seq_head vrs) r
          (mk_fn Continuation (r1 vs1)
            ('TE*' (seq_tail vrs) r1
              (mk_fn Continuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))

  /*
    (den TE "Top-level value evaluation"
      ([TRVal] (e Environment) (k Continuation) -> 'Value*')
      [IVM]  = (k e0 (seq Value))
      [RVal::v] = (E v e (|e1 v1| (IF (= (annot v1) <$ion_symbol_table>)
                                    (k <> (extend_env e1 (imports v1))
                                    (k v1 e1)))))

    (den 'TE*' "Top-level stream evaluation"
      ('TRVal*' x Environment x Continuation -> 'Value*'))
  */

    (fn expand ((rvals 'TRVal*') (c Catalog) -> 'Value*')
      ('TE*' (seq_prepend (lift_to TRVal IVM_1_0) rvals)
             (initial_env c)
             k0))
  )

  (define NOTHING          (singleton Nothing))
  (define IVM_1_0          (lift_to IVM (singleton Ion1_0)))
  (define SYM0             (singleton Sym0))
  (define EMPTY_CATALOG    (seq Catalog))
  (define EMPTY_UNICODE    (inject_into Unicode ""))
  (define EMPTY_SYMBOLICS  (seq 'Symbolic*'))
  (define EMPTY_STRUCT     (lift_to Struct (seq 'Field*')))
)

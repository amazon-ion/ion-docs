(module ion_semantic_model "/fusion"
  '''
A denotational semantic model of Ion.

TODO
----
Functional:
* Implement $ion_symbol_table
  * Imports
  * LST Extension
  * SID too large must raise an error
* [NULL] Implement DotNull
* Distinguish top and internal continuations, to prove that non-TLV cannot alter
  the environment.
* Struct denotations should be order-agnostic.

Cleanup:
* Streamline singleton domain values SYM0, IVMs via framework.
* Remove use of non-functional features in modeled functions
  * if
  * raise

  '''


  (require
    "/fusion/exception"               // Not functional, should not be needed
    "/fusion/private/record"
    "/fusioncontrib/denotation"
    )

  (provide (all_defined_out))


  (define_values (_SYM0 is_sym0)
    (let_values [((rtd ctor pred accessor) (make_record_type (quote Sym0) null 0))]
      (values (ctor) pred)))


  (define_values (_IVM_1_0 _IVM_1_1 is_ivm)
    (let_values [((rtd ctor pred accessor) (make_record_type (quote IVM) null 0))]
      (values (ctor) (ctor) pred)))


  (define_model Ion

    (dom IVM = (^ is_ivm) "Ion version markers")

    (dom Unicode = (^ is_string) "Sequence of Unicode code points")
    (dom Sym0    = (^ is_sym0)   "The undefined symbol")

    (dom B      = (^ is_bool)      "Booleans")
    (dom I      = (^ is_int)       "Integers")
    (dom D      = (^ is_decimal)   "Decimals")
    (dom F      = (^ is_float)     "Floats")
    (dom T      = (^ is_timestamp) "Timestamps")


    //=============================
    // Safe values cannot contain SIDs.
    // Their 'raw' and 'application' values are the same.

    (dom DotNull = "Sentinel for typed nulls")

    (dom NullNull = (+ DotNull))
    (dom Boolean  = (+ B DotNull))
    (dom Int      = (+ I DotNull))
    (dom String   = (+ Unicode))

    (dom SafeVal = (+ NullNull Boolean Int String /*decimal float blob clob*/)
      "Values that cannot contain SIDs")


    //=============================
    // Raw-layer Data Types, which can contain unresolved SIDs

    (dom SymTok    = (+ Unicode I))     // "Raw" symbol token
    (dom 'SymTok*' = (** SymTok))

    (dom RSym     = (+ SymTok DotNull))

    (dom RList   = (+ 'RVal*'))

//  (dom RStruct = (-> SymTok RVal))   // Currently can't recurse in ->
    (dom RField    = (* SymTok RVal))
    (dom 'RField*' = (** RField))
    (dom RStruct   = (+ 'RField*'))

    // The "raw" data model
    (dom RContent = (+ SafeVal RSym RList RStruct))
    (dom RVal     = (* 'SymTok*' RContent))
    (dom TRVal    = (+ RVal IVM))

    (dom 'RVal*'  = (** RVal))
    (dom 'TRVal*' = (** TRVal))

    (fn rval_annots  ((v RVal) -> 'SymTok*')  (ith v 0))
    (fn rval_content ((v RVal) -> 'RContent') (ith v 1))

    (fn rfield_name  ((f RField) -> SymTok) (ith f 0))
    (fn rfield_value ((f RField) -> RVal)   (ith f 1))


    //=============================
    // Application-layer Data Types

    (dom Symbolic    = (+ Unicode Sym0))  // "Expanded" symbol token
    (dom 'Symbolic*' = (** Symbolic))

    (dom Symbol   = (+ Symbolic DotNull))

    (dom List    = (+ 'Value*'))

    (dom Field    = (* Symbolic Value))
    (dom 'Field*' = (** Field))
    (dom Struct   = (+ 'Field*'))

    // The Ion data model, proper
    (dom Content   = (+ SafeVal Symbol List Struct))
    (dom Value     = (* 'Symbolic*' Content))

    (dom 'Value*' = (** Value))

    (fn List_elts  ((v List) -> 'Value*') (lower_to 'Value*' v))

    (fn value_annots  ((v Value) -> 'Symbolic*') (ith v 0))
    (fn value_content ((v Value) -> 'Content')   (ith v 1))

    (fn Field_name  ((f Field) -> Symbolic) (ith f 0))
    (fn Field_value ((f Field) -> Value)    (ith f 1))


    (fn symbol_text_matches ((s Symbolic) (t Unicode) -> B)
      (if (= Unicode (subdomain s))
        (inject_into B (=== (eject t) (eject (lower_to Unicode s))))
        (inject_into B false)))

    (fn Fields_get1 ((fs 'Field*') (u Unicode) -> 'Value*')  // returns 0 or 1, raises if more
      (if (seq_is_empty fs)
        (seq 'Value*')
        (if (eject (symbol_text_matches (Field_name (seq_head fs)) u))
          (if (seq_is_empty (Fields_get1 (seq_tail fs) u))
            (seq 'Value*' (Field_value (seq_head fs)))
            (raise "repeated field"))
          (Fields_get1 (seq_tail fs) u))))

    (fn Struct_get1 ((s Struct) (u Unicode) -> 'Value*')
      (Fields_get1 (lower_to 'Field*' s) u))


    //=======================
    // Environment Management

    (fn system_symbols ((i IVM) -> 'Symbolic*')
      (seq 'Symbolic*'
        (lift_to Symbolic (inject_into Sym0    _SYM0))
        (lift_to Symbolic (inject_into Unicode "$ion"))
        (lift_to Symbolic (inject_into Unicode "$ion_1_0"))
        (lift_to Symbolic (inject_into Unicode "$ion_symbol_table"))
        (lift_to Symbolic (inject_into Unicode "name"))
        (lift_to Symbolic (inject_into Unicode "version"))
        (lift_to Symbolic (inject_into Unicode "imports"))
        (lift_to Symbolic (inject_into Unicode "symbols"))
        (lift_to Symbolic (inject_into Unicode "max_id"))
        (lift_to Symbolic (inject_into Unicode "$ion_shared_symbol_table"))))


    (dom SharedSymtab = (* Unicode I 'Symbolic*'))     // name, version, symbols
    (dom LocalSymtab  = (+ 'Symbolic*'))               // imports, symbols
    (dom Environment  = (* IVM LocalSymtab))

    (fn lst_lookup ((lst LocalSymtab) (i I) -> Symbolic)
      (ith (lower_to 'Symbolic*' lst)
        (if (< (eject i) (seq_length (lower_to 'Symbolic*' lst)))
          (eject i)
          0)))

    // Returns Symbolic so it can represent SYM0 when the sid
    // doesn't map to text.
    (fn env_lookup_sid ((e Environment) (i I) -> Symbolic)
      (lst_lookup (ith e 1) i))


    (fn expand_SymTok ((r Environment) (s SymTok) -> Symbolic)
      (if (= Unicode (subdomain s))
        (lift_to Symbolic (lower_to Unicode s))
        (env_lookup_sid r (lower_to I s))))

    (fn expand_SymToks ((r Environment) (s 'SymTok*') -> 'Symbolic*')
      (if (seq_is_empty s)
        (seq 'Symbolic*')
        (seq_append (seq 'Symbolic*' (expand_SymTok r (seq_head s)))
                    (expand_SymToks r (seq_tail s)))))


    (fn has_IST_annot ((ss 'Symbolic*') -> B)
      (if (seq_is_empty ss)
        (inject_into B false)
        (symbol_text_matches
          (seq_head ss)
          (inject_into Unicode "$ion_symbol_table"))))

    (fn is_local_symtab ((v Value) -> B)
      (if (eject (has_IST_annot (value_annots v)))
        (inject_into B (= Struct (subdomain (value_content v))))
        (inject_into B false)))

    (fn compile_symbol_elt ((c Content) -> Symbolic)
      (if (= SafeVal (subdomain c))
        (if (= String (subdomain (lower_to SafeVal c)))
          // TODO [NULL]
          (lift_to Symbolic (lower_to Unicode (lower_to String (lower_to SafeVal c))))
          (lift_to Symbolic (inject_into Sym0 _SYM0)))
        (lift_to Symbolic (inject_into Sym0 _SYM0))))

    (fn compile_symbol_elts ((vs 'Value*') -> 'Symbolic*')
      (if (seq_is_empty vs)
        (seq 'Symbolic*')
        (seq_append (seq 'Symbolic*' (compile_symbol_elt (value_content (seq_head vs))))
                    (compile_symbol_elts (seq_tail vs)))))

    (fn compile_symbols_field ((v Value) -> 'Symbolic*')
      (if (= List (subdomain (value_content v)))
        (compile_symbol_elts (List_elts (lower_to List (value_content v))))
        (seq 'Symbolic*')))

    (fn lst_symbols ((s Struct) -> 'Symbolic*')
      (if (seq_is_empty (Struct_get1 s (inject_into Unicode "symbols")))
        (seq 'Symbolic*')
        (compile_symbols_field (seq_head (Struct_get1 s (inject_into Unicode "symbols"))))))

    (fn new_env ((e Environment) (s Struct) -> Environment)
      (tuple Environment
        (ith e 0)
        (lift_to LocalSymtab
          (seq_append (system_symbols (ith e 0)) (lst_symbols s)))))

    (fn e0 ((ivm IVM) -> Environment)               // The bootstrap Environment
      (tuple Environment
        ivm
        (lift_to LocalSymtab (system_symbols ivm))))


    //=======================
    // Denotations

    (dom Continuation = (-> Environment 'Value*' 'Value*'))

    (fn k0 Continuation (e v)                      // The bootstrap continuation
      v)


    (fn E ((vr RVal) (r Environment) (k Continuation) -> 'Value*')
      // General value evaluation
      (E_RContent (rval_content vr) r
        (mk_fn CContinuation (c1)
          (k r (seq 'Value*' (tuple Value (expand_SymToks r (rval_annots vr)) c1))))))

    (dom CContinuation = (-> Content 'Value*')
      "Accepts results of value expansion, sans annotations")

    (fn E_RContent ((vr RContent) (r Environment) (k CContinuation) -> 'Value*')
      // General value evaluation
      (if (= SafeVal (subdomain vr))
        (k (lift_to Content (lower_to SafeVal vr)))
        (if (= RSym (subdomain vr))
          (E_RSym (lower_to RSym vr) r k)
          (if (= RList (subdomain vr))
            (E_RList (lower_to RList vr) r k)
            (if (= RStruct (subdomain vr))
              (E_RStruct (lower_to RStruct vr) r k)
              (raise "not implemented"))))))

    (fn E_RSym ((v RSym) (r Environment) (k CContinuation) -> 'Value*')
      // [NULL] implement null.symbol
      (k (lift_to Content (lift_to Symbol (expand_SymTok r (lower_to SymTok v))))))

    (fn E_RList ((v RList) (r Environment) (k CContinuation) -> 'Value*')
      ('E*' (lower_to 'RVal*' v) r
        (mk_fn Continuation (r1 vs1)
          (k (lift_to Content (lift_to List vs1))))))

    (dom FContinuation = (-> 'Field*' 'Value*'))
    (fn 'E_RField*' ((rfs 'RField*') (r Environment) (k FContinuation) -> 'Value*')
      (if (seq_is_empty rfs)
        (k (seq 'Field*'))
        (E (rfield_value (seq_head rfs)) r
          (mk_fn Continuation (r1 vs1)               // Value(s) from head field
            // TODO Verify that vs1 is singleton?
            ('E_RField*' (seq_tail rfs) r1
              (mk_fn FContinuation (fs2)             // Field* from tail fields
                (k (seq_append
                     (seq 'Field*' (tuple Field
                                     (expand_SymTok r1 (rfield_name (seq_head rfs)))
                                     (seq_head vs1)))
                     fs2))))))))

    (fn E_RStruct ((v RStruct) (r Environment) (k CContinuation) -> 'Value*')
      ('E_RField*' (lower_to 'RField*' v) r
        (mk_fn FContinuation (fs1)
          (k (lift_to Content (lift_to Struct fs1))))))


    (fn 'E+' ((vr 'RVal') (vrs 'RVal*') (r Environment) (k Continuation) -> 'Value*')
      (if (seq_is_empty vrs)
        (E vr r k)
        (E vr r (mk_fn Continuation (r1 vs1) // v1 is expansion of first raw value
                  ('E+' (seq_head vrs) (seq_tail vrs) r1
                    (mk_fn Continuation (r2 vs2) (k r2 (seq_append vs1 vs2))))))))

    (fn 'E*' ((vrs 'RVal*') (r Environment) (k Continuation) -> 'Value*')
      (if (seq_is_empty vrs)
        (k r (seq 'Value*'))
        (E (seq_head vrs) r
          (mk_fn Continuation (r1 vs1)
            ('E*' (seq_tail vrs) r1
              (mk_fn Continuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))


    // Top-level expansion

    (fn TE ((vr TRVal) (r Environment) (k Continuation) -> 'Value*')
      (if (=== IVM (subdomain vr))
        (k (e0 (lower_to IVM vr)) (seq 'Value*'))
        (E (lower_to RVal vr) r
          (mk_fn Continuation (r1 vs1)
            (if (seq_is_empty vs1)
              (k r1 vs1)
              (if (eject (is_local_symtab (seq_head vs1)))
                (k (new_env r1 (lower_to Struct (value_content (seq_head vs1))))
                   (seq_tail vs1))                             // TODO what if more than one value?
                // Expand normally
                (k r1 vs1)))))))

    (fn 'TE*' ((vrs 'TRVal*') (r Environment) (k Continuation) -> 'Value*')
      (if (seq_is_empty vrs)
        (k r (seq 'Value*'))
        (TE (seq_head vrs) r
          (mk_fn Continuation (r1 vs1)
            ('TE*' (seq_tail vrs) r1
              (mk_fn Continuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))

  /*
    (den TE "Top-level value evaluation"
      ([TRVal] (e Environment) (k Continuation) -> 'Value*')
      [IVM]  = (k e0 (seq Value))
      [RVal::v] = (E v e (|e1 v1| (IF (= (annot v1) <$ion_symbol_table>)
                                    (k <> (extend_env e1 (imports v1))
                                    (k v1 e1)))))

    (den 'TE*' "Top-level stream evaluation"
      ('TRVal*' x Environment x Continuation -> 'Value*'))
  */

    (fn expand ((rvals 'TRVal*') -> 'Value*')
      ('TE*' (seq_append (seq 'TRVal*' IVM_1_0) rvals)
             (e0 (lower_to IVM IVM_1_0))
             k0))
  )


  (define IVM_1_0
    (lift_to TRVal (inject_into IVM _IVM_1_0)))

)

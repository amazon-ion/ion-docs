// Copyright (c) 2023 Amazon.com, Inc.  All rights reserved.

(module ion_semantic_model "/fusion"
  '''
A denotational semantic model of Ion.

TODO
----
Terminology/Readability:
* The names around "document symbols" don't read well in prose. "local symbols"
  might be better but that requires careful editing to keep "local" precise.
* Figure out the proper name for `I`.  N? Z?
* Less type-switching via E[[]] denotations
  * Easier with distinct typed nulls
    * [LITERALS] Requires literals to render them as typewriter `null.foo`.
* Separate syntactic IVM from semantic spec-version?
* Print the Appendix in manually-assembled sections.
  * Should have a way to detect when a domain element is forgotten.

Features:
* Implement Decimal, Float, Timestamp, Blob/Clob
* Eexpr in field-position (struct inlining)
  * If `{(:values {a:1}), b:2}` ==> `{ a:1, b:2 }` then what about `{ {a:1}, b:2 }`?
    Isn't (:values V) == V ?
* Macro argument type-checking

Defects:
* SIDs should be non-negative.
* The spec doesn't say that SST must have its annotation as the first one.
* [SST Semantics] "When mapping from string to symbol ID, there may be multiple
  associated IDs (the same string could appear twice as children of the symbols
  field). Implementations MUST select the lowest known ID, and all other
  associated IDs MUST be handled as if undefined."
  * Not sure what "handled as undefined" implies.
* Catalog construction should reject duplicate keys, so we don't imply anything
  about selection criteria.
* Struct denotations should be order-agnostic. See L.I.S.P. §5.5

Cleanup:
* `lambda`s should instead use `mk_fn` with ad-hoc signature.


Spec Problems
-------------
* No mention of possible annotations on imports field or its entries.
* "A version marker can also occur at non-initial positions at the top level,
  and it will have the same effect; when encountered below top-level, it has no
  processing effect and is treated as an ordinary user value."
  * Wrong, IVMs are syntactically distinct and cannot appear elsewhere.
* "Null elements declare undefined symbol IDs (“gaps”) within the sequence;
  implementations must handle requests for such symbols the same as if the
  requested ID beyond the end of the list."
  * BUT: "beyond the end" is an error.
  * AND: what does "requests for such symbols" mean?
* Content under "Imports" should use present/absent instead of defined/undefined
  since the latter has other meaning.
* [Symbol Zero] "$0 is only semantically equivalent to itself and to
  locally-declared SIDs with unknown text."
  * Probably better to treat the local case as something other than "unknown"
    so that term only applies to the SST case.  A local null entry is _known_ to
    be $0, but we know _nothing_ about an absent (or undersized substitute) SST.
  '''


  (require "/fusioncontrib/denotation/dsl")

  (provide (all_defined_out))


  (define_model Ion
    (import B I Unicode)
    (dom 'Unicode?*' = (** 'Unicode?'))


    //=============================
    // Application-layer Data Types

    (dom Value     = (* 'SymTok*'::annots Content::content))
    (dom Content   = (+ Symbol List Sexp Struct NullNull Bool Int String
                        /*Decimal Float Timestamp Blob Clob*/))


    // Simple values require no expansion.
    // Their 'syntax' and 'application' denotations are the same.

    (dom DotNull  = (= DOTNULL) "Sentinel for typed nulls")
    (dom NullNull = (+ DotNull))
    (dom Bool     = (+ B DotNull))
    (dom Int      = (+ I DotNull))
    (dom String   = (+ Unicode DotNull))


    // Symbols

    (dom Sym0      = (= SYM0)            "The undefined symbol $0")
    (dom AbsentSym = (* Unicode::module I::index))
    (dom SymTok    = (+ Unicode Sym0 AbsentSym))
    (dom Symbol    = (+ SymTok DotNull))


    (fn SymTok_matches ((s SymTok) (u Unicode) -> B)
      (and (element_of s Unicode)
           (U_EQ (lower s Unicode) u)))

    (fn Symbol_matches ((s Symbol) (u Unicode) -> B)
      (and (element_of s SymTok)
           (SymTok_matches (lower s SymTok) u)))

    (fn Value_is_symbol_matching ((v Value) (u Unicode) -> B)
      (and (element_of (Value_content v) Symbol)
           (Symbol_matches (lower (Value_content v) Symbol) u)))

    (fn 'Value?_is_symbol_matching' ((v 'Value?') (u Unicode) -> B)
      (and (opt_is_present v) (Value_is_symbol_matching (opt_value v) u)))


    // Containers

    (dom List     = (+ 'Value*' DotNull))
    (dom Sexp     = (+ 'Value*' DotNull))
    (dom Struct   = (+ 'Field*' DotNull))
    (dom Field    = (* SymTok::name Value::value))


    (fn Fields_get ((fs 'Field*') (u Unicode) -> 'Value*')
      (if (seq_is_empty fs)
        (seq 'Value*')
        (let [(f (seq_head fs)),
              (vs (Fields_get (seq_tail fs) u))]
          (if (SymTok_matches (Field_name f) u)
            (seq_prepend (Field_value f) vs)
            vs))))

    (fn Struct_get ((s Struct) (u Unicode) -> 'Value*')
      (Fields_get (lower s 'Field*') u))

    (fn Struct_get1 ((s Struct) (u Unicode) -> 'Value?')
      (let [(vs (Struct_get s u))]
        (if (EQ (seq_length vs) 0)
          (opt 'Value?')
          (if (EQ (seq_length vs) 1)
            (opt 'Value?' (ith vs 0))
            (wrong "Repeated field: " u)))))


    //==========================================================================
    // Abstract Syntax Trees, which can contain unresolved SIDs

    (dom TSTree     = (+ STree IVM))
    (dom STree      = (+ SValue SEexp))
    (dom SValue     = (* 'SSymTok*'::annots SContent::content))
    (dom SContent   = (+ SSymbol SList SSexp SStruct NullNull Bool Int String
                         /*Decimal Float Timestamp Blob Clob*/))

    (dom SSymTok   = (+ Unicode I))
    (dom SSymbol   = (+ SSymTok DotNull))

    (dom SList     = (+ 'STree*' DotNull))
    (dom SSexp     = (+ 'STree*' DotNull))

    (dom SField    = (* SSymTok::name STree::tree))
    (dom SStruct   = (+ 'SField*' DotNull))

    (dom SEexp      = (* MacroRef::ref 'STree*'::args))
    (dom MacroRef   = (* 'Unicode?'::module NameOrAddr::macro))
    (dom NameOrAddr = (+ Unicode I))


    // Ion Version Markers

    (dom IVM = (* I I) "Ion version markers")

    (const IVM_1_0 (tuple IVM 1 0))
    (const IVM_1_1 (tuple IVM 1 1))

    (fn IVM_eq ((i1 IVM) (i2 IVM)-> B)
      (and (EQ (ith i1 0) (ith i2 0))
           (EQ (ith i1 1) (ith i2 1))))


    //==========================================================================
    // Parsing Interface

    // Here we abstract over the parser, to show the encoding feedback loop.
    // The parsing layer is given a subset of the expansion environment.
    // It would be easier to just pass the Environment, but this is explicit
    // WRT exactly what information can affect parsing.

    (dom ParseStep    = (* TSTree::tree ParseStream::next))
    (dom ParseStream  = (-> IVM 'ParseStep?'))

    (dom Document  = (^ is_truthy) "Ion documents")
    (dom Parser    = (-> Document ParseStream))


    //==========================================================================
    // Expansion of abstract syntax trees into values

    (dom Environment = (* Catalog::catalog BoundModule::sysModule 'SymTok*'::docSymbols
                          'BoundModule*'::modules 'BoundModule*'::mactab))
    // docSymbols does not include $0 or system symbols


    (fn currentSpecVersion ((r Environment) -> IVM)
      (Module_specVersion (BoundModule_module (Environment_sysModule r))))

    (fn currentSymtab ((r Environment) -> 'SymTok*')
      (let [(ss (Module_symtab (BoundModule_module (Environment_sysModule r))))]
        (seq_prepend (lift_to SymTok SYM0)
                     (seq_append (compile_symtab ss "$ion" (seq_length ss))
                                 (Environment_docSymbols r)))))


    (fn expand_STree ((t STree) (r Environment) -> 'Value*')
      (if (element_of t SValue)
        (seq 'Value*' (expand_SValue (lower t SValue) r))
        (expand_SEexp (lower t SEexp) r)))

    (fn 'expand_STree*' ((ts 'STree*') (r Environment) -> 'Value*')
      (if (seq_is_empty ts)
        (seq 'Value*')
        (seq_append ('expand_STree'  (seq_head ts) r)
                    ('expand_STree*' (seq_tail ts) r))))

    (fn expand_SValue ((sv SValue) (r Environment) -> Value)
      (tuple Value ('expand_SSymTok*' (SValue_annots  sv) r)
                   ('expand_SContent' (SValue_content sv) r)))

    (fn expand_SContent ((sv SContent) (r Environment) -> Content)
      (if (element_of sv SSymbol)
        (lift (expand_SSymbol (lower sv SSymbol) r) Content)
        (if (element_of sv SList)
          (lift (expand_SList (lower sv SList) r) Content)
          (if (element_of sv SSexp)
            (lift (expand_SSexp (lower sv SSexp) r) Content)
            (if (element_of sv SStruct)
              (lift (expand_SStruct (lower sv SStruct) r) Content)
              (if (element_of sv NullNull)
                (lift (lower sv NullNull) Content)
                (if (element_of sv Bool)
                  (lift (lower sv Bool) Content)
                  (if (element_of sv Int)
                    (lift (lower sv Int) Content)
                    (if (element_of sv String)
                      (lift (lower sv String) Content)
                      (wrong "not implemented in this model"))))))))))


    // Symbol expansion

    (fn expand_SSymbol ((v SSymbol) (r Environment) -> Symbol)
      (if (element_of v DotNull)
        (lift DOTNULL Symbol)
        (lift (expand_SSymTok (lower v SSymTok) r) Symbol)))

    (fn expand_SSymTok ((s SSymTok) (r Environment) -> SymTok)
      (if (element_of s Unicode)
        (lift (lower s Unicode) SymTok)
        (let [(i  (lower s I)),
              (ts (currentSymtab r))]
          (if (< i (seq_length ts))
            (ith ts i)
            (wrong "Invalid symbol address " i)))))

    (fn 'expand_SSymTok*' ((ss 'SSymTok*') (r Environment) -> 'SymTok*')
      (if (seq_is_empty ss)
        EMPTY_SYMTOKS
        (seq_prepend (expand_SSymTok  (seq_head ss) r)
                     ('expand_SSymTok*' (seq_tail ss) r))))


    // Sequence expansion

    (fn expand_SList ((v SList) (r Environment) -> List)
      (if (element_of v DotNull)
        (lift DOTNULL List)
        (lift ('expand_STree*' (lower v 'STree*') r) List)))

    (fn expand_SSexp ((v SSexp) (r Environment) -> Sexp)
      (if (element_of v DotNull)
        (lift DOTNULL Sexp)
        (lift ('expand_STree*' (lower v 'STree*') r) Sexp)))


    // Struct expansion

    (fn expand_SStruct ((v SStruct) (r Environment) -> Struct)
      (if (element_of v DotNull)
        (lift DOTNULL Struct)
        (lift ('expand_SField*' (lower v 'SField*') r) Struct)))

    (fn expand_SField ((sf 'SField') (r Environment) -> 'Field*')
      (let [(t  (expand_SSymTok (SField_name sf) r)),
            (vs (expand_STree   (SField_tree sf) r))]
        (letrec [(mk_fields (lambda (vs1)
                              (if (seq_is_empty vs1)
                                  (seq 'Field*')
                                  (seq_prepend (tuple Field t (seq_head vs1))
                                               (mk_fields (seq_tail vs1))))))]
          (mk_fields vs))))

    (fn 'expand_SField*' ((sfs 'SField*') (r Environment) -> 'Field*')
      (if (seq_is_empty sfs)
        (seq 'Field*')
        (seq_append (expand_SField (seq_head sfs) r) ('expand_SField*' (seq_tail sfs) r))))


    //==========================================================================
    // Top-level evaluation

    (dom Evaluator = (-> Document Catalog 'Value*'))

    (fn mk_Evaluator ((p Parser) -> Evaluator)
      (mk_fn Evaluator (d c)
        (let [(p0 (p d)),
              (r0 (tuple Environment c (systemModule IVM_1_0)
                    EMPTY_SYMTOKS
                    (seq 'BoundModule*' (systemModule IVM_1_0))
                    (seq 'BoundModule*' /* No user macros installed */))),
              (k0 (mk_fn TContinuation (r vs) vs))]
          (TE_ParseStream p0 r0 k0))))


    (dom TContinuation = (-> Environment 'Value*' 'Value*')
      "Continuation when expanding top-level values")


    // TODO don't overload p with two different types
    (fn TE_ParseStream ((p ParseStream) (r Environment) (k TContinuation) -> 'Value*')
      (let [(step (p (currentSpecVersion r)))]
        (if (opt_is_present step)
          (TE_TSTree (ParseStep_tree (opt_value step)) r
            (mk_fn TContinuation (r1 vs1)
              (TE_ParseStream (ParseStep_next (opt_value step)) r1
                (mk_fn TContinuation (r2 vs2)
                  (k r2 (seq_append vs1 vs2))))))
          (k r (seq 'Value*')))))


    (fn TE_TSTree ((t TSTree) (r Environment) (k TContinuation) -> 'Value*')
      (if (element_of t IVM)
        (k (compile_IVM (lower t IVM) r) (seq 'Value*'))
        (let [(vs (expand_STree (lower t STree) r))]
          ('TE_Value*' vs r k))))


    (fn TE_Value ((v Value) (r Environment) (k TContinuation) -> 'Value*')
      (if (isLocalSymbolTable v)
        (k (compile_LST (lower (Value_content v) Struct) r) (seq 'Value*'))
        (if (and (IVM_eq (currentSpecVersion r) IVM_1_1) (isIonLiteral v))
          (TE_literal v r k)
          (k r (seq 'Value*' v)))))

    (fn 'TE_Value*' ((vs 'Value*') (r Environment) (k TContinuation) -> 'Value*')
      (if (seq_is_empty vs)
        (k r vs)
        (TE_Value (seq_head vs) r
          (mk_fn TContinuation (r1 vs1)
            ('TE_Value*' (seq_tail vs) r1
              (mk_fn TContinuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))


    //==========================================================================
    // IVM compilation

    (fn compile_IVM ((i IVM) (r Environment) -> Environment)
      (tuple Environment
        (Environment_catalog r)
        (systemModule i)
        EMPTY_SYMTOKS
        (seq 'BoundModule*' (systemModule i))
        (seq 'BoundModule*' /* No user macros installed */)))


    //==========================================================================
    // $ion_symbol_table compilation

    (fn isLocalSymbolTable ((v Value) -> B)
      (and (element_of (Value_content v) Struct)
           (and (not (seq_is_empty (Value_annots v)))
                (SymTok_matches (seq_head (Value_annots v)) "$ion_symbol_table"))))

    (fn compile_LST ((s Struct) (r Environment) -> Environment)
      (if (element_of s DotNull)
        (compile_LST (lift (seq 'Field*') Struct) r)
        (let [(is (if ('Value?_is_symbol_matching'
                        ('hint:paren' (Struct_get1 s "imports"))
                        "$ion_symbol_table")
                    (Environment_docSymbols r)
                    (compile_LST_imports (normalize_list (Struct_get1 s "imports")) r))),
              (ss (map 'SymTok*' compile_LST_symbol
                    (normalize_list (Struct_get1 s "symbols"))))]
          (tuple Environment
            (Environment_catalog r)
            (Environment_sysModule r)
            (seq_append is ss)
            (seq 'BoundModule*' (Environment_sysModule r))
            (seq 'BoundModule*')))))


    // LST symbols field

    // Try inlining c for better math and collapsing ifs
    (fn normalize_list ((v 'Value?') -> 'Value*')
      (if (opt_is_present v)
        (let [(c (Value_content (opt_value v)))]
          ('hint:oneline'
            (if (and (element_of c List) (not (element_of c DotNull)))
              (lower c List 'Value*')
              (seq 'Value*'))))
        (seq 'Value*')))

    (fn compile_LST_symbol ((v Value) -> SymTok)
      (let [(c (Value_content v))]
        ('hint:oneline'
          (if (and (element_of c String) (not (element_of c DotNull)))
            (lift_to SymTok (lower c String Unicode))
            (lift_to SymTok SYM0)))))

    // LST imports field

    (fn compile_LST_imports ((vs 'Value*') (r Environment) -> 'SymTok*')
      // Would be nice to `map`, but this has two args and appends, not cons'es.
      (if (seq_is_empty vs)
        EMPTY_SYMTOKS
        (let [(c (Value_content (seq_head vs)))]
          (let [(ts ('hint:oneline'
                      (if (and (element_of c Struct) (not (element_of c DotNull)))
                        (compile_import (lower c Struct) r)
                        EMPTY_SYMTOKS)))]
            (seq_append ts (compile_LST_imports (seq_tail vs) r))))))

    (fn compile_import ((s Struct) (r Environment) -> 'SymTok*')
      (let [(n (normalize_name    (Struct_get1 s "name"   ))),
            (v (normalize_version (Struct_get1 s "version"))),
            (m (normalize_max_id  (Struct_get1 s "max_id" )))]
        (if (or (U_EQ n "")
                (U_EQ n "$ion"))
          (seq 'SymTok*')
          (if (opt_is_present m)
            // We have max_id, find best-match and adjust the length
            (let [(s (bestModule_Catalog (Environment_catalog r) n v))]
              (let [(symtab ('hint:oneline'
                              (if (opt_is_present s)
                                (Module_symtab (SharedModule_module (opt_value s)))
                                (seq 'Unicode?*'))))]
                (compile_symtab symtab n (opt_value m))))
            (let [(s (exactModule_Catalog (Environment_catalog r) n v))]
              (let [(symtab (Module_symtab (SharedModule_module s)))]
                (compile_symtab symtab n (seq_length symtab))))))))


    (fn compile_symtab ((us 'Unicode?*') (moduleName Unicode) (maxId I) -> 'SymTok*')
      (compile_symtab_loop us moduleName maxId 0))

    (fn compile_symtab_loop ((us 'Unicode?*') (moduleName Unicode) (maxId I) (i I) -> 'SymTok*')
      // i = number of elements collected so far; index of next elt
      (if (EQ i maxId)
        (seq 'SymTok*')
        (let [(s (if (and (< i (seq_length us))
                          (opt_is_present (ith us i)))
                   (lift (opt_value (ith us i)) SymTok)
                   (lift (tuple AbsentSym moduleName (+ i 1)) SymTok)))]
          (seq_prepend s (compile_symtab_loop us moduleName maxId (+ i 1))))))


    (fn normalize_name ((v 'Value?') -> Unicode)             // "" = absent or invalid
      (if (and (opt_is_present v)
               (and (element_of (Value_content (opt_value v)) String)
                    (not (element_of (Value_content (opt_value v)) DotNull))))
        (lower (Value_content (opt_value v)) String Unicode)
        ""))

    (fn normalize_version ((v 'Value?') -> I)                // 1 = absent or invalid
      (if (and (opt_is_present v)
               (and (element_of (Value_content (opt_value v)) Int)
                    (and (not (element_of (Value_content (opt_value v)) DotNull))
                         (>= (lower (Value_content (opt_value v)) Int I) 1))))
        (lower (Value_content (opt_value v)) Int I)
        1))

    (fn normalize_max_id ((v 'Value?') -> 'I?')              // <> = absent or invalid
      (if (and (opt_is_present v)
               (and (element_of (Value_content (opt_value v)) Int)
                    (and (not (element_of (Value_content (opt_value v)) DotNull))
                         (>= (lower (Value_content (opt_value v)) Int I) 0))))
        (opt 'I?' (lower (Value_content (opt_value v)) Int I))
        (opt 'I?')))


    //==========================================================================
    // Encoding Modules

    (dom Module        = (* IVM::specVersion 'Unicode?*'::symtab 'ExportedMacro*'::mactab))
    (dom SharedModule  = (* Unicode::name I::version Module::module))
    (dom BoundModule   = (* Unicode::name Module::module))   // Locally-assigned name

    (fn BoundModule_symtab  ((m BoundModule) -> 'SymTok*')
      (Module_symtab (BoundModule_module m)))
    (fn BoundModule_mactab  ((m BoundModule) -> 'ExportedMacro*')
      (Module_mactab (BoundModule_module m)))


    //==========================================================================
    // Catalogs

    (dom Catalog = (* 'SharedModule*'::modules))


    (fn exactModule_Catalog ((c Catalog) (n Unicode) (v I) -> 'SharedModule')
      (exactModule_SMs (Catalog_modules c) n v))

    (fn exactModule_SMs ((ss 'SharedModule*') (n Unicode) (v I) -> 'SharedModule')
      (if (seq_is_empty ss)
        (wrong "No exact-match for " n "@" v)
        (if (and (U_EQ (SharedModule_name (seq_head ss)) n)
                 (EQ (SharedModule_version (seq_head ss)) v))
          (seq_head ss)
          (exactModule_SMs (seq_tail ss) n v))))


    (fn bestModule_Catalog ((c Catalog) (n Unicode) (v I) -> 'SharedModule?')
      (bestModule_SMs (Catalog_modules c) n v))

    (fn bestModule_SMs ((ss 'SharedModule*') (n Unicode) (v I) -> 'SharedModule?')
      (if (seq_is_empty ss)
        (opt 'SharedModule?')
        // WARNING These variable names appear in the narrative, keep it in sync!
        (let [(ss1 (bestModule_SMs (seq_tail ss) n v))]
          (if (not (U_EQ (SharedModule_name (seq_head ss)) n))
            ss1
            (if (or (EQ (SharedModule_version (seq_head ss)) v)
                    (not (opt_is_present ss1)))
              // Exact match, or only match.
              (opt 'SharedModule?' (seq_head ss))
              // Inexact match, and the tail had a match.
              (if (or (EQ (SharedModule_version (opt_value ss1)) v)
                      (>  (SharedModule_version (opt_value ss1))
                          (SharedModule_version (seq_head ss))))
                // The tail had an exact match, or larger version.
                ss1
                (opt 'SharedModule?' (seq_head ss))))))))

    (fn Catalog_extend ((c Catalog) (s SharedModule) -> Catalog)
      // TODO reject duplicate key
      (tuple Catalog (seq_prepend s (Catalog_modules c))))


    //==========================================================================
    // System Modules

    (const systemSymbols_1_0
      ('hint:multiline'
        (seq 'Unicode?*'
          (opt 'Unicode?' "$ion")
          (opt 'Unicode?' "$ion_1_0")
          (opt 'Unicode?' "$ion_symbol_table")
          (opt 'Unicode?' "name")
          (opt 'Unicode?' "version")
          (opt 'Unicode?' "imports")
          (opt 'Unicode?' "symbols")
          (opt 'Unicode?' "max_id")
          (opt 'Unicode?' "$ion_shared_symbol_table"))))


    (fn systemModule ((i IVM) -> BoundModule)
      (if (IVM_eq i IVM_1_0)
        (tuple BoundModule "$ion" (tuple Module i systemSymbols_1_0 (seq 'ExportedMacro*')))
        (if (IVM_eq i IVM_1_1)
          (tuple BoundModule "$ion" (tuple Module i systemSymbols_1_1 systemMacros_1_1))
          (wrong "Unsupported Ion version: " (ith i 0) "." (ith i 1)))))


    //==========================================================================
    // Shared Symbol Table complation

    (fn isSST ((v Value) -> B)
      (and (element_of (Value_content v) Struct)
           (and (not (seq_is_empty (Value_annots v)))
              (SymTok_matches (seq_head (Value_annots v)) "$ion_shared_symbol_table"))))

    (fn compile_SST ((s Struct) -> SharedModule)
      (let [(n (normalize_name    (Struct_get1 s "name"))),
            // Yes, SST version is normalized to 1
            (v (normalize_version (Struct_get1 s "version")))]
        (if (U_EQ n "")
          (wrong "SST has invalid name")
          (tuple SharedModule n v
            (tuple Module IVM_1_0
              (map 'Unicode?*' compile_SST_symbol
                (normalize_list (Struct_get1 s "symbols")))
              (seq 'ExportedMacro*'))))))


    (fn compile_SST_symbol ((v Value) -> 'Unicode?')
      (let [(c (Value_content v))]
        ('hint:oneline'
          (if (and (element_of c String) (not (element_of c DotNull)))
            (opt 'Unicode?' (lower c String Unicode))
            (opt 'Unicode?')))))


    //==========================================================================
    // Ion 1.1

    //==========================================================================
    // Literals

    (fn isIonLiteral ((v Value) -> B)
      (and (not (seq_is_empty (Value_annots v)))
           (SymTok_matches (seq_head (Value_annots v)) "$ion_literal")))

    (fn TE_literal ((v Value) (r Environment) (k TContinuation) -> 'Value*')
      (let [(v1 (tuple Value (seq_tail (Value_annots v)) (Value_content v)))]
        (if (isLocalSymbolTable v1)
          (wrong "Cannot use literal $ion_symbol_table struct as application data")
          (k r (seq 'Value*' v1)))))


    //==========================================================================
    // Macros

    (dom Macro = (* Signature::signature F::xform))

    (dom Signature   = (* 'ParamSpec*'::params B::hasRest /* TODO ResultSpec */))
    (dom ParamSpec   = (* Unicode::name ParamShape::shape))  // TODO Should name be a SymTok?
    (dom ParamShape  = (* ParamType::type Cardinality::card /*B::grouped*/))
    (dom ParamType   = (= ANY))
    (dom Cardinality = (= EXACTLY_ONE ONE_OR_MORE ZERO_OR_ONE ZERO_OR_MORE))


    (fn is_voidable ((p ParamSpec) -> B)
      (let [(c (ParamShape_card (ParamSpec_shape p)))]
        (or (EQ_Enum c ZERO_OR_ONE) (EQ_Enum c ZERO_OR_MORE))))


    (dom ExportedMacro = (* 'Unicode?'::name Macro::macro))

    (fn ExportedMacros_get ((ms 'ExportedMacro*') (u Unicode) -> 'Macro?')
      (if (seq_is_empty ms)
        (opt 'Macro?')
        (if (and (opt_is_present  (ExportedMacro_name (seq_head ms)))
                 (U_EQ (opt_value (ExportedMacro_name (seq_head ms))) u))
          (opt 'Macro?' (ExportedMacro_macro (seq_head ms)))
          (ExportedMacros_get (seq_tail ms) u))))

    (fn BoundModules_get ((ms 'BoundModule*') (u Unicode) -> 'Macro?')
      (if (seq_is_empty ms)
        (opt 'Macro?')
        (let [(m1 (ExportedMacros_get (BoundModule_mactab (seq_head ms)) u)),
              (m2 (BoundModules_get   (seq_tail ms) u))]
          (if (opt_is_present m1)
            (if (opt_is_present m2)
              (wrong "Ambiguous macroreference :" u)
              m1)
            m2))))


    //==========================================================================
    // Macro Expansion

    (fn resolve_MacroRef ((m MacroRef) (r Environment) -> Macro)
      (let [(mod (MacroRef_module m)),
            (mac (MacroRef_macro  m)),
            (sysMod (Environment_sysModule r))]
        (if (opt_is_present mod)
          // Quailified reference
          (if (U_EQ (opt_value mod) "$ion")
            (if (element_of mac Unicode)
              (let [(m (ExportedMacros_get (BoundModule_mactab sysMod) (lower_to Unicode mac)))]
                (if (opt_is_present m)
                  (opt_value m)
                  (wrong "No such macro: :$ion:" (lower_to Unicode mac))))
              // TODO handle qualified ints
              (wrong "Qualified macro addresses not implemented"))
            // TODO Find other modules
            (wrong "Module not in scope: " (opt_value mod)))
          // Named or local-offset
          (if (element_of mac Unicode)
            (let [(ms (seq_prepend sysMod (Environment_mactab r)))]
              (let [(m (BoundModules_get ms (lower_to Unicode mac)))]
                (if (opt_is_present m)
                  (opt_value m)
                  (wrong "No such macro: :" (lower_to Unicode mac)))))
            // TODO handle unqualified ints
            (wrong "Unqualified macro addresses not implemented")))))


    (fn expand_SEexp ((v SEexp) (r Environment) -> 'Value*')
      (if (IVM_eq (currentSpecVersion r) IVM_1_0)
        (wrong "Eexp not allowed in Ion 1.0")
        (let [(m (resolve_MacroRef (SEexp_ref v) r))]
          (Macro_invoke m (SEexp_args v) r))))


    (dom 'Value**' = (** 'Value*'))

    (fn collateArgs ((ps 'ParamSpec*') (isRest B) (r Environment) (ts 'STree*') -> 'Value**')
      (if (seq_is_empty ps)
        (if (seq_is_empty ts)
          (seq 'Value**')                 // All done!
          (wrong "Too many arguments"))
        (let [(p (seq_head ps))]
          (if (seq_is_empty ts)
            // We hava a param, but no more arguments; param must be voidable.
            (if (is_voidable p)
              (seq_prepend (seq 'Value*')
                (collateArgs (seq_tail ps) isRest r ts))
              (wrong "Too few arguments"))
            // We have both a param and more arguments
            (if (and isRest (seq_is_empty (seq_tail ps)))
              // We're at a rest-parameter, so grab everything that remains.
              (seq 'Value**' ('expand_STree*' ts r))
              (let [(t  (seq_head ts)),
                    (is (collateArgs (seq_tail ps) isRest r (seq_tail ts) ))]
                // TODO Grouped parameters
                (seq_prepend (expand_STree t r) is)))))))


    // Collate, validate the arguments based on the Macro's signature, then
    // invoke the macro
    (fn Macro_invoke ((m Macro) (ts 'STree*') (r Environment) -> 'Value*')
      (let [(sig (Macro_signature m))]
        (apply (Macro_xform m)
          (collateArgs (Signature_params sig) (Signature_hasRest sig) r ts))))


    // TODO $ion_encoding compilation
    // TODO $ion_shared_module compilation
    // TODO Macro definitions
    // TODO Template operators


    //==========================================================================
    // System Module 1.1

    (const systemSymbols_1_1
      (seq_append systemSymbols_1_0
        (seq 'Unicode?*'
          (opt 'Unicode?' "$ion_literal")
          /* ... */)))

    (const systemMacros_1_1
      ('hint:multiline'
        (seq 'ExportedMacro*'
          (tuple ExportedMacro (opt 'Unicode?' "void")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  (tuple ParamSpec "args" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (rest)
                (seq 'Value*'))))
          (tuple ExportedMacro (opt 'Unicode?' "values")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  (tuple ParamSpec "args" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (rest)
                rest)))
          (tuple ExportedMacro (opt 'Unicode?' "make_string")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  // TODO ANY should be TEXT
                  (tuple ParamSpec "content" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (content /* Value* */)
                (seq 'Value*'
                  (tuple Value (seq 'SymTok*')
                    (lift (appendText content) String Content))))))
          (tuple ExportedMacro (opt 'Unicode?' "make_symbol")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  // TODO ANY should be TEXT
                  (tuple ParamSpec "content" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (content /* Value* */)
                (seq 'Value*'
                  (tuple Value (seq 'SymTok*')
                    (lift (appendText content) SymTok Symbol Content))))))
          (tuple ExportedMacro (opt 'Unicode?' "make_list")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  (tuple ParamSpec "args" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (rest)
                (seq 'Value*'
                  (tuple Value (seq 'SymTok*')
                    (lift_to Content (lift_to List rest)))))))
          (tuple ExportedMacro (opt 'Unicode?' "make_sexp")
            (tuple Macro
              (tuple Signature
                (seq 'ParamSpec*'
                  (tuple ParamSpec "args" (tuple ParamShape ANY ZERO_OR_MORE)))
                true)  // has rest param
              (lambda (rest)
                (seq 'Value*'
                  (tuple Value (seq 'SymTok*')
                    (lift_to Content (lift_to Sexp rest)))))))
          /* ... */)))


    (fn appendText ((vs 'Value*') -> Unicode)
      (if (seq_is_empty vs)
        (inject_into Unicode "")
        (Unicode_append (Value_unicode (seq_head vs))
          (appendText (seq_tail vs)))))

    (fn Value_unicode ((v Value) -> Unicode)
      (let [(c (Value_content v))]
        (if (element_of c Symbol)
          (if (element_of c Unicode)
            (lower c Symbol SymTok Unicode)
            "")
          (if (element_of c String)
            (if (element_of c Unicode)
              (lower c String Unicode)
              "")
            (wrong "Not a text value")))))
  )

  (define EMPTY_SYMTOKS    (seq 'SymTok*'))
)

(module ion_semantic_model "/fusion"
  '''
A denotational semantic model of Ion.

TODO
----
Terminology/Readability:
* Replace at-most-one uses of D* with D? and bespoke accessor syntax.
* Figure out the proper name for `I`.  N? Z?
* Greekify invocations of:
  * Environment_after_IVM/LST to C_IVM and C_LST ?
  * symbol_padding
  * adjust_length
* Less type-switching via E[[]] denotations
  * Easier with distinct typed nulls
    * [LITERALS] Requires literals to render them as typewriter `null.foo`.
* Add seq_is_not_empty for better prose in compile_import;
  inlining Value_has_first_annot

Features:
* Implement Decimal, Float, Timestamp, Blob/Clob

Defects:
* From spec: "$0 is not semantically equivalent to SIDs with unknown text from
  shared symbol tables, so replacing such SIDs with $0 is a destructive operation
  to the semantics of the data."
  * Probably SymTok needs to track symbol source: SharedSymtab x N::index
* SIDs should be non-negative.
* [SST Semantics] "When mapping from string to symbol ID, there may be multiple
  associated IDs (the same string could appear twice as children of the symbols
  field). Implementations MUST select the lowest known ID, and all other
  associated IDs MUST be handled as if undefined."
  * Not sure what "handled as undefined" implies.
* SST compilation is very weak.
* Catalog construction should reject duplicate keys, so we don't imply anything
  about selection criteria.
* Struct denotations should be order-agnostic. See L.I.S.P. §5.5

Cleanup:
* (inject_into Unicode ...) should not be needed; string literals _are_ Unicode.
* `lambda`s should instead use `mk_fn` with ad-hoc signature.


Spec Problems
-------------
* No mention of possible annotations on imports field or its entries.
* "A version marker can also occur at non-initial positions at the top level,
  and it will have the same effect; when encountered below top-level, it has no
  processing effect and is treated as an ordinary user value."
  * Wrong, IVMs are syntactically distinct and cannot appear elsewhere.
* "Null elements declare undefined symbol IDs (“gaps”) within the sequence;
  implementations must handle requests for such symbols the same as if the
  requested ID beyond the end of the list."
  * BUT: "beyond the end" is an error.
  * AND: what does "requests for such symbols" mean?
* Content under "Imports" should use present/absent instead of defined/undefined
  since the latter has other meaning.
* [Symbol Zero] "$0 is only semantically equivalent to itself and to
  locally-declared SIDs with unknown text."
  * Probably better to treat the local case as something other than "unknown"
    so that term only applies to the SST case.  A local null entry is _known_ to
    be $0, but we know _nothing_ about an absent (or undersized substitute) SST.
  '''


  (require "/fusioncontrib/denotation/dsl")

  (provide (all_defined_out))


  (define_model Ion
    (import B I Unicode)

    (dom IVM     = (* I I) "Ion version markers")

    (fn IVM_eq ((i1 IVM) (i2 IVM)-> B)
      (and (EQ (ith i1 0) (ith i2 0))
           (EQ (ith i1 1) (ith i2 1))))


    (dom Sym0    = "The undefined symbol")


    //=============================
    // Simple values require no expansion.
    // Their 'syntax' and 'application' denotations are the same.

    (dom DotNull = "Sentinel for typed nulls")

    (dom NullNull = (+ DotNull))
    (dom Bool     = (+ B DotNull))
    (dom Int      = (+ I DotNull))
    (dom String   = (+ Unicode DotNull))


    //=============================
    // Abstract Syntax Trees, which can contain unresolved SIDs

    (dom SSymTok   = (+ Unicode I))
    (dom SSymbol   = (+ SSymTok DotNull))

    (dom SList     = (+ 'STree*' DotNull))
    (dom SSexp     = (+ 'STree*' DotNull))

    (dom SField    = (* SSymTok STree))
    (dom SStruct   = (+ 'SField*' DotNull))


    (dom SContent   = (+ SSymbol SList SSexp SStruct NullNull Bool Int String
                         /*Decimal Float Timestamp Blob Clob*/))
    (dom SValue     = (* 'SSymTok*' SContent))
    (dom STree      = (+ SValue /* Eexp will go here */))
    (dom TSTree     = (+ STree IVM))

    (fn SValue_annots  ((rv SValue) -> 'SSymTok*') (ith rv 0))
    (fn SValue_content ((rv SValue) -> 'SContent') (ith rv 1))

    (fn SField_name  ((rf SField) -> SSymTok) (ith rf 0))
    (fn SField_tree  ((rf SField) -> STree)   (ith rf 1))


    //=============================
    // Application-layer Data Types

    (dom SymTok    = (+ Unicode Sym0))  // "Expanded" symbol token
    (dom Symbol    = (+ SymTok DotNull))

    (dom List     = (+ 'Value*' DotNull))
    (dom Sexp     = (+ 'Value*' DotNull))

    (dom Field    = (* SymTok Value))
    (dom Struct   = (+ 'Field*' DotNull))

    // The Ion data model, proper
    (dom Content   = (+ Symbol List Sexp Struct NullNull Bool Int String
                        /*Decimal Float Timestamp Blob Clob*/))
    (dom Value     = (* 'SymTok*' Content))


    (fn Value_annots  ((v Value) -> 'SymTok*') (ith v 0))
    (fn Value_content ((v Value) -> 'Content') (ith v 1))

    (fn Field_name  ((f Field) -> SymTok)   (ith f 0))
    (fn Field_value ((f Field) -> Value)    (ith f 1))

    (fn SymTok_matches ((s SymTok) (u Unicode) -> B)
      (and (element_of s Unicode)
           (U_EQ (lower s Unicode) u)))

    (fn Symbol_matches ((s Symbol) (u Unicode) -> B)
      (and (element_of s SymTok)
           (SymTok_matches (lower s SymTok) u)))

    (fn Value_is_symbol_matching ((v Value) (u Unicode) -> B)
      (and (element_of (Value_content v) Symbol)
           (Symbol_matches (lower (Value_content v) Symbol) u)))

    (fn Fields_get ((fs 'Field*') (u Unicode) -> 'Value*')
      (if (seq_is_empty fs)
        (seq 'Value*')
        (let [(f (seq_head fs)),
              (vs (Fields_get (seq_tail fs) u))]
          (if (SymTok_matches (Field_name f) u)
            (seq_prepend (Field_value f) vs)
            vs))))

    (fn Struct_get ((s Struct) (u Unicode) -> 'Value*')
      (Fields_get (lower s 'Field*') u))

    (fn Struct_get1 ((s Struct) (u Unicode) -> 'Value?')
      (let [(vs (Struct_get s u))]
        (if (= (seq_length vs) 0)
          (opt 'Value?')
          (if (= (seq_length vs) 1)
            (opt 'Value?' (ith vs 0))
            (wrong "Repeated field: " u)))))


    //=======================
    // Environment Management

    (fn SymToks_for_IVM ((i IVM) -> 'SymTok*')
      (if (IVM_eq i IVM_1_0)
        (seq 'SymTok*'
          (lift_to SymTok SYM0)
          (lift_to SymTok (inject_into Unicode "$ion"))
          (lift_to SymTok (inject_into Unicode "$ion_1_0"))
          (lift_to SymTok (inject_into Unicode "$ion_symbol_table"))
          (lift_to SymTok (inject_into Unicode "name"))
          (lift_to SymTok (inject_into Unicode "version"))
          (lift_to SymTok (inject_into Unicode "imports"))
          (lift_to SymTok (inject_into Unicode "symbols"))
          (lift_to SymTok (inject_into Unicode "max_id"))
          (lift_to SymTok (inject_into Unicode "$ion_shared_symbol_table")))
        (wrong "Unsupported Ion version: " (ith i 0) "." (ith i 1))))


    (dom SharedSymtab    = (* Unicode I 'SymTok*'))     // name, version, symbols

    (fn SST_name    ((s SharedSymtab) -> Unicode)     (ith s 0))
    (fn SST_version ((s SharedSymtab) -> I)           (ith s 1))
    (fn SST_symbols ((s SharedSymtab) -> 'SymTok*')   (ith s 2))

    (fn is_SST ((v Value) -> B)
      (and (element_of (Value_content v) Struct)
           (and (not (seq_is_empty (Value_annots v)))
              (SymTok_matches (seq_head (Value_annots v)) "$ion_shared_symbol_table"))))

    (fn compile_SST ((s Struct) -> SharedSymtab)
      (let [(n (lower (Value_content (opt_value (Struct_get1 s "name")))
                 String Unicode)),
            (v (normalize_version (Struct_get1 s "version")))]
        (tuple SharedSymtab n v (declared_symbols (Struct_get1 s "symbols")))))


    (dom Catalog = (+ 'SharedSymtab*'))

    (fn best_match_Catalog ((c Catalog) (n Unicode) (v I) -> 'SharedSymtab?')
      (best_match_SST (lower c 'SharedSymtab*') n v))

    (fn best_match_SST ((ssts 'SharedSymtab*') (n Unicode) (v I) -> 'SharedSymtab?')
      (if (seq_is_empty ssts)
        (opt 'SharedSymtab?')
        // WARNING These variable names appear in the narrative, keep it in sync!
        (let [(sst0 (seq_head ssts)),
              (ssts1 (best_match_SST (seq_tail ssts) n v))]
          (if (not (U_EQ (SST_name sst0) n))
            ssts1
            (if (or (EQ (SST_version sst0) v)
                    (not (opt_is_present ssts1)))
              // Exact match, or only match.
              (opt 'SharedSymtab?' sst0)
              // Inexact match, and the tail had a match.
              (if (or (EQ (SST_version (opt_value ssts1)) v)
                      (>  (SST_version (opt_value ssts1)) (SST_version sst0)))
                // The tail had an exact match, or larger version.
                ssts1
                (opt 'SharedSymtab?' sst0)))))))

    (fn Catalog_extend ((c Catalog) (s SharedSymtab) -> Catalog)
      // TODO reject duplicate key
      (lift (seq_prepend s (lower c 'SharedSymtab*')) Catalog))


    (dom Environment = (* Catalog IVM 'SymTok*'))

    (fn Environment_catalog ((r Environment) -> Catalog)   (ith r 0))
    (fn Environment_IVM     ((r Environment) -> IVM)       (ith r 1))
    (fn Environment_symbols ((r Environment) -> 'SymTok*') (ith r 2))



    // $ion_symbol_table "compilation"

    (fn symbol_padding ((n I) -> 'SymTok*')
      (if (EQ n 0)
        EMPTY_SYMTOKS
        (seq_prepend (lift SYM0 SymTok)
          (symbol_padding (- n 1)))))

    (fn adjust_length ((ss 'SymTok*') (n I) -> 'SymTok*')
      (if (< n (seq_length ss))
        (seq_truncate ss (eject n))
        (seq_append ss (symbol_padding (- n (seq_length ss))))))


    (fn normalize_name ((v 'Value?') -> Unicode)             // "" = absent or invalid
      (if (opt_is_present v)
        (let [(c (Value_content (opt_value v)))]
          (if (and (element_of c String) (not (element_of c DotNull)))
            (lower c String Unicode)
            EMPTY_UNICODE))
        EMPTY_UNICODE))

    (fn normalize_version ((v 'Value?') -> I)                // 1 = absent or invalid
      (if (opt_is_present v)
        (let [(c (Value_content (opt_value v)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (let [(i (lower c Int I))]
              (if (< i 1) 1 i))
            1))
        1))

    (fn normalize_max_id ((v 'Value?') -> 'I?')              // <> = absent or invalid
      (if (opt_is_present v)
        (let [(c (Value_content (opt_value v)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (let [(n (lower c Int I))]
              (if (< n 0) (opt 'I?') (opt 'I?' n)))
            (opt 'I?')))
        (opt 'I?')))


    (fn compile_import ((s Struct) (r Environment) -> 'SymTok*')
      (let [(n  (normalize_name    (Struct_get1 s "name"   ))),
            (v  (normalize_version (Struct_get1 s "version"))),
            (ms (normalize_max_id  (Struct_get1 s "max_id" )))]
        (if (or (U_EQ n "")
                (U_EQ n "$ion"))
          EMPTY_SYMTOKS
          (let [(ssts (best_match_Catalog (Environment_catalog r) n v))]
            (if (opt_is_present ms)  // We have max_id, adjust the length
              (let [(ts (if (opt_is_present ssts) (SST_symbols (opt_value ssts)) (seq 'SymTok*')))]
                (adjust_length ts (opt_value ms)))
              (if (and (opt_is_present ssts) (EQ (SST_version (opt_value ssts)) v))
                (SST_symbols (opt_value ssts))
                (wrong "No exact-match for " n "@" v)))))))


    (fn compile_imports ((vs 'Value*') (r Environment) -> 'SymTok*')
      (if (seq_is_empty vs)
        EMPTY_SYMTOKS
        (let [(c (Value_content (seq_head vs)))]
          (let [(ts (if (and (element_of c Struct) (not (element_of c DotNull)))
                      (compile_import (lower c Struct) r)
                      EMPTY_SYMTOKS))]
            (seq_append ts (compile_imports (seq_tail vs) r))))))

    (fn imported_symbols ((v 'Value?') (r Environment) -> 'SymTok*')
      (let [(ts (SymToks_for_IVM (Environment_IVM r)))]
        (if (opt_is_present v)
          (if (Value_is_symbol_matching (opt_value v) "$ion_symbol_table")
            (Environment_symbols r)
            (let [(c (Value_content (opt_value v)))]
              (if (and (element_of c List) (not (element_of c DotNull)))
                (seq_append ts
                            (compile_imports (lower c List 'Value*') r))
                ts)))
          ts)))

    (fn compile_symbols ((vs 'Value*') -> 'SymTok*')
      (if (seq_is_empty vs)
        EMPTY_SYMTOKS
        (let [(c (Value_content (seq_head vs)))]
          (let [(t (if (and (element_of c String) (not (element_of c DotNull)))
                     (lift_to SymTok (lower c String Unicode))
                     (lift_to SymTok SYM0)))]
            (seq_prepend t (compile_symbols (seq_tail vs)))))))

    (fn declared_symbols ((v 'Value?') -> 'SymTok*')
      (if (opt_is_present v)
        (let [(c (Value_content (opt_value v)))]
          (if (and (element_of c List) (not (element_of c DotNull)))
            (compile_symbols (lower c List 'Value*'))
            EMPTY_SYMTOKS))
        EMPTY_SYMTOKS))


    // Environment construction
    
    (fn SymToks_for_LST ((s Struct) (r Environment) -> 'SymTok*')
      (if (element_of s DotNull)
        (SymToks_for_LST (lift (seq 'Field*') Struct) r)
        (seq_append (imported_symbols (Struct_get1 s "imports") r)
                    (declared_symbols (Struct_get1 s "symbols")))))


    (fn Environment_after_IVM ((ivm IVM) (r Environment) -> Environment)
      (tuple Environment
        (Environment_catalog r)
        ivm
        (SymToks_for_IVM ivm)))

    (fn Environment_after_LST ((s Struct) (r Environment) -> Environment)
      (tuple Environment
        (Environment_catalog r)
        (Environment_IVM r)
        (SymToks_for_LST s r)))


    //==========================================================================
    // Expansion of abstract syntax trees into values

    (fn expand_STree ((t STree) (r Environment) -> 'Value*')
      (seq 'Value*' (expand_SValue (lower t SValue) r)))

    (fn expand_SValue ((rv SValue) (r Environment) -> Value)
      (tuple Value ('expand_SSymTok*' (SValue_annots  rv) r)
                   ('expand_SContent' (SValue_content rv) r)))

    (fn 'expand_STree*' ((rvs 'STree*') (r Environment) -> 'Value*')
      (if (seq_is_empty rvs)
        (seq 'Value*')
        (seq_append ('expand_STree'  (seq_head rvs) r)
                    ('expand_STree*' (seq_tail rvs) r))))


    (fn expand_SContent ((rv SContent) (r Environment) -> Content)
      (if (element_of rv SSymbol)
        (lift (expand_SSymbol (lower rv SSymbol) r) Content)
        (if (element_of rv SList)
          (lift (expand_SList (lower rv SList) r) Content)
          (if (element_of rv SSexp)
            (lift (expand_SSexp (lower rv SSexp) r) Content)
            (if (element_of rv SStruct)
              (lift (expand_SStruct (lower rv SStruct) r) Content)
              (if (element_of rv NullNull)
                (lift (lower rv NullNull) Content)
                (if (element_of rv Bool)
                  (lift (lower rv Bool) Content)
                  (if (element_of rv Int)
                    (lift (lower rv Int) Content)
                    (if (element_of rv String)
                      (lift (lower rv String) Content)
                      (wrong "should not happen"))))))))))


    (fn expand_SSymTok ((s SSymTok) (r Environment) -> SymTok)
      (if (element_of s Unicode)
        (lift (lower s Unicode) SymTok)
        (let [(i  (eject (lower s I))),
              (ts (Environment_symbols r))]
          (if (< i (seq_length ts))
            (ith ts i)
            (wrong "Invalid symbol address " i)))))

    (fn 'expand_SSymTok*' ((ss 'SSymTok*') (r Environment) -> 'SymTok*')
      (if (seq_is_empty ss)
        EMPTY_SYMTOKS
        (seq_prepend (expand_SSymTok  (seq_head ss) r)
                     ('expand_SSymTok*' (seq_tail ss) r))))

    (fn expand_SSymbol ((v SSymbol) (r Environment) -> Symbol)
      (if (element_of v DotNull)
        (lift DOTNULL Symbol)
        (lift (expand_SSymTok (lower v SSymTok) r) Symbol)))


    (fn expand_SList ((v SList) (r Environment) -> List)
      (if (element_of v DotNull)
        (lift DOTNULL List)
        (lift ('expand_STree*' (lower v 'STree*') r) List)))

    (fn expand_SSexp ((v SSexp) (r Environment) -> Sexp)
      (if (element_of v DotNull)
        (lift DOTNULL Sexp)
        (lift ('expand_STree*' (lower v 'STree*') r) Sexp)))


    (fn expand_SField ((rf 'SField') (r Environment) -> 'Field*')
      (let [(t  (expand_SSymTok (SField_name rf) r)),
            (vs (expand_STree   (SField_tree rf) r))]
        (letrec [(mk_fields (lambda (vs)
                              (if (seq_is_empty vs)
                                  (seq 'Field*')
                                  (seq_prepend (tuple Field t (seq_head vs))
                                               (mk_fields (seq_tail vs))))))]
          (mk_fields vs))))

    (fn 'expand_SField*' ((rfs 'SField*') (r Environment) -> 'Field*')
      (if (seq_is_empty rfs)
        (seq 'Field*')
        (seq_append (expand_SField (seq_head rfs) r) ('expand_SField*' (seq_tail rfs) r))))

    (fn expand_SStruct ((v SStruct) (r Environment) -> Struct)
      (if (element_of v DotNull)
        (lift DOTNULL Struct)
        (lift ('expand_SField*' (lower v 'SField*') r) Struct)))


    //==========================================================================
    // Top-level evaluation

    (dom TContinuation = (-> Environment 'Value*' 'Value*')
      "Continuation when expanding top-level values")


    // Scan for directives in expanded values and update Environment accordingly

    (fn TE_Value ((v Value) (r Environment) (k TContinuation) -> 'Value*')
      (if (and (element_of (Value_content v) Struct)
               (and (not (seq_is_empty (Value_annots v)))
                    (SymTok_matches (seq_head (Value_annots v)) "$ion_symbol_table")))
        (k (Environment_after_LST (lower (Value_content v) Struct) r) (seq 'Value*'))
        (k r (seq 'Value*' v))))

    (fn 'TE_Value*' ((vs 'Value*') (r Environment) (k TContinuation) -> 'Value*')
      (if (seq_is_empty vs)
        (k r vs)
        (TE_Value (seq_head vs) r
          (mk_fn TContinuation (r1 vs1)
            ('TE_Value*' (seq_tail vs) r1
              (mk_fn TContinuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))


    // Evaluate parsed top-level ASTs; handle directives

    (fn TE_TSTree ((trv TSTree) (r Environment) (k TContinuation) -> 'Value*')
      (if (element_of trv IVM)
        (k (Environment_after_IVM (lower trv IVM) r) (seq 'Value*'))
        (let [(vs (expand_STree (lower trv STree) r))]
          ('TE_Value*' vs r k))))


    // Here we abstract over the parser, to show the encoding feedback loop.
    // The parsing layer is given a subset of the expansion environment.
    // It would be easier to just pass the Environment, but this is explicit
    // WRT exactly what information can affect parsing.

    (dom ParseStep    = (* TSTree ParseStream))
    (dom ParseStream  = (-> IVM 'ParseStep?'))

    (fn ParseStep_tree ((p ParseStep) -> TSTree)      (ith p 0))
    (fn ParseStep_next ((p ParseStep) -> ParseStream) (ith p 1))


    (dom Document  = (^ is_truthy) "Ion documents")
    (dom Parser    = (-> Document ParseStream))
    (dom Evaluator = (-> Document Catalog 'Value*'))


    (fn TE_ParseStream ((p ParseStream) (r Environment) (k TContinuation) -> 'Value*')
      (let [(step (p (Environment_IVM  r)))]
        (if (opt_is_present step)
          (TE_TSTree (ParseStep_tree (opt_value step)) r
            (mk_fn TContinuation (r1 vs1)
              (TE_ParseStream (ParseStep_next (opt_value step)) r1
                (mk_fn TContinuation (r2 vs2)
                  (k r2 (seq_append vs1 vs2))))))
          (k r (seq 'Value*')))))

    (fn mk_Evaluator ((p Parser) -> Evaluator)
      (mk_fn Evaluator (d c)
        (let [(p0 (p d)),
              (r0 (tuple Environment c IVM_1_0 (SymToks_for_IVM IVM_1_0))),
              (k0 (mk_fn TContinuation (r vs) vs))]
          (TE_ParseStream p0 r0 k0))))

  )

  (define IVM_1_0          (tuple IVM 1 0))
  (define SYM0             (singleton Sym0))
  (define DOTNULL          (singleton DotNull))
  (define EMPTY_CATALOG    (lift (seq 'SharedSymtab*') Catalog))
  (define EMPTY_UNICODE    (inject_into Unicode ""))
  (define EMPTY_SYMTOKS    (seq 'SymTok*'))
)

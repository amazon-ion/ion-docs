(module ion_semantic_model "/fusion"
  '''
A denotational semantic model of Ion.

TODO
----
Functional:
* SID too large must raise an error. Need new way to test the LST maxid.
* From spec: "$0 is not semantically equivalent to SIDs with unknown text from
  shared symbol tables, so replacing such SIDs with $0 is a destructive operation
  to the semantics of the data."
  * Probably SymTok needs to track symbol source: SharedSymtab x N::index
* [SST Semantics] "When mapping from string to symbol ID, there may be multiple
  associated IDs (the same string could appear twice as children of the symbols
  field). Implementations MUST select the lowest known ID, and all other
  associated IDs MUST be handled as if undefined."
  * Not sure what "handled as undefined" implies.
* SST compilation is very weak.
* Catalog construction should reject duplicate keys, so we don't imply anything
  about selection criteria.
* Struct denotations should be order-agnostic. See L.I.S.P. §5.5

Cleanup:
* Remove use of non-functional features in modeled functions
  * if
  * raise
* `lambda`s should instead use `mk_fn` with ad-hoc signature.


Spec Problems
-------------
* No mention of possible annotations on imports field or its entries.
* "A version marker can also occur at non-initial positions at the top level,
  and it will have the same effect; when encountered below top-level, it has no
  processing effect and is treated as an ordinary user value."
  * Wrong, IVMs are syntactically distinct and cannot appear elsewhere.
* "Null elements declare undefined symbol IDs (“gaps”) within the sequence;
  implementations must handle requests for such symbols the same as if the
  requested ID beyond the end of the list."
  * BUT: "beyond the end" is an error.
  * AND: what does "requests for such symbols" mean?
* Content under "Imports" should use present/absent instead of defined/undefined
  since the latter has other meaning.
* [Symbol Zero] "$0 is only semantically equivalent to itself and to
  locally-declared SIDs with unknown text."
  * Probably better to treat the local case as something other than "unknown"
    so that term only applies to the SST case.  A local null entry is _known_ to
    be $0, but we know _nothing_ about an absent (or undersized substitute) SST.
  '''


  (require
    "/fusion/exception"               // Not functional, should not be needed
    "/fusion/private/record"
    "/fusioncontrib/denotation"
    )

  (provide (all_defined_out))


  (define_model Ion
    (import B)

    (dom I       = (^ is_int)    "Integers")
    (dom Unicode = (^ is_string) "Sequences of Unicode code points")

    (dom IVM     = (* I I) "Ion version markers")

    (fn IVM_eq ((i1 IVM) (i2 IVM)-> B)
      (and (=== (ith i1 0) (ith i2 0))
           (=== (ith i1 1) (ith i2 1))))


    (dom Sym0    = "The undefined symbol")


    //=============================
    // Safe values cannot contain SIDs.
    // Their 'raw' and 'application' values are the same.

    (dom DotNull = "Sentinel for typed nulls")

    (dom NullNull = (+ DotNull))
    (dom Boolean  = (+ B DotNull))
    (dom Int      = (+ I DotNull))
    (dom String   = (+ Unicode DotNull))

    (dom SafeVal = (+ NullNull Boolean Int String /*Decimal Float Timestamp Blob Clob*/)
      "Values that cannot contain SIDs")


    //=============================
    // Raw-layer Data Types, which can contain unresolved SIDs

    (dom RSymTok   = (+ Unicode I))
    (dom RSymbol   = (+ RSymTok DotNull))

    (dom RList     = (+ 'RValue*' DotNull))

    (dom RField    = (* RSymTok RValue))
    (dom RStruct   = (+ 'RField*' DotNull))


    // The "raw" data model
    (dom RContent = (+ SafeVal RSymbol RList RStruct))
    (dom RValue     = (* 'RSymTok*' RContent))
    (dom TRValue    = (+ RValue IVM))

    (fn RValue_annots  ((rv RValue) -> 'RSymTok*') (ith rv 0))
    (fn RValue_content ((rv RValue) -> 'RContent') (ith rv 1))

    (fn RField_name  ((rf RField) -> RSymTok) (ith rf 0))
    (fn RField_value ((rf RField) -> RValue)  (ith rf 1))


    //=============================
    // Application-layer Data Types

    (dom SymTok    = (+ Unicode Sym0))  // "Expanded" symbol token
    (dom Symbol    = (+ SymTok DotNull))

    (dom List     = (+ 'Value*' DotNull))

    (dom Field    = (* SymTok Value))
    (dom Struct   = (+ 'Field*' DotNull))

    // The Ion data model, proper
    (dom Content   = (+ SafeVal Symbol List Struct))
    (dom Value     = (* 'SymTok*' Content))

    (fn List_elts  ((v List) -> 'Value*') (lower v 'Value*'))

    (fn Value_annots  ((v Value) -> 'SymTok*') (ith v 0))
    (fn Value_content ((v Value) -> 'Content')   (ith v 1))

    (fn Field_name  ((f Field) -> SymTok) (ith f 0))
    (fn Field_value ((f Field) -> Value)    (ith f 1))

    (fn SymTok_matches ((s SymTok) (u Unicode) -> B)
      (if (element_of s Unicode)
        (=== (eject u) (eject (lower s Unicode)))
        false))

    (fn Symbol_matches ((s Symbol) (u Unicode) -> B)
      (if (element_of s SymTok)
        (SymTok_matches (lower s SymTok) u)
        false))

    (fn Value_is_symbol_matching ((v Value) (u Unicode) -> B)
      (if (element_of (Value_content v) Symbol)
        (Symbol_matches (lower (Value_content v) Symbol) u)
        false))

    (fn Struct_get ((s Struct) (u Unicode) -> 'Value*')
      (letrec [(seek (lambda (fs u)
                       (if (seq_is_empty fs)
                         (seq 'Value*')
                         (let [(f (seq_head fs)),
                               (vs (seek (seq_tail fs) u))]
                           (if (eject (SymTok_matches (Field_name f) u))
                             (seq_prepend (Field_value f) vs)
                             vs)))))]
        (seek (lower s 'Field*') u)))

    (fn Struct_get1 ((s Struct) (u Unicode) -> 'Value*')
      (let [(vs (Struct_get s u))]
        (if (> (seq_length vs) 1)
          (raise "repeated field")
          vs)))

    (fn Value_has_first_annot ((v Value) (u Unicode) -> B)
      (if (seq_is_empty (Value_annots v)) false
        (SymTok_matches (seq_head (Value_annots v)) u)))


    //=======================
    // Environment Management

    (fn SymToks_for_IVM ((i IVM) -> 'SymTok*')
      (if (eject (IVM_eq i IVM_1_0))
        (seq 'SymTok*'
          (lift_to SymTok SYM0)
          (lift_to SymTok (inject_into Unicode "$ion"))
          (lift_to SymTok (inject_into Unicode "$ion_1_0"))
          (lift_to SymTok (inject_into Unicode "$ion_symbol_table"))
          (lift_to SymTok (inject_into Unicode "name"))
          (lift_to SymTok (inject_into Unicode "version"))
          (lift_to SymTok (inject_into Unicode "imports"))
          (lift_to SymTok (inject_into Unicode "symbols"))
          (lift_to SymTok (inject_into Unicode "max_id"))
          (lift_to SymTok (inject_into Unicode "$ion_shared_symbol_table")))
        (raise "Unsupported Ion version")))


    (dom SharedSymtab    = (* Unicode I 'SymTok*'))     // name, version, symbols

    (fn SST_name    ((s SharedSymtab) -> Unicode)     (ith s 0))
    (fn SST_version ((s SharedSymtab) -> I)           (ith s 1))
    (fn SST_symbols ((s SharedSymtab) -> 'SymTok*') (ith s 2))

    (fn is_SST ((v Value) -> B)
      (and (eject (Value_has_first_annot v "$ion_shared_symbol_table"))
           (element_of (Value_content v) Struct)))

    (fn compile_SST ((s Struct) -> SharedSymtab)
      (let [(n (lower (Value_content (seq_head (Struct_get1 s "name")))
                 SafeVal String Unicode)),
            (v (lower (Value_content (seq_head (Struct_get1 s "version")))
                 SafeVal Int I))]
        (tuple SharedSymtab n v (declared_symbols s))))


    (dom Catalog = (+ 'SharedSymtab*'))  // TODO * would be better

    (fn Catalog_lookup ((c Catalog) (name Unicode) (version I) -> 'SharedSymtab*')
      (letrec [(seek (lambda (ssts n v bs)
                       (if (seq_is_empty ssts)
                         bs
                         (let [(sst (seq_head ssts))]
                           (if (=== (eject n) (eject (SST_name sst)))
                             (if (=== (eject v) (eject (SST_version sst)))
                               // Exact match
                               (seq 'SharedSymtab*' sst)
                               (if (or (seq_is_empty bs)
                                       (< (eject (SST_version (ith bs 0)))
                                          (eject (SST_version sst))))
                                 // Found a new best match
                                 (seek (seq_tail ssts) n v (seq 'SharedSymtab*' sst))
                                 (seek (seq_tail ssts) n v bs)))
                             (seek (seq_tail ssts) n v bs))))))]
        (seek (lower c 'SharedSymtab*') name version (seq 'SharedSymtab*'))))

    (fn Catalog_extend ((c Catalog) (s SharedSymtab) -> Catalog)
      // TODO reject duplicate key
      (lift (seq_prepend s (lower c 'SharedSymtab*')) Catalog))


    (dom Environment = (* Catalog IVM 'SymTok*'))

    (fn Environment_catalog ((r Environment) -> Catalog)   (ith r 0))
    (fn Environment_IVM     ((r Environment) -> IVM)       (ith r 1))
    (fn Environment_symbols ((r Environment) -> 'SymTok*') (ith r 2))



    // $ion_symbol_table "compilation"

    (fn is_LST ((v Value) -> B)
      (and (eject (Value_has_first_annot v "$ion_symbol_table"))
           (element_of (Value_content v) Struct)))

    (fn symbol_padding ((n I) -> 'SymTok*')
      (if (=== 0 (eject n))
        EMPTY_SYMTOKS
        (seq_prepend (lift SYM0 SymTok)
          (symbol_padding (- (eject n) 1)))))

    (fn adjust_length ((ss 'SymTok*') (n I) -> 'SymTok*')
      (if (< (eject n) (seq_length ss))
        (seq_truncate ss (eject n))
        (seq_append ss (symbol_padding (- (eject n) (seq_length ss))))))

    (fn compile_import ((name Unicode) (version I) (max I) (c Catalog) -> 'SymTok*')
      (if (or (=== (eject name) "")
              (=== (eject name) "$ion"))
        EMPTY_SYMTOKS
        (let [(found (Catalog_lookup c name version))]
          (if (seq_is_empty found)
            // The Catalog has nothing with this name.
            (if (< (eject max) 0)
              // If max_id is invalid or absent, must have exact match.
              (raise (display_to_string "No exact-match for " (eject name) " @" (eject version)))
              (symbol_padding max))
            // We found something in the catalog
            (let [(best (ith found 0))]
              (if (=== (eject version) (eject (SST_version best)))
                // We have an exact match!
                (if (< (eject max) 0)
                  // No max_id, use as-is
                  (SST_symbols best)
                  (adjust_length (SST_symbols best) max))
                // Inexact match
                (if (< (eject max) 0)
                  (raise (display_to_string "No exact-match for " (eject name) " @" (eject version)))
                  (adjust_length (SST_symbols best) max))))))))

    (fn normalize_name ((vs 'Value*') -> Unicode)             // "" = absent or invalid
      (if (seq_is_empty vs) EMPTY_UNICODE
        (let [(c (Value_content (seq_head vs)))]
          (if (and (element_of c String) (not (element_of c DotNull)))
            (lower c SafeVal String Unicode)
            EMPTY_UNICODE))))

    (fn normalize_version ((vs 'Value*') -> I)                // 1 = absent or invalid
      (if (seq_is_empty vs) 1
        (let [(c (Value_content (seq_head vs)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (let [(i (lower c SafeVal Int I))]
              (if (< (eject i) 1) 1 i))
            1))))

    (fn normalize_max_id ((vs 'Value*') -> I)                // < 0 = absent or invalid
      (if (seq_is_empty vs)
        -1
        (let [(c (Value_content (seq_head vs)))]
          (if (and (element_of c Int) (not (element_of c DotNull)))
            (lower c SafeVal Int I)
            -1))))

    (fn compile_import_struct ((s Struct) (r Environment) -> 'SymTok*')
      (let [(n (normalize_name    (Struct_get1 s "name"))),
            (v (normalize_version (Struct_get1 s "version"))),
            (m (normalize_max_id  (Struct_get1 s "max_id")))]
        (compile_import n v m (Environment_catalog r))))

    (fn compile_imports_elts ((vs 'Value*') (r Environment) -> 'SymTok*')
      (if (seq_is_empty vs)
        EMPTY_SYMTOKS
        (let [(c (Value_content (seq_head vs)))]
          (let [(ts (if (and (element_of c Struct) (not (element_of c DotNull)))
                      (compile_import_struct (lower c Struct) r)
                      EMPTY_SYMTOKS))]
            (seq_append ts (compile_imports_elts (seq_tail vs) r))))))

    (fn imported_symbols ((s Struct) (r Environment) -> 'SymTok*')
      (let [(vals (Struct_get1 s "imports"))]
        (if (seq_is_empty vals)
          (SymToks_for_IVM (Environment_IVM r))
          (if (eject (Value_is_symbol_matching (seq_head vals) "$ion_symbol_table"))
            (Environment_symbols r)
            (let [(c (Value_content (seq_head vals)))]
              (if (and (element_of c List) (not (element_of c DotNull)))
                (seq_append (SymToks_for_IVM (Environment_IVM r))
                            (compile_imports_elts (List_elts (lower c List)) r))
                (SymToks_for_IVM (Environment_IVM r))))))))

    (fn compile_symbols_elts ((vs 'Value*') -> 'SymTok*')
      (if (seq_is_empty vs)
        EMPTY_SYMTOKS
        (let [(c (Value_content (seq_head vs)))]
          (let [(t (if (and (element_of c String) (not (element_of c DotNull)))
                     (lift_to SymTok (lower c SafeVal String Unicode))
                     (lift_to SymTok SYM0)))]
            (seq_prepend t (compile_symbols_elts (seq_tail vs)))))))

    (fn declared_symbols ((s Struct) -> 'SymTok*')
      (let [(vals (Struct_get1 s "symbols"))]
        (if (seq_is_empty vals)
          EMPTY_SYMTOKS
          (let [(c (Value_content (seq_head vals)))]
            (if (element_of c List)
              (compile_symbols_elts (List_elts (lower c List)))
              EMPTY_SYMTOKS)))))


    // Environment construction
    
    (fn SymToks_for_LST ((s Struct) (r Environment) -> 'SymTok*')
      (if (element_of s DotNull)
        (SymToks_for_LST EMPTY_STRUCT r)
        (seq_append (imported_symbols s r)
                    (declared_symbols s))))


    (fn Environment_after_IVM ((ivm IVM) (r Environment) -> Environment)
      (tuple Environment
        (Environment_catalog r)
        ivm
        (SymToks_for_IVM ivm)))

    (fn Environment_after_LST ((s Struct) (r Environment) -> Environment)
      (tuple Environment
        (Environment_catalog r)
        (Environment_IVM r)
        (SymToks_for_LST s r)))


    //=======================
    // Denotations

    (fn E ((rv RValue) (r Environment) -> Value)
      (tuple Value ('E_RSymTok*' (RValue_annots rv) r)
                   (E_RContent (RValue_content rv) r)))

    (fn 'E*' ((rvs 'RValue*') (r Environment) -> 'Value*')
      (if (seq_is_empty rvs)
        (seq 'Value*')
        (seq_prepend (E (seq_head rvs) r) ('E*' (seq_tail rvs) r))))


    (fn E_RContent ((rv RContent) (r Environment) -> Content)
      // General value evaluation
      (if (element_of rv SafeVal)
        (lift (lower rv SafeVal) Content)
        (if (element_of rv RSymbol)
          (lift (E_RSymbol (lower rv RSymbol) r) Content)
          (if (element_of rv RList)
            (lift (E_RList (lower rv RList) r) Content)
            (if (element_of rv RStruct)
              (lift (E_RStruct (lower rv RStruct) r) Content)
              (raise "not implemented"))))))


    (fn E_RSymTok ((s RSymTok) (r Environment) -> SymTok)
      (if (element_of s Unicode)
        (lift (lower s Unicode) SymTok)
        (let [(i  (eject (lower s I))),
              (ts (Environment_symbols r))]
          (if (< i (seq_length ts))
            (ith ts i)
            (lift_to SymTok SYM0)))))

    (fn 'E_RSymTok*' ((ss 'RSymTok*') (r Environment) -> 'SymTok*')
      (if (seq_is_empty ss)
        EMPTY_SYMTOKS
        (seq_prepend (E_RSymTok  (seq_head ss) r)
                     ('E_RSymTok*' (seq_tail ss) r))))

    (fn E_RSymbol ((v RSymbol) (r Environment) -> Symbol)
      (if (element_of v DotNull)
        (lift DOTNULL Symbol)
        (lift (E_RSymTok (lower v RSymTok) r) Symbol)))


    (fn E_RList ((v RList) (r Environment) -> List)
      (if (element_of v DotNull)
        (lift DOTNULL List)
        (lift ('E*' (lower v 'RValue*') r) List)))


    (fn 'E_RField*' ((rfs 'RField*') (r Environment) -> 'Field*')
      (if (seq_is_empty rfs)
        (seq 'Field*')
        (let [(t (E_RSymTok (RField_name (seq_head rfs)) r)),
              (v (E (RField_value (seq_head rfs)) r))]
          (seq_prepend (tuple Field t v)
            ('E_RField*' (seq_tail rfs) r)))))

    (fn E_RStruct ((v RStruct) (r Environment)-> Struct)
      (if (element_of v DotNull)
        (lift DOTNULL Struct)
        (lift ('E_RField*' (lower v 'RField*') r) Struct)))


    // Top-level expansion

    (dom TContinuation = (-> Environment 'Value*' 'Value*')
      "Continuation when expanding top-level values")

    (fn TE ((trv TRValue) (r Environment) (k TContinuation) -> 'Value*')
      (if (element_of trv IVM)
        (k (Environment_after_IVM (lower trv IVM) r) (seq 'Value*'))
        (let [(v (E (lower trv RValue) r))]
          (if (eject (is_LST v))
            (k (Environment_after_LST
                 (lower (Value_content v) Struct) r)
               (seq 'Value*'))
            // Expand normally
            (k r (seq 'Value*' v))))))

    (fn 'TE*' ((trvs 'TRValue*') (r Environment) (k TContinuation) -> 'Value*')
      (if (seq_is_empty trvs)
        (k r (seq 'Value*'))
        (TE (seq_head trvs) r
          (mk_fn TContinuation (r1 vs1)
            ('TE*' (seq_tail trvs) r1
              (mk_fn TContinuation (r2 vs2)
                (k r2 (seq_append vs1 vs2))))))))

  /*
    (den TE "Top-level value evaluation"
      ([TRValue] (e Environment) (k Continuation) -> 'Value*')
      [IVM]  = (k e0 (seq Value))
      [RValue::v] = (E v e (|e1 v1| (IF (= (annot v1) <$ion_symbol_table>)
                                    (k <> (extend_env e1 (imports v1))
                                    (k v1 e1)))))

    (den 'TE*' "Top-level stream evaluation"
      ('TRValue*' x Environment x Continuation -> 'Value*'))
  */

    (fn expand ((trvs 'TRValue*') (c Catalog) -> 'Value*')
      (let [(r0 (tuple Environment c IVM_1_0 (SymToks_for_IVM IVM_1_0))),
            (k0 (mk_fn TContinuation (r vs) vs))]
        ('TE*' trvs r0 k0)))
  )

  (define IVM_1_0          (tuple IVM (inject_into I 1) (inject_into I 0)))
  (define SYM0             (singleton Sym0))
  (define DOTNULL          (singleton DotNull))
  (define EMPTY_CATALOG    (lift (seq 'SharedSymtab*') Catalog))
  (define EMPTY_UNICODE    (inject_into Unicode ""))
  (define EMPTY_SYMTOKS    (seq 'SymTok*'))
  (define EMPTY_STRUCT     (lift (seq 'Field*') Struct))
)

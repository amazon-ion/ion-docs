(module ion_latex "/fusion"


  (require
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/printing/latex"
    "/ion_model/model"
  )

  (provide
    ion_print_latex
  )


  (define ion_print_latex
    '''
A model printer that renders in LaTeX format, for inclusion in a larger book.
    '''
    (make_printer latexprint
      // TODO use a method-factory to streamline these.
      // TODO these functions, and the print methods, should be generated.
      (form_method Environment_catalog (|v e| (pp_ith (append v (quote (catalog))) e)))
      (form_method Environment_IVM     (|v e| (pp_ith (append v (quote (IVM    ))) e)))
      (form_method Environment_symbols (|v e| (pp_ith (append v (quote (symbols))) e)))
      (form_method List_elts           (|v e| (pp_ith (append v (quote (elts   ))) e)))
      (form_method RField_name         (|v e| (pp_ith (append v (quote (name   ))) e)))
      (form_method RField_value        (|v e| (pp_ith (append v (quote (value  ))) e)))
      (form_method RValue_annots       (|v e| (pp_ith (append v (quote (annots ))) e)))
      (form_method RValue_content      (|v e| (pp_ith (append v (quote (content))) e)))
      (form_method Field_name          (|v e| (pp_ith (append v (quote (name   ))) e)))
      (form_method Field_value         (|v e| (pp_ith (append v (quote (value  ))) e)))
      (form_method SST_name            (|v e| (pp_ith (append v (quote (name   ))) e)))
      (form_method SST_symbols         (|v e| (pp_ith (append v (quote (symbols))) e)))
      (form_method SST_version         (|v e| (pp_ith (append v (quote (version))) e)))
      (form_method Value_annots        (|v e| (pp_ith (append v (quote (annots ))) e)))
      (form_method Value_content       (|v e| (pp_ith (append v (quote (content))) e)))

      // The outer parens make the function definition less confusing; without
      // them it prints as "i1 = i2 = ..." but now its (i1 = i2) = ...".
      // The downside is irregular (though not confusing) rendering where the
      // function is invoked.
      (form_method IVM_eq              (pp_binary "(" " = " ")"))

      (sym_image "{\\cal E}"                                      'E')
      (sym_image "{\\cal E}^{\\ast}"                              'E*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RContent}}"        'E_RContent')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymTok}}"         'E_RSymTok')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymTok}}^{\\ast}" 'E_RSymTok*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymbol}}"         'E_RSymbol')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RList}}"           'E_RList')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RField}}^{\\ast}"  'E_RField*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RStruct}}"         'E_RStruct')

      (sym_image "\\overline{\\cal E}"           TE)
      (sym_image "\\overline{{\\cal E}^{\\ast}}" 'TE*')

//    (sym_image (string_append (texify_symbol (quote f)) "^{\\ast}") fs)
      (sym_image "\\mbox{\\it b\\/}^{\\ast}"               bs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}"               fs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{1}"           fs1)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{2}"           fs2)
      (sym_image "\\mbox{\\it i\\/}_{1}"                   i1)
      (sym_image "\\mbox{\\it i\\/}_{2}"                   i2)
      (sym_image "\\kappa"                                 k)
      (sym_image "\\kappa_{0}"                             k0)
      (sym_image "\\rho"                                   r)
      (sym_image "\\rho_{0}"                               r0)
      (sym_image "\\rho_{1}"                               r1)
      (sym_image "\\rho_{2}"                               r2)
      (sym_image "\\mbox{\\it rf\\/}^{\\ast}"              rfs)
      (sym_image "\\mbox{\\it rv\\/}^{\\ast}"              rvs)
      (sym_image "\\mbox{\\it s\\/}^{\\ast}"               ss ssts)
      (sym_image "\\mbox{\\it t\\/}^{\\ast}"               ts)
      (sym_image "\\overline{\\mbox{\\it rv\\/}}"          trv)
      (sym_image "\\overline{\\mbox{\\it rv\\/}^{\\ast}}"  trvs)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}"               vs vals)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{1}"           vs1)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{2}"           vs2)
    ))

)

(module ion_latex "/fusion"


  (require
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/printing/latex"
    "/ion_model/model"
  )

  (provide
    ion_print_latex
  )


  (define ion_print_latex
    '''
A model printer that renders in LaTeX format, for inclusion in a larger book.
    '''
    (make_printer latexprint
      // TODO [ACCESSORS] These clauses should be generated.
      (accessor Catalog_modules      "modules")
      (accessor Environment_catalog  "catalog")
      (accessor Environment_sysModule   "sysModule")
      (accessor Environment_docSymbols  "docSymbols")
      (accessor Field_name           "name")
      (accessor Field_value          "value")
      (accessor Module_specVersion   "specVersion")
      (accessor Module_symtab        "symtab")
      (accessor ParseStep_next       "next")
      (accessor ParseStep_tree       "tree")
      (accessor SField_name          "name")
      (accessor SField_tree          "tree")
      (accessor SharedModule_module  "module")
      (accessor SharedModule_name    "name")
      (accessor SharedModule_version "version")
      (accessor SValue_annots        "annots")
      (accessor SValue_content       "content")
      (accessor Value_annots         "annots")
      (accessor Value_content        "content")


      (oneline Catalog_extend
               IVM_eq
               Struct_get
               SymTok_matches
               Symbol_matches
               'Value_is_symbol_matching'
               'Value?_is_symbol_matching'
               compile_symtab
               isLocalSymbolTable)

      // Functions with infix syntax
      (form_method Fields_get                (pp_binary "" " \\odot^{\\ast} " ""))
      (form_method IVM_eq                    (pp_binary "" " = " ""))
      (form_method Struct_get                (pp_binary "" " \\odot^{\\ast} " ""))
      (form_method Struct_get1               (pp_binary "" " \\odot " ""))
      (form_method Symbol_matches            (pp_binary "" " \\cong " ""))
      (form_method SymTok_matches            (pp_binary "" " \\cong " ""))
      (form_method Value_is_symbol_matching  (pp_binary "" " \\cong " ""))
      (form_method 'Value?_is_symbol_matching' (pp_binary "" " \\cong " ""))


      // Singletons
      (sym_image "\\mbox{\\bf dotnull}"                                DOTNULL)
      (sym_image "\\mbox{\\bf ivm}_{\\scriptsize 1.0}"                 IVM_1_0)
      (sym_image "\\mbox{\\bf sym0}"                                   SYM0)
      (sym_image "\\mbox{\\bf systemSymbols}_{\\scriptsize 1.0}"       systemSymbols_1_0)

      (sym_image "\\mbox{\\it bestModule}"                             bestModule_Catalog
                                                                       bestModule_SMs)
      (sym_image "\\mbox{\\it exactModule}"                            exactModule_Catalog
                                                                       exactModule_SMs)

      (sym_image "\\mbox{\\it LST?}"                                   isLocalSymbolTable)
      (sym_image "\\mbox{\\it SST?}"                                   isSST)

      (sym_image "{\\cal C}_{\\mbox{\\scriptsize import}}"             compile_import)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize IVM}}"                compile_IVM)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize LST}}"                compile_LST)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize LST.\\tt imports}}"   compile_LST_imports)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize LST.\\tt symbols}}"   compile_LST_symbols)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize SST}}"                compile_SST)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize SST.\\tt symbols}}"   compile_SST_symbols)
      (sym_image "{\\cal C}_{\\mbox{\\scriptsize symtab}}"             compile_symtab
                                                                       compile_symtab_loop)

      (sym_image "{\\cal N}_{\\mbox{\\scriptsize list}}"               normalize_list)
      (sym_image "{\\cal N}_{\\mbox{\\scriptsize\\tt max\\_id}}"       normalize_max_id)
      (sym_image "{\\cal N}_{\\mbox{\\scriptsize\\tt name}}"           normalize_name)
      (sym_image "{\\cal N}_{\\mbox{\\scriptsize\\tt version}}"        normalize_version)

      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf STree}}"           'expand_STree')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf STree}}^{\\ast}"   'expand_STree*')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SValue}}"          'expand_SValue')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SContent}}"        'expand_SContent')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SSymTok}}"         'expand_SSymTok')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SSymTok}}^{\\ast}" 'expand_SSymTok*')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SSymbol}}"         'expand_SSymbol')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SList}}"           'expand_SList')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SSexp}}"           'expand_SSexp')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SField}}"          'expand_SField')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SField}}^{\\ast}"  'expand_SField*')
      (sym_image "{\\cal X}_{\\mbox{\\scriptsize\\bf SStruct}}"         'expand_SStruct')

      (sym_image "\\overline{\\cal E}_{\\mbox{\\scriptsize\\bf TSTree}}"        'TE_TSTree')
      (sym_image "\\overline{\\cal E}_{\\mbox{\\scriptsize\\bf Value}}"         'TE_Value')
      (sym_image "\\overline{\\cal E}_{\\mbox{\\scriptsize\\bf Value}}^{\\ast}" 'TE_Value*')
      (sym_image "\\overline{\\cal E}_{\\mbox{\\scriptsize\\bf ParseStream}}"   'TE_ParseStream')

//    (sym_image (string_append (texify_symbol (quote f)) "^{\\ast}") fs)
      (sym_image "\\mbox{\\it b\\/}^{\\ast}"               bs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}"               fs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{1}"           fs1)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{2}"           fs2)
      (sym_image "\\mbox{\\it i\\/}^{\\ast}"               is)
      (sym_image "\\mbox{\\it i\\/}_{1}"                   i1)
      (sym_image "\\mbox{\\it i\\/}_{2}"                   i2)
      (sym_image "\\kappa"                                 k)
      (sym_image "\\kappa_{0}"                             k0)
      (sym_image "\\mbox{\\it p\\/}_{0}"                   p0)
      (sym_image "\\rho"                                   r)
      (sym_image "\\rho_{0}"                               r0)
      (sym_image "\\rho_{1}"                               r1)
      (sym_image "\\rho_{2}"                               r2)
      (sym_image "\\mbox{\\it sf\\/}^{\\ast}"              sfs)
      (sym_image "\\mbox{\\it s\\/}^{\\ast}"               ss)
      (sym_image "\\mbox{\\it s\\/}^{\\ast}_{1}"           ss1)
      (sym_image "\\mbox{\\it t\\/}^{\\ast}"               ts)
      (sym_image "\\mbox{\\it u\\/}^{\\ast}"               us)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}"               vs)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{1}"           vs1)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{2}"           vs2)
//    (sym_image "\\mbox{\\it v\\/}^{?}"                   'v?')   // Doesn't look good

      // TODO [CONST] Framework should be able to "inline" these definitions.
      (sym_image "\\langle\\rangle" EMPTY_SYMTOKS)
    ))

)

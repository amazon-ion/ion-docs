(module ion_latex "/fusion"


  (require
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/printing/latex"
    "/ion_model/model"
  )

  (provide
    ion_print_latex
  )


  (define (pp_accessor name)
    "Like `pp_ith` but the selector is literal text, not a sub-expression."
    // \! is negative thin-space
    (pp_unary "" (string_append "\\!\\downarrow_{\\mbox{" name "}}")))


  (define ion_print_latex
    '''
A model printer that renders in LaTeX format, for inclusion in a larger book.
    '''
    (make_printer latexprint
      // TODO these functions, and the print methods, should be generated.
      (form_method Environment_catalog (pp_accessor "catalog"))
      (form_method Environment_IVM     (pp_accessor "IVM"))
      (form_method Environment_symbols (pp_accessor "symbols"))
      (form_method List_elts           (pp_accessor "elts"))
      (form_method RField_name         (pp_accessor "name"))
      (form_method RField_value        (pp_accessor "value"))
      (form_method RValue_annots       (pp_accessor "annots"))
      (form_method RValue_content      (pp_accessor "content"))
      (form_method Field_name          (pp_accessor "name"))
      (form_method Field_value         (pp_accessor "value"))
      (form_method SST_name            (pp_accessor "name"))
      (form_method SST_symbols         (pp_accessor "symbols"))
      (form_method SST_version         (pp_accessor "version"))
      (form_method Value_annots        (pp_accessor "annots"))
      (form_method Value_content       (pp_accessor "content"))

      // The outer parens make the function definition less confusing; without
      // them it prints as "i1 = i2 = ..." but now its (i1 = i2) = ...".
      // The downside is irregular (though not confusing) rendering where the
      // function is invoked.
      (form_method IVM_eq              (pp_binary "(" " = " ")"))

      (form_method Struct_get          (pp_binary "" " \\odot^{\\ast} " ""))
      (form_method Struct_get1         (pp_binary "" " \\odot " ""))
      (form_method Symbol_matches      (pp_binary "" " \\cong " ""))
      (form_method SymTok_matches      (pp_binary "" " \\cong " ""))

      // This doesn't read well, since the RHS is a quoted string
      // (form_method Value_is_symbol_matching  (pp_binary "" " \\cong " ""))


      (sym_image "{\\cal C}_{\\mbox{\\small import}}"             compile_import)
      (sym_image "{\\cal C}_{\\mbox{\\small import}}^{\\ast}"     compile_imports)
      (sym_image "{\\cal C}_{\\mbox{\\small symbol}}^{\\ast}"     compile_symbols)
      (sym_image "{\\cal C}_{\\mbox{\\small\\tt symbols}}"        declared_symbols)
      (sym_image "{\\cal C}_{\\mbox{\\small\\tt imports}}"        imported_symbols)
      (sym_image "{\\cal C}_{\\mbox{\\small LST}}"                SymToks_for_LST)

      (sym_image "{\\cal N}_{\\mbox{\\small\\tt max\\_id}}"       normalize_max_id)
      (sym_image "{\\cal N}_{\\mbox{\\small\\tt name}}"           normalize_name)
      (sym_image "{\\cal N}_{\\mbox{\\small\\tt version}}"        normalize_version)

      (sym_image "{\\cal E}"                                      'E')
      (sym_image "{\\cal E}^{\\ast}"                              'E*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RContent}}"        'E_RContent')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymTok}}"         'E_RSymTok')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymTok}}^{\\ast}" 'E_RSymTok*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RSymbol}}"         'E_RSymbol')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RList}}"           'E_RList')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RField}}^{\\ast}"  'E_RField*')
      (sym_image "{\\cal E}_{\\mbox{\\tiny\\bf RStruct}}"         'E_RStruct')

      (sym_image "\\overline{\\cal E}"           TE)
      (sym_image "\\overline{{\\cal E}^{\\ast}}" 'TE*')

//    (sym_image (string_append (texify_symbol (quote f)) "^{\\ast}") fs)
      (sym_image "\\mbox{\\it b\\/}^{\\ast}"               bs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}"               fs)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{1}"           fs1)
      (sym_image "\\mbox{\\it f\\/}^{\\ast}_{2}"           fs2)
      (sym_image "\\mbox{\\it i\\/}_{1}"                   i1)
      (sym_image "\\mbox{\\it i\\/}_{2}"                   i2)
      (sym_image "\\kappa"                                 k)
      (sym_image "\\kappa_{0}"                             k0)
      (sym_image "\\rho"                                   r)
      (sym_image "\\rho_{0}"                               r0)
      (sym_image "\\rho_{1}"                               r1)
      (sym_image "\\rho_{2}"                               r2)
      (sym_image "\\mbox{\\it rf\\/}^{\\ast}"              rfs)
      (sym_image "\\mbox{\\it rv\\/}^{\\ast}"              rvs)
      (sym_image "\\mbox{\\it s\\/}^{\\ast}"               ss ssts)
      (sym_image "\\mbox{\\it t\\/}^{\\ast}"               ts)
      (sym_image "\\overline{\\mbox{\\it rv\\/}}"          trv)
      (sym_image "\\overline{\\mbox{\\it rv\\/}^{\\ast}}"  trvs)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}"               vs vals)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{1}"           vs1)
      (sym_image "\\mbox{\\it v\\/}^{\\ast}_{2}"           vs2)

      // TODO [CONST] Framework should be able to "inline" these definitions.
      (sym_image "\\langle\\rangle" EMPTY_SYMTOKS)
      (sym_image "\\langle\\rangle" EMPTY_UNICODE)
    ))

)

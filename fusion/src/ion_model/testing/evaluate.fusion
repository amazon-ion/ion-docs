(module ion_testing "/fusion"

  '''
Utilities for testing the Ion denotational model.
  '''

  (require
    "/fusioncontrib/denotation"
    "/ion_model/model"
    "/ion_model/testing/ast"

    (only_in "/fusioncontrib/denotation/testing"
      seq_to_sexp
      tuple_values)
  )

  (provide
    evaluate
  )


  //============================================================================
  // Parsing and Expanding Inputs

  (define (mk_ParseStream tlvs)
    (mk_fn ParseStream (parse_env)   // IVM -> ParseStep?
      (if (is_empty tlvs)
        (opt 'ParseStep?')
        (opt 'ParseStep?'
          (tuple ParseStep (mk_TSTree      (head tlvs))
                           (mk_ParseStream (tail tlvs)))))))

  (define parser
    '''
A Parser is the semantic model's extension point for providing a stream of
abstract syntax trees (ie 'TSTree*').
    '''
    (mk_fn Parser (doc)              // Document -> ParseStream
      (mk_ParseStream (eject doc))))

  (define evaluator
    '''
Create a reusable Evaluator based on our Parser.
    '''
    (mk_Evaluator parser))                 // mk_Evaluator is part of the model.


  (define (evaluate input)
    '''
Parse top-level inputs (contained in a sexp) into `TSTree` then expand it.
    '''
    (evaluator input testing_catalog))



  //============================================================================
  // Catalogs

  (define EMPTY_CATALOG
    (tuple Catalog (seq 'SharedModule*')))

  (define catalog_data
    (with_ion_from_file "ion-tests/catalog/catalog.ion"
      (|| (series_to_sexp (in_port)))))

  (define testing_catalog
    (for_fold [(c EMPTY_CATALOG)]
      [(sst (seq_to_sexp (evaluator catalog_data EMPTY_CATALOG)))]
      (Catalog_extend c
        (compile_SST (lower_to Struct (Value_content sst))))))

)

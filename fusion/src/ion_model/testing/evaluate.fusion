(module ion_testing "/fusion"

  '''
Utilities for testing the Ion denotational model.
  '''

  (require
    "/fusioncontrib/denotation"
    "/ion_model/model"
    "/ion_model/testing/ast"
    "/ion_model/testing/fragment"

    (only_in "/fusioncontrib/denotation/testing"
      seq_to_sexp
    )
  )

  (provide
    evaluate
  )


  //============================================================================
  // Evaluating Documents

  (define evaluator
    '''
Create a reusable Evaluator based on our Parser.
    '''
    (mk_Evaluator document_parser))       // mk_Evaluator is part of the model.


  (define (evaluate doc)
    '''
Parse, expand, and evaluate an abstract document.
    '''
    (unless (is_document doc)
      (raise_argument_error "evaluate" "document" 0 doc))
    (evaluator doc testing_catalog))


  //============================================================================
  // Catalogs

  (define EMPTY_CATALOG
    (tuple Catalog (seq 'SharedModule*')))

  (define catalog_doc
    (extend_document empty_document
      (apply ast_fragment
        (with_ion_from_file "ion-tests/catalog/catalog.ion"
          (|| (series_to_sexp (in_port)))))))

  (define testing_catalog
    (for_fold [(c EMPTY_CATALOG)]
      [(sst (seq_to_sexp (evaluator catalog_doc EMPTY_CATALOG)))]
      (Catalog_extend c
        (compile_SST (lower_to Struct (Value_content sst))))))

)

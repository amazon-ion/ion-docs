(module bottom "/fusion"

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/list"
    "/fusion/private/continuation"
    "/fusion/private/record"
    "/fusioncontrib/denotation/private/base"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/util"
  )


  (provide
    bottom_message
    bottom_parts
    bottom_stack
    define_strict
    frame_line
    frame_column
    frame_expr
    is_bottom
    make_frame
    stack_mark_key
    wrong
  )


  (define stack_mark_key
    // This should be a continuation-mark-key, not a parameter.
    (make_parameter null))

  (record frame (line column expr))

  (define (make_frame stx)
    (frame (syntax_line stx) (syntax_column stx) (syntax_to_datum stx)))


  (define BottomDomain
    (make_domain_meta "BottomDomain" null))

  (define Bottom
    (make_domain BottomDomain "Bottom"
      (|d v| (is_string v))
      "The error domain"
      null))

  (define_values ('record:bottom' bottom_ctor is_bottom bottom_element)
    [
      "private record type",
      "private Bottom constructor",
      '''
    (is_bottom v)

Determines whether `v` is a bottom value, which denotes an error condition.
    ''',
      "private field accessor",
    ]
    (make_record_type (quote 'record:bottom') 'record:domain_value' 2 0))
    // The inherited domain_value_rep field holds a sexp of message parts.
    // The added fields in this subtype are:
    //  * the procedure to apply
    //  * a sexp holding the stack frames at the time of creation



  (define (bottom_parts v)
    (unless (is_bottom v)
      (raise_argument_error "bottom_parts" "bottom value" 0 v))
    (domain_value_rep v))

  (define (bottom_message v)
    '''
Constructs a string from the bottom's message parts.
Each part is converted to text as per `display`.
    '''
    (unless (is_bottom v)
      (raise_argument_error "bottom_message" "bottom value" 0 v))
    (apply display_to_string
      (map (|m| (if (is_base_domain_value m) (eject m) m))
        (bottom_parts v))))

  (define (bottom_stack v)
    (bottom_element v 1))


  (define wrong
    '''
    (wrong message ...+)

Returns a bottom value with the given message content.
The message parts are retained after ejecting any base-domain values.
    '''
    (lambda msgs
      (letrec [(bottom_val
                 (bottom_ctor
                   Bottom
                   msgs
                   // When called as a procedure, a bottom value returns itself.
                   // This is so that ⊥ ∈ F and every other function domain.
                   // If a function-creation fails, then applying that function
                   // will fail the same way.
                   (lambda args bottom_val)
                   // PRIVATE API!
                   (current_continuation_mark_sexp stack_mark_key)))]
        bottom_val)))


  //============================================================================
  // Strict Functions
  //
  // These return ⊥ when any argument is ⊥.
  //
  // This follow's Queinnec; see LiSP §5.2.1 p154
  //
  // Interestingly, Stoy uses a different formulation, with distinct concepts of
  // `⊥`, denoting "the absence of information" (p81), and `?`, denoting errors
  // (p144).  Stoy then has three tiers of strictness to propagate ⊥, ⊤, and ?.
  // Queinnec unifies ⊥ and ? and uses "strict" for Stoy's "completely strict".
  //
  // Another difference is that Stoy defines `wrong` as an unspecified error
  // continuation (p256) while Queinnec defines it as a bottom-constructor.


  (define CTX (quote_syntax lexical_context))

  (define_syntax define_strict
    '''
    (define_strict (f a ...) b ...)

Like `(define (f a ...) b ...)`, but before `b` is evaluated the arguments are
checked to ensure none are bottom.  If any argument `is_bottom`, the first
such value is returned and the body is ignored.
    '''
    (lambda (stx)
      (lets [(sig   (syntax_get stx 1)),
             (args  (tail (syntax_unwrap sig))),
             (body  (tail (tail (syntax_unwrap stx)))),
             (tests (map (|a| (QQ ((is_bottom (UQ a)) (UQ a)))) args)),
             (else  (pair (quote true) body))]
        /*
        (define (f a ...)
          (cond
            ((is_bottom a) a) ...
            (true b ...)))
        */
        (datum_to_syntax
          (QQ (define (UQ sig)
                (UQ (pair (QS cond) (append tests (sexp else))))))
          CTX
          stx))))
)

(module typecheck "/fusion"

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation/private/base"
    "/fusioncontrib/denotation/private/bottom"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    F
    typecheck_arg
    typecheck_args
  )


  // TODO This doesn't really belong in this module.
  (define FMeta
    (make_domain_meta "FMeta" (|d v| (is_procedure v))))

  (define F
    (make_domain FMeta "F"
      (always false) // checker
      "All functions"
      null))



  (define (typecheck_arg d v fail_thunk)
    '''
Determines whether `v` is an acceptable argument for domain `d`, returning
the effective value after any necessary injection.  Bottom values pass through.

Invokes `fail_thunk` when `v` is not acceptable to domain `d`.
    '''
    (cond
      ((is_bottom v)   v)
      ((domain_is v d) v)
      ((and (ident d F) (is_procedure v)) v)
      ((and (is_base_domain d) (base_domain_accepts d v))
        // Auto-inject
        (inject_into d v))
      (true (fail_thunk))))



  (define (typecheck_args where domains args offset)
    '''
Typechecks each element of the sexp `args` (skipping the first `offset` items)
against correspending elements of the sexp `domains`.
If any argument fails typechecking, an exception is raised; this is considered
a defect in the model.  The `offset` is added to the implicated argument index.
If any argument is a `Bottom` value, the first such value is returned.
Otherwise, returns a sexp of the effective argument values after any necessary
injection.
    '''
    (unless (is_text where)
      (raise_argument_error "typecheck_args" "text"  0 where domains args offset))
    (let [(count (size domains)),
          (vals (subseq args offset (size args)))]
      (unless (=== count (size vals))
        (apply raise_arity_error where count vals))
      (let [(valid_args
              (let loop [(i offset), (ds domains), (as vals)]
                (if (=== i (size args))
                  (quote ())
                  (let [(d (head ds)), (a (head as))]
                    (pair (typecheck_arg d a
                            (|| (apply raise_argument_error where
                                  (symbol_to_string (domain_name d))
                                  i args)))
                      (loop (+ 1 i) (tail ds) (tail as)))))))]
        (or (find is_bottom valid_args) valid_args))))
  )

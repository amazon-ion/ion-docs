(module function "/fusion"

  '''
Domain functions are implemented as Fusion record-procedures.
This makes "interpretation" of domain functions trivial; it's just Fusion execution.
It should also allow us to perform static type-checking of much of the modeled
code, particularly once every subexpression is a function invocation.

Domain functions are denoted using an expression language, something like:

e ::= v           // local variable / argument
    | (F e ...)
    | (eltof D v)
    | (lift_to D e)
    | (lower_to D e)
    | (case v (D e) ...)  // where v:DD and DD = D + ...
    | (index v i)         // where v:D*

Remember that _everything is functional here_, even things like IF.

  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/private/record"
    "/fusioncontrib/denotation/private/bottom"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/tuple"
    "/fusioncontrib/denotation/private/typecheck"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    define_fn
    define_func_domain
    fn_args
    fn_binding
    fn_code
    fn_name
    func_domain_argdomains
    func_domain_output
    is_fn
    is_func_domain
    make_func_domain
    mk_fn
  )


  (define CTX (quote_syntax lexical_context))

  (define FuncDomain
    (make_domain_meta "FuncDomain" null))


  (define (make_func_domain name description input output)
    '''
`input` can be a named domain, a list of named domains for multi-arg,
or null for TOP (accept any one value).
    '''
    (unless (or (is_domain input)
                (is_list_of_domains input)
                (is_null input))                                        // [TOP]
      (raise_argument_error "make_func_domain" "input domain or domains" 2
        name description input output))
    (when (and (is_product_domain input) (is_null (domain_name input)))
      // FIXME This doesn't handle single-entry list
      (raise_argument_error "make_func_domain"
        "singular product-domain arg must be named" 0
        name description input output))
    (unless (is_domain output)                                          // [TOP]
      (raise_argument_error "make_func_domain" "output domain" 3
        name description input output))
    (let [(input (if (is_list_of_domains input)
                   (if (=== 1 (size input))
                     (. input 0)
                     (make_product_domain null.string null.string (|| input)))
                   input))]
      (make_domain FuncDomain name is_procedure description [input, output])))

  (define (is_func_domain v) (is_domain_of_type FuncDomain v))

  (define (func_domain_input  d) (list_element (domain_data d) 0))
  (define (func_domain_output d) (list_element (domain_data d) 1))

  (define (func_domain_argdomains d)
    "Return list of domains for the arguments to `d`."
    (let [(in_dom (func_domain_input d))]
      (if (and (is_product_domain in_dom) (is_null (domain_name in_dom)))
        (product_domain_subdomains in_dom)
        [in_dom])))


  (define_syntax define_func_domain
    '''
    (define_func_domain name description inDomain ...+ outDomain)
    '''
    (lambda (stx)
      (when (< (syntax_size stx) 5)
        (wrong_syntax stx "Bad syntax for define_func_domain"))
      (lets [(name_stx (syntax_get stx 1)),
             (desc_stx (syntax_get stx 2)),  // TODO typecheck
             (domains (tail (tail (tail (syntax_unwrap stx))))),
             (domains_rev (reverse domains)),
             (out_domain (head domains_rev)),
             (in_domains (reverse (tail domains_rev)))]
        (datum_to_syntax
          (QQ (define (UQ name_stx)
                (make_func_domain
                  (quote (UQ name_stx))
                  (UQ desc_stx)
                  // TODO Delay evaluation of the domains, so they can recurse
                  (UQ (pair (quote list) in_domains))
                  (UQ out_domain))))
          CTX stx))))


  //============================================================================
  // Function Values

  (define_values ('record:fn' fn_ctor is_fn fn_get)
    [
      "private record type",
      "private fn constructor",
      '''
    (is_fn v)

Predicate for domain functions.
      ''',
      "private fn accessor"
    ]
    (make_record_type (quote 'record:fn') 'record:domain_value' 3 0))
    // The inherited domain_value_rep field holds the function's bound identifier.
    // The fields in this subtype are:
    //   0: the procedure to apply (that is, the compiled function).
    //   1: a sexp of identifiers; the argument names.
    //   2: a syntax-object for the body of the function.

  (define (fn_binding fn)
    (unless (is_fn fn) (raise_argument_error "fn_binding" "domain function" 0 fn))
    (domain_value_rep fn))

  (define (fn_name fn)
    (unless (is_fn fn) (raise_argument_error "fn_name" "domain function" 0 fn))
    (syntax_unwrap (domain_value_rep fn)))


  (define (fn_args fn) (fn_get fn 1))
  (define (fn_code fn) (fn_get fn 2))



  (define (make_fn name domain impl arg_stxs code_stx)
    '''
The `domain` must be a func_domain, the `impl` a Fusion procedure.

Type-checking of function application:
  * If input domain is named (even a product domain), then the function requires
    one domain value of that domain.
  * If the input domain is an anonymous product domain, then the function requires
    arguments of the same number and type of the subdomains.
    '''
      // TODO validate name
    (unless (or (is_identifier name) (is_null name))
      (raise_argument_error "make_fn" "identifier" 0 name domain impl))
    (unless (is_func_domain domain)
      (raise_argument_error "make_fn" "function domain" 1 name domain impl))
    (unless (is_procedure impl)
      (raise_argument_error "make_fn" "procedure" 2 name domain impl))
    (lets [(argdomains (apply sexp (func_domain_argdomains domain))),
           (out_dom (func_domain_output domain)),
           (applier (lambda rest
                      (lets [(where (or (desyntax name)
                                      (string_append "local "
                                        (or (domain_name domain) "function")))),
                             (args (typecheck_args where argdomains rest 0))]
                        // Strictness check
                        (if (is_bottom args)
                          args                         // Don't invoke the function w/ bottom.
                          (let [(r (apply impl args))]
                            // Bottom result will be returned as-is.
                            (typecheck_arg out_dom r
                              (|| (raise_result_error (string_append "result of " where)
                                    (symbol_to_string (domain_name out_dom)) r))))))))]
      (fn_ctor domain name applier arg_stxs code_stx)))


  (define (check_fn_arity d args)
    (unless (is_func_domain d)
      (raise_contract_error "mk_fn"
        (display_to_string "expected function domain, given "
          (if (is_domain d) (domain_name d) d))))
    (let [(arity (size (func_domain_argdomains d)))]
      (unless (same arity (size args))
        (raise_contract_error "mk_fn"
          (display_to_string (domain_name d) " has arity " arity " but declaration is " args)))))


  (define_syntax mk_fn
    '''
    (mk_fn domain (arg ...+) body)
    '''
    (lambda (stx)
      (unless (=== 4 (syntax_size stx))
        (wrong_syntax stx "invalid syntax"))
      (let [(domain_stx (syntax_get stx 1)),  // TODO allow for ad-hoc domains as per `fn` and `define_fn`
            (args_stx   (syntax_get stx 2)),
            (body_stx   (syntax_get stx 3))]
        (unless (is_identifier domain_stx)
          (wrong_syntax stx "invalid domain name: " domain_stx))
        (let [(args (syntax_unwrap args_stx))]
          // TODO ensure sexp of identifiers
          (unless (is_pair args)
            (wrong_syntax stx "expected args sexp: " args_stx)))
        (datum_to_syntax
          // Using a let-binding forces a continuation frame with the mk_fn location.
          (QQ (let [(loc (UQ (datum_to_syntax
                               (QQ (check_fn_arity (UQ domain_stx) (quote (UQ args_stx))))
                               CTX
                               stx)))]
                (make_fn
                  null    // (string_append "local " (or (domain_name domain) "function")))
                  (UQ domain_stx)
                  (lambda (UQ args_stx) (UQ body_stx))
                  (syntax_unwrap (QS (UQ args_stx)))
                  (QS (UQ body_stx)))))
          CTX
          stx))))


  (define (xform_fn_sig sig_stx)
    '''
Returns:
  * A sexp denoting syntax that constructs the function domain, as per `make_fn`.
  * A sexp holding identifiers binding the formal argument names.
    '''
    (let_values [((domains argnames codomain) (split_fn_sig sig_stx))]
      // TODO check for absent codomain
      (values (sexp (Q make_func_domain) null.string null.string (apply list domains) codomain)
              argnames)))


  (define (split_fn_sig sig_stx)
    '''
Returns:
  * A sexp holding identifiers bound to the argument domains.
  * A sexp holding identifiers binding the formal argument names.
  * An identifier bound to the codomain.
    '''
    (for_fold [(arg_domains (sexp)),
               (arg_names   (sexp)),
               (codomain    (void))]
              [(entry_stx sig_stx)]
      (when (is_domain codomain)
        (wrong_syntax entry_stx "unexpected element in signature after codomain"))
      (if (is_void codomain)
        // We are still processing arguments
        (if (= "->" (syntax_unwrap entry_stx))
          (values arg_domains arg_names "->")  // Signal next round to grab codomain
          (if (is_identifier entry_stx)
            (values (pair null arg_domains) // TODO use TOP domain
              (pair entry_stx arg_names)
              codomain)
            (if (is_pair (syntax_unwrap entry_stx))
              (let [(name (syntax_get entry_stx 0)),
                    (dom  (syntax_get entry_stx 1))]
                // TODO typecheck name
                // TODO typecheck dom
                (values
                  (pair dom  arg_domains)
                  (pair name arg_names)
                  codomain))
              (wrong_syntax entry_stx "Expected identifier, sexp, or ->"))))
        // Time to find the codomain
        // TODO assert codomain === "->"
        // TODO typecheck entry_stx
        (values (reverse arg_domains) (reverse arg_names) entry_stx))))


  (define (define_fn_adhoc_domain stx)
      (let [(name_stx (syntax_get stx 1)),
            (sig_stx  (syntax_get stx 2)),
            (expr_stx (syntax_get stx 3))]
        // TODO typecheck name
        (unless (is_syntax_pair sig_stx)
          (wrong_syntax stx "invalid fn signature: " sig_stx))
        (let_values [((func_domain_stx args_stx)
                      (xform_fn_sig (syntax_unwrap sig_stx)))]
          (datum_to_syntax
            (QQ (define (UQ name_stx)
                  (make_fn (quote_syntax (UQ name_stx))
                    (UQ func_domain_stx)
                    (lambda (UQ args_stx)
                      (UQ expr_stx))
                    (syntax_unwrap (QS (UQ args_stx)))
                    (QS (UQ expr_stx)))))
            CTX stx))))

  (define (define_fn_named_domain stx)
    (let [(name_stx (syntax_get stx 1)),
          (type_stx (syntax_get stx 2)),
          (args_stx (syntax_get stx 3)),
          (expr_stx (syntax_get stx 4))]
      // TODO typecheck name, type
      (unless (and (is_syntax_pair args_stx)
                   (is_sexp_of_ids (syntax_unwrap args_stx)))
        (wrong_syntax args_stx "expected sexp of arguments"))
      (datum_to_syntax
        (QQ (define (UQ name_stx)
              (make_fn (quote_syntax (UQ name_stx))
                (UQ type_stx)
                (lambda (UQ args_stx)
                  (UQ expr_stx))
                (syntax_unwrap (QS (UQ args_stx)))
                (QS (UQ expr_stx)))))
        CTX stx)))

  (define_syntax define_fn
    '''
    (define_fn name ( <arg>+ -> <domain-name> ) <expr>)
    <arg> ::= var-name  |  ( <var-name> <domain-name> )

Defines a function in a semantic model, typed via an ad-hoc domain.

    (define_fn name <domain-name> ( <var-name>+ ) <expr>)

Defines a function in a semantic model, typed via named domain.
The `var-name`s must be identifiers and are bound in the body `expr` as if by
`lambda`.
    '''
    (lambda (stx)
      (cond
        ((== (syntax_size stx) 4) (define_fn_adhoc_domain stx))
        ((== (syntax_size stx) 5) (define_fn_named_domain stx))
        (true (wrong_syntax stx "Bad syntax for fn")))))
)

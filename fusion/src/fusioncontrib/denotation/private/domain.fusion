(module domain "/fusion"

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/private/record"
    (rename_in "/fusion/experimental/syntax"
      (quote_syntax QS))
    (rename_in "/fusion/base"
      (quote Q) (quasiquote QQ) (unquote UQ))
  )

  (provide
    // Domain meta-types
    make_domain_meta
    make_domain

    // Domains
    is_domain
    domain_description
    domain_name
    domain_data
    domain_type
    display_domain
    element_of

    define_dummy_domain
    define_base_domain
    define_union_domain
    define_product_domain
    define_func_domain

    // Domain Values
    'record:domain_value'
    make_value
    is_domain_value
    domain_value_domain
    domain_value_rep

    // Base domain value operators
    is_base_domain_value
    inject_into
    eject

    // Union domain value operators
    is_union_domain_value
    lift_to
    subdomain
    unwrap
    lower_to

    // Product domain operators
    make_product_domain
    is_product_domain
    product_domain_subdomains

    // Product domain value operators
    is_tuple
    tuple
    tuple_ith
    tuple_values
    product_domain_element

    // Function domains
    make_func_domain
    is_func_domain
    func_domain_argdomains
    func_domain_input
    func_domain_output

    // Helpers
    is_list_of_domains
  )


  (define CTX (quote_syntax lexical_context))

  (define (is_text v)
    (or (is_symbol v) (is_string v)))

  (define (text_to_symbol t)
    (if (is_symbol t)
      t
      (if (is_string t)
        (string_to_symbol t)
        (raise_argument_error "text_to_symbol" "string or symbol" 0 t))))


  // Basically the class metaobject/vtable for domain objects.
  // Instances include BaseDomain, UnionDomain, ProductDomain, FuncDomain.
  (record domain_meta (name display_fn eltof_fn))

  (define (make_domain_meta name display_fn eltof_fn)
    '''
Creates a new domain "class".
  * The `display_fn` accepts a domain value and `display`s its RHS.
  * The `eltof_fn` accepts a domain (of this type) and a value, returns truthy iff
    the value is an element of the domain.
    May be null, to use the default mechanism.
    '''
    // TODO Use [GUARD] to populate default values.
    (domain_meta name display_fn
      (or eltof_fn (|d v|
                     (and (is_domain_value v)
                          (or (ident d (domain_value_domain v))
                              (and (is_union_domain_value v)
                                   (element_of (unwrap v) d))))))))


  // The "classes" from which domain values can be created.
  (record domain (type name checker description data))
  // * The `type` is the category of domain: base, union, product, etc.
  //   We can't name this field "meta" b/c its accessor would clash with
  //   the `domain_meta` constructor.
  // * The `checker` is a procedure that accepts the domain and a value,
  //   returning true when the value can be lifted into the domain.
  // * The shape of `data` is controlled by the type.
  //   TODO We could probably use record subtypes instead.

  (define (make_domain type name checker description data)
    (unless (is_domain_meta type)
      (raise_argument_error "make_domain" "domain type" 0
        type name checker description data))
    (unless (is_text name)
      (raise_argument_error "make_domain" "symbol or string" 1
        type name checker description data))
    (unless (is_procedure checker)
      (raise_argument_error "make_domain" "type-check procedure" 2
        type name checker description data))
    (unless (is_string description)
      (raise_argument_error "make_domain" "string" 3
        type name checker description data))
    (let [(namesym (text_to_symbol name))]
      (domain type namesym checker description data)))

  (define (is_domain_of_type d v)
    (and (is_domain v)
         (ident d (domain_type v))))

  (define (domain_accepts d v)
    // TODO Replace this with something better defined. It's not used uniformly.
    //   It only checks the _internal representation_ of domain values.
    (unless (is_domain d)
      (raise_argument_error "domain_accepts" "domain" 0 d v))
    ((domain_checker d) d v))


  (define (display_domain_name_else_rhs d)
    (let [(name (domain_name d))]
      (if name (display name) (display_domain_rhs d))))

  (define (display_domain_rhs d)
    ((domain_meta_display_fn (domain_type d)) d))

  (define (display_domain d)
    (unless (is_domain d)
      (raise_argument_error "display_domain" "domain" 0 d))
    (display (domain_name d) " = ")
    (display_domain_rhs d))


  (define (is_list_of_domains v)
    (and (is_list v) (every is_domain v)))


  //-------------------
  // Domain Values

  // TODO display these in a readable way!

  (record domain_value (domain rep))  // TODO guardian to typecheck

  (define (make_value domain v)
    (unless (is_domain domain)
      (raise_argument_error "make_value" "domain" 0 domain v))
    (unless (domain_accepts domain v)
      (raise_argument_error "make_value"
        (string_append "value acceptable to domain " (domain_name domain))
        1 domain v))
    (domain_value domain v))

  (define (element_of v domain)  // i.e., ∈
    (unless (is_domain domain)
      (raise_argument_error "element_of" "domain" 1 v domain))
    ((domain_meta_eltof_fn (domain_type domain)) domain v))


  //-------------------
  // Dummy Domains

  (define DummyDomain
    (make_domain_meta "DummyDomain"
      (|d| (display "<" (domain_description d) ">"))
      null))

  (define (make_dummy_domain name desc)
    (make_domain DummyDomain name (always true) desc null))


  (define_syntax define_dummy_domain
    '''
    (define_dummy_domain name description)
    '''
    (lambda (stx)
      (unless (=== (syntax_size stx) 3)
        (wrong_syntax stx "Bad syntax for define_dummy_domain"))
      (let [(name_stx (syntax_get stx 1)),
            (desc_stx (syntax_get stx 2))]  // TODO typecheck
        (datum_to_syntax
          (QQ
            (define (UQ name_stx)
              (make_dummy_domain
                (quote (UQ name_stx))
                (UQ desc_stx))))
          (quote_syntax context)
          stx))))


  //-------------------
  // Base Domains

  (define BaseDomain
    (make_domain_meta "BaseDomain"
      (|d| (display "<" (domain_description d) ">"))
      null))

  (define (make_base_domain name desc pred)
    (let [(pred (or pred (always true)))]
      // TODO type check args
      (make_domain BaseDomain name
        (|d v| (pred v))
        desc
        pred)))

  (define (is_base_domain d)
    (and (is_domain d) (ident BaseDomain (domain_type d))))

  (define (base_domain_predicate d)
    (domain_data d))


  (define (inject_into d v)
    '''
Lifts a Fusion value into a base domain.
    '''
    (unless (is_base_domain d)
      (raise_argument_error "inject_into" "base domain" 0 d v))
    (unless (domain_accepts d v)
      (raise_argument_error "inject_into"
        (string_append "value in domain " (domain_name d))
        1 d v))
    (make_value d v))


  (define (is_base_domain_value v)
    (and (is_domain_value v)
         (is_base_domain (domain_value_domain v))))


  (define (eject v)
    "Extracts the implementation datum from a base value"
    (unless (is_base_domain_value v)
      (raise_argument_error "eject" "base-domain value" 0 v))
    (domain_value_rep v))


  (define_syntax define_base_domain
    '''
    (define_base_domain name description predicate)
    '''
    (lambda (stx)
      (unless (=== (syntax_size stx) 4)
        (wrong_syntax stx "Bad syntax for define_base_domain"))
      (let [(name_stx (syntax_get stx 1)),
            (desc_stx (syntax_get stx 2)),  // TODO typecheck
            (pred_stx (syntax_get stx 3))]
        (datum_to_syntax
          (QQ
            (define (UQ name_stx)
              (make_base_domain
                (quote (UQ name_stx))
                (UQ desc_stx)
                (UQ pred_stx))))
          (quote_syntax context)
          stx))))


  //-------------------
  // Union Domains

  (define UnionDomain
    (make_domain_meta "UnionDomain"
      (|d| (display (apply string_join " + "
                      (map domain_name (union_domain_subdomains d)))))
      null))

  (define (make_union_domain name description domain_producer)
    // TODO Memoize domain production
    (make_domain UnionDomain name union_domain_checker description domain_producer))

  (define (is_union_domain d)
    (and (is_domain d) (ident UnionDomain (domain_type d))))

  (define (union_domain_subdomains d)
    "Returns list of domains"
    (let [(domains ((domain_data d)))]
      (unless (and (is_list domains)
                   (every is_domain domains))
        (raise_result_error "union_domain_subdomains" "list of domains" domains))
      domains))

  (define (union_domain_checker d v)
    (any (|sub| (element_of v sub))
      (union_domain_subdomains d)))

  (define_syntax define_union_domain
    '''
    (define_union_domain name description domain ...)
    '''
    (lambda (stx)
      (unless (> (syntax_size stx) 3)
        (wrong_syntax stx "Bad syntax for define_union_domain"))
      (let [(name_stx (syntax_get stx 1)),
            (desc_stx (syntax_get stx 2)),  // TODO typecheck
            (domains (tail (tail (tail (syntax_unwrap stx)))))]
        (let [(dupe (check_duplicate_identifier domains))]
          (when dupe
            (wrong_syntax dupe
              "Duplicate domain identifier in specification of domain " name_stx)))
        (datum_to_syntax
          (QQ
            (define (UQ name_stx)
              (make_union_domain
                (quote (UQ name_stx))
                (UQ desc_stx)
                // Delay evaluation of the domains, so they can recurse
                (thunk (UQ (pair (quote list) domains))))))
          (quote_syntax context)
          stx))))

  (define (lift_to d v)
    '''
Lifts a subdomain value into a union domain.
    '''
    (unless (is_union_domain d)
      (raise_argument_error "lift_to" "union domain" 0 d v))
    (unless (is_domain_value v)
      (raise_argument_error "lift_to" "a domain value" 1 d v))
    (unless (domain_accepts d v)
      (raise_argument_error (string_append "lift_to " (domain_name d))
        (display_to_string "value in one of "
          (map domain_name (union_domain_subdomains d)))
        1 d v))
    (make_value d v))


  (define (is_union_domain_value v)
    (and (is_domain_value v)
         (is_union_domain (domain_value_domain v))))


  (define (unwrap v)
    "Extracts the subdomain value from a union value"
    (unless (is_union_domain_value v)
      (raise_argument_error "unwrap" "union-domain value" 0 v))
    (domain_value_rep v))


  (define (subdomain v)
    "Extracts the subdomain type from a union value"
    (unless (is_union_domain_value v)
      (raise_argument_error "subdomain" "union-domain value" 0 v))
    (domain_value_domain (domain_value_rep v)))


  (define (lower_to d v)
    (unless (is_domain d)
      (raise_argument_error "lower_to" "domain" 0 d v))
    (unless (is_union_domain_value v)
      (raise_argument_error "lower_to" "union-domain value" 1 d v))
    (let [(rep (domain_value_rep v))]
      (unless (element_of rep d)
        (raise_argument_error "lower_to"
          (string_append "element of domain " (domain_name d))
          1 d v))
      rep))


  //-------------------
  // Product Domains

  (define ProductDomain
    (make_domain_meta "ProductDomain"
      (|d| (display (apply string_join " * "
                      (map domain_name (product_domain_subdomains d)))))
      null))

  (define (make_product_domain name description domain_producer)  // Ugh
    // TODO Memoize domain production
    (make_domain ProductDomain name product_domain_checker description domain_producer))

  (define (is_product_domain d)
    (and (is_domain d) (ident ProductDomain (domain_type d))))

  (define (product_domain_subdomains d)
    '''
Returns the list of component domains.
    '''
    (let [(domains ((domain_data d)))]
      (unless (and (is_list domains)
                   (every is_domain domains))
        (raise_result_error "product_domain_subdomains" "list of domains" domains))
      domains))

  (define tuple
    '''
    (tuple domain elt0 elt1 ...+)

Constructs a product-domain value.
    '''
    (lambda rest
      (let [(domain (head rest)),
            (value  (apply list (tail rest)))]
        (unless (is_product_domain domain)
          (apply raise_argument_error "tuple" "product domain" 0 rest))
        (unless (domain_accepts domain value)
          // TODO Error message should identify the correct arg index.
          (apply raise_argument_error "tuple"
            (string_append "fields for domain " (domain_name domain))
            -1 rest))
        (make_value domain value))))

  (define (is_tuple v)
    (and (is_domain_value v)
         (is_product_domain (domain_value_domain v))))


  (define (tuple_values tuple)
    '''
Return the components of tuple `v` as multiple values.
    '''
    (unless (is_tuple tuple)
      (raise_argument_error "tuple_values" "tuple value" 0 tuple))
    (apply values (domain_value_rep tuple)))


  (define (tuple_ith v i)
    '''
Access component i of tuple v.
    '''
    // TODO type-check v
    (list_element (domain_value_rep v) i))


  (define (product_domain_element d v i)
    '''
Access component i of domain value v in domain d.
    '''
    // TODO type-check v
    (list_element (domain_value_rep v) i))


  (define (product_domain_checker d values)
    (let [(subdomains (product_domain_subdomains d))]
      (and (is_list values)
           (== (size values) (size subdomains))
        (for_fold [(all_are_good true)]
                  [(v values), (s subdomains)]
          (and all_are_good (element_of v s))))))

  (define_syntax define_product_domain
    '''
    (define_product_domain name description domain0 domain1 ...+)
    '''
    (lambda (stx)
      (when (< (syntax_size stx) 4)
        (wrong_syntax stx "Bad syntax for define_product_domain"))
      (let [(name_stx (syntax_get stx 1)),
            (desc_stx (syntax_get stx 2)),  // TODO typecheck
            (domains (tail (tail (tail (syntax_unwrap stx)))))]
        (when (< (size domains) 2)
          (wrong_syntax stx "define_product_domain requires at least two elements"))
        (datum_to_syntax
          (QQ
            (define (UQ name_stx)
              (make_product_domain
                (quote (UQ name_stx))
                (UQ desc_stx)
                // Delay evaluation of the domains, so they can recurse
                (thunk (UQ (pair (quote list) domains))))))
          (quote_syntax context)
          stx))))


  //-------------------
  // Function Domains

  (define (display_func_domain d)
    (display_domain_name_else_rhs (func_domain_input d))
    (display " -> ")
    (display_domain_name_else_rhs (func_domain_output d)))


  (define FuncDomain
    (make_domain_meta "FuncDomain" display_func_domain null))


  (define (make_func_domain name description input output)
    '''
`input` can be a named domain, a list of named domains for multi-arg,
or null for TOP (accept any one value).
    '''
    (unless (or (is_domain input)
                (is_list_of_domains input)
                (is_null input))                                        // [TOP]
      (raise_argument_error "make_func_domain" "input domain or domains" 2
        name description input output))
    (when (and (is_product_domain input) (is_null (domain_name input)))
      // FIXME This doesn't handle single-entry list
      (raise_argument_error "make_func_domain"
        "singular product-domain arg must be named" 0
        name description input output))
    (unless (is_domain output)                                          // [TOP]
      (raise_argument_error "make_func_domain" "output domain" 3
        name description input output))
    (let [(input (if (is_list_of_domains input)
                   (if (=== 1 (size input))
                     (. input 0)
                     (make_product_domain null.string null.string (|| input)))
                   input))]
      (make_domain FuncDomain name is_procedure description [input, output])))

  (define (is_func_domain v) (is_domain_of_type FuncDomain v))

  (define (func_domain_input  d) (list_element (domain_data d) 0))
  (define (func_domain_output d) (list_element (domain_data d) 1))

  (define (func_domain_argdomains d)
    (let [(in_dom (func_domain_input d))]
      (if (and (is_product_domain in_dom) (is_null (domain_name in_dom)))
        (product_domain_subdomains in_dom)
        [in_dom])))


  (define_syntax define_func_domain
    '''
    (define_func_domain name description inDomain ...+ outDomain)
    '''
    (lambda (stx)
      (when (< (syntax_size stx) 5)
        (wrong_syntax stx "Bad syntax for define_func_domain"))
      (lets [(name_stx (syntax_get stx 1)),
             (desc_stx (syntax_get stx 2)),  // TODO typecheck
             (domains (tail (tail (tail (syntax_unwrap stx))))),
             (domains_rev (reverse domains)),
             (out_domain (head domains_rev)),
             (in_domains (reverse (tail domains_rev)))]
        (datum_to_syntax
          (QQ (define (UQ name_stx)
                (make_func_domain
                  (quote (UQ name_stx))
                  (UQ desc_stx)
                  // TODO Delay evaluation of the domains, so they can recurse
                  (UQ (pair (quote list) in_domains))
                  (UQ out_domain))))
          CTX stx))))

)

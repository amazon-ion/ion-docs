(module unicode "/fusion"

  '''
Predefined denotational model of Unicode code-point sequences and related functions.
  '''

  (require
    "/fusioncontrib/denotation/private/base"
    "/fusioncontrib/denotation/private/boolean"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/optional"
    "/fusioncontrib/denotation/private/sequence"
  )

  (provide
    Unicode
    Unicode_append
    EQ_Unicode
  )


  (define_base_domain Unicode "Sequences of Unicode code points" is_string)


  (define_fn Unicode_append ((a Unicode) (b Unicode) -> Unicode)
    (string_append (eject a) (eject b)))

  (define_fn EQ_Unicode ((a Unicode) (b Unicode) -> B)
    (=== (eject a) (eject b)))
)

(module integer "/fusion"

  '''
Predefined denotational model of Integer values and related functions.
  '''

  (require
    "/fusioncontrib/denotation/private/boolean"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/optional"
    "/fusioncontrib/denotation/private/sequence"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    I 'I?' 'I*'
    EQ
    GT
    GTE
    LT
    LTE
    MINUS
    PLUS
  )


  (define_base_domain I   "Integers"       is_int)
  (define_opt_domain 'I?' "Optional I"     I)
  (define_seq_domain 'I*' "Sequence of I"  I)

  (define_fn EQ    ((a I) (b I) -> B)  (same (eject a) (eject b)))
  (define_fn GT    ((a I) (b I) -> B)  (>    (eject a) (eject b)))
  (define_fn GTE   ((a I) (b I) -> B)  (>=   (eject a) (eject b)))
  (define_fn LT    ((a I) (b I) -> B)  (<    (eject a) (eject b)))
  (define_fn LTE   ((a I) (b I) -> B)  (<=   (eject a) (eject b)))
  (define_fn MINUS ((a I) (b I) -> I)  (-    (eject a) (eject b)))
  (define_fn PLUS  ((a I) (b I) -> I)  (+    (eject a) (eject b)))
)

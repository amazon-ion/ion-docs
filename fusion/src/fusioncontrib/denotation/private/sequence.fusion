(module sequence "/fusion"

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/private/record"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/util"
  )


  (provide
    define_seq_domain
    is_seq
    is_seq_domain
    make_seq_domain
    seq
    seq_append
    seq_domain_subdomain
    seq_head
    seq_ith
    seq_is_empty
    seq_length
    seq_prepend
    seq_tail
    seq_truncate
  )


  (define SeqDomain
    (make_domain_meta "SeqDomain" null))


  (define (make_seq_domain name description entry_domain)
    '''
`entry_domain` must be a named domain.
    '''
    (unless (is_domain entry_domain)
      (raise_argument_error "make_seq_domain" "entry domain" 2
        name description entry_domain))
    (when (is_null (domain_name entry_domain))
      (raise_argument_error "make_seq_domain" "entry domain must be named" 2
        name description entry_domain))
    (make_domain SeqDomain name seq_domain_checker description entry_domain))


  (define (seq_domain_subdomain d)
    '''
Returns the domain of the seq's elements.
    '''
    (domain_data d))


  (define (seq_domain_checker d values)
    (let [(subdomain (seq_domain_subdomain d))]
      (and (is_sexp values)
           (every (|v| (domain_is v subdomain)) values))))


  (define (is_seq_domain d)
    (is_domain_of_type SeqDomain d))


  (define_syntax define_seq_domain
    '''
    (define_seq_domain name description subdomain)
    '''
    (lambda (stx)
      (unless (= (syntax_size stx) 4)
        (wrong_syntax stx "Bad syntax for define_seq_domain"))
      (let [(name_stx  (syntax_get stx 1)),
            (desc_stx  (syntax_get stx 2)),  // TODO typecheck
            (subdomain (syntax_get stx 3))]
        (datum_to_syntax
          (QQ
            (define (UQ name_stx)
              (make_seq_domain
                (quote (UQ name_stx))
                (UQ desc_stx)
                (UQ subdomain))))
          (quote_syntax context)
          stx))))


  //================
  // Sequence Values

  (define seq
    '''
    (seq domain value ...)

Constructs a sequence of type `domain` from the values, each of which must be
within `domain`'s subdomain.
    '''
    (lambda rest
      (let [(domain (head rest)),
            (values (tail rest))]
        (unless (is_seq_domain domain)
          (apply raise_argument_error "seq" "seq domain" 0 rest))
        (let [(subdomain (seq_domain_subdomain domain))]
          (let loop [(i 1), (vs values)]
            (when (is_pair vs)
              (if (domain_is (head vs) subdomain)
                (loop (+ 1 i) (tail vs))
                (apply raise_argument_error "seq"
                  (string_append "value in domain " (domain_name subdomain))
                  i rest)))))
        (make_value domain values))))

  (define (is_seq v)
    (and (is_domain_value v)
         (is_seq_domain (domain_value_domain v))))


  (define (seq_is_empty seq)
    (unless (is_seq seq)
      (raise_argument_error "seq_is_empty" "seq value" 0 seq))
    (is_empty (domain_value_rep seq)))


  (define (seq_length seq)
    (unless (is_seq seq)
      (raise_argument_error "seq_length" "seq value" 0 seq))
    (size (domain_value_rep seq)))


  (define (seq_ith seq i)
    (unless (and (is_seq seq) (not (seq_is_empty seq)))
      (raise_argument_error "ith" "non-empty seq value" 0 seq i))
    // TODO typecheck/rangecheck i
    (element (domain_value_rep seq) i))


  (define (seq_head seq)
    (unless (and (is_seq seq) (not (seq_is_empty seq)))
      (raise_argument_error "seq_head" "non-empty seq value" 0 seq))
    (let [(sexp (domain_value_rep seq))]
      (if (is_empty sexp)
        (raise_argument_error "seq_head" "non-empty seq" 0 seq)
        (head sexp))))

  (define (seq_tail seq)
    (unless (and (is_seq seq) (not (seq_is_empty seq)))
      (raise_argument_error "seq_tail" "non-empty seq value" 0 seq))
    (make_value (domain_value_domain seq) (tail (domain_value_rep seq))))


  (define (seq_prepend v seq)
    (unless (is_seq seq)
      (raise_argument_error "seq_append" "seq value" 1 v seq))
    (let [(subdomain (seq_domain_subdomain (domain_value_domain seq)))]
      (unless (domain_is v subdomain)
        (raise_argument_error "seq_prepend"
          (string_append "value in domain " (domain_name subdomain))
          0 v seq)))
    (make_value (domain_value_domain seq)
      (pair v (domain_value_rep seq))))


  (define (seq_append seq0 seq1)
    (unless (is_seq seq0)
      (raise_argument_error "seq_append" "seq value" 0 seq0 seq1))
    (unless (is_seq seq1)
      (raise_argument_error "seq_append" "seq value" 1 seq0 seq1))
    (unless (same (domain_value_domain seq0)
                  (domain_value_domain seq1))
      (raise_argument_error "seq_append" "same sequence type" -1 seq0 seq1))
    (make_value (domain_value_domain seq0)
      (append (domain_value_rep seq0) (domain_value_rep seq1))))


  (define (seq_truncate seq len)
    (unless (is_seq seq)
      (raise_argument_error "seq_truncate" "seq value" 0 seq len))
    (unless (and (is_int len) (<= 0 len))
      (raise_argument_error "seq_truncate" "non-negative int" 1 seq len))
    (unless (<= len (seq_length seq))
      (raise_argument_error "seq_truncate" "int <= sequence length" 1 seq len))
    (make_value (domain_value_domain seq) (subseq (domain_value_rep seq) 0 len)))
)

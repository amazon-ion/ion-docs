(module tuple "/fusion"

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation/private/bottom"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/typecheck"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    define_tuple_domain
    is_tuple
    is_tuple_domain
    tuple
    tuple_domain_field_names
    tuple_domain_subdomains
    tuple_ith
    tuple_values
  )



  (define TupleDomain
    (make_domain_meta "TupleDomain" null))

  (define (make_tuple_domain name description domain_producer field_names)
    (assert (is_list field_names) field_names)
    (make_domain TupleDomain name tuple_domain_checker description
      [domain_producer, field_names]))

  (define (is_tuple_domain d)
    (is_domain_of_type TupleDomain d))

  // TODO rename -> tuple_domain_field_types
  (define (tuple_domain_subdomains d)
    '''
Returns a list of domains: the types of the fields of the tuple domain `d`.
    '''
    (lets [(producer (element (domain_data d) 0)),
           (domains  (producer))]
      (unless (is_list_of_named_domains domains)
        (raise_result_error "tuple_domain_subdomains" "list of named domains" domains))
      domains))


  (define (tuple_domain_field_names d)
    '''
Returns a list of symbols: the names of the fields of the tuple domain `d`.

When a field doesn't have a name, its entry in the list is `null.symbol`.
    '''
    (element (domain_data d) 1))


  (define tuple
    '''
    (tuple domain elt0 elt1 ...+)

Constructs a tuple-domain value.
    '''
    (lambda rest
      (unless (is_pair rest)
        // TODO Exception should say "at least 2" arguments expected
        (apply raise_arity_error "tuple" 2 rest))
      (let [(domain (head rest)),
            (args   (tail rest))]
        (unless (is_tuple_domain domain)
          (apply raise_argument_error "tuple" "tuple domain" 0 rest))
        (lets [(where (string_append "tuple " (domain_name domain))),
               (subs  (apply sexp (tuple_domain_subdomains domain))),
               (arity (size subs))]
          (unless (=== (size args) arity)
            (apply raise_arity_error where (+ 1 arity) rest))
          (let [(args (typecheck_args where subs args 1))]
            (if (is_bottom args)
                args
                (make_value domain (apply list args))))))))

  (define (is_tuple v)
    (and (is_domain_value v)
         (is_tuple_domain (domain_value_domain v))))


  (define (tuple_values tuple)
    '''
Return the components of tuple `v` as multiple values.
    '''
    (unless (is_tuple tuple)
      (raise_argument_error "tuple_values" "tuple value" 0 tuple))
    (apply values (domain_value_rep tuple)))


  (define_strict (tuple_ith v i)
    '''
Access component i of tuple v.
    '''
    // TODO type-check v
    (list_element (domain_value_rep v) i))


  (define (tuple_domain_checker d values)
    (let [(subdomains (tuple_domain_subdomains d))]
      // We don't type-check the elements here, its been done by `tuple`.
      (and (is_list values)
           (same_size values subdomains))))


  (define (split_field_decl decl)
    (lets [(anns (annotations (syntax_unwrap decl)))]
      (if (is_empty anns)
        (values decl (quote null.symbol))
        (if (== 1 (size anns))
          (values (datum_to_syntax (first anns) decl decl)
                  (annotate (syntax_unwrap decl)))
          (wrong_syntax decl "Too many annotations in field declaration")))))

  (define (split_field_decls decls)
    "Returns two sexps, holding the field types and names."
    (if (is_empty decls)
      (values (sexp) (sexp))
      (let_values [((head_domain   head_name) (split_field_decl  (head decls))),
                   ((tail_domains tail_names) (split_field_decls (tail decls)))]
        (values (pair head_domain tail_domains)
                (pair head_name   tail_names)))))


  (define_syntax define_field_accessor
    '''
    (define_field_accessor name tuple_domain field_domain index)
    '''
    (lambda (stx)
      (unless (= (syntax_size stx) 5)
        (wrong_syntax stx "Bad syntax for define_field_accessor"))
      (let [(name_stx  (syntax_get stx 1)),
            (tuple_dom (syntax_get stx 2)),
            (field_dom (syntax_get stx 3)),
            (index     (syntax_get stx 4))]
        (datum_to_syntax
          (QQ
            (define_fn (UQ name_stx) ((v (UQ tuple_dom)) -> (UQ field_dom))
              (tuple_ith v (UQ index))))
          (quote_syntax context)
          stx))))

  (define (accessor_name domname_stx fname_text)
    "Intentionally non-hygienic, so the accessor is accessible."
    (datum_to_syntax
      (symbol_append (syntax_unwrap domname_stx) "_" fname_text)
      domname_stx))

  (define_syntax define_tuple_domain
    '''
    (define_tuple_domain name description <field> ...+)

Each <field> is either an identifier bound to the field's domain, or
`domain::field_name`.
    '''
    (lambda (stx)
      (when (< (syntax_size stx) 3)
        (wrong_syntax stx "Bad syntax for define_tuple_domain"))
      (let [(domname_stx (syntax_get stx 1)),
            (desc_stx    (syntax_get stx 2)),  // TODO typecheck
            (fields      (tail (tail (tail (syntax_unwrap stx)))))]
        (unless (> (size fields) 0)
          (wrong_syntax stx "tuple domain requires at least one field"))
        (let_values [((domains fnames) (split_field_decls fields))]
          (datum_to_syntax
            (apply sexp
              (QS begin)
              (QQ
                (define (UQ domname_stx)
                  (make_tuple_domain
                    (quote (UQ domname_stx))
                    (UQ desc_stx)
                    // Delay evaluation of the domains, so they can recurse
                    (thunk (UQ (pair (quote list) domains)))
                    (apply list (quote (UQ fnames))))))
              (let def_fields [(domains domains), (fnames fnames), (index 0)]
                (if (is_empty domains)
                  (sexp (QS (begin)))
                  (pair
                    (if (head fnames)
                      // We have a named field
                      (let [(fname_stx (accessor_name domname_stx (head fnames)))]
                        (QQ (define_field_accessor (UQ fname_stx)
                              (UQ domname_stx) (UQ (head domains)) (UQ index))))
                      (QS (begin)))
                    (def_fields (tail domains) (tail fnames) (+ 1 index))))))
            (quote_syntax context)
            stx)))))
)

(module display "/fusion"
  '''
Miscellaneous things that should really be provided by Fusion.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"

    (rename_in "/fusion/experimental/syntax"
      (quote_syntax QS))
    (rename_in "/fusion/base"
      (quote Q) (quasiquote QQ) (unquote UQ))
  )

  (provide
    desyntax
    flatten_to_sexp
    in_naturals
    is_sexp_of_ids
    is_syntax_pair
    is_text
    symbol_append
    text_to_string
    text_to_symbol
    Q
    QS
    QQ
    UQ
  )

  (define (is_syntax_pair v)
    (and (is_syntax v)
         (is_pair (syntax_unwrap v))))

  (define (is_sexp_of_ids ids)
    // Hmm, returns true for null.sexp
    (if (is_sexp ids)
      (if (is_pair ids)
        (if (is_identifier (head ids))
          (is_sexp_of_ids (tail ids))
          false)
        true)
      false))

  (define flatten_to_sexp
    (lambda vs
      (apply append
        (sexp)
        (for_list [(v vs)]       // Produce a list of sexps
          (if (is_sequence v)
            (apply flatten_to_sexp v)
            (sexp v))))))

  (define (remove_first pred sequence)
    (choose (let [(looking true)]
              (lambda (e)
                (if (and looking (pred e))
                  (begin (set looking false) false)
                  true)))
       sequence))

  (define (bag_equal equal list1 list2)
    (and (same_size list1 list2)
      (let loop [(i 0), (list2 list2)]
        (if (== i (size list1))
           (is_empty list2)
           (let [(v1 (element list1 i))]
             (loop (+ i 1)
               (remove_first (|v2| (equal v1 v2)) list2)))))))


  // Also exists in /fusion/private/record
  (define symbol_append
    (lambda texts
      (string_to_symbol (apply string_append texts))))

  (define (is_text v)
    (or (is_string v) (is_symbol v)))

  (define (text_to_string v)
    (if (is_string v) v (symbol_to_string v)))

  (define (text_to_symbol t)
    (if (is_symbol t)
      t
      (if (is_string t)
        (string_to_symbol t)
        (raise_argument_error "text_to_symbol" "string or symbol" 0 t))))

  (define (desyntax v)
    "If `v` is a syntax object, unwrap it, otherwise return it as is."
    (if (is_syntax v) (syntax_unwrap v) v))


  (define (in_naturals n)
    "Returns an endless iterator counting up from `n`."
    // TODO ensure n is int.
    (make_iterator (always true) (lambda () (set n (+ 1 n)) // [BEGIN0]
                                            (- 1 n))))
)

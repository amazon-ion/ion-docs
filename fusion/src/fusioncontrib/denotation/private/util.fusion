(module display "/fusion"
  '''
Miscellaneous things that should really be provided by Fusion.
  '''

  (require
    "/fusion/experimental/syntax"

    (rename_in "/fusion/experimental/syntax"
      (quote_syntax QS))
    (rename_in "/fusion/base"
      (quote Q) (quasiquote QQ) (unquote UQ))
  )

  (provide
    is_syntax_pair
    symbol_append
    Q
    QS
    QQ
    UQ
  )

  (define (is_syntax_pair v)
    (and (is_syntax v)
         (is_pair (syntax_unwrap v))))

  // Also exists in /fusion/private/record
  (define symbol_append
    (lambda texts
      (string_to_symbol (apply string_append texts))))

)

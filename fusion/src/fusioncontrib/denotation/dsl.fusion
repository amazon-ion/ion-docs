(module densem "/fusion"
  '''
Work-in-progress dialect for defining modules entirely within the denotational
semantics DSL.
  '''

  (require
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/printing"
  )


  (provide             // domains
    B 'B?' 'B*'
    F 'F?' 'F*'
    I 'I?' 'I*'
    Unicode 'Unicode?' 'Unicode*'
  )

  (provide             // functions
    bottom_message
    define_fn
    define_model
    dom
    domain_description
    domain_is
    domain_name
    domain_of
    element_of
    fn
    import
    inject_into           // TODO remove?
    is_bottom
    is_domain
    is_fn
    is_model
    ith
    lift
    lift_to
    lower
    lower_to
    mk_fn
    opt
    opt_is_present
    opt_value
    subdomain
    tuple
    seq
    seq_append
    seq_head
    seq_is_empty
    seq_length
    seq_prepend
    seq_tail
    seq_truncate
    wrong

    // Pre-defined domains and functions
    EQ
    EQ_Enum
    IF
    U_EQ
    Unicode_append

    (rename_out
      (AND    and)
      (APPLY  apply)
      (GT     >)
      (GTE    >=)
      (IF1    if)
      (LT     <)
      (LTE    <=)
      (MAP    map)
      (MINUS  -)
      (NOT    not)
      (OR     or)
      (PLUS   +)))

  (provide                // Pretty-printing hints
    'hint:multiline'
    'hint:oneline'
    'hint:paren'
  )
)

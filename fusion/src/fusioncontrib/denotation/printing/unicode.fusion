(module uniprinter "/fusion"

  '''
Print domain models in a Unicode-rich plain-text format.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    uniprinter
  )


  //============================================================================
  // Custom Printing Methods

  (define (pp_domain_name_else_rhs d e)
    (let [(name (domain_name d))]
      // This is the DSL `if`, which we need for the printer config below.
      (if (not (is_null name)) (display name) (pp_domain_rhs d e))))

  (define (pp_subdoms subdoms e mid)
    (pp_print_terms (map domain_name subdoms) e "" mid ""))

  (define (pp_domain_rhs d e)
    (cond
      ((is_base_domain  d) (display "<" (domain_description d) ">"))
      ((is_enum_domain  d) (pp_print_terms (enum_const_ids d) e "{ " ", " " }"))
      ((is_union_domain d) (pp_subdoms (union_domain_subdomains d) e " + "))
      ((is_tuple_domain d) (pp_subdoms (tuple_domain_subdomains d) e " * "))
      ((is_func_domain  d) (pp_subdoms (func_domain_inputs      d) e " * ")
                           (display " -> ")
                           (pp_domain_name_else_rhs (func_domain_output d) e))
      ((is_seq_domain   d) (display (domain_name (seq_domain_subdomain d)) "*"))
      (true (raise_argument_error "pp_domain_rhs" "known domain type" 0 d e))))


  (define (pp_model m e)
    (display "Domains\n=======")
    (pp_print_terms (model_domains m) e "\n" "\n" "\n")
    (unless (is_empty (model_consts m))
      (display "\nConstants\n=========")
      (pp_print_terms (model_consts m) e "\n" "\n" "\n"))
    (unless (is_empty (model_fns m))
      (display "\nFunctions\n=========")
      (pp_print_terms (model_fns m) e "\n" "\n" "\n")))

  (define (pp_domain_def d e)
    (display (domain_name d) " = ")
    (pp_domain_rhs d e))

  (define (pp_const_def v e)
    (pp_print (const_name v) e)
    (display " = ")
    (pp_print (const_code v) e))

  (define (pp_fn_def f e)
    (pp_print       (fn_name f) e)
    (pp_print_terms (fn_args f) e "(" ", " ") = ")
    (pp_print       (fn_code f) e))


  // Special Forms and Functions

  (define (pp_bindings bindings e)
    (assert (is_sexp bindings))
    (when (is_pair bindings)
      (let [(binding (syntax_unwrap (head bindings)))]
        (assert (=== 2 (size binding)))
        (pp_print (. binding 0) e)
        (display " = ")
        (pp_print (. binding 1) e)
        (when (is_pair (tail bindings))
          (display " ; ")
          (pp_bindings (tail bindings) e)))))

  (define (pp_let s e)
    (display "LET ")
    (let [(bindings (apply sexp (syntax_unwrap (. s 1)))),
          (body     (. s 2))]
      (assert (not (is_empty bindings)))
      (pp_bindings bindings e)
      (display " IN ")
      (pp_print body e)
      (display " ENDLET")))

  (define (pp_lift s e)
    (for [(d (reverse (tail (tail s))))]
      (display "in")
      (pp_print d e)
      (display "("))
    (pp_print (. s 1) e)
    (for [(d (tail (tail s)))]
      (display ")")))

  (define (pp_lift_to d v e)
    (display "in")
    (pp_print d e)
    (display "(")
    (pp_print v e)
    (display ")"))

  (define (pp_seq t e)
    (pp_print_terms t e "⟨" ", " "⟩"))

  (define (pp_tuple s e)
    (display "in")
    (pp_print (. s 1) e)
    (display "(")
    (pp_seq (tail (tail s)) e)
    (display ")"))


  //============================================================================


  (define uniprinter
    '''
A model printer that renders in Unicode plain-text.
    '''
    (make_printer                  // Formatting rules in decreasing precedence
      // Special forms
      (form_method eject           (pp_unary "" ""))
      (form_method element_of      (pp_binary "" " ∈ " ""))
      (form_method IF1             (pp_ternary "IF " " THEN " " ELSE " " ENDIF"))
      (form_method inject_into     (|s e| (pp_lift_to (. s 1) (. s 2) e)))
      (form_method ith             (pp_binary "" "↓" ""))
      (form_method let             pp_let)
      (form_method lift            pp_lift)
      (form_method lift_to         (|s e| (pp_lift_to (. s 1) (. s 2) e)))
      (form_method lower           (|s e| (pp_print (. s 1) e)
                                          (pp_print_terms (tail (tail s)) e "|" "|" "")))
      (form_method lower_to        (|s e| (pp_print (. s 2) e)
                                          (display "|")
                                          (pp_print (. s 1) e)))
      (form_method mk_fn           (|s e| (pp_print_terms (. s 2) e "λ" " " ".")
                                          (pp_print (. s 3) e)))
      (form_method seq             (|s e| (pp_seq (tail (tail s)) e)))
      (form_method seq_append      (pp_binary "" "§" ""))
      (form_method seq_head        (pp_unary "" "↓0"))
      (form_method seq_is_empty    (pp_unary "#" " = 0"))
      (form_method seq_length      (pp_unary "#" ""))
      (form_method seq_prepend     (pp_binary "⟨" "⟩§" ""))
      (form_method seq_tail        (pp_unary "" "†1"))
      // TODO seq_truncate
      (form_method tuple           pp_tuple)

      (form_method PLUS            (pp_binary "" " + " ""))
      (form_method MINUS           (pp_binary "" " - " ""))
      (form_method LT              (pp_binary "" " < " ""))
      (form_method EQ              (pp_binary "" " = " ""))
      (form_method GT              (pp_binary "" " > " ""))

      // Function application. This must follow other forms!
      (type_method is_syntax_pair  (|stx e| (pp_print_terms stx e "(" " " ")")))


      (type_method is_model        pp_model)
      (type_method is_domain       pp_domain_def)
      (type_method is_const        pp_const_def)
      (type_method is_fn           pp_fn_def)

      (type_method is_symbol       (|v e| (display v)))   // Override default `write` call.
    ))
)

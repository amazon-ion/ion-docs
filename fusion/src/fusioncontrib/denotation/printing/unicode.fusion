(module uniprinter "/fusion"

  '''
Print domain models in a Unicode-rich plain-text format.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    uniprinter
  )


  (define (pp_domain_name_else_rhs d r)
    (let [(name (domain_name d))]
      (if name (display name) (pp_domain_rhs d r))))

  (define (pp_subdoms subdoms r mid)
    (pp_print_terms (map domain_name subdoms) r "" mid ""))

  (define (pp_domain_rhs d r)
    (cond
      ((is_singleton_domain d) (display "<" (domain_description d) ">"))
      ((is_base_domain      d) (display "<" (domain_description d) ">"))
      ((is_union_domain     d) (pp_subdoms (union_domain_subdomains   d) r " + "))
      ((is_product_domain   d) (pp_subdoms (product_domain_subdomains d) r " * "))
      ((is_func_domain      d) (pp_subdoms (func_domain_argdomains    d) r " * ")
                               (display " -> ")
                               (pp_domain_name_else_rhs (func_domain_output d) r))
      ((is_seq_domain       d) (display (domain_name (seq_domain_subdomain d)) "*"))
      (true (raise_argument_error "pp_domain_rhs" "known domain type" 0 d r))))


  (define (pp_model m r)
    (display "Domains\n=======")
    (pp_print_terms (model_domains m) r "\n" "\n" "\n")
    (unless (is_empty (model_fns m))
      (display "\nFunctions\n=========")
      (pp_print_terms (model_fns m) r "\n" "\n" "\n")))


  // Special Forms and Functions

  (define (pp_bindings bindings r)
    (assert (is_sexp bindings))
    (when (is_pair bindings)
      (let [(binding (syntax_unwrap (head bindings)))]
        (assert (=== 2 (size binding)))
        (pp_print (. binding 0) r)
        (display " = ")
        (pp_print (. binding 1) r)
        (when (is_pair (tail bindings))
          (display " ; ")
          (pp_bindings (tail bindings) r)))))

  (define (pp_let s r)
    (display "LET ")
    (let [(bindings (apply sexp (syntax_unwrap (. s 1)))),
          (body     (. s 2))]
      (assert (not (is_empty bindings)))
      (pp_bindings bindings r)
      (display " IN ")
      (pp_print body r)
      (display " ENDLET")))

  (define (pp_lift s r)
    (for [(d (reverse (tail (tail s))))]
      (display "in")
      (pp_print d r)
      (display "("))
    (pp_print (. s 1) r)
    (for [(d (tail (tail s)))]
      (display ")")))

  (define (pp_lift_to d v r)
    (display "in")
    (pp_print d r)
    (display "(")
    (pp_print v r)
    (display ")"))

  (define (pp_seq t r)
    (pp_print_terms t r "⟨" ", " "⟩"))

  (define (pp_tuple s r)
    (display "in")
    (pp_print (. s 1) r)
    (display "(")
    (pp_seq (tail (tail s)) r)
    (display ")"))


  (define uniprinter
    '''
A model printer that renders in Unicode plain-text.
    '''
    (make_printer
      // formatting rules in decreasing precedence
      (sexp
        // General functions
        (type_method is_fn
          (|fn r| (pp_print (fn_name fn) r)
                  (pp_print_terms (fn_args fn) r "(" ", " ") = ")
                  (pp_print (fn_code fn) r)))

        // Special forms
        (form_method (quote_syntax eject) // Ignored
          (pp_unary "" ""))
        (form_method (quote_syntax element_of)
          (pp_binary "" " ∈ " ""))
        (form_method (quote_syntax if)
          (pp_ternary "IF " " THEN " " ELSE " " ENDIF"))
        (form_method (quote_syntax inject_into)
          (|s r| (pp_lift_to (. s 1) (. s 2) r)))
        (form_method (quote_syntax ith)
          (pp_binary "" "↓" ""))
        (form_method (quote_syntax let)  pp_let)
        (form_method (quote_syntax lift) pp_lift)
        (form_method (quote_syntax lift_to)
          (|s r| (pp_lift_to (. s 1) (. s 2) r)))
        (form_method (quote_syntax lower)
          (|s r| (pp_print (. s 1) r)
                 (pp_print_terms (tail (tail s)) r "|" "|" "")))
        (form_method (quote_syntax lower_to)
          (|s r| (pp_print (. s 2) r)
                 (display "|")
                 (pp_print (. s 1) r)))
        (form_method (quote_syntax mk_fn)
          (|s r| (pp_print_terms (. s 2) r "λ" " " ".")
                 (pp_print (. s 3) r)))
        (form_method (quote_syntax seq)
          (|s r| (pp_seq (tail (tail s)) r)))
        (form_method (quote_syntax seq_append)
          (pp_binary "" "§" ""))
        (form_method (quote_syntax seq_head)
          (pp_unary "" "↓0"))
        (form_method (quote_syntax seq_is_empty)
          (pp_unary "#" " = 0"))
        (form_method (quote_syntax seq_length)
          (pp_unary "#" ""))
        (form_method (quote_syntax seq_prepend)
          (pp_binary "⟨" "⟩§" ""))
        (form_method (quote_syntax seq_tail)
          (pp_unary "" "†1"))
        // TODO seq_truncate
        (form_method (quote_syntax tuple) pp_tuple)

        (form_method (quote_syntax +)     (pp_binary "" " + " ""))
        (form_method (quote_syntax -)     (pp_binary "" " - " ""))
        (form_method (quote_syntax <)     (pp_binary "" " < " ""))
        (form_method (quote_syntax ===)   (pp_binary "" " = " ""))
        (form_method (quote_syntax >)     (pp_binary "" " > " ""))

        // Function application. This must follow other forms!
        (type_method is_syntax_pair
          (|stx r| (pp_print_terms stx r "(" " " ")")))

        // For any other syntax form, unwrap and try again.
        (type_method is_syntax
          (|stx r| (pp_print (syntax_unwrap stx) r)))

        (type_method is_domain
          (|d r| (display (domain_name d) " = ")
                 (pp_domain_rhs d r)))

        (type_method is_model pp_model)
      )))
)

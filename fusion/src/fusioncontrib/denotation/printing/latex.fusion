(module latex "/fusion"

  '''
Print domain models in a LaTeX format.

In general, the output is in math mode, but individual print methods may shift
back to text mode to print things like identifiers and strings in text mode.

**Note:** The generated LaTeX assumes the presence of a wrapping `tabbing`
environment with additional definitions along these lines (from LiSP2TeX):

```                          '''/* Double-backslashes are for Ion, not TeX */'''
\\def\\DenotedLisp{\\begingroup
  \\def\\EndDenotedLisp{$ \\end{tabbing}\\endgroup}
  \\ifDenotationInline
    \\def\\setandincrindent{ }
    \\def\\decrindent{ }
    \\def\\newline{ }
  \\else
    \\def\\setandincrindent{ $\\@settab\\@tabplus$ } % Avoid space between the $
    \\def\\decrindent{ $\\@tabminus$ }
    \\def\\newline{ $\\@tabcr$ }
  \\fi\\begin{tabbing} $ }
```

Observe that the local definitions, including a redefinition of `\\newline`,
switch out of math-mode and then back, because tabbing/newlines aren't allowed
in math mode.


TODO
====
  * Print sequence-domain names with non-bold superscript asterisk.
  * Insert some vertical space between function definitions.
    * Perhaps: 	\\smallskip, \\medskip, \\bigskip
  * When printing multiple domains definitions, column-align them.
  * Remove a bit of hspace before the | in lower_to?
    * Note they are already pretty close when chained.
  * Figure out decorations for raw values.  Degrees?  Hat?
    * \\dot  \\dotaccent?
  '''

  // Helpful reference to what's available in MathJAX:
  // https://onemathematicalcat.org//MathJaxDocumentation/TeXSyntax.htm

  
  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/printing"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    accessor
    latexprint
    pp_domain_def
    pp_ith
    pp_fn_def
    pp_fn_def1
  )


  // Formatting constants per LiSP2TeX

  // LaTeX space commands:
  //   \,  thin space       (normally 1/6 = 3/18 of a quad)
  //   \:  medium space     (normally 2/9 = 4/18 of a quad)
  //   \>  alt medium space
  //   \;  thick space      (normally 5/18 of a quad)
  //   \!  negative thin space

  (define SPACE "\\:")       // medium space
  (define NL "\\newline\n")  // "real" newline for code readablity

  (define wrap_with_space (|s| (string_append SPACE s SPACE)))

  (define TRUE  "\\mbox{\\bf true}")
  (define FALSE "\\mbox{\\bf false}")

  (define SEQ_OPEN  "\\langle ")
  (define SEQ_CLOSE "\\rangle ")

  (define DEFINE_EQ  " ~\\equiv~ ")

  (define IF_IF    (wrap_with_space "\\mbox{\\bf{if}}"))
  (define IF_THEN  (wrap_with_space "\\mbox{\\bf{then}}"))
  (define IF_ELSE  (wrap_with_space "\\mbox{\\bf{else}}"))
  (define IF_END   (wrap_with_space "\\mbox{\\bf{endif}}"))
  (define LET_LET  (wrap_with_space "\\mbox{\\bf{let}}"))
  (define LET_LETREC (wrap_with_space "\\mbox{\\bf{letrec}}"))
  (define LET_IN   (wrap_with_space "\\mbox{\\bf{in}}"))
  (define LET_END  "")

  (define WITHIN_BINDINGS   " = ")
  (define BETWEEN_BINDINGS  (wrap_with_space "\\mbox{\\bf{and}}"))


  (define (texescape text)
    '''
Returns TeX-escaped string representing the text, which can be string or symbol,
or syntax string or symbol.
    '''
    (let [(str (text_to_string (desyntax text)))]
      (string_replace (string_replace str "_" "\\_") "$" "\\$")))

  (define (texify_symbol v)
    // The trailing '\/' is post-italic space.
    (string_append "\\mbox{\\it " (texescape v) "\\/}"))


  (define (pp_newline e)
    (unless (is_oneline_mode e)
      (display NL)))

  (define (pp_incr_indentation e)
    (display " \\setandincrindent\n")
    // (pp-extend r 'indent) TODO record in environment
    e)

  (define (pp_decr_indentation e)
    (display " \\decrindent\n"))


  //============================================================================
  // Printing Model Definitions

  (define (pp_model m e)
    // TODO [SEQSEQ] model_domains should exclude axiomatic sequence definitions.
    (let [(non_seq_domains (choose (negate is_seq_domain) (model_domains m)))]
      (pp_print_terms non_seq_domains e "" NL NL))
    (unless (is_empty (model_fns m))
      (pp_print_terms (model_fns m) e NL "\\newline\n\\newline\n" "")))


  (define pp_domain_name_symbol
    (pp_symbol (|sym| (string_append "\\mbox{\\bf " (texescape sym) "}"))))

  (define (pp_domain_name v e)
    (pp_domain_name_symbol (desyntax v) e))

  (define (pp_domain_name_else_rhs d e)
    (let [(name (domain_name d))]
      (if name
        (pp_domain_name name e)
        (pp_domain_rhs d e))))

  (define (pp_subdoms subdoms env mid)
    (let loop [(i 0)]
      (when (< i (size subdoms))
        (unless (=== 0 i) (display mid))
        (pp_domain_name (domain_name (list_element subdoms i)) env)
        (loop (+ 1 i)))))

  (define (pp_domain_rhs d e)
    (cond
      ((is_base_domain      d) (display "\\mbox{(" (texescape (domain_description d)) ")}"))
      ((is_enum_domain      d) (display "\\{\\; ")
                               (pp_print_terms (enum_const_ids d) e "" ", " "")
                               (display " \\;\\}"))
      ((is_union_domain     d) (pp_subdoms (union_domain_subdomains   d) e " + "))
      ((is_product_domain   d) (pp_subdoms (product_domain_subdomains d) e " \\times "))
      ((is_func_domain      d) (pp_subdoms (func_domain_argdomains    d) e " \\times ")
                               (display " \\rightarrow ")
                               (pp_domain_name_else_rhs (func_domain_output d) e))
      (true (raise_argument_error "pp_domain_rhs" "known domain type" 0 d e))))

  (define (pp_domain_def v e)
    (pp_domain_name (domain_name v) e)
    (display DEFINE_EQ)
    (pp_domain_rhs v e)
    (display "\n"))


  // Constants

  (define (pp_const_def v e)
    (pp_print (const_name v) e)
    (display DEFINE_EQ)
    (let [(e1 (pp_incr_indentation e))]
      (pp_print (const_code v) e1)
      (pp_decr_indentation e1)))


  // Functions

  (define (pp_fn_def_lhs v e)
    // We want to render the LHS as if it were an invocation, so fake one up
    // and send it back for rendering, using any form-methods installed.
    (pp_print (datum_to_syntax (pair (fn_binding v) (fn_args v)) (QS ignored)) e))

  (define (pp_fn_def v e)
    (pp_fn_def_lhs v e)
    (display DEFINE_EQ)
    (display "$\\`$ ")   // Tabbing command to right-align the rest of the line
    (pp_domain_rhs (domain_of v) e)
    (display NL "\\;\\;")
    (let [(e1 (pp_incr_indentation e))]
      (pp_print (fn_code v) e1)
      (pp_decr_indentation e1)))

  (define (pp_fn_def1 v e)
    "Like `pp_fn_def` but renders the function body is assumed to fit on one line."
    (pp_fn_def_lhs v e)
    (display DEFINE_EQ)
    (pp_print (fn_code v) e)
    (display "$\\`$ ")   // Tabbing command to right-align the rest of the line
    (pp_domain_rhs (domain_of v) e)
    (display "\n"))


  (define (pp_accessor name)
    "Like `pp_ith` but the selector is literal text, not a sub-expression."
    // \! is negative thin-space
    (pp_unary "" (string_append "\\!\\downarrow_{\\mbox{\\scriptsize " name "}}")))

  (define_syntax accessor
    (lambda (stx)
      (let [(fn (syntax_get stx 1)), (field_name (syntax_get stx 2))]
        // TODO typecheck
        (datum_to_syntax
          (QQ [(form_method (UQ fn) (pp_accessor (UQ field_name))),
               (fn_method   (UQ fn) pp_fn_def1)])
          (QS context)
          stx))))


  //============================================================================
  // Special Forms and Functions

  (define (pp_lambda stx e)
    (pp_print_terms (. stx 1) e "\\lambda " " " "\\:.\\:")
    (pp_print (. stx 2) e))

  (define (pp_fn_call stx e)
    (lets [(sexp (desyntax stx)),
           (name (head sexp)),
           (args (tail sexp))]
      (pp_print name e)
      (pp_print_terms args e "(" ", " ")")))


  (define (pp_bindings bindings e)
    "Print name=expr bindings for let, letrec, etc."
    (assert (is_sexp bindings))
    (when (is_pair bindings)
      (let [(binding (syntax_unwrap (head bindings)))]
        (assert (=== 2 (size binding)))
        (pp_print (. binding 0) e)
        (display WITHIN_BINDINGS)
        (pp_print (. binding 1) e)
        (when (is_pair (tail bindings))
          (pp_newline e)
          (display BETWEEN_BINDINGS)
          (pp_bindings (tail bindings) e)))))


  (define (pp_let s e)
    (let [(e1 (pp_incr_indentation e))]
      (display LET_LET)
      (let [(bindings (apply sexp (syntax_unwrap (. s 1)))),
            (body     (. s 2))]
        (assert (not (is_empty bindings)))
        (pp_bindings bindings e)
        (display NL)
        (display LET_IN)
        (pp_print body e)
        (display LET_END))
      (pp_decr_indentation e)))   // FIXME? shouldn't this decr e1?

  (define (pp_letrec s e)
    (let [(e1 (pp_incr_indentation e))]
      (display LET_LETREC)
      (let [(bindings (apply sexp (syntax_unwrap (. s 1)))),
            (body     (. s 2))]
        (assert (not (is_empty bindings)))
        (pp_bindings bindings e)
        (display NL)
        (display LET_IN)
        (pp_print body e)
        (display LET_END))
      (pp_decr_indentation e)))


  (define (pp_if v e)
    (let [(e (pp_incr_indentation e))]
      (display IF_IF)
      (pp_print (. v 1) e)
      (pp_newline e)
      (display IF_THEN)
      (pp_print (. v 2) e)
      (pp_newline e)
      (display IF_ELSE)
      (pp_print (. v 3) e)
      (pp_newline e)
      (display IF_END)
      (pp_decr_indentation e)))


  (define pp_equals
    (pp_binary "" " = " ""))

  (define pp_not_equals
    (pp_binary "" " \\neq " ""))


  (define (pp_element_of v e)
    (pp_print (. v 1) e)
    (display "\\in ")
    (pp_domain_name (. v 2) e))

  (define (pp_not_element_of v e)
    (pp_print (. v 1) e)
    (display "\\notin ")
    (pp_domain_name (. v 2) e))


  (define pp_ith
    (|v e|
      (let [(arg_exp (. v 2))]
        (when (is_sexp (desyntax arg_exp))
          (raise "cannot combine ith with an S-expression")))
        // \! is negative thin-space
      ((pp_binary "" "\\!\\downarrow_{" "}") v e)))



  (define (pp_lift v e)  // (lift expr d1 d2 ...)  => (lift (lift_to d1 expr) d2 ...)
    (pp_print
      (datum_to_syntax
        (let [(first_lift (sexp (QS lift_to) (. v 2) (. v 1))),
              (more_doms   (tail (tail (tail v))))]
          (if (is_empty more_doms)
            first_lift
            (apply sexp (QS lift) first_lift more_doms)))
        (. v 0))
      e))

  (define (pp_lift_to v e) // v ~= (lift_to DOM EXPR)
    (display "\\mbox{\\it{in}\\small $")
    (pp_domain_name (. v 1) e)
    (display "$}(")
    (pp_print (. v 2) e)
    (display ")"))


  (define (pp_lower v e)    // (lower expr d1 d2 ...)  =>  (lower (lower_to d1 expr) d2 ...)
    (pp_print
      (datum_to_syntax
        (let [(first_lower (sexp (QS lower_to) (. v 2) (. v 1))),
              (more_doms   (tail (tail (tail v))))]
          (if (is_empty more_doms)
            first_lower
            (apply sexp (QS lower) first_lower more_doms)))
        (. v 0))
      e))

  (define (pp_lower_to v e)  // v ~= (lower_to DOM_NAME EXPR)
    (pp_print (. v 2) e)
    (display "\\mid_{\\mbox{\\scriptsize $")
    (pp_domain_name (. v 1) e)
    (display "$}}"))


  (define (pp_seq v e)
    (if (is_multiline_mode e)
      (begin
        (display SEQ_OPEN)
        (let [(e1 (pp_incr_indentation e))]
          (let loop [(vs (tail (tail v)))]
            (when (is_pair vs)
              (pp_print (head vs) e1)
              (when (is_pair (tail vs))
                (display ",")
                (pp_newline e1)
                (loop (tail vs)))))
          (display SEQ_CLOSE)
          (pp_decr_indentation e1)))
      (pp_print_terms (tail (tail v)) e SEQ_OPEN ", " SEQ_CLOSE)))

  (define (pp_seq_prepend v e)
    "Expand (seq_prepend e1 e2) => (seq_append (seq null e1) e2)"
    (pp_print
      (datum_to_syntax
        (sexp (QS seq_append)
          (sexp (QS seq) (quote IgnoredDomainName) (. v 1))
          (. v 2))
        (. v 0))
      e))


  (define (pp_tuple v e)  // (tuple D v1 v2 ...) => (lift_to D (seq D v1 v2 ...))
    (pp_print
      (datum_to_syntax
        (sexp (QS lift_to) (. v 1)
           (apply sexp (QS seq) (. v 1) (tail (tail v))))
        (. v 0))
      e))


  (define (pp_not v e)
    (lets [(arg_stx (. v 1)),
           (arg_dat (syntax_unwrap arg_stx))]
      (if (form_matches (QS element_of) arg_stx)
        (pp_not_element_of arg_dat e)
        (if (or (form_matches (QS   EQ) arg_stx)
                (form_matches (QS U_EQ) arg_stx))
          (pp_not_equals arg_dat e)
          (if (form_matches (QS seq_is_empty) arg_stx)
            ((pp_unary "\\#" "\\neq 0") arg_dat e)
            ((pp_unary "\\lnot " "") v e))))))


  //============================================================================


  (define latexprint
    '''
A model printer that renders in Unicode plain-text.
    '''
    (make_printer                  // Formatting rules in decreasing precedence
      // Base Types
      (type_method is_bool         (|v e| (display (if v TRUE FALSE))))
      (type_method is_symbol       (pp_symbol texify_symbol))
      (type_method is_string       (|v e| (display "\\mbox{\\rm ``{\\tt " (texescape v) "}''}")))

      // Special forms
      (form_method eject           (pp_unary "" ""))
      (form_method element_of      pp_element_of)
      (form_method if              pp_if)
      (form_method IF              pp_if)
      (form_method IF1             pp_if)
      (form_method inject_into     pp_lift_to)
      (form_method ith             pp_ith)
      (form_method lambda          pp_lambda)
      (form_method let             pp_let)
      (form_method letrec          pp_letrec)
      (form_method lift            pp_lift)
      (form_method lift_to         pp_lift_to)
      (form_method lower           pp_lower)
      (form_method lower_to        pp_lower_to)
      (form_method mk_fn           (|s e| (pp_lambda (tail s) e))) // Skip over the domain
      (form_method opt             pp_seq)
      (form_method opt_is_present  (pp_unary "" "\\mbox{\\ooalign{?\\cr\\hss!\\kern .025em\\hss}}"))
      (form_method opt_value       (pp_unary "" "\\mbox{!}"))
      (form_method seq             pp_seq)
      (form_method seq_append      (pp_binary "" "\\S" ""))
      (form_method seq_head        (pp_unary "" "\\!\\downarrow_{0}"))
      (form_method seq_is_empty    (pp_unary "\\#" "=0"))
      (form_method seq_length      (pp_unary "\\#" ""))
      (form_method seq_prepend     pp_seq_prepend)
      (form_method seq_tail        (pp_unary "" "\\dagger1"))
      // TODO seq_truncate
      (form_method tuple           pp_tuple)

      (form_method AND             (pp_nary "" "\\ \\wedge\\ " ""))
      (form_method OR              (pp_nary "" "\\ \\vee\\ "   ""))
      (form_method NOT             pp_not)

      (form_method PLUS            (pp_binary "" " + " ""))
      (form_method MINUS           (pp_binary "" " - " ""))
      (form_method LT              (pp_binary "" " < " ""))
      (form_method LTE             (pp_binary "" " \\le " ""))
      (form_method EQ              pp_equals)
      (form_method U_EQ            pp_equals)
      (form_method GTE             (pp_binary "" " \\ge " ""))
      (form_method GT              (pp_binary "" " > " ""))

      // Rendering hints            // TODO Should be provided by base printer.
      (form_method 'hint:multiline' pp_multiline)
      (form_method 'hint:oneline'   pp_oneline)
      (form_method 'hint:paren'     (pp_unary "(" ")"))

      // Function application. This must follow other forms!
      (type_method is_syntax_pair  pp_fn_call)

      // Semantic Model Elements
      (type_method is_model        pp_model)
      (type_method is_domain       pp_domain_def)
      (type_method is_const        pp_const_def)
      (type_method is_fn           pp_fn_def)
    ))
)

(module testing "/fusion"

  '''
Utilities for testing denotational models.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/private/io"
    "/fusioncontrib/denotation/private/bottom"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/sequence"
    "/fusioncontrib/denotation/private/tuple"
    "/fusioncontrib/denotation/private/union"
  )

  (provide
    check_bottom
    check_not_bottom
    check_eqv
    check_is_seq_of
    check_lower
    is_seq
    is_tuple
    seq_to_list
    seq_to_sexp
    tuple_values
    unwrap
  )

  (define (seq_to_sexp seq)
    "Extract the content of a sequence into a sexp."
    (unless (is_seq seq)
      (raise_argument_error "seq_to_sexp" "seq value" 0 seq))
    (domain_value_rep seq))

  (define (seq_to_list seq)
    "Extract the content of a sequence into a list."
    (unless (is_seq seq)
      (raise_argument_error "seq_to_list" "seq value" 0 seq))
    (apply list (domain_value_rep seq)))


  (define_binary_check (check_eqv expected actual)
    // This appears useless vs (check === expected actual)
    // but it ensures the failure message clearly labels the expected/actual data.
    (=== expected actual))

  (define_check (check_is_seq_of type value)
    (check_pred is_seq value)
    (check_same type (seq_domain_subdomain (domain_value_domain value))))


  (define check_lower
    '''
    (check_lower value domain ...)

Successively lowers the `value` through the `domain`s, in order, returning a
value in the final domain.
A check error is raised if any step fails type-checking.
    '''
    (lambda args
      (let loop [(val  (head args)),
                 (doms (tail args))]
        (if (is_empty doms)
          val
          (let [(dom (head doms))]
            (check_pred is_union_domain_value val)
            (check_same dom (subdomain val))
            (loop (lower_to dom val) (tail doms)))))))


  (define_check (check_bottom message v)
    '''
Check that `v` is a bottom value with the given `message`.
If the `message` ends with `":"` then it is treated as an expected prefix of
`v`'s message.
    '''
    // TODO Accept a Bottom as expected value, comparing messages.
    (check_pred is_bottom v)
    (unless (and (string_ends_with message ":")
                 (string_starts_with (bottom_message v) message))
      (check_eqv message (bottom_message v))))

  (define_check (check_not_bottom v)
    "Check that `v` is not a bottom value."
    (when (is_bottom v)
      (let [(msg (with_output_to_string
                   (display "Unexpected bottom: " (bottom_message v))
                   (for [(f (bottom_stack v))]
                     (displayln)
                     (display "    L" (frame_line f) " C" (frame_column f)))))]
        (fail msg))))
)

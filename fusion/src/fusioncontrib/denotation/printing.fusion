(module display "/fusion"
  '''
Customizable pretty-printing framework for denotational models (and,
potentially, Fusion in general).

The design and implementation draw heavily from Christian Queinnec's `l2t` tool,
formerly known as LiSP2TeX and used to produce the math in his book
_Lisp in Small Pieces_.

References:
* [l2t: literate programming utility][l2t-web]
* [_Literate programming from Scheme to TEX_][l2t-doc]

[lt2-web]: https://christian.queinnec.org/WWW/l2t.html
[l2t-doc]: https://www.researchgate.net/publication/2798097_Literate_programming_from_Scheme_to_TEX

  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/private/record"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/model"
    "/fusioncontrib/denotation/private/sequence"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    domain_method
    fn_args
    fn_code
    fn_name
    form_method
    func_domain_argdomains
    func_domain_output
    is_base_domain
    is_fn
    is_func_domain
    is_product_domain
    is_seq_domain
    is_singleton_domain
    is_union_domain
    make_printer
    model_domains
    model_fns
    pp_basedom
    pp_binary
    pp_display
    pp_nary
    pp_print
    pp_print_terms
    pp_syntax
    pp_ternary
    pp_unary
    pp_write
    product_domain_subdomains
    seq_domain_subdomain
    type_method
    union_domain_subdomains
  )


  (define_values ('record:model_printer' model_printer is_model_printer accessor)
    // Fields are:
    //   0) The invokable procedure
    //   1) The environment
    (make_record_type (quote model_printer) null 2 0))


  // Environment is a sexp of frames, each frame is one of:
  //  * A procedure, takes a value and returns a printer xor falsey.
  //  * ...more to come.
  (define (model_printer_env p) (accessor p 1))


  (define make_printer
    '''
Contruct a customized pretty-printer.

You'll generally need to add methods for is_fn, is_domain_value, etc.
    '''
    (lambda clauses
      (lets [(base (when (is_model_printer (head clauses)) (head clauses))),
             (env  (if base
                     (append (tail clauses) (model_printer_env base))
                     (append clauses
                       (sexp
                         (type_method is_base_domain_value pp_basedom)
                         (type_method is_string            pp_write)
                         (type_method is_symbol            pp_write)
                         // For any syntax forms, unwrap and try again.
                         (type_method is_syntax            pp_syntax)
                         (|v| pp_display)))))]
        (model_printer (|v| (pp_print v env)) env))))


  //============================================================================
  // Printer Customization Clauses

  (define (type_method pred method)
    '''
Configuration clause declaring a printing method for values that match the
predicate `pred`.
    '''
    (assert (is_procedure pred))
    (assert (is_procedure method))
    (|v| (if (pred v) method false)))


  (define (domain_method dom method)
    '''
Configuration clause declaring a printing method for values in the domain `dom`.
    '''
    (assert (is_domain dom))
    (type_method (|v| (domain_is v dom)) method))


  (define_syntax form_method
    '''
    (form_method id method)

Configuration clause declaring a printing method for the procedure or syntax
form with the binding `id`.
    '''
    (lambda (stx)
      (let [(id (syntax_get stx 1)), (method (syntax_get stx 2))]
        (unless (is_identifier id)
          (wrong_syntax id "Expected an identifier"))
        (datum_to_syntax
          (QQ (type_method
                (|v| (and (is_syntax_pair v)
                          (is_identifier (head (syntax_unwrap v)))
                          (free_identifier_equal (QS (UQ id)) (head (syntax_unwrap v)))))
                (|v e| ((UQ method) (syntax_unwrap v) e))))
          (QS context)
          stx))))


  //============================================================================
  // Printing Methods
  // Each takes a value and an environment, and prints to current-output-port

  (define (pp_print v env)
    '''
General-purpose dispatcher for pretty-printing values, for use by customization
clauses.
    '''
    (let find_method [(e env)]
      (if (is_pair e)
        (let [(frame (head e))]
          (if (is_procedure frame)
            (let [(method (frame v))]
              (if method
                (method v env)         // TODO extend env per l2t context-extend
                (find_method (tail e))))
            (find_method (tail e))))
        (raise "can't print it"))))


  (define (pp_display v e)
    // TODO This should eventually allow override of things _inside_ v.
    (display v))


  (define (pp_write v e)
    "Prints a value using `write`."
    (write v))


  (define (pp_syntax v env)
    "Prints a syntax object by unwrapping it and recursing."
    (pp_print (syntax_unwrap v) env))


  (define (pp_print_terms vs env beg mid end)
    (let [(vs (desyntax vs))]
      (unless (is_sequence vs)
        (raise_argument_error "pp_print_terms" "list/sexp" 0 vs end beg mid end))
      (display beg)
      (if (is_sexp vs)
        (let loop [(vs vs)]
          (when (is_pair vs)
            (pp_print (head vs) env)
            (when (is_pair (tail vs))
              (display mid))
              (loop (tail vs))))
        (let loop [(i 0)]
          (when (< i (size vs))
            (unless (=== 0 i) (display mid))
            (pp_print (list_element vs i) env)
            (loop (+ 1 i)))))
      (display end)))


  //============================================================================
  // Printing Method Factories
  // Each creates a printing method.

  (define (pp_unary beg end)
    '''
Generates a print method that prints a unary expression (a sexp with two
elements) by displaying text before and after the single argument expression.
    '''
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display end)))


  (define (pp_binary beg mid end)
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display mid)
           (pp_print (. v 2) e)
           (display end)))


  (define (pp_ternary beg mid1 mid2 end)
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display mid1)
           (pp_print (. v 2) e)
           (display mid2)
           (pp_print (. v 3) e)
           (display end)))

  (define (pp_nary beg mid end)
    (|v e| (pp_print_terms (tail v) e beg mid end)))


  //============================================================================
  // Printing Methods specific to denatational models.

  (define (pp_basedom v e)
    '''
Prints base-domain values by ejecting their representation and printing that.
    '''
    (pp_print (eject v) e))

)

(module display "/fusion"
  '''
Customizable pretty-printing framework for denotational models (and,
potentially, Fusion in general).

The design and implementation draw heavily from Christian Queinnec's `l2t` tool,
formerly known as LiSP2TeX and used to produce the math in his book
_Lisp in Small Pieces_.

References:
* [l2t: literate programming utility][l2t-web]
* [_Literate programming from Scheme to TEX_][l2t-doc]

[lt2-web]: https://christian.queinnec.org/WWW/l2t.html
[l2t-doc]: https://www.researchgate.net/publication/2798097_Literate_programming_from_Scheme_to_TEX

  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/syntax"
    "/fusion/private/record"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/private/constant"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/enum"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/model"
    "/fusioncontrib/denotation/private/sequence"
    "/fusioncontrib/denotation/private/tuple"
    "/fusioncontrib/denotation/private/union"
    "/fusioncontrib/denotation/private/util"
  )

  (provide
    const_code
    const_name
    domain_description
    domain_method
    domain_name
    enum_const_ids
    fn_args
    fn_binding
    fn_code
    fn_method
    fn_name
    form_matches
    form_method
    func_domain_argdomains
    func_domain_output
    'hint:multiline'
    'hint:oneline'
    'hint:paren'
    is_base_domain
    is_const
    is_domain
    is_enum_domain
    is_fn
    is_func_domain
    is_model
    is_multiline_mode
    is_oneline_mode
    is_product_domain
    is_seq_domain
    is_union_domain
    make_printer
    model_consts
    model_domains
    model_fns
    pp_basedom
    pp_binary
    pp_display
    pp_multiline
    pp_nary
    pp_oneline
    pp_print
    pp_print_terms
    pp_symbol
    pp_syntax
    pp_ternary
    pp_unary
    pp_write
    product_domain_subdomains
    seq_domain_subdomain
    sym_image
    type_method
    union_domain_subdomains
  )


  (define_values ('record:model_printer' model_printer is_model_printer accessor)
    // Fields are:
    //   0) The invokable procedure
    //   1) The environment
    (make_record_type (quote model_printer) null 2 0))


  // Environment is a sexp of frames, each frame is one of:
  //  * A procedure, takes a value and returns a print method xor falsey.
  //  * A `oneline` record, avoiding line breaks for some span of code.
  //  * A `symimage` record, mapping one or more identifiers to a printed image.
  (define (model_printer_env p) (accessor p 1))


  //============================================================================
  // One-Line Mode and Multi-Line Mode

  (record 'frame:oneline' ())
  (record 'frame:multiline' ())


  (define (is_oneline_mode e)
    (and (is_pair e)
          (or ('is_frame:oneline' (head e))
              // A multi-line frame overrides any previous one-line frame.
              (and (not ('is_frame:multiline' (head e)))
                   (is_oneline_mode (tail e))))))

  (define ('hint:oneline' v)
    '''
Does nothing; returns the given value.

When encountered by the pretty-printer, the argument code is printed in
one-line mode.  This overrides any extant multi-line mode.
    '''
    v)

  (define (pp_oneline v e)
    (pp_print (. v 1) (pair ('frame:oneline') e)))



  (define (is_multiline_mode e)
    (and (is_pair e)
          (or ('is_frame:multiline' (head e))
              // A one-line frame overrides any previous multiline frame.
              (and (not ('is_frame:oneline' (head e)))
                   (is_multiline_mode (tail e))))))

  (define ('hint:multiline' v)
    '''
Does nothing; returns the given value.

When encountered by the pretty-printer, the argument code is printed in
multi-line mode.  This overrides any extant one-line mode.
    '''
    v)

  (define (pp_multiline v e)
    (pp_print (. v 1) (pair ('frame:multiline') e)))


  //============================================================================
  // Forcing parentheses

  (define ('hint:paren' v)
    '''
Does nothing; returns the given value.

When encountered by the pretty-printer, the argument code is printed within
parentheses.
    '''
    v)


  //============================================================================
  // Symbol images

  (record symimage (image vars))

  (define (symimage_handles frame var)
    (let loop [(vars (symimage_vars frame))]
      (and (is_pair vars)
           (or (=== var (head vars))
               (loop (tail vars))))))


  (define make_printer
    '''
Contruct a customized pretty-printer.

You'll generally need to add methods for is_fn, is_domain_value, etc.

Sequences in the arguments are flattened recursively.
    '''
    (lambda clauses
      (lets [(base (when (is_model_printer (head clauses)) (head clauses))),
             (env  (if base
                     (append (flatten_to_sexp (tail clauses)) (model_printer_env base))
                     (append (flatten_to_sexp clauses)
                       (sexp
                         // Would like to have this here, but this is overridden
                         // by sub-printer config for syntax-sexp (fn application).
//                       (form_method 'hint:oneline'       pp_oneline)

                         (type_method is_base_domain_value pp_basedom)
                         (type_method is_string            pp_write)
                         (type_method is_symbol            pp_write)
                         // For any syntax forms, unwrap and try again.
                         (type_method is_syntax            pp_syntax)
                         (|v| pp_display)))))]
        (model_printer (|v| (pp_print v env)) env))))


  //============================================================================
  // Printer Customization Clauses

  (define (type_method pred method)
    '''
Configuration clause declaring a printing method for values that match the
predicate `pred`.
    '''
    (assert (is_procedure pred))
    (assert (is_procedure method))
    (|v| (if (pred v) method false)))


  (define (domain_method dom method)
    '''
Configuration clause declaring a printing method for values in the domain `dom`.
    '''
    (assert (is_domain dom))
    (type_method (|v| (domain_is v dom)) method))


  (define (fn_method fn method)
    '''
Configuration clause declaring a printing method for a specific function
definition.
    '''
    (assert (is_fn fn))
    (type_method (|v| (ident v fn)) method))


  (define (form_matches id v)
    (unless (is_identifier id)
      (raise_argument_error "mk_form_matcher" "identifier" 0 id v))
    (and (is_syntax_pair v)
         (is_identifier (head (syntax_unwrap v)))
         (free_identifier_equal id (head (syntax_unwrap v)))))

  (define_syntax form_method
    '''
    (form_method id method)

Configuration clause declaring a printing method for uses of the procedure or
syntax form with the binding `id`.
    '''
    (lambda (stx)
      (let [(id (syntax_get stx 1)), (method (syntax_get stx 2))]
        (unless (is_identifier id)
          (wrong_syntax id "Expected an identifier"))
        (datum_to_syntax
          (QQ (type_method
                (|v| (form_matches (QS (UQ id)) v))
                (|v e| ((UQ method) (syntax_unwrap v) e))))
          (QS context)
          stx))))


  (define_syntax sym_image
    '''
    (sym_image string id ...+)

Configuration clause declaring that the given `id`s are to be printed using the
`string`.  These clauses are effectively directives to `pp_symbol`, bypassing
its normal escaping.
    '''
    (lambda (stx)
      (let [(image (syntax_get stx 1)),
            (ids   (tail (tail (syntax_unwrap stx))))]
        (unless (is_string (syntax_unwrap image))
          (wrong_syntax image "Expected a string"))
        // TODO (is_sexp_of_ids ids)
        (datum_to_syntax
          (QQ (symimage (UQ image) (quote (UQ ids))))
          (QS context)
          stx))))


  //============================================================================
  // Printing Methods
  // Each takes a value and an environment, and prints to current-output-port

  (define (pp_print v env)
    '''
General-purpose dispatcher for pretty-printing values, for use by customization
clauses.
    '''
    (let find_method [(e env)]
      (if (is_pair e)
        (let [(frame (head e))]
          (if (is_procedure frame)
            (let [(method (frame v))]
              (if method
                (method v env)         // TODO extend env per l2t context-extend
                (find_method (tail e))))
            (find_method (tail e))))
        (raise "can't print it"))))


  (define (pp_display v e)
    // TODO This should eventually allow override of things _inside_ v.
    (display v))


  (define (pp_write v e)
    "Prints a value using `write`."
    (write v))


  (define (pp_symbol escaper)
    '''
Produces a print method for symbols that uses the given `escaper` to prepare
proprocess the symbol's text.  The `escaper` must accept a symbol and return a
string whose content is printed as-is.

To customize the rendering of specific symbols, configure the printer with
`sym_image` clauses.  Such images are printed directly, bypassing the escaper.
    '''
    (|v e|
      (assert (is_symbol v) "Not a symbol: " v)
      (letrec [(find_image (|e| (if (is_pair e)
                                  (let [(frame (head e))]
                                    (if (and (is_symimage frame)
                                             (symimage_handles frame v))
                                      (symimage_image frame)
                                      (find_image (tail e))))
                                  (escaper v))))]
        (let [(image (find_image e))]
          (display image)))))


  (define (pp_syntax v env)
    "Prints a syntax object by unwrapping it and recursing."
    (pp_print (syntax_unwrap v) env))


  (define (pp_print_terms vs env beg mid end)
    (let [(vs (desyntax vs))]
      (unless (is_sequence vs)
        (raise_argument_error "pp_print_terms" "list/sexp" 0 vs end beg mid end))
      (display beg)
      (if (is_sexp vs)
        (let loop [(vs vs)]
          (when (is_pair vs)
            (pp_print (head vs) env)
            (when (is_pair (tail vs))
              (display mid))
              (loop (tail vs))))
        (let loop [(i 0)]
          (when (< i (size vs))
            (unless (=== 0 i) (display mid))
            (pp_print (list_element vs i) env)
            (loop (+ 1 i)))))
      (display end)))


  //============================================================================
  // Printing Method Factories
  // Each creates a printing method.

  (define (pp_unary beg end)
    '''
Generates a print method that prints a unary expression (a sexp with two
elements) by displaying text before and after the single argument expression.
    '''
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display end)))


  (define (pp_binary beg mid end)
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display mid)
           (pp_print (. v 2) e)
           (display end)))


  (define (pp_ternary beg mid1 mid2 end)
    (|v e| (display beg)
           (pp_print (. v 1) e)
           (display mid1)
           (pp_print (. v 2) e)
           (display mid2)
           (pp_print (. v 3) e)
           (display end)))

  (define (pp_nary beg mid end)
    (|v e| (pp_print_terms (tail v) e beg mid end)))


  //============================================================================
  // Printing Methods specific to denatational models.

  (define (pp_basedom v e)
    '''
Prints base-domain values by ejecting their representation and printing that.
    '''
    (pp_print (eject v) e))

)

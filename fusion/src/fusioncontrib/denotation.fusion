(module densem "/fusion"
  '''
Tools for writing and testing denotational semantic models.

A model consists of a set of definitions of domains, functions, and denoters.
Each such element has a name to which a Fusion value is bound.


_Domains_ denote sets of values in the model space.

_Domain values_ denote individual values in a specific domain.

_Functions_ are higher-level domains that operate over domain values.

_Donaters_ are special functions expressed as a set of cases that together
cover a full domain.


Domains come in several types:
  * _Base domains_ are the primitives of the model space.
    Base domain values wrap Fusion values that match a given predicate, lifting
    them into the model.
  * _Union domains_ model tagged unions of other domains.
    They are "tagged" in the sense that elements of a subdomain must be
    explicitly lifted into the union, and lowered back out of the union.
  * _Product domains_ model ordered tuples of values.
  * _Sequence domains_ model sequences of zero or more values from a given
    domain.  Sequence domains cannot be defined directly, they are defined
    automatically for each domain.

  '''
  (require
    "/fusion/exception"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/model"
    "/fusioncontrib/denotation/private/sequence"
  )

  (provide
    // The model DSL
    define_model
    is_model
    dom
    fn

    // Core domain operators
    is_domain
    domain_description
    domain_name
    domain_is
    domain_of
    element_of

    // Singleton domains
    singleton

    // Base domain value operators
    inject_into
    eject

    // Union domain value operators
    lift
    lift_to
    subdomain
    lower
    lower_to

    // Product domains
    tuple
    product_domain_element

    // Sequence domain values
    ith
    seq
    seq_append
    seq_head
    seq_is_empty
    seq_length
    seq_prepend
    seq_tail
    seq_truncate

    // Function domains
    define_fn
    mk_fn
    is_fn
  )


  // Functions that are polymorphic over multiple domain types

  (define (ith v i)
    "Extract the `i`th element from `v`, which must be a tuple or seq value."
    (if (is_tuple v)
      (tuple_ith v i)
      (if (is_seq v)
        (seq_ith v i)
        (raise_argument_error "ith" "tuple or seq value" 0 v i))))
)

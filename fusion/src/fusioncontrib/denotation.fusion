(module densem "/fusion"
  '''
Tools for writing and testing denotational semantic models.

A model consists of a set of definitions of domains, functions, and denoters.
Each such element has a name to which a Fusion value is bound.


_Domains_ denote sets of values in the model space.

_Domain values_ denote individual values in a specific domain.

_Functions_ are higher-level domains that operate over domain values.

_Donaters_ are special functions expressed as a set of cases that together
cover a full domain.


Domains come in several types:
  * _Base domains_ are the primitives of the model space.
    Base domain values wrap Fusion values that match a given predicate, lifting
    them into the model.
  * _Union domains_ model tagged unions of other domains.
    They are "tagged" in the sense that elements of a subdomain must be
    explicitly lifted into the union, and lowered back out of the union.
  * _Tuple domains_ model ordered tuples of values.
  * _Sequence domains_ model sequences of zero or more values from a given
    domain.  Sequence domains cannot be defined directly, they are defined
    automatically for each domain.

  '''
  (require
    "/fusion/exception"
    "/fusioncontrib/denotation/private/base"
    "/fusioncontrib/denotation/private/bind"
    "/fusioncontrib/denotation/private/bottom"
    "/fusioncontrib/denotation/private/domain"
    "/fusioncontrib/denotation/private/enum"
    "/fusioncontrib/denotation/private/function"
    "/fusioncontrib/denotation/private/model"
    "/fusioncontrib/denotation/private/boolean"
    "/fusioncontrib/denotation/private/integer"
    "/fusioncontrib/denotation/private/optional"
    "/fusioncontrib/denotation/private/sequence"
    "/fusioncontrib/denotation/private/tuple"
    "/fusioncontrib/denotation/private/unicode"
    "/fusioncontrib/denotation/private/union"
  )

  (provide
    // The model DSL
    define_model
    is_model
    dom
    fn
    import

    // Core domain operators
    is_domain
    domain_description
    domain_name
    domain_is
    domain_of
    element_of

    // Base domain value operators
    inject_into
    eject

    // Union domain value operators
    lift
    lift_to
    subdomain
    lower
    lower_to

    // Tuple domains
    tuple

    // Optional domain values
    opt
    opt_is_present
    opt_value

    // Sequence domain values
    ith
    seq
    seq_append
    seq_head
    seq_is_empty
    seq_length
    seq_prepend
    seq_tail
    seq_truncate

    // Function domains
    define_fn
    mk_fn
    is_fn

    // Pre-defined domains and functions
    AND
    APPLY
    B 'B?' 'B*'
    bottom_message
    EQ
    F 'F?' 'F*'
    GT
    GTE
    I 'I?' 'I*'
    IF
    IF1
    is_bottom
    LET
    LETREC
    LT
    LTE
    MAP
    MINUS
    NOT
    OR
    PLUS
    Unicode 'Unicode?' 'Unicode*'
    Unicode_append
    wrong
  )


  (define_opt_domain 'B?'       "Optional B"                  B)
  (define_seq_domain 'B*'       "Sequence of B"               B)
  (define_opt_domain 'I?'       "Optional I"                  I)
  (define_seq_domain 'I*'       "Sequence of I"               I)
  (define_opt_domain 'F?'       "Optional F"                  F)
  (define_seq_domain 'F*'       "Sequence of F"               F)
  (define_opt_domain 'Unicode?' "Optional Unicode string"     Unicode)
  (define_seq_domain 'Unicode*' "Sequence of Unicode strings" Unicode)

  (define_strict (APPLY fn seq)
    (apply fn (domain_value_rep seq)))

  (define_strict (MAP domain fn s)
    // FIXME use of domain_value_rep is bad coupling
    (assert (is_seq_domain domain) domain)
    (let [(r (map fn (domain_value_rep s)))]
      (apply seq domain r)))

  // Functions that are polymorphic over multiple domain types

  (define (element_of v domain)  // i.e., ∈
    "Determine whether `v` is in `domain` or can be lowered to it."
    (unless (is_domain domain)
      (raise_argument_error "element_of" "domain" 1 v domain))
    (let [(domain_eltof (domain_meta_eltof_fn (domain_type domain)))]
      (if domain_eltof
        (domain_eltof domain v)
        (and (is_domain_value v)
             (or (ident domain (domain_value_domain v))
                 (and (is_union_domain_value v)
                      (element_of (unwrap v) domain)))))))


  (define_strict (ith v i)
    "Extract the `i`th element from `v`, which must be a tuple or seq value."
    (if (is_tuple v)
      (tuple_ith v i)
      (if (is_seq v)
        (seq_ith v i)
        (raise_argument_error "ith" "tuple or seq value" 0 v i))))

  (define (intish v)
    (or (is_int v) (domain_is v I)))

  (define (unicodeish v)
    (or (is_string v) (domain_is v Unicode)))

  (define_strict (EQ v1 v2)
    (cond
      ((and (intish        v1) (intish        v2))     (EQ_I       v1 v2))
      ((and (unicodeish    v1) (unicodeish    v2))     (EQ_Unicode v1 v2))
      ((and (is_enum_value v1) (is_enum_value v2))     (EQ_Enum    v1 v2))
      (true (raise_argument_error EQ "comparable values" -1 v1 v2))))

)

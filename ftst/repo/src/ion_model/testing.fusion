(module ion_testing "/fusion"

  '''
Utilities for testing the Ion denotational model.
  '''

  (require
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/ion_model/testing/evaluate"
  )

  (provide
    expand1
    quote_top
  )


  //============================================================================
  // Parsing and Expanding Inputs

  (define_syntax quote_top
    (lambda (stx)
      (datum_to_syntax
        (quasiquote (quote (unquote (tail (syntax_unwrap stx)))))
        (quote_syntax context)
        stx)))

  // FIXME should be evaluate1
  (define (expand1 input)
    (ith (evaluate input) 0))

)

(module ion_testing "/fusion"

  '''
Utilities for testing the Ion denotational model.


Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * On input, `'#$ion_d_d'` represents an IVM.
  * On input, S-expressions starting with a symbol with prefix `'#$:'` denote
    an E-expression.  The text starting with : is parsed as a macro reference.
  * On output, `'#$name#ddd'` represents absent symbol at index `ddd` of SST `name`.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/experimental/string"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/testing"
    "/fusioncontrib/denotation/private/util"
    "/ion_model/model"
  )

  (provide (all_defined_out))


  //============================================================================
  // Creating abstract syntax trees

  // IVMs

  (define (is_IVM c)
    (and c (is_symbol c) (string_starts_with (symbol_to_string c) "#$ion_")))

  (define (mk_IVM c)
    (lets [(parts (string_split (symbol_to_string c) "_")),
           (major (string_to_int (. parts 1))),
           (minor (string_to_int (. parts 2)))]
      (tuple IVM major minor)))


  // Simple types

  (define (mk_NullNull c)
    (lift DOTNULL NullNull))

  (define (mk_Bool c)
    (lift_to Bool
      (if (is_null c) DOTNULL
        (inject_into B c))))

  (define (mk_Int c)
    (lift_to Int
      (if (is_null c) DOTNULL
        (inject_into I c))))

  (define (mk_String c)
    (lift_to String
      (if (is_null c) DOTNULL
        (inject_into Unicode c))))


  // Symbols

  (define (mk_SSymTok c)
    (lift_to SSymTok
      (if (is_int c)
        (inject_into I c)
        (let [(str (symbol_to_string c))]
          (if (string_starts_with str "#$")
            // If the content following #$ isn't an integer, this raises an error.
            // This is important to prevent the prefix from "leaking through".
            (inject_into I (string_to_int (string_replace str "#$" "")))
            (inject_into Unicode str))))))

  (define (mk_SSymbol c)
    (lift_to SSymbol
      (if (is_null c) DOTNULL
        (mk_SSymTok c))))


  // Containers

  (define (mk_SList c)
    (lift_to SList
      (if (is_null c) DOTNULL
        (apply seq 'STree*' (map mk_STree c)))))

  (define (mk_SSexp c)
    (lift_to SSexp
      (if (is_null c) DOTNULL
        (apply seq 'STree*' (map mk_STree c)))))

  (define (mk_SStruct c)
    (lift_to SStruct
      (if (is_null c) DOTNULL
        (apply seq 'SField*'
          (for_list [((k v) c)]
            (tuple SField (mk_SSymTok k) (mk_STree v)))))))


  // E-expressions

  (define (is_eexp c)
    (and (is_sexp c)
         (is_symbol (head c))
         (string_starts_with (symbol_to_string (head c)) "#$:")))

  (define (mk_MacroRef c)
    (assert (string_starts_with (symbol_to_string c) "#$:") "Not a macro-ref: " c)
    (lets [(chars (string_explode (symbol_to_string c))),
           // Drop the "#$" prefix
           (sym   (string_implode (subseq chars 2 (size chars)))),
           (ref   (parseMacroRef sym))]
      (when (is_bottom ref)
        // TODO: Improve message when triggered from the conformance DSL.
        (raise_argument_error "mk_MacroRef" "well-formed macro-ref" 0 c))
      ref))

  (define (mk_SEexp c)
    (let [(ref (mk_MacroRef (head c)))]
      (tuple SEexp ref (apply seq 'STree*' (map mk_STree (tail c))))))


  // Values

  (define (mk_SValue c)
    (tuple SValue
      (apply seq 'SSymTok*' (map mk_SSymTok (annotations c)))
      (lift_to SContent
        (let [(c (annotate c))]  // Remove any annotations
          (cond
            ((is_symbol    c) (mk_SSymbol  c))
            ((is_list      c) (mk_SList    c))
            ((is_sexp      c) (mk_SSexp    c))
            ((is_struct    c) (mk_SStruct  c))
            ((is_null_null c) (mk_NullNull c))
            ((is_bool      c) (mk_Bool     c))
            ((is_int       c) (mk_Int      c))
            ((is_string    c) (mk_String   c))
            (true (raise_argument_error "mk_SValue" "symbol/bool/int/string/list" 0 c)))))))

  (define (mk_STree c)
    (lift_to STree
      (if (is_eexp c)
        (mk_SEexp c)
        (mk_SValue c))))

  (define (mk_TSTree c)
    (lift_to TSTree
      (if (is_IVM c)
        (mk_IVM c)
        (mk_STree c))))


  //============================================================================
  // Ejecting output domain values to produce Fusion data

  // Safe types

  (define (eject_NullNull v)
    (assert (element_of v DotNull))
    null.null)

  (define (eject_Bool v)
    (if (element_of v DotNull)
      null.bool
      (eject (unwrap v))))

  (define (eject_Int v)
    (if (element_of v DotNull)
      null.int
      (eject (unwrap v))))

  (define (eject_String v)
    (if (element_of v DotNull)
      null.string
      (eject (unwrap v))))


  // Symbols

  (define (eject_SymTok sym)
    (if (element_of sym Unicode)
      (string_to_symbol (eject (check_lower sym Unicode)))
      (if (element_of sym AbsentSym)
        (let [(a (lower sym AbsentSym))]
          (symbol_append "#$" (eject (AbsentSym_module a))
                         "#" (int_to_string (eject (AbsentSym_index a)))))
        (quote '#$0'))))

  (define (eject_SymToks syms)
    (assert (domain_is syms 'SymTok*'))
    (map eject_SymTok (seq_to_sexp syms)))

  (define (eject_Symbol v)
    (if (element_of v DotNull)
      (quote null.symbol)
      (eject_SymTok (unwrap v))))


  // Containers

  (define (eject_List v)
    (if (element_of v DotNull)
      null.list
      (apply list (eject_Values (unwrap v)))))

  (define (eject_Sexp v)
    (if (element_of v DotNull)
      (quote null.sexp)
      (apply sexp (eject_Values (unwrap v)))))

  (define (eject_Struct v)
    (if (element_of v DotNull)
      null.struct
      (for_struct [(f (seq_to_sexp (unwrap v)))]
        (values (eject_SymTok (Field_name  f))
                (eject_Value    (Field_value f))))))


  // Values

  (define (eject_Content v)
    (let [(ejector (cond
                     ((element_of v Symbol  ) eject_Symbol  )
                     ((element_of v List    ) eject_List    )
                     ((element_of v Sexp    ) eject_Sexp    )
                     ((element_of v Struct  ) eject_Struct  )
                     ((element_of v NullNull) eject_NullNull)
                     ((element_of v Bool    ) eject_Bool    )
                     ((element_of v Int     ) eject_Int     )
                     ((element_of v String  ) eject_String  )
                     (true (raise (subdomain v)))))]
      (ejector (unwrap v))))

  (define (eject_Value value)
    (let_values [((annots content) (tuple_values value))]
      // `annotate` replaces any existing annotations on the content.
      (apply annotate (eject_Content content) (eject_SymToks annots))))

  (define (eject_Values values)
    (unless (element_of values 'Value*')
      (raise_argument_error eject_Values "Value*" 0 values))
    (map eject_Value (seq_to_sexp values)))


  //============================================================================
  // Parsing and Expanding Inputs

  (define_syntax quote_top
    (lambda (stx)
      (datum_to_syntax
        (quasiquote (quote (unquote (tail (syntax_unwrap stx)))))
        (quote_syntax context)
        stx)))

  (define_syntax quote11
    (lambda (stx)
      (datum_to_syntax
        (quasiquote (quote (unquote (pair (quote '#$ion_1_1')
                                          (tail (syntax_unwrap stx))))))
        (quote_syntax context)
        stx)))


  (define (mk_stream tlvs)
    (mk_fn ParseStream (parse_env)
      (if (is_empty tlvs)
        (opt 'ParseStep?')
        (opt 'ParseStep?'
          (tuple ParseStep (mk_TSTree (head tlvs))
                           (mk_stream (tail tlvs)))))))

  (define parser
    (mk_fn Parser (doc)         // Document -> ParseStream
      (mk_stream (eject doc))))

  (define evaluator
    (mk_Evaluator parser))


  (define (evaluate input catalog)
    (evaluator (inject_into Document input) catalog))

  // FIXME should be evaluate_doc
  (define (expand_doc input)
    "Parse top-level inputs (contained in a sequence) into `TRValue*` then expand it."
    (evaluate input testing_catalog))

  // FIXME should be evaluate1
  (define (expand1 input)
    (ith (expand_doc input) 0))


  //============================================================================
  // Catalogs

  (define EMPTY_CATALOG
    (tuple Catalog (seq 'SharedModule*')))

  (define catalog_data
    (quote_top
      $ion_shared_symbol_table::{
        name:"empty", version:1, symbols:[]
      }
      $ion_shared_symbol_table::{
        name:"abcs", version:1, symbols:["a"]
      }
      $ion_shared_symbol_table::{
        name:"abcs", version:2, symbols:["a", "b"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:1, symbols:["m"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:3, symbols:["m", "n", "o"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:4, symbols:[absent, "n", "o", "p"]  // Gap used to detect v4
      }
    ))

  (define testing_catalog
    (for_fold [(c EMPTY_CATALOG)]
      [(sst (seq_to_sexp (evaluate catalog_data EMPTY_CATALOG)))]
      (Catalog_extend c
        (compile_SST (lower_to Struct (Value_content sst))))))


  //============================================================================
  // Test assertions

  (define_check (check_eval_success doc)
    (check_not_bottom (expand_doc doc)))

  (define_check (check_eval_fail bottom_msg doc)
    (check_bottom bottom_msg (expand_doc doc)))


  (define_check (check_Value expected value)
    (check_eqv expected (eject_Value value)))

  (define_check (check_Values expected values)
    (check_eqv expected (eject_Values values)))

  (define_check (check_expansion expected input)
    (let [(actual (expand_doc input))]
      (check_not_bottom actual)
      (check_Values expected actual)))

  (define_check (check_expansion_and_bounds max_sid expected input)
    (check_expansion expected input)
    // Ensure the given max_sid is valid
    (check_eval_success
      (append input (sexp (symbol_append "#$" (int_to_string max_sid)))))
    // Ensure the next sid is invalid
    (check_eval_fail
      (display_to_string "Invalid symbol address " (+ 1 max_sid))
      (append input (sexp (symbol_append "#$" (int_to_string (+ 1 max_sid)))))))


  //============================================================================
  // Streamlined macro testing

  // Might be nice if the various bits of data could use `unquote`.

  (provide with_mactab document produces signals)

  (define (gen_cases directive cases)
    "Returns sexp of syntax-able objects"
    (if (is_empty cases) (sexp)
      (let [(content (head cases)),
            (expect_stx  (head (tail cases)))]
        (pair (gen_doc_case directive content (gen_checker expect_stx))
              (gen_cases directive (tail (tail cases)))))))

  (define (gen_doc_case directive content_stx checker_stx)
    (if (free_identifier_equal (head (syntax_unwrap content_stx)) (QS document))
      (let [(doc (pair (quote '#$ion_1_1') (pair directive (tail (syntax_unwrap content_stx)))))]
        (datum_to_syntax
          // This code ensures the context_stx location is in the stack when
          // the checker fails.
          (QQ (lets [(actual (expand_doc (quote (UQ doc)))),
                     (check  ((UQ checker_stx) actual))]
                check))
          (QS context)
          content_stx))
      (wrong_syntax content_stx "Only `document` is supported")))

  (define (gen_checker expectation_stx)
    // Produces (code for) a function that accepts the results of evaluation.
    (if (free_identifier_equal (head (syntax_unwrap expectation_stx)) (QS produces))
      (datum_to_syntax
        (QQ (lambda (actual)
              (check_not_bottom actual)
              (check_eqv (quote (UQ (syntax_subseq expectation_stx 1))) (eject_Values actual))))
        (QS context)
        expectation_stx)
    (if (free_identifier_equal (head (syntax_unwrap expectation_stx)) (QS signals))
      (datum_to_syntax
        (QQ (lambda (actual)
              (check_bottom (UQ (element (syntax_unwrap expectation_stx) 1)) actual)))
        (QS context)
        expectation_stx)
      (wrong_syntax expectation_stx "Unrecognized clause"))))

  (define_syntax document
    (lambda (stx)
      (wrong_syntax stx "Must be inside `with_mactab`")))
  (define_syntax produces
    (lambda (stx)
      (wrong_syntax stx "Must be inside `with_mactab`")))
  (define_syntax signals
    (lambda (stx)
      (wrong_syntax stx "Must be inside `with_mactab`")))

  (define_syntax with_encoding
    (lambda (stx)
      (lets [(enc (syntax_get stx 1)),
             (cases (tail (tail (syntax_unwrap stx)))),
             (directive (annotate (syntax_unwrap enc) "$ion_encoding"))]
        (datum_to_syntax
          (pair (QS begin) (gen_cases directive (if (is_empty cases)
                                                  (sexp (QS (document)) (QS (produces)))
                                                  cases)))
          (QS context)
          stx))))

  (define_syntax with_mactab
    (lambda (stx)
      (lets [(macros (syntax_get stx 1)),
             (cases (tail (tail (syntax_unwrap stx)))),
             (mactab (pair (quote macro_table) macros)),
             (enc  (QQ ((module M (UQ mactab)) (macro_table M))))]
        (datum_to_syntax
          (pair (QS with_encoding) (pair enc cases))
          (QS context)
          stx))))

)

(module ion_testing_dsl "/fusion"

  '''
A DSL for testing the Ion denotational model.

Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * On input, `'#$ion_d_d'` represents an IVM.
  * On input, S-expressions starting with a symbol with prefix `'#$:'` denote
    an E-expression.  The text starting with : is parsed as a macro reference.
  * On output, `'#$name#ddd'` represents absent symbol at index `ddd` of SST `name`.


Here's the grammar for the DSL:

    <test> := (in10 <body>) | (in11 <body>)

    <body> := <content>* <fork>

    <fork> := <expectation> | <extension>+

    <extension> := (then <content>+ <fork>)
                 | (each <content>+ <fork>)

    <content> := (toplevel ___)
               | (ivm <version>)
               | (encoding ___)
               | (mactab   ___)
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/testing"
    "/fusioncontrib/denotation/private/util"
    "/ion_model/model"

    (only_in "/fusion/private/io"
      with_output_to_string
    )
    (only_in "/ion_model/testing"
      eject_Values
      expand_doc
    )
  )

  (provide
    in11
  )


  '''
TODOs
-----
  * Might be nice if the various bits of data could use `unquote`.
  * Fanout at encoding/mactab/document level

Nesting the expectation-clause inside the content clause is structurally clear,
but the extra delimeter in `document` may be annoying.
Plus we should also have one in `produces` for consistency.

Could also be nice to allow nesting of encoding/mactab/document for hierarchical
fanout.  Extension of encoding directives.

- encoding
  - module
    - mactab
      - segment
        - expectation
      - segment
        - expectation

Expectation clause can appear at any level, to test the preceding document.
  * Is there any reason to allow continuing with more content and expectation?
    * Yes: to show that a successful doc produces content, but adding an error
      causes a signals failure.
  '''


  (define (is_clause stx)
    (and (is_pair (syntax_unwrap stx))
         (is_identifier (syntax_get stx 0))))

  (define (clause_keyword clause_stx)
    (syntax_unwrap (syntax_get clause_stx 0)))

  (define (clause_args clause_stx)
    (tail (syntax_unwrap clause_stx)))

  (define (is_keyword_clause stx kw)
    (and (is_clause stx)
         (=== (clause_keyword stx) kw)))


  (define dispatch
    '''
    (dispatch vtable clause args ...)

Finds a function in the vtable for the clause, the applies it to the clause and args.
    '''
    (lambda rest
      (unless (<= 2 (size rest))
        (apply raise_arity_error dispatch 2 rest))
      (let [(vtable (. rest 0)),
            (clause (. rest 1))]
        (apply (. vtable (clause_keyword clause)) (tail rest)))))

  (define (can_dispatch vtable clause)
    (and (is_clause clause)
         (is_truthy (. vtable (clause_keyword clause)))))


  //============================================================================
  // Expectations are implemented by functions accepting ejected evaluation
  // results ie 'Value*'

  (define (interp_produces clause_stx doc Values)
    // TODO arity and typecheck
    (let [(expected_data (syntax_to_datum (syntax_subseq clause_stx 1)))]
      (when (is_bottom Values)
        (raise_contract_error (quote produces)
          (with_output_to_string
            (displayln "Failure at L" (syntax_line clause_stx) ":" (syntax_column clause_stx))
            (displayln "Unexpected bottom.")
            (display "Document: ")
            (writeln doc)
            (display "Expected: ")
            (writeln expected_data)
            (display "Message:  ")
            (displayln (bottom_message Values)))))
      (let [(actual_data (eject_Values Values))]
        (unless (=== expected_data actual_data)
          (raise_contract_error (quote produces)
            (with_output_to_string
              (displayln "Failure at L" (syntax_line clause_stx) ":" (syntax_column clause_stx))
              (displayln "Document didn't produce expected output.")
              (display "Document: ")
              (writeln doc)
              (display "Expanded: ")
              (writeln actual_data)
              (display "Expected: ")
              (writeln expected_data)))))))

  (define (interp_signals clause_stx doc Values)
    // TODO arity and typecheck
    (let [(msg (syntax_unwrap (syntax_get clause_stx 1)))]
      (check_bottom msg Values)))


  (define expectation_vtable
    { produces: interp_produces,
      signals:  interp_signals,
    })

  (define (is_expectation_clause stx)
    (can_dispatch expectation_vtable stx))

  (define (interp_expectation clause_stx docs)
    (unless (is_expectation_clause clause_stx)
      (wrong_syntax clause_stx "Not an expectation"))
    (for [(doc docs)]
      (let [(Values (expand_doc doc))]
        (dispatch expectation_vtable clause_stx doc Values))))


  //============================================================================
  // Content producers are no-argument functions that return a sequence of top-level
  // elements to be added to each in-progress document.

  (define (interp_toplevel clause_stx args)
    args)

  (define (interp_encoding clause_stx args)
    [(annotate args (Q $ion_encoding))])

  (define (interp_mactab clause_stx macros)
    (lets [(mactab   (pair (quote macro_table) macros)),
           (encoding (QQ ((module M (UQ mactab)) (macro_table M))))]
      (interp_encoding clause_stx encoding)))


  (define content_vtable
    { toplevel: interp_toplevel,
      encoding: interp_encoding,
      mactab:   interp_mactab,
    })

  (define (is_content_clause stx)
    (can_dispatch content_vtable stx))

  (define (interp_content stx docs)
    (unless (is_content_clause stx)
      (wrong_syntax stx "Expected content expression"))
    (map (|d| (append d (dispatch content_vtable stx (tail (syntax_to_datum stx))))) docs))


  //============================================================================
  // Extensions are functions that take a list of in-progress documents,
  // extend them, eventually checking expectations.

  (define (interp_then clause_stx docs)
    // TODO length check; ensure at least one content clause?
    (interp_body clause_stx (clause_args clause_stx) docs))

  // FIXME this is nowhere near correct
  (define (interp_each clause_stx docs)
    // TODO length check; ensure at least one content clause?
    (interp_body clause_stx (clause_args clause_stx) docs))


  (define extension_vtable
    { then: interp_then,
      each: interp_each,
    })

  (define (is_extension_clause stx)
    (can_dispatch extension_vtable stx))

  (define (interp_extension clause_stx docs)
    (unless (is_extension_clause clause_stx)
      (wrong_syntax clause_stx "Expected a document extension"))
    (dispatch extension_vtable clause_stx docs))


  (define (interp_body containing_stx clauses docs)
    (when (is_empty clauses)
      (wrong_syntax containing_stx "Expected at least one body clause"))
    (if (is_content_clause (head clauses))
      (interp_body containing_stx (tail clauses) (interp_content (head clauses) docs))
      (if (is_expectation_clause (head clauses))
        (if (is_empty (tail clauses))
          (interp_expectation (head clauses) docs)
          (wrong_syntax (. clauses 1) "Extraneous forms after an expectation clause"))
        (do (|c| (interp_extension c docs)) clauses))))


  //============================================================================
  // These outer-edge forms bootstrap the tests by feeding its body the
  // appropriate document prologue(s).

  (define (interp_in11 stx)
    (interp_body stx (tail (syntax_unwrap stx)) (quote [('#$ion_1_1')])))

  (define_syntax in11
    (lambda (stx)
      (datum_to_syntax
        (QQ (interp_in11 (quote_syntax (UQ stx))))
        (QS context)
        stx)))

)

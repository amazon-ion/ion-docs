(module ion_testing_dsl "/fusion"

  '''
A DSL for testing the Ion denotational model.

Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * On input, `'#$ion_d_d'` represents an IVM.
  * On input, S-expressions starting with a symbol with prefix `'#$:'` denote
    an E-expression.  The text starting with : is parsed as a macro reference.
  * On output, `'#$name#ddd'` represents absent symbol at index `ddd` of SST `name`.


Here's the grammar for the DSL:

    <test> := (in10 <body>) | (in11 <body>)

    <body> := <expectation> | <extension>+

    // <extension> may fork but always terminates in an <expectation>
    <extension> := <after> | <finish>

    <after> := (after <content> <body>)

    <finish> := <content> <expectation>    // == (after <content> <expectation>)

    <content> := (encoding ___)
               | (mactab   ___)
               | (toplevel ___)
               | (<content> ...)
               | (each <content> ...+)

  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/testing"
    "/fusioncontrib/denotation/private/util"
    "/ion_model/model"

    (only_in "/fusion/private/io"
      with_output_to_string
    )
    (only_in "/ion_model/testing"
      eject_Values
      expand_doc
    )
  )

  (provide
    in11
  )


  '''
TODOs
-----
  * Might be nice if the various bits of data could use `unquote`.
  * Fanout at encoding/mactab/document level

Nesting the expectation-clause inside the content clause is structurally clear,
but the extra delimeter in `document` may be annoying.
Plus we should also have one in `produces` for consistency.

Could also be nice to allow nesting of encoding/mactab/document for hierarchical
fanout.  Extension of encoding directives.

- encoding
  - module
    - mactab
      - segment
        - expectation
      - segment
        - expectation

Expectation clause can appear at any level, to test the preceding document.
  * Is there any reason to allow continuing with more content and expectation?
    * Yes: to show that a successful doc produces content, but adding an error
      causes a signals failure.
  '''


  (define (is_keyword_clause stx kw)
    (and (is_sexp (syntax_unwrap stx))
         // TODO size checks
         (=== (syntax_unwrap (syntax_get stx 0)) kw)))


  //============================================================================
  // Expectations are implemented by functions accepting ejected evaluation
  // results ie 'Value*'

  (define (is_expectation_clause stx)
    // TODO type, size checks
    (or (is_keyword_clause stx (Q produces))
        (is_keyword_clause stx (Q signals))))


  (define (interp_produces clause_stx doc Values)
    // TODO arity and typecheck
    (let [(expected_data (syntax_to_datum (syntax_subseq clause_stx 1)))]
      (check_not_bottom Values)
      (let [(actual_data (eject_Values Values))]
        (unless (=== expected_data actual_data)
          (raise_contract_error (quote produces)
            (with_output_to_string
              (displayln "Failure at L" (syntax_line clause_stx) ":" (syntax_column clause_stx))
              (displayln "Document didn't produce expected output.")
              (display "Document: ")
              (writeln doc)
              (display "Expanded: ")
              (writeln actual_data)
              (display "Expected: ")
              (writeln expected_data)))))))

  (define (interp_signals clause_stx doc Values)
    // TODO arity and typecheck
    (let [(msg (syntax_unwrap (syntax_get clause_stx 1)))]
      (check_bottom msg Values)))


  (define (interp_expectation clause_stx docs)
    (lets [(kw (syntax_unwrap (syntax_get clause_stx 0))),
           (interp (cond ((=== kw (quote produces)) interp_produces)
                         ((=== kw (quote signals )) interp_signals )))]
      (for [(doc docs)]
        (let [(Values (expand_doc doc))]
          (interp clause_stx doc Values)))))


  //============================================================================
  // Content producers are functions that take a list of in-progress documents
  // and add more data to each one.

  (define (is_content_clause stx)
    (is_keyword_clause stx (Q toplevel)))


  (define (interp_toplevel clause_stx docs)
    (let [(fragment (tail (syntax_to_datum clause_stx)))]
      (map (|d| (append d fragment)) docs)))

  (define (interp_content clause docs)
    (if (is_keyword_clause clause (Q toplevel))
      (interp_toplevel clause docs)
      (wrong_syntax clause "Malformed content expression")))


  (define (interp_extensions clauses docs)
    (unless (is_empty clauses)
      (if (is_keyword_clause (head clauses) (Q after))
        (begin (interp_after (head clauses) docs)
               (interp_extensions (tail clauses) docs))
        (if (is_content_clause (head clauses))
          (let [(content_stx (head clauses))]
            (when (is_empty (tail clauses))
              (wrong_syntax content_stx "Expected an expectation clause after this"))
            (let [(expect_stx  (head (tail clauses)))]
              // TODO validate the expect-clause somewhere
              (interp_after2 content_stx expect_stx docs))
            (interp_extensions (tail (tail clauses)) docs))
          (wrong_syntax (head clauses) "Expected document extension clause")))))


  (define (interp_body containing_stx clauses docs)
    (when (is_empty clauses)
      (wrong_syntax containing_stx "Expected at least one body clause"))
    (if (and (== 1 (size clauses))
             (is_expectation_clause (head clauses)))
      (interp_expectation (head clauses) docs)
      (interp_extensions clauses docs)))


  (define (interp_after2 content_stx expect_stx docs)
    (let [(new_docs (interp_content content_stx docs))]
      (interp_expectation expect_stx new_docs)))

  (define (interp_after clause docs)
    (lets [(content_stx  (syntax_get clause 1)),
           (body_clauses (tail (tail (syntax_unwrap clause)))),
           (new_docs     (interp_content content_stx docs))]
      (interp_body clause body_clauses new_docs)))


  //============================================================================
  // These outer-edge forms bootstrap the tests by feeding its body the
  // appropriate document prologue(s).

  (define (interp_in11 stx)
    (interp_body stx (tail (syntax_unwrap stx)) (quote [('#$ion_1_1')])))

  (define_syntax in11
    (lambda (stx)
      (datum_to_syntax
        (QQ (interp_in11 (quote_syntax (UQ stx))))
        (QS context)
        stx)))

)

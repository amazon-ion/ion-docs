(module ion_testing_dsl "/fusion"

  '''
A DSL for testing the Ion denotational model.

Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * On input, `'#$ion_d_d'` represents an IVM.
  * On input, S-expressions starting with a symbol with prefix `'#$:'` denote
    an E-expression.  The text starting with : is parsed as a macro reference.
  * On output, `'#$name#ddd'` represents absent symbol at index `ddd` of SST `name`.


Here's the grammar for the DSL:

    <test> := (in10 <body>) | (in11 <body>)

    <body> := <expectation> | <extension>+

    // <extension> may fork but always terminates in an <expectation>
    <extension> := <after> | <finish>

    <after> := (after <content> <body>)

    <finish> := <content> <expectation>    // == (after <content> <expectation>)

    <content> := (encoding ___)
               | (mactab   ___)
               | (toplevel ___)
               | (<content> ...)
               | (each <content> ...+)

  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/testing"
    "/fusioncontrib/denotation/private/util"
    "/ion_model/model"

    (only_in "/fusion/private/io"
      with_output_to_string
    )
    (only_in "/ion_model/testing"
      eject_Values
      expand_doc
    )
  )

  (provide
    after
    in11
    produces
    signals
    toplevel
  )


  '''
TODOs
-----
  * Might be nice if the various bits of data could use `unquote`.
  * Fanout at encoding/mactab/document level

Nesting the expectation-clause inside the content clause is structurally clear,
but the extra delimeter in `document` may be annoying.
Plus we should also have one in `produces` for consistency.

Could also be nice to allow nesting of encoding/mactab/document for hierarchical
fanout.  Extension of encoding directives.

- encoding
  - module
    - mactab
      - segment
        - expectation
      - segment
        - expectation

Expectation clause can appear at any level, to test the preceding document.
  * Is there any reason to allow continuing with more content and expectation?
    * Yes: to show that a successful doc produces content, but adding an error
      causes a signals failure.
  '''


  (define (is_keyword_clause stx ident)
    (and (is_sexp (syntax_unwrap stx))
          // TODO size checks
          (free_identifier_equal (head (syntax_unwrap stx)) ident)))


  //============================================================================
  // Expectations are implemented by functions accepting ejected evaluation
  // results ie 'Value*'

  (define_syntax produces
    (lambda (stx)
      (wrong_syntax stx "Must be inside a test case")))
  (define_syntax signals
    (lambda (stx)
      (wrong_syntax stx "Must be inside a test case")))

  (define (is_expectation_clause stx)
    // TODO type, size checks
    (or (is_keyword_clause stx (QS produces))
        (is_keyword_clause stx (QS signals))))


  (define (do_produces doc)
    (unless (is_sexp doc)
      (raise_argument_error do_produces "doc sexp" doc))
    (lambda (actual)
      (check_not_bottom actual)
      (let [(actual_doc (eject_Values actual))]
        (unless (=== doc actual_doc)
          (raise_contract_error (quote produces)
            (with_output_to_string
              (displayln "Document didn't produce expected output.")
              // TODO Include the complete original doc?
//              (display "Document: ")
//              (writeln actual)
              (display "Expanded: ")
              (writeln actual_doc)
              (display "Expected: ")
              (writeln doc)))))))

  (define (do_signals msg)
    (lambda (actual)
      (check_bottom msg actual)))


  (define_syntax gen_expectation
    "Returns an expression for a function that tests an output document"
    (lambda (stx)
      (let [(expectation_stx (syntax_get stx 1))]
        // Produces (code for) a function that accepts the results of evaluation.
        (if (is_keyword_clause expectation_stx (QS produces))
          (datum_to_syntax
            (QQ (do_produces (quote (UQ (syntax_subseq expectation_stx 1)))))
            (QS context)
            expectation_stx)
          (if (is_keyword_clause expectation_stx (QS signals))
            (datum_to_syntax
              // TODO validate the argument is a literal string.
              (QQ (do_signals (UQ (element (syntax_unwrap expectation_stx) 1))))
              (QS context)
              expectation_stx)
            (wrong_syntax expectation_stx "Unrecognized expectation clause"))))))



  //============================================================================
  // Content producers are functions that take a list of in-progress documents
  // and add more data to each one.

  (define_syntax toplevel
    (lambda (stx)
      (wrong_syntax stx "Must be inside a test case")))

  (define (is_content_clause stx)
    (is_keyword_clause stx (QS toplevel)))


  (define (do_toplevel content)
    (lambda (docs)
      (map (|d| (append d content)) docs)))


  (define_syntax gen_content
    (lambda (stx)
      (let [(content (syntax_get stx 1))]
        (if (is_keyword_clause content (QS toplevel))
          (let [(fragment (tail (syntax_unwrap content)))]
            (datum_to_syntax
              (QQ (do_toplevel (quote (UQ fragment))))
              (QS context)
              content))
          (wrong_syntax content "Malformed content expression")))))


  (define (do_extensions extends)
    (lambda (docs)
      (for [(extend extends)]
        (extend docs))))

  (define_syntax gen_extensions
    (lambda (stx)
      '''
      (gen_extensions (CLAUSE ...))
      '''
      (let [(cases (let loop [(clauses (syntax_unwrap (syntax_get stx 1)))]
                     (cond
                       ((is_empty clauses)
                        (sexp))
                       ((is_keyword_clause (head clauses) (QS after))
                        (pair (head clauses)
                              (loop (tail clauses))))
                       ((is_content_clause (head clauses))
                        (let [(content_stx (head clauses))]
                          (if (is_empty (tail clauses))
                            (wrong_syntax content_stx "Expected an expectation clause after this")
                            (let [(expect_stx  (head (tail clauses)))]
                              // TODO validate the expect-clause somewhere
                              (pair (sexp (QS after) content_stx expect_stx)
                                    (loop (tail (tail clauses))))))))
                        (true
                         (wrong_syntax (head clauses) "Expected document extension clause")))))]
        (datum_to_syntax
          (QQ (do_extensions (UQ (pair (QS list) cases))))
          (QS context)
          stx))))

  (define_syntax gen_body
    "(gen_body (CLAUSE ...))"
    (lambda (stx)
      (let [(clauses (syntax_unwrap (syntax_get stx 1)))]
        (when (is_empty clauses)
          (wrong_syntax stx "Expected at least one body clause"))
        (if (and (== 1 (size clauses))
                 (is_expectation_clause (head clauses)))
          (datum_to_syntax
            (QQ (let [(checker (gen_expectation (UQ (head clauses))))]
                  (lambda (docs)
                    (for [(doc docs)]
                      (let [(actual (expand_doc doc))]
                        (checker actual))))))
            (QS context)
            // This location ensures stack traces are tied to the expectation.
            (head clauses))
          (datum_to_syntax
            (QQ (gen_extensions (UQ clauses)))
            (QS context)
            stx)))))


  (define (do_after extender body)
    (lambda (docs)
      (body (extender docs))))

  (define_syntax after
    (lambda (stx)
      (let [(content (syntax_get stx 1)),
            (body    (tail (tail (syntax_unwrap stx))))]
        (datum_to_syntax
          (QQ (do_after (gen_content (UQ content))
                        (gen_body    (UQ body))))
          (QS context)
          stx))))


  //============================================================================
  // These outer-edge forms bootstrap the tests by feeding its body the
  // appropriate document prologue(s).

  (define (do_in11 cases)
    // Bootstrap the cases with one document that's just the 1.1 IVM
    (cases (quote [('#$ion_1_1')])))

  (define_syntax in11
    (lambda (stx)
      (let [(clauses (tail (syntax_unwrap stx)))]
        (datum_to_syntax
          (QQ (do_in11 (gen_body (UQ clauses))))
          (QS context)
          stx))))

)

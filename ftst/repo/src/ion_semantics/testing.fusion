(module ion_testing "/fusion"

  '''
Utilities for testing the Ion denotational model.
  '''

  (require
    "/fusion/exception"
    "/fusion/experimental/check"
    "/fusion/experimental/syntax"
    "/fusioncontrib/denotation"
    "/fusioncontrib/denotation/testing"
    "/ion_semantics/model"
  )

  (provide (all_defined_out))



  (define (remove_first pred sequence)
    (choose (let [(looking true)]
              (lambda (e)
                (if (and looking (pred e))
                  (begin (set looking false) false)
                  true)))
       sequence))

  (define (bag_equal equal list1 list2)
    (and (same_size list1 list2)
      (let loop [(i 0), (list2 list2)]
        (if (== i (size list1))
           (is_empty list2)
           (let [(v1 (element list1 i))]
             (loop (+ i 1)
               (remove_first (|v2| (equal v1 v2)) list2)))))))


  (define (is_safe v)
    (or (is_bool   v)
        (is_int    v)
        (is_string v)))


  //============================================================================
  // Creating model values for the input domains like RVal

  // Safe types

  (define (mk_Boolean c)
    (cond
      ((is_null c) (raise "[NULL]"))
      ((is_bool c) (lift_to Boolean (inject_into B c)))
      (true (raise_argument_error "mk_Boolean" "null or bool" 0 c))))

  (define (mk_Int c)
    (cond
      ((is_null c) (raise "[NULL]"))
      ((is_int  c) (lift_to Int (inject_into I c)))
      (true (raise_argument_error "mk_Int" "null or int" 0 c))))

  (define (mk_String c)
    (cond
      ((is_null   c) (raise "[NULL]"))
      ((is_string c) (lift_to String (inject_into Unicode c)))
      (true (raise_argument_error "mk_String" "null or string" 0 c))))

  (define (mk_SafeVal c)
    (cond
      ((is_null   c) (raise "[NULL]"))
      ((is_bool   c) (lift_to SafeVal (mk_Boolean c)))
      ((is_int    c) (lift_to SafeVal (mk_Int c)))
      ((is_string c) (lift_to SafeVal (mk_String c)))
      (true (raise_argument_error "mk_SafeVal" "null/bool/int/string" 0 c))))


  // Symbols

  (define (mk_SymTok c)
    (lift_to SymTok
      (cond
        ((is_string c) (inject_into Unicode c))
        ((is_symbol c) (let [(str (symbol_to_string c))]
                         (if (string_starts_with str "#$")
                           (inject_into I (string_to_int (string_replace str "#$" "")))
                           (inject_into Unicode str))))
        ((is_int    c) (inject_into I c))
        (true (raise_argument_error "mk_SymTok" "string/int" 0 c)))))

  (define (mk_RSym c)
    (cond
      ((is_null   c) (lift_to RSym (raise "[NULL]")))
      ((is_string c) (lift_to RSym (mk_SymTok c)))
      ((is_symbol c) (lift_to RSym (mk_SymTok c)))
      ((is_int    c) (lift_to RSym (mk_SymTok c)))
      (true (raise_argument_error "mk_RSym" "null/string/int" 0 c))))


  // Containers

  (define (mk_RList c)
    (lift_to RList (apply seq 'RVal*' (map mk_RVal c))))

  (define (mk_RStruct c)
    (lift_to RStruct (apply seq 'RField*'
                       (for_list [((k v) c)]
                         (tuple RField (mk_SymTok k) (mk_RVal v))))))


  // Values

  (define (mk_RVal c)
    (tuple RVal (apply seq 'SymTok*' (map mk_SymTok (annotations c)))
      (lift_to RContent
        (cond
          // TODO Annotations are not stripped from c and are injected into the model.
          //  This is confusing when debugging, at the very least.
          //  Currently this is counterbalanced by how eject_Value applies annotations.
          ((is_safe   c)       (mk_SafeVal c))
          ((is_symbol c)       (mk_RSym    c))
          ((is_list   c)       (mk_RList   c))
          ((is_struct c)       (mk_RStruct c))
          ((domain_is c RSym)  c)
          (true (raise_argument_error "mk_RVal" "symbol/bool/int/string/list" 0 c))))))

  (define (mk_TRVal c)
    (lift_to TRVal
      (if (=== (quote '#$ion_1_0') c)
        IVM_1_0
        (mk_RVal c))))


  //============================================================================
  // Comparing normal-ish Fusion data with the output domain values

  // Safe types

  (define_check (check_Int expected actual)
    // TODO null.int
    (check === expected (eject (check_lower actual I))))

  (define_check (check_SafeVal expected actual)
    (cond
      ((is_int expected) (check_Int expected (check_lower actual Int)))
      (true (fail "Unhandled expected value"))))


  // Symbols

  (define_check (check_Sym0 actual)
    (check_same Sym0 (subdomain actual)))

  (define_check (check_Symbol expected actual)
    // TODO $0, null.symbol
    (check === (symbol_to_string expected)
      (eject (check_lower actual Symbolic Unicode))))


  // Containers

  (define_check (check_List expected actual)
    (check_Values (apply sexp expected) (check_lower actual 'Value*')))

  (define_check (check_Struct expected actual)
    //   Perhaps we should be using Fusion equality to make this easier.
    //   Transform the modeled result into Fusion data and === to expected Fusion data.
    //   Not sure how to handle $0 since Fusion can't represent it.  We could use a
    //   sentinel value but that doesn't work for field names and annotations.

    // Turn expected and actual structs into list of key/values pairs, then use bag_equal.
    (let [(exp_bag (for_list [((k v) expected)]
                     (pair (symbol_to_string k) v))),
          (act_bag (for_list [(f (seq_to_sexp (check_lower actual 'Field*')))]
                     (pair (eject (check_lower (ith f 0) Unicode))
                           (ith f 1))))]
      (check (curry_left bag_equal (|e a| (and (=== (head e) (head a))
                                               (equals_Value (tail e) (tail a)))))
        exp_bag act_bag)))


  // Values

  (define_check (check_Value expected actual)
    (let_values [((annot content) (tuple_values actual))]
      (cond
        ((is_safe   expected) (check_SafeVal expected (check_lower content SafeVal)))
        ((is_symbol expected) (check_Symbol  expected (check_lower content Symbol)))
        ((is_list   expected) (check_List    expected (check_lower content List)))
        ((is_struct expected) (check_Struct  expected (check_lower content Struct)))
        (true (fail "Unhandled expected value")))))

  (define (check_Values expecteds actuals) // sexp and Value*
    (let loop [(es expecteds), (as actuals)]
      (check_same (is_empty es) (seq_is_empty as))
      (or (is_empty es)
          (begin
            (check_Value (head es) (ith as 0))
            (loop (tail es) (seq_tail as))))))

  (define (equals_Value expected actual)
    // Hacky way to avoid writing both raising and non-raising comparisons.
    (with_handlers
      [(is_check_error (|e| false))]
    (check_Value expected actual)
    true))


  //============================================================================
  // Ejecting output domain values to produce Fusion data

  // Safe types

  (define (eject_Boolean v)
    (if (element_of v DotNull)
      null.bool
      (eject (unwrap v))))

  (define (eject_Int v)
    (if (element_of v DotNull)
      null.int
      (eject (unwrap v))))

  (define (eject_String v)
    (if (element_of v DotNull)
      null.string
      (eject (unwrap v))))

  (define (eject_SafeVal v)
    (cond
      ((element_of v NullNull) (raise "TODO null"))
      ((element_of v Boolean ) (eject_Boolean (unwrap v)))
      ((element_of v Int     ) (eject_Int     (unwrap v)))
      ((element_of v String  ) (eject_String  (unwrap v)))
      (true (raise (subdomain v)))))


  // Symbols

  (define (eject_Symbolic sym)
    (if (element_of sym Unicode)
      (string_to_symbol (eject (check_lower sym Unicode)))
      (quote '#$0')))

  (define (eject_Symbolics syms)
    (assert (domain_is syms 'Symbolic*'))
    (map eject_Symbolic (seq_to_sexp syms)))

  (define (eject_Symbol v)
    (if (element_of v DotNull)
      (quote null.symbol)
      (eject_Symbolic (unwrap v))))


  // Containers

  (define (eject_List v)
    (if (element_of v DotNull)
      null.list
      (apply list (eject_Values (unwrap v)))))

  (define (eject_Struct v)
    (if (element_of v DotNull)
      null.struct
      (for_struct [(f (seq_to_sexp (unwrap v)))]
        (values (eject_Symbolic (Field_name  f))
                (eject_Value    (Field_value f))))))


  // Values

  (define (eject_Content v)
    (let [(ejector (cond
                     ((element_of v SafeVal) eject_SafeVal)
                     ((element_of v Symbol ) eject_Symbol)
                     ((element_of v List   ) eject_List)
                     ((element_of v Struct ) eject_Struct)
                     (true (raise (subdomain v)))))]
      (ejector (unwrap v))))

  (define (eject_Value value)
    (let_values [((annots content) (tuple_values value))]
      // `annotate` replaces any existing annotations on the content.
      (apply annotate (eject_Content content) (eject_Symbolics annots))))

  (define (eject_Values values)
    (assert (domain_is values 'Value*'))
    (map eject_Value (seq_to_sexp values)))


  //============================================================================
  // Parsing Inputs

  (define_syntax quote_top
    (lambda (stx)
      (datum_to_syntax
        (quasiquote (quote (unquote (tail (syntax_unwrap stx)))))
        (quote_syntax context)
        stx)))

  (define parse
    "Construct a `TRVal*` denoting the input values."
    (lambda input
      (apply seq 'TRVal*' (map mk_TRVal input))))


  //============================================================================
  // Catalogs

  (define catalog_data
    (quote_top
      $ion_shared_symbol_table::{
        name:"empty", version:1, symbols:[]
      }
      $ion_shared_symbol_table::{
        name:"abcs", version:1, symbols:["a"]
      }
      $ion_shared_symbol_table::{
        name:"abcs", version:2, symbols:["a", "b"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:1, symbols:["m"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:3, symbols:["m", "n", "o"]
      }
      $ion_shared_symbol_table::{
        name:"mnop", version:4, symbols:["4", "n", "o", "p"]  // Change used to detect v4
      }
    ))

  (define testing_catalog
    (for_fold [(c EMPTY_CATALOG)]
      [(sst (seq_to_sexp (expand (apply parse catalog_data) EMPTY_CATALOG)))]
      (Catalog_extend c
        (SST_for_$ion_shared_symbol_table (lower_to Struct (value_content sst))))))


  //============================================================================
  // Test drivers

  (define (expand_doc input)
    "Parse top-level inputs (contained in a sequence) into `TRVal*` then expand it."
    (expand (apply parse input) testing_catalog))

  (define doc_matches
    (lambda expecteds
      (lambda (actuals)
        (check_Values expecteds actuals))))

  (define_binary_check (check_expansion expected input)
    // Inner check ensures the failure message shows the ejected data.
    (check === expected (eject_Values (expand_doc input)))
    true)
)

(module model1 "/fusion"

  (require "/fusioncontrib/denotation/dsl")

  (provide (all_defined_out))


  (define_model M1
    (import B)

    (dom Single = (= SINGLE)   "singleton")
    (dom Enum   = (= E1 E2 E3) "enumeration")

    (dom Z = (^ is_int)       "Integers")
    (dom D = (^ is_decimal)   "Decimals")
    (dom Flt = (^ is_float)   "Floats")
    (dom S = (^ is_string)    "Strings")
    (dom T = (^ is_timestamp) "Timestamps")

    (dom Exact = (+ Z D))
    (dom Num   = (+ Z D Flt))
    (dom Any   = (+ B Num S T) "All Values")

    (dom Stamped = (* T Any) "A timestamped value")

    (dom Any2Any = (-> Any Any))
    (dom Pred    = (-> Any B)  "A predicate function")

    (dom Point2d = (* Z Z))
    (dom Projection = (-> Point2d Z))  // Single argument of tuple domain

    (dom Stamper = (-> T Any Stamped)) // Two arguments

    (const Z_0     (inject_into Z 0))
    (const Exact_0 (lift_to Exact Z_0))

    (fn Stamped_time ((s Stamped) -> T) (ith s 0))

    (fn id ((a Any) -> Any)
      a)
    (fn stamp ((t T) (v Any) -> Stamped)
      (tuple Stamped t v))

    (fn filter ((vs 'Any*') (p Pred) -> 'Any*')
      (if (seq_is_empty vs) (seq 'Any*')
        (if (p (seq_head vs))
          (seq_append (seq 'Any*' (seq_head vs)) (filter (seq_tail vs) p))
          (filter (seq_tail vs) p))))

    (fn select_ints ((vs 'Any*') -> 'Any*')
      (filter vs (mk_fn Pred (v) (element_of v Z))))
  )


  // Base domain values

  (define true_val (inject_into B true))

  (define z_rep 1456)
  (define z_val (inject_into Z z_rep))

  (define d_val (inject_into D 1.23))
  (define Flt_4_56e0 (inject_into Flt 4.56e0))
  (define s_val (inject_into S "an S"))
  (define t_val (inject_into T 1776T))


  // Union domain values

  (define int_exact_val (lift_to Exact z_val))
  (define dec_exact_val (lift_to Exact d_val))
  (define int_num_val   (lift_to Num z_val))
  (define flt_num_val   (lift_to Num Flt_4_56e0))

  (define Any_true    (lift_to Any true_val))
  (define int_any_val (lift z_val Num Any))


  // Tuple domain values

  (define stamped_int_val (tuple Stamped t_val int_any_val))

  // Sequence values
  (define Zs_1_2_3 (seq 'Z*' 1 2 3))
)

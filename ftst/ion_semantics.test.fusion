'''

Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * Similarly, `'#$ion_d_d'` represents an IVM within the input.



TODO
----

'''

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_semantics/model"
  "/ion_semantics/testing"
)


(check_expansion
  (quote_top true false 1)   // Expected output
  (quote_top true false 1))  // Input document


// Symbols

(check_expansion
  (quote_top danny $ion  '#$0')
  (quote_top danny '#$1' '#$999'))


// Lists

(check_expansion
  (quote_top [] [[], 1, danny, $ion])
  (quote_top [] [[], 1, danny, '#$1']))


// Structs

(check_expansion
  (quote_top {} {a:$ion, c:{}, a:1, b:danny})
  (quote_top {} {a:1, b: danny, a:'#$1', c:{}}))


"SUCCESS (ion_semantics.test)"

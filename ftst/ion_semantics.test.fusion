'''

TODO
----
* Transform Values (expansion result) to Fusion data, to make result check straightforwards.

'''

(require
  "/fusion/exception"
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/ion_semantics/model"
)


(define (mk_RSym c)
  (cond
    ((is_null   c) (lift_to_RSym (raise "[NULL]")))
    ((is_string c) (lift_to RSym (lift_to SymTok (inject_into Unicode c))))
    ((is_int    c) (lift_to RSym (lift_to SymTok (inject_into I c))))
    (true (raise_argument_error "mk_RSym" "bad arg" 0 c))))

(define (mk_Boolean c)
  (cond
    ((is_null c) (raise "[NULL]"))
    ((is_bool c) (lift_to Boolean (inject_into B c)))
    (true (raise_argument_error "mk_Boolean" "bad arg" 0 c))))

(define (mk_SafeVal c)
  (cond
    ((is_null c) (raise "[NULL]"))
    ((is_bool c) (lift_to SafeVal (mk_Boolean c)))
    (true (raise_argument_error "mk_SafeVal" "bad arg" 0 c))))

(define (mk_RVal c)
  (cond
    ((is_symbol c) (lift_to RVal (mk_RSym (symbol_to_string c))))
    ((is_bool   c) (lift_to RVal (mk_SafeVal c)))
    ((element_of c RSym) (lift_to RVal c))
    (true (raise_argument_error "mk_RVal" "bad arg" 0 c))))


(lets [(content "text for symbol"),
       (unicode (inject_into Unicode content)),
       (string  (lift_to String unicode)),
       (symbol  (string2symbol string))]
  (check === content (eject (lower_to Unicode symbol))))


(lets [(i        (inject_into I 0)),
       (symtok   (lift_to SymTok i)),
       (expanded (expand_SymTok e0 symtok))]
  (check_true (element_of expanded Symbolic))
  (check_same SYM0 (lower_to Sym0 expanded)))

(lets [(i        (inject_into I 1)),
       (symtok   (lift_to SymTok i)),
       (expanded (expand_SymTok e0 symtok))]
  (check_true (element_of expanded Symbolic))
  (check === "$ion" (eject (lower_to Unicode expanded))))


// Expand a safe value
(let [(v (expand (mk_RVal true)))]
  (check_true (eject (lower_to B (lower_to Boolean (lower_to SafeVal v))))))

// Expand a textual symbol
(let [(v (expand (mk_RVal (quote danny))))]
  (check === "danny" (eject (lower_to Unicode (lower_to Symbolic (lower_to Symbol v))))))

// Expand a system SID
(let [(v (expand (mk_RVal (mk_RSym 1))))]
  (check === "$ion" (eject (lower_to Unicode (lower_to Symbolic (lower_to Symbol v))))))

// Expand an out-of-range SID
(let [(v (expand (mk_RVal (mk_RSym 9999999999999))))]
  (check === Sym0 (subdomain (lower_to Symbolic (lower_to Symbol v)))))


"SUCCESS (ion_semantics.test)"

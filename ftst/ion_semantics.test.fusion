'''

Our testing strategy uses normal Fusion data to represent input documents for
the model to expand, and to represent the expected results of expansion.
This allows us to use built-in Fusion equality to validate the results.

We "tunnel" special tokens as follows:
  * Both input and output documents use symbols of the form `'#$ddd'` to represent
    SIDS.
  * Similarly, `'#$ion_d_d'` represents an IVM within the input.



TODO
----

'''

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_semantics/model"
  "/ion_semantics/testing"
)


(check_expansion
  (quote_top true a::false 1 a::'#$0' ::2 $ion_shared_symbol_table)   // Expected output
  (quote_top true a::false 1 a::'#$99'::2 '#$9'))                     // Input document


// Symbols

(check_expansion
  (quote_top danny $ion   $ion::'#$0')
  (quote_top danny '#$1' '#$1'::'#$999'))


// Lists

(check_expansion
  (quote_top a::[] [[], 1, danny, $ion])
  (quote_top a::[] [[], 1, danny, '#$1']))


// Structs

(check_expansion
  (quote_top g::{} {a:$ion, c:{}, a:1, b:danny})
  (quote_top g::{} {a:1, b: danny, a:'#$1', c:{}}))


// LSTs

(check_expansion                                     // Non-structs pass through
  (quote_top first $ion_symbol_table::[] second)
  (quote_top first $ion_symbol_table::[] second))

(check_expansion                         // IST structs are elided from app view
  (quote_top first second)
  (quote_top first $ion_symbol_table::{} second))
(check_expansion                                     // ...but only at top-level
  (quote_top [first, $ion_symbol_table::{}, second])
  (quote_top [first, $ion_symbol_table::{}, second]))
(check_expansion
  (quote_top a::'#$0' a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10'::'#$11' '#$10'))

(check_expansion                               // Non-string entries act like $0
  (quote_top '#$0' '#$0' '#$0')
  (quote_top $ion_symbol_table::{symbols:[a, 1, true]} '#$10' '#$11' '#$12'))
  // TODO [NULL] entries for null.null, null.string, null.symbol

(check_expansion
  (quote_top a b)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$10'
    $ion_symbol_table::{symbols:["b"]} '#$10'))

// $ion_symbol_table must be first annotation
(check_expansion
  (quote_top not::$ion_symbol_table::{symbols:["a"]})
  (quote_top not::$ion_symbol_table::{symbols:["a"]}))

(check_expansion
  (quote_top a not::$ion_symbol_table::{symbols:["b"]} a)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$10'
    not::$ion_symbol_table::{symbols:["b"]} '#$10'))


// Malformed `imports` field

(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:1} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:boom} '#$1' '#$10'))
// TODO [NULL] imports:null.symbol
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:[]} '#$1' '#$10'))


// Symbol Table Extension

(check_expansion
  (quote_top $ion a $ion a b)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$1' '#$10'
    $ion_symbol_table::{symbols:["b"], imports:$ion_symbol_table}  '#$1' '#$10' '#$11'))


// TODO test rejection of repeated symbols and/or imports field.


// IVMs

// Inline IVM resets the LST
(check_expansion
  (quote_top $ion a '#$0')
  (quote_top
    '#$ion_1_0' $ion_symbol_table::{symbols:["a"]} '#$1' '#$10'
    '#$ion_1_0' '#$10'))


"SUCCESS (ion_semantics.test)"

'''

TODO
----
* Transform Values (expansion result) to Fusion data, to make result check straightforwards.

'''

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_semantics/model"
  "/ion_semantics/testing"
)


(lets [(content "text for symbol"),
       (unicode (inject_into Unicode content)),
       (string  (lift_to String unicode)),
       (symbol  (string2symbol string))]
  (check === content (eject (lower_to Unicode symbol))))


(lets [(i        (inject_into I 0)),
       (symtok   (lift_to SymTok i)),
       (expanded (expand_SymTok e0 symtok))]
  (check_true (element_of expanded Symbolic))
  (check_Sym0 expanded))

(lets [(i        (inject_into I 1)),
       (symtok   (lift_to SymTok i)),
       (expanded (expand_SymTok e0 symtok))]
  (check_true (element_of expanded Symbolic))
  (check === "$ion" (eject (lower_to Unicode expanded))))


// Expand a safe value
(let [(v (expand1 true))]
  (check_true (eject (check_lower (value_content v) SafeVal Boolean B))))

// Expand a textual symbol
(let [(v (expand1 (quote danny)))]
  (check === "danny" (eject (check_lower (value_content v) Symbol Symbolic Unicode))))

// Expand a system SID
(let [(v (expand1 (mk_RSym 1)))]
  (check === "$ion" (eject (check_lower (value_content v) Symbol Symbolic Unicode))))

// Expand an out-of-range SID
(let [(v (expand1 (mk_RSym 9999999999999)))]
  (check === Sym0 (subdomain (check_lower (value_content v) Symbol Symbolic))))



// TODO (check_pred (doc_matches) (expand (seq 'RVal*')))

(check_pred (doc_matches 1)
  (expand (parse 1)))
(check_pred (doc_matches (quote danny) (quote $ion))
  (expand (parse (quote danny) (mk_RSym 1))))
(check_pred (doc_matches [[], 1, (quote danny), (quote $ion)])  // Lists
  (expand (parse [[], 1, (quote danny), (mk_RSym 1)])))
(check_pred (doc_matches {} (quote {a:$ion, c:{}, a:1, b:danny}))     // Structs
  (expand (parse {} {a:1, b:(quote danny), a:(mk_RSym 1), c:{}})))


"SUCCESS (ion_semantics.test)"

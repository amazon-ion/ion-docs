(require "/ion_model/testing/dsl")

// TODO:[CONFORM] Move these into conformance suite

(ion_1_x (denotes))
(ion_1_x (toplevel) (denotes))

(ion_1_x "Primitive denotations"
  (toplevel true false -1 0 1 "" "str")
  (denotes  true false -1 0 1 "" "str"))

(ion_1_x (toplevel [])       (denotes (list)))
(ion_1_x (toplevel ())       (denotes (sexp)))
(ion_1_x (toplevel [1, ("a")]) (denotes (list 1 (sexp "a"))))
(ion_1_x (toplevel (1  ["a"])) (denotes (sexp 1 (list "a"))))

(ion_1_x "Symbol denotations"
  (then (toplevel '' symbol 'null')
        (denotes (symbol (text)) (symbol "symbol") (symbol (text 110 117 108 108)))))

(ion_1_x "String denotations"
  (then (toplevel "" "a\x62\u0063")
        (denotes (string) (string 97 0x62 99))))

(ion_1_x "Struct denotations"
  (then (toplevel {} {a:1} {a:1, b:2})
        (denotes (struct) (struct ("a" 1)) (struct ((text 0x62 /* "b" */) 2)("a" 1)))))

(ion_1_x "Null denotations"
  (then (toplevel null.blob     ) (denotes ('null' blob     )))
  (then (toplevel null.bool     ) (denotes ('null' bool     )))
  (then (toplevel null.clob     ) (denotes ('null' clob     )))
  (then (toplevel null.decimal  ) (denotes ('null' decimal  )))
  (then (toplevel null.float    ) (denotes ('null' float    )))
  (then (toplevel null.int      ) (denotes ('null' int      )))
  (then (toplevel null.list     ) (denotes ('null' list     )))
  (then (toplevel null.null     ) (denotes ('null' 'null'   )))
  (then (toplevel null.sexp     ) (denotes ('null' sexp     )))
  (then (toplevel null.string   ) (denotes ('null' string   )))
  (then (toplevel null.struct   ) (denotes ('null' struct   )))
  (then (toplevel null.symbol   ) (denotes ('null' symbol   )))
  (then (toplevel null.timestamp) (denotes ('null' timestamp)))
)


// TODO move to local_symtab_imports
(ion_1_0
  (then (toplevel $ion_symbol_table::{imports:[{name:"absent", max_id:0}, {name:"abcs"}]} '#$10')
        (produces a))
  (then (toplevel $ion_symbol_table::{imports:[{name:"absent", max_id:2}, {name:"abcs"}]}
                  '#$10' '#$11' '#$12')
        (denotes (symbol (absent "absent" 1)) (symbol (absent "absent" 2)) (symbol "a")))
  (then (toplevel $ion_symbol_table::{imports:[{name:"empty", version:2, max_id:3}, {name:"abcs"}]}
                  '#$10' '#$11' '#$12' '#$13')
        (denotes (symbol (absent "empty" 1))
                 (symbol (absent "empty" 2))
                 (symbol (absent "empty" 3))
                 (symbol "a")))
  (then (toplevel $ion_symbol_table::{imports:[{name:"mnop", version:2, max_id:2}, {name:"abcs"}]}
                  '#$10' '#$11' '#$12')
        // mnop v2 doesn't exist, so we should get truncated v4, which has a gap
        (denotes (symbol (absent "mnop" 1)) (symbol "n") (symbol "a"))))

// Safe types

(ion_1_x
  (toplevel null      null.null a::null '#$1'::null)
  (produces null.null null.null a::null $ion ::null))

(ion_1_x
  (toplevel null.bool a::null.bool true '#$1'::false)
  (produces null.bool a::null.bool true $ion ::false))

(ion_1_x
  (toplevel null.int a::null.int 0 1 a::'#$1'::2)
  (produces null.int a::null.int 0 1 a::$ion ::2))


(ion_1_x
  (toplevel null.string a::null.string "" "queen" '#$1'::"king")
  (produces null.string a::null.string "" "queen" $ion ::"king"))


// Symbols

(ion_1_x
  (toplevel null.symbol a::null.symbol '' danny '#$1' '#$1'::'#$4')
  (produces null.symbol a::null.symbol '' danny $ion   $ion::name))


// Lists

(ion_1_x
  (toplevel null.list a::null.list a::[] [[], 1, danny, '#$1'])
  (produces null.list a::null.list a::[] [[], 1, danny, $ion]))


// Sexps

(ion_1_x
  (toplevel null.sexp a::null.sexp a::() (() 1 danny '#$1'))
  (produces null.sexp a::null.sexp a::() (() 1 danny $ion)))


// Structs

(ion_1_x
  (toplevel null.struct a::null.struct g::{} {a:1, b: danny, a:'#$1', c:{}})
  (produces null.struct a::null.struct g::{} {a:$ion, c:{}, a:1, b:danny}))


"SUCCESS (ion_model.test)"

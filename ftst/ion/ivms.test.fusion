(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


(check_true (eject (IVM_eq IVM_1_0 (tuple IVM 1 0))))

(check_true (eject (IVM_eq IVM_1_0 (mk_IVM (quote '#$ion_1_0')))))
(check_true (eject (IVM_eq IVM_1_1 (mk_IVM (quote '#$ion_1_1')))))


// TODO:[CONFORM] move to conformance suite
// Inline IVM resets the LST
(check_expansion_and_bounds 9
  (quote_top $ion a)
  (quote_top
    '#$ion_1_0' $ion_symbol_table::{symbols:["a"]} '#$1' '#$10'
    '#$ion_1_0'))


"SUCCESS (ivms.test)"

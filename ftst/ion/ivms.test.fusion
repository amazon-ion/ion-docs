(check_true (eject (IVM_eq IVM_1_0 (tuple IVM 1 0))))

(check_true (eject (IVM_eq IVM_1_0 (mk_IVM (quote '#$ion_1_0')))))
(check_true (eject (IVM_eq IVM_1_1 (mk_IVM (quote '#$ion_1_1')))))


// TODO:[CONFORM] move to conformance suite

(ion_1_0 "IVM resets the LST"
  (toplevel $ion_symbol_table::{symbols:["a"]})
  (toplevel '#$ion_1_0')
  (toplevel '#$10')
  (signals "Invalid symbol address:"))


"SUCCESS (ivms.test)"

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)



(define_check (check_SeqCardinality e a)
  (check_same e a))

(define_check (check_Cardinality e a)
  (check_same (subdomain e) (subdomain a))
  (if (element_of e OptCardinality)
    (check_same (lower e OptCardinality) (lower a OptCardinality))
    (check_same (lower e SeqCardinality) (lower a SeqCardinality))))


(define_check (check_SimpleShape e a)
  (check_same        (SimpleShape_type e) (SimpleShape_type a))
  (check_Cardinality (SimpleShape_card e) (SimpleShape_card a)))

(define_check (check_RestShape e a)
  (check_same           (RestShape_type e) (RestShape_type a))
  (check_SeqCardinality (RestShape_card e) (RestShape_card a)))


(define_check (check_ParamSpec e a)
  (check_eqv (eject (ParamSpec_name e)) (eject (ParamSpec_name a)))
  (let [(e_shape (ParamSpec_shape e)),
        (a_shape (ParamSpec_shape a))]
    (check_same (subdomain e_shape) (subdomain a_shape))
    (if (element_of e_shape SimpleShape)
      (check_SimpleShape (lower e_shape SimpleShape) (lower a_shape SimpleShape))
      (fail "testing groups not implemented"))))

(define_check (check_RestSpec e a)
  (if (opt_is_present e)
    (let [(e (opt_value e)),
          (a (opt_value a))]  // "unwrap" the optional domain values
      (check_eqv (eject (RestSpec_name e)) (eject (RestSpec_name a)))
      (let [(e_shape (RestSpec_shape e)),
            (a_shape (RestSpec_shape a))]
        (check_RestShape e_shape a_shape)))
    (check_false (opt_is_present a))))


(define_check (check_Signature params rest data)
  (let [(s (compile_Signature (expand1 (sexp data))))]
    (check_not_bottom s)
    (check_same (size params) (seq_length (Signature_params s)))
    (for [(e params), (a (seq_to_sexp (Signature_params s)))]
      (check_ParamSpec e a))
    (check_RestSpec rest (Signature_rest s))))


//==============================================================================

// Defaulting of simple param-specs

(check_Signature [] NO_REST
  (quote ()))
(check_Signature [('param!' "v" ANY)] NO_REST
  (quote (v)))
(check_Signature [('param!' "v" ANY), ('param!' "w" ANY)] NO_REST
  (quote (v w)))

(check_Signature [] NO_REST
  (quote []))
(check_Signature [('param!' "v" ANY)] NO_REST
  (quote [v]))
(check_Signature [('param!' "v" ANY), ('param!' "w" ANY)] NO_REST
  (quote [v, w]))



// Rest parameters

(check_Signature [] ('rest...' "r" ANY)
  (quote ((r ...))))
(check_Signature [('param!' "v" ANY), ('param!' "w" ANY)] ('rest...' "r" ANY)
  (quote (v w (r ...))))


"SUCCESS (signature.test)"

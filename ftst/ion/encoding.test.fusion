(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


// Non-sexps pass through
(check_expansion
  (quote_top first $ion_encoding::[] second)
  (quote11   first $ion_encoding::[] second))

(check_expansion
  (quote_top first $ion_encoding::{} second)
  (quote11   first $ion_encoding::{} second))

// Encoding directives are elided from app view
(check_expansion
  (quote_top first second)
  (quote11   first $ion_encoding::() $ion_encoding::null.sexp second))


// Local symbols

(check_expansion_and_bounds 12
  (quote_top a b)
  (quote11   $ion_encoding::((symbol_table ["a"] ["b"])) '#$11' '#$12'))


// Exact-match imports

(check_expansion_and_bounds 11
  (quote_top a)
  (quote11 $ion_encoding::((load abc "abcs" 1)
                           (symbol_table abc))
    '#$11'))

(check_expansion_and_bounds 14
  (quote_top a m o)
  (quote11 $ion_encoding::((load mno "mnop" 3)
                           (load abc "abcs" 1)
                           (symbol_table abc mno))
    '#$11' '#$12' '#$14'))


"SUCCESS (encoding.test)"

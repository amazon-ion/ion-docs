(require
  "/fusion/experimental/check"
  "/ion_model/testing/dsl"
)


(check_void (ion_1_0 (produces)))
(check_void (ion_1_1 (produces)))
(check_void (ion_1_x (produces)))

(check_void (ion_1_0 (toplevel)         (produces)))
(check_void (ion_1_1 (toplevel)         (produces)))
(check_void (ion_1_x (toplevel)         (produces)))

(check_void (ion_1_0 (toplevel '#$1' 1) (produces $ion 1)))
(check_void (ion_1_1 (toplevel '#$1' 1) (produces $ion 1)))
(check_void (ion_1_x (toplevel '#$1' 1) (produces $ion 1)))

(check_void (ion_1_0 (toplevel '#$999') (signals "Invalid symbol address: 999")))
(check_void (ion_1_1 (toplevel '#$999') (signals "Invalid symbol address: 999")))
(check_void (ion_1_x (toplevel '#$999') (signals "Invalid symbol address: 999")))

(check_void (ion_1_1 (then (toplevel)         (produces))
                     (then (toplevel '#$1' 1) (produces $ion 1))
                     (then (toplevel '#$999') (signals "Invalid symbol address: 999"))))


(expect_syntax_error (ion_1_0 /* No body */))
(expect_syntax_error (ion_1_1 /* No body */))
(expect_syntax_error (ion_1_x /* No body */))


//=========================
// Fragment expressions

// DSL expressions don't access Fusion bindings
(expect_contract_error
  (let [(x "outer")]
    (ion_1_1 (toplevel x) (produces "outer"))))


(ion_1_1 (encoding (symbol_table ["a"] ["b"]))
         (toplevel '#$12' '#$13')
         (produces a b))

(ion_1_1 (mactab (macro m () "m"))
         (toplevel ('#$:m'))
         (produces "m"))


//=========================
// then

(check_void (ion_1_1 (then (toplevel 1 2)
                           (produces 1 2))))

// THEN accepts multiple fragment clauses
(check_void (ion_1_1 (then (toplevel 1)
                           (toplevel 2)
                           (produces 1 2))))

// ...but there can't be multiple expectations
(expect_syntax_error (ion_1_1 (then (toplevel 1)
                                    (produces 1 2)
                                    (signals "foo"))))   // Dangling expectation

// THEN accepts nested extension clauses
(check_void (ion_1_1 (then (toplevel 1)
                           (then (toplevel 2)
                                 (produces 1 2)))))
// Even multiple extensions
(check_void (ion_1_1 (then (toplevel 1)
                           (then (toplevel 2)
                                 (produces 1 2))
                           (then (toplevel 3)
                                 (produces 1 3)))))

// ...but extensions can't be followed by another expectation
(expect_syntax_error (ion_1_1 (then (toplevel 1)
                                    (then (toplevel 2)
                                          (produces 1 2))
                                    (produces 1))))   // Dangling expectation


(expect_syntax_error (ion_1_1 (then ()                  // Malformed fragment clause
                                (produces))))
(expect_syntax_error (ion_1_1 (then 1                   // Malformed fragment clause
                                (produces 1))))



//=========================
// each

(expect_syntax_error
  (ion_1_1 (each /* no body */)))
(expect_syntax_error
  (ion_1_1 (each (toplevel) /* no expectation */)))

(ion_1_1 (each /* no fragment */ (produces)))
(ion_1_1 (toplevel 2)
         (each /* no fragment */ (produces 2)))


(check_void (ion_1_1 (each (toplevel 1 2)
                           (produces 1 2))))
(check_void (ion_1_1 (each (toplevel 1 2)
                           (toplevel 1 2)
                           (produces 1 2))))

// EACH can end with an extension
(check_void (ion_1_1 (each (toplevel 1)
                           (then (toplevel 2) (produces 1 2)))))

(check_void (ion_1_1 (each (toplevel 1)
                           (toplevel 1)
                           (each (toplevel 2)
                                 (toplevel 2)
                                 (produces 1 2)))))

(check_void (ion_1_x (each (toplevel 1)
                           (then (toplevel 2) (produces 1 2))
                           (then (toplevel 3) (produces 1 3)))))


//=========================
// Denotations

// Successful cases are in the conformance suite.

(expect_syntax_error (ion_1_0 (denotes annotation::1)))  // annotations not allowed

// Non-core types cannot be used directly in `denotes`
(expect_syntax_error (ion_1_0 (denotes null.null)))
(expect_syntax_error (ion_1_0 (denotes symbol)))
(expect_syntax_error (ion_1_0 (denotes 1.23)))
(expect_syntax_error (ion_1_0 (denotes [])))
(expect_syntax_error (ion_1_0 (denotes ())))
(expect_syntax_error (ion_1_0 (denotes {})))
(expect_syntax_error (ion_1_0 (denotes {{}} )))
(expect_syntax_error (ion_1_0 (denotes {{""}})))


//=========================
// AST Synthesis

// Reject malformed macro references

(expect_argument_error (ion_1_1 (toplevel ('#$:' )) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$::' )) (produces)))

// Malformed module name:
(expect_argument_error (ion_1_1 (toplevel ('#$::m')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:0:m')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:*:m')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:0M:m')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M@dule:m')) (produces)))

// Malformed name|address
(expect_argument_error (ion_1_1 (toplevel ('#$:M:')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:/')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:@')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:m acro')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:01')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:-1')) (produces)))

// Extra parts
(expect_argument_error (ion_1_1 (toplevel ('#$:M:m:')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:m:a')) (produces)))
(expect_argument_error (ion_1_1 (toplevel ('#$:M:m:0')) (produces)))

// Module ref not head of an AST S-expression
(expect_argument_error (ion_1_x  (toplevel '#$:oops') (denotes)))
// IVM not at top-level
(expect_argument_error (ion_1_x  (toplevel ['#$ion_1_0']) (denotes)))


"SUCCESS (testing_dsl.test)"

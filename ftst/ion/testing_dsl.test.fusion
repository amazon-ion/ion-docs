(require
  "/fusion/experimental/check"
  "/ion_model/testing/dsl"
)


(check_void (in10 (produces)))
(check_void (in11 (produces)))
(check_void (in1x (produces)))

(check_void (in10 (toplevel)         (produces)))
(check_void (in11 (toplevel)         (produces)))
(check_void (in1x (toplevel)         (produces)))

(check_void (in10 (toplevel '#$1' 1) (produces $ion 1)))
(check_void (in11 (toplevel '#$1' 1) (produces $ion 1)))
(check_void (in1x (toplevel '#$1' 1) (produces $ion 1)))

(check_void (in10 (toplevel '#$999') (signals "Invalid symbol address 999")))
(check_void (in11 (toplevel '#$999') (signals "Invalid symbol address 999")))
(check_void (in1x (toplevel '#$999') (signals "Invalid symbol address 999")))

(check_void (in11 (then (toplevel)         (produces))
                  (then (toplevel '#$1' 1) (produces $ion 1))
                  (then (toplevel '#$999') (signals "Invalid symbol address 999"))))


(expect_syntax_error (in10 /* No body */))
(expect_syntax_error (in11 /* No body */))
(expect_syntax_error (in1x /* No body */))


//=========================
// Content expressions

// DSL expressions don't access Fusion bindings
(expect_contract_error
  (let [(x "outer")]
    (in11 (toplevel x) (produces "outer"))))


(in11 (encoding (symbol_table ["a"] ["b"]))
      (toplevel '#$11' '#$12')
      (produces a b))

(in11 (mactab (macro m [] "m"))
      (toplevel ('#$:m'))
      (produces "m"))


//=========================
// then

(check_void (in11 (then (toplevel 1 2)
                        (produces 1 2))))

// THEN accepts multiple content clauses
(check_void (in11 (then (toplevel 1)
                        (toplevel 2)
                        (produces 1 2))))

// ...but there can't be multiple expectations
(expect_syntax_error (in11 (then (toplevel 1)
                                 (produces 1 2)
                                 (signals "foo"))))   // Dangling expectation

// THEN accepts nested extension clauses
(check_void (in11 (then (toplevel 1)
                        (then (toplevel 2)
                              (produces 1 2)))))
// Even multiple extensions
(check_void (in11 (then (toplevel 1)
                        (then (toplevel 2)
                              (produces 1 2))
                        (then (toplevel 3)
                              (produces 1 3)))))

// ...but extensions can't be followed by another expectation
(expect_syntax_error (in11 (then (toplevel 1)
                                 (then (toplevel 2)
                                       (produces 1 2))
                                 (produces 1))))   // Dangling expectation


(expect_syntax_error (in11 (then ()                  // Malformed content clause
                                 (produces))))
(expect_syntax_error (in11 (then 1                   // Malformed content clause
                                 (produces 1))))



//=========================
// each

(expect_syntax_error
  (in11 (each /* no expectation */)))
(expect_syntax_error
  (in11 (each (toplevel) /* no expectation */)))
(expect_syntax_error
  (in11 (each /* no fragment */ (produces))))


(check_void (in11 (each (toplevel 1 2)
                        (produces 1 2))))
(check_void (in11 (each (toplevel 1 2)
                        (toplevel 1 2)
                        (produces 1 2))))

// EACH can end with an extension
(check_void (in11 (each (toplevel 1)
                        (then (toplevel 2) (produces 1 2)))))

(check_void (in11 (each (toplevel 1)
                        (toplevel 1)
                        (each (toplevel 2)
                              (toplevel 2)
                              (produces 1 2)))))

// TODO EACH can end with multiple extensions
//(check_void (in1x (each (toplevel 1)
//                        (then (toplevel 2) (produces 1 2))
//                        (then (toplevel 3) (produces 1 3)))))


"SUCCESS (testing_dsl.test)"

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


(check_expansion "#$?Eexp not allowed in Ion 1.0"
  (quote_top '#$ion_1_0' ('#$:nomod:mac')))

(check_expansion "#$?Module not in scope: nomod"
  (quote_top '#$ion_1_1' ('#$:nomod:mac')))

(check_expansion "#$?No such macro: :$ion:mac"
  (quote_top '#$ion_1_1' ('#$:$ion:mac')))


// void

(check_expansion
  (quote_top 1 2)
  (quote_top '#$ion_1_1' 1 ('#$:$ion:void') 2))
(check_expansion
  (quote_top 1 2)
  (quote_top '#$ion_1_1' 1 ('#$:void') 2))
(check_expansion
  (quote_top 1 2)
  (quote_top '#$ion_1_1' 1 ('#$:$ion:void' true ('#$:void' false)) 2))


// values

(check_expansion
  (quote_top 1 2)
  (quote_top '#$ion_1_1' 1 ('#$:$ion:values') 2))
(check_expansion
  (quote_top 1 2)
  (quote_top '#$ion_1_1' 1 ('#$:values') 2))
(check_expansion
  (quote_top 1 2 3 4)
  (quote_top '#$ion_1_1' 1 ('#$:$ion:values' 2 3) 4))
(check_expansion
  (quote_top 1 2 3 4)
  (quote_top '#$ion_1_1' 1 ('#$:values' 2 3) 4))


// make_string

(check_expansion
  (quote_top "" "str" "sym")
  (quote_top '#$ion_1_1'
    ('#$:make_string') ('#$:make_string' "str") ('#$:make_string' sym)))

(check_expansion
  (quote_top "ab" "ab" "ab" "ab")
  (quote_top '#$ion_1_1'
    ('#$:make_string' "a" "b") ('#$:make_string' a  b)
    ('#$:make_string' "a"  b ) ('#$:make_string' a "b")))

// null.string and null.symbol act like ""
(check_expansion
  (quote_top "" "" "")
  (quote_top '#$ion_1_1'
    ('#$:make_string' null.string) ('#$:make_string' null.symbol)
    ('#$:make_string' null.string "" null.symbol)))
(check_expansion
  (quote_top "ab" "ab" "ab")
  (quote_top '#$ion_1_1'
    ('#$:make_string' null.string "ab" null.symbol "")
    ('#$:make_string' "a" null.string "b" null.symbol)
    ('#$:make_string' null.symbol "a" null.string "b")))


// make_symbol

(check_expansion
  (quote_top '' str sym)
  (quote_top '#$ion_1_1'
    ('#$:make_symbol') ('#$:make_symbol' "str") ('#$:make_symbol' sym)))

(check_expansion
  (quote_top ab ab ab ab)
  (quote_top '#$ion_1_1'
    ('#$:make_symbol' "a" "b") ('#$:make_symbol' a  b)
    ('#$:make_symbol' "a"  b ) ('#$:make_symbol' a "b")))

// null.string and null.symbol act like ""
(check_expansion
  (quote_top '' '' '')
  (quote_top '#$ion_1_1'
    ('#$:make_symbol' null.string) ('#$:make_symbol' null.symbol)
    ('#$:make_symbol' null.string "" null.symbol)))
(check_expansion
  (quote_top ab ab ab)
  (quote_top '#$ion_1_1'
    ('#$:make_symbol' null.string "ab" null.symbol "")
    ('#$:make_symbol' "a" null.string "b" null.symbol)
    ('#$:make_symbol' null.symbol "a" null.string "b")))


// make_list

(check_expansion
  (quote_top [] [1, 2])
  (quote_top '#$ion_1_1' ('#$:$ion:make_list') ('#$:$ion:make_list' 1 2)))
(check_expansion
  (quote_top [1, 2, 3, 4])
  (quote_top '#$ion_1_1' ('#$:$ion:make_list' 1 ('#$:values' 2 3) 4)))


// make_sexp

(check_expansion
  (quote_top () (1 2))
  (quote_top '#$ion_1_1' ('#$:$ion:make_sexp') ('#$:$ion:make_sexp' 1 2)))
(check_expansion
  (quote_top (1 2 3 4))
  (quote_top '#$ion_1_1' ('#$:$ion:make_sexp' 1 ('#$:values' 2 3) 4)))


// annotate

(check_expansion "#$?Expected grouping list"
  (quote_top '#$ion_1_1' ('#$:annotate' () 1)))
(check_expansion "#$?Expected grouping list"
  (quote_top '#$ion_1_1' ('#$:annotate' ann 1)))

// Existing annotations are preserved.
(check_expansion
  (quote_top 1 a::2 b::c::3)
  (quote_top '#$ion_1_1'
    ('#$:annotate' [] 1) ('#$:annotate' [] a::2) ('#$:annotate' [] b::c::3)))

// Both string and symbols are accepted as annotations
(check_expansion
  (quote_top a::1 a::b::2 a::b::c::d::3)
  (quote_top '#$ion_1_1'
    ('#$:annotate' ["a"] 1) ('#$:annotate' [a] b::2) ('#$:annotate' ["a", b] c::d::3)))

// But not nulls.
(check_expansion "#$?:$ion:annotate doesn't accept null.string"
  (quote_top '#$ion_1_1' ('#$:annotate' [null.string] 1)))
(check_expansion "#$?:$ion:annotate doesn't accept null.symbol"
  (quote_top '#$ion_1_1' ('#$:annotate' [null.symbol] 1)))

// Or other types
(check_expansion "#$?Not a text value"
  (quote_top '#$ion_1_1' ('#$:annotate' [0] 1)))
(check_expansion "#$?Not a text value"
  (quote_top '#$ion_1_1' ('#$:annotate' [["a"]] 1)))

// Annotations on the annotation-args are discarded
(check_expansion
  (quote_top b::1 c::e::f::2)
  (quote_top '#$ion_1_1'
    ('#$:annotate' [a::b] 1) ('#$:annotate' [a::b::"c", d::e] f::2)))


"SUCCESS (macro.test)"

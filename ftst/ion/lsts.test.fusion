(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


// Non-structs pass through
(check_expansion
  (quote_top first $ion_symbol_table::[] second)
  (quote_top first $ion_symbol_table::[] second))
(check_expansion
  (quote_top first $ion_symbol_table::() second)
  (quote_top first $ion_symbol_table::() second))

// IST structs are elided from app view
(check_expansion
  (quote_top first second)
  (quote_top first $ion_symbol_table::{} $ion_symbol_table::null.struct second))

// ...but only at top-level
(check_expansion
  (quote_top [first, $ion_symbol_table::{}, $ion_symbol_table::null.struct, second])
  (quote_top [first, $ion_symbol_table::{}, $ion_symbol_table::null.struct, second]))


// Basic symbol expansion
(check_expansion
  (quote_top a::a a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10'::'#$10' '#$10'))


// Out-of-bounds SID
//  At present, the model doesn't support partial expansion of the front of stream.
(check_eval_fail "Invalid symbol address 10"
  (quote_top '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10'))
(check_expansion_and_bounds 11
  (quote_top a b)
  (quote_top $ion_symbol_table::{symbols:["a", "b"]} '#$10' '#$11'))

// Empty, null, or malformed `symbols` field is ignored
(check_expansion_and_bounds 9
  (quote_top a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10' $ion_symbol_table::{symbols:[]}))
(check_expansion_and_bounds 9
  (quote_top a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10' $ion_symbol_table::{symbols:null.list}))
(check_expansion_and_bounds 9
  (quote_top a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10' $ion_symbol_table::{symbols:42}))
(check_expansion_and_bounds 9
  (quote_top a)
  (quote_top $ion_symbol_table::{symbols:["a"]} '#$10' $ion_symbol_table::{symbols:("b")}))


// Non-string and null (local) `symbols` entries act like $0
(check_expansion
  (quote_top '#$0' '#$0' '#$0' '#$0')
  (quote_top $ion_symbol_table::{symbols:[a, 1, true, ()]} '#$10' '#$11' '#$12' '#$13'))
(check_expansion
  (quote_top a '#$0' '#$0' '#$0' '#$0' b)
  (quote_top $ion_symbol_table::{symbols:["a", null.null, null.symbol, null.string, null.int, "b"]}
    '#$10' '#$11' '#$12' '#$13' '#$14' '#$15'))

// Successive ISTs replace earlier ones
(check_expansion
  (quote_top a b)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$10'
    $ion_symbol_table::{symbols:["b"]} '#$10'))

// $ion_symbol_table must be first annotation
(check_expansion
  (quote_top not::$ion_symbol_table::{symbols:["a"]})
  (quote_top not::$ion_symbol_table::{symbols:["a"]}))

(check_expansion
  (quote_top a not::$ion_symbol_table::{symbols:["b"]} a)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$10'
    not::$ion_symbol_table::{symbols:["b"]} '#$10'))


// Empty or malformed `imports` field is ignored

(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:1} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:boom} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:[]} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:null} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:null.list} '#$1' '#$10'))
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:null.int} '#$1' '#$10'))

// Ensure sexp isn't treated like a list; here the absent import would cause an error
(check_expansion
  (quote_top $ion a)
  (quote_top $ion_symbol_table::{symbols:["a"], imports:({name:"absent"})} '#$1' '#$10'))


// Non-exact-match imports

// If no max_id, lack of exact-match must raise an error.
(check_bottom "No exact-match for not-in-catalog@1"
  (expand_doc (quote_top $ion_symbol_table::{imports:[{name:"not-in-catalog"}]})))
(check_bottom "No exact-match for empty@2"
  (expand_doc (quote_top $ion_symbol_table::{imports:[{name:"empty", version:2}]})))

// If max_id not non-negative int, lack of exact-match must raise an error.
(check_bottom "No exact-match for not-in-catalog@1"
  (expand_doc (quote_top $ion_symbol_table::{imports:[{name:"not-in-catalog", max_id:null.int}]})))
(check_bottom "No exact-match for empty@2"
  (expand_doc (quote_top $ion_symbol_table::{imports:[{name:"empty", version:2, max_id:-5}]})))


// When max_id is present and valid, pad/truncade mismatched or absent SSTs.
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"absent", max_id:0}, {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top '#$absent#1' '#$absent#2' a)
  (quote_top $ion_symbol_table::{imports:[{name:"absent", max_id:2}, {name:"abcs"}]}
    '#$10' '#$11' '#$12'))
(check_expansion
  (quote_top '#$empty#1' '#$empty#2' '#$empty#3' a)
  (quote_top $ion_symbol_table::{imports:[{name:"empty", version:2, max_id:3}, {name:"abcs"}]}
    '#$10' '#$11' '#$12' '#$13'))
(check_expansion
  (quote_top '#$mnop#1' n a)
  // mnop v2 doesn't exist, so we should get truncated v4, which has a gap
  (quote_top $ion_symbol_table::{imports:[{name:"mnop", version:2, max_id:2}, {name:"abcs"}]}
    '#$10' '#$11' '#$12'))


// Exact-match imports

(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs"}]} '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:1}]} '#$10'))
(check_expansion_and_bounds 11
  (quote_top a b)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:2}]} '#$10' '#$11'))

// max_id inserts padding when exact-match
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"empty", version:1, max_id:3}, {name:"abcs"}]} '#$13'))

// Multiple imports

(check_expansion_and_bounds 13
  (quote_top m a)
  (quote_top $ion_symbol_table::{imports:[{name:"mnop", max_id:3}, {name:"abcs"}]} '#$10' '#$13'))


// TODO Use both versions of abcs; how to handle the second copy of "a"?

// Empty/malformed `name` => ignore the import
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:""},
                                          {name:null},
                                          {name:null.string},
                                          {name:1, version:1},
                                          {name:"abcs"}]}
    '#$10'))



// Non-struct entries in `imports` list are ignored.
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[null,        {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[null.bool,   {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[null.struct, {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[true,        {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[[],          {name:"abcs"}]} '#$10'))
(check_expansion
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[(),          {name:"abcs"}]} '#$10'))


// Normalise bad version values to 1
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:null}]} '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:null.int}]} '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:null.bool}]} '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:0}]} '#$10'))
(check_expansion_and_bounds 10
  (quote_top a)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", version:"2"}]} '#$10'))


// Bad max_id values ignored given exact match
(check_expansion
  (quote_top a m)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", max_id:null}, {name:"mnop"}]} '#$10' '#$11'))
(check_expansion
  (quote_top a m)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", max_id:null.int}, {name:"mnop"}]} '#$10' '#$11'))
(check_expansion
  (quote_top a m)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", max_id:null.bool}, {name:"mnop"}]} '#$10' '#$11'))
(check_expansion
  (quote_top a m)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", max_id:-1}, {name:"mnop"}]} '#$10' '#$11'))
(check_expansion
  (quote_top a m)
  (quote_top $ion_symbol_table::{imports:[{name:"abcs", max_id:"2"}, {name:"mnop"}]} '#$10' '#$11'))

(check_eval_fail "Repeated field: imports"
  (quote_top $ion_symbol_table::{imports:[], imports:null}))
(check_eval_fail "Repeated field: symbols"
  (quote_top $ion_symbol_table::{symbols:[], symbols:null}))

(check_eval_fail "Repeated field: name"
  (quote_top $ion_symbol_table::{imports:[{name:"empty", name:"empty"}]}))
(check_eval_fail "Repeated field: version"
  (quote_top $ion_symbol_table::{imports:[{name:"empty", version:1, version:1}]}))

(check_eval_fail "Repeated field: max_id"
  (quote_top $ion_symbol_table::{imports:[{name:"empty", max_id:1, max_id:1}]}))


// Symbol Table Extension

(check_expansion
  (quote_top $ion a $ion a b)
  (quote_top
    $ion_symbol_table::{symbols:["a"]} '#$1' '#$10'
    $ion_symbol_table::{symbols:["b"], imports:$ion_symbol_table}  '#$1' '#$10' '#$11'))


"SUCCESS (lsts.test)"

(require "/ion_model/testing/dsl")


// Non-structs pass through
(in1x (toplevel first $ion_symbol_table::[] second)
      (produces first $ion_symbol_table::[] second))
(in1x (toplevel first $ion_symbol_table::() second)
      (produces first $ion_symbol_table::() second))

// IST structs are elided from app view
(in1x (toplevel first $ion_symbol_table::{} $ion_symbol_table::null.struct second)
      (produces first                                                      second))

// ...but only at top-level
(in1x (toplevel [first, $ion_symbol_table::{}, $ion_symbol_table::null.struct, second])
      (produces [first, $ion_symbol_table::{}, $ion_symbol_table::null.struct, second]))


// Basic symbol expansion
(in10 (toplevel $ion_symbol_table::{symbols:["a"]})
      (toplevel '#$10'::'#$10' '#$10')
      (produces      a::a         a))


// Out-of-bounds SID
//  At present, the model doesn't support partial expansion of the front of stream.
(in10 (toplevel '#$10')
      (signals "Invalid symbol address 10"))
(in10 (toplevel $ion_symbol_table::{symbols:["a"]})
      (then (toplevel '#$11')
            (signals "Invalid symbol address 11")))
(in10 (toplevel $ion_symbol_table::{symbols:["a", "b"]})
      (then (toplevel '#$10' '#$11')
            (produces a b))
      (then (toplevel '#$12')
            (signals "Invalid symbol address 12")))


// Empty, null, or malformed `symbols` field is ignored
(in10 (each (toplevel $ion_symbol_table::{symbols:[]       })
            (toplevel $ion_symbol_table::{symbols:null.list})
            (toplevel $ion_symbol_table::{symbols:42       })
            (toplevel $ion_symbol_table::{symbols:("b")    })
            (then (toplevel '#$10')
                  (signals "Invalid symbol address 10"))))


// Non-string and null (local) `symbols` entries act like $0
(in10 (toplevel $ion_symbol_table::{symbols:[a, 1, true, ()]} '#$10' '#$11' '#$12' '#$13')
      (produces '#$0' '#$0' '#$0' '#$0'))
(in10 (toplevel $ion_symbol_table::{symbols:["a", null.null, null.symbol, null.string, null.int, "b"]})
      (toplevel '#$10' '#$11' '#$12' '#$13' '#$14' '#$15')
      (produces a      '#$0'  '#$0'  '#$0'  '#$0'  b))

// Successive ISTs replace earlier ones
(in10 (toplevel $ion_symbol_table::{symbols:["a"]} '#$10'
                $ion_symbol_table::{symbols:["b"]} '#$10')
      (produces a b))

// $ion_symbol_table must be first annotation
(in10 (toplevel not::$ion_symbol_table::{symbols:["a"]})
      (produces not::$ion_symbol_table::{symbols:["a"]}))

(in10 (toplevel $ion_symbol_table::{symbols:["a"]}
                '#$10' not::$ion_symbol_table::{symbols:["b"]} '#$10')
      (produces a      not::$ion_symbol_table::{symbols:["b"]} a))


// Empty or malformed `imports` field is ignored

(in10 (each (toplevel $ion_symbol_table::{symbols:["a"], imports:1        })
            (toplevel $ion_symbol_table::{symbols:["a"], imports:boom     })
            (toplevel $ion_symbol_table::{symbols:["a"], imports:[]       })
            (toplevel $ion_symbol_table::{symbols:["a"], imports:null     })
            (toplevel $ion_symbol_table::{symbols:["a"], imports:null.list})
            (toplevel $ion_symbol_table::{symbols:["a"], imports:null.int })
            (then (toplevel '#$10')
                  (produces a))))

// Ensure sexp isn't treated like a list; here the absent import would cause an error
(in10 (toplevel $ion_symbol_table::{symbols:["a"], imports:({name:"absent"})} '#$1' '#$10')
      (produces $ion a))


// Non-exact-match imports

// If no max_id, lack of exact-match must raise an error.
(in1x (toplevel $ion_symbol_table::{imports:[{name:"not-in-catalog"}]})
      (signals "No exact-match for not-in-catalog@1"))
(in1x (toplevel $ion_symbol_table::{imports:[{name:"empty", version:2}]})
      (signals "No exact-match for empty@2"))

// If max_id not non-negative int, lack of exact-match must raise an error.
(in1x (toplevel $ion_symbol_table::{imports:[{name:"not-in-catalog", max_id:null.int}]})
      (signals "No exact-match for not-in-catalog@1"))
(in1x (toplevel $ion_symbol_table::{imports:[{name:"empty", version:2, max_id:-5}]})
      (signals "No exact-match for empty@2"))


// When max_id is present and valid, pad/truncade mismatched or absent SSTs.
(in10 (toplevel $ion_symbol_table::{imports:[{name:"absent", max_id:0}, {name:"abcs"}]} '#$10')
      (produces a))
(in10 (toplevel $ion_symbol_table::{imports:[{name:"absent", max_id:2}, {name:"abcs"}]}
                '#$10' '#$11' '#$12')
      (produces '#$absent#1' '#$absent#2' a))
(in10 (toplevel $ion_symbol_table::{imports:[{name:"empty", version:2, max_id:3}, {name:"abcs"}]}
                '#$10' '#$11' '#$12' '#$13')
      (produces '#$empty#1' '#$empty#2' '#$empty#3' a))
(in10 (toplevel $ion_symbol_table::{imports:[{name:"mnop", version:2, max_id:2}, {name:"abcs"}]}
                '#$10' '#$11' '#$12')
      // mnop v2 doesn't exist, so we should get truncated v4, which has a gap
      (produces '#$mnop#1' n a))


// Exact-match imports
(in10 (each (toplevel $ion_symbol_table::{imports:[{name:"abcs"           }]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:1}]})
            (then (toplevel '#$10')
                  (produces a))
            (then (toplevel '#$11')
                  (signals "Invalid symbol address 11"))))
(in10 (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:2}]})
      (then (toplevel '#$10' '#$11')
            (produces a b))
      (then (toplevel '#$12')
            (signals "Invalid symbol address 12")))


// max_id inserts padding when exact-match
(in10 (toplevel $ion_symbol_table::{imports:[{name:"empty", version:1, max_id:3},
                                             {name:"abcs"}]}
                '#$13')
      (produces a))

// Multiple imports

// TODO [TAB-BOUNDS] This should be easier.
(in10 (toplevel $ion_symbol_table::{imports:[{name:"mnop", max_id:3}, {name:"abcs"}]})
      (then (toplevel '#$10' '#$13')
            (produces m      a))
      (then (toplevel '#$14')
            (signals "Invalid symbol address 14")))


// TODO Use both versions of abcs; how to handle the second copy of "a"?

// Empty/malformed `name` => ignore the import
(in10 (each (toplevel $ion_symbol_table::{imports:[{name:""},          {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[{name:null},        {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[{name:null.string}, {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[{name:1, version:1},{name:"abcs"}]})
            (then (toplevel '#$10')
                  (produces a))))


// Non-struct entries in `imports` list are ignored.
(in10 (each (toplevel $ion_symbol_table::{imports:[null,        {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[null.bool,   {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[null.struct, {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[true,        {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[[],          {name:"abcs"}]})
            (toplevel $ion_symbol_table::{imports:[(),          {name:"abcs"}]})
            (then (toplevel '#$10')
                  (produces a))))


// Normalise bad version values to 1
(in10 (each (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:null     }]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:null.int }]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:null.bool}]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", version:"2"      }]})
            (then (toplevel '#$10')
                  (produces a))
            (then (toplevel '#$11')
                  (signals "Invalid symbol address 11"))))


// Bad max_id values ignored given exact match
(in10 (each (toplevel $ion_symbol_table::{imports:[{name:"abcs", max_id:null     }, {name:"mnop"}]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", max_id:null.int }, {name:"mnop"}]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", max_id:null.bool}, {name:"mnop"}]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", max_id:-1       }, {name:"mnop"}]})
            (toplevel $ion_symbol_table::{imports:[{name:"abcs", max_id:"2"      }, {name:"mnop"}]})
            (then (toplevel '#$10' '#$11')
                  (produces a m))))

// Repeated fields in symbol table signal an error
(in1x (toplevel $ion_symbol_table::{imports:[], imports:null})
      (signals "Repeated field: imports"))
(in1x (toplevel $ion_symbol_table::{symbols:[], symbols:null})
      (signals "Repeated field: symbols"))

// Repeated fields in an import signal an error
(in1x (toplevel $ion_symbol_table::{imports:[{name:"empty", name:"empty"}]})
      (signals "Repeated field: name"))
(in1x (toplevel $ion_symbol_table::{imports:[{name:"empty", version:1, version:1}]})
      (signals "Repeated field: version"))
(in1x (toplevel $ion_symbol_table::{imports:[{name:"empty", max_id:1, max_id:1}]})
      (signals "Repeated field: max_id"))


// Symbol Table Extension

(in10 (toplevel $ion_symbol_table::{symbols:["a"]} '#$1' '#$10'
                $ion_symbol_table::{symbols:["b"], imports:$ion_symbol_table}  '#$1' '#$10' '#$11')
      (produces $ion a $ion a b))


"SUCCESS (lsts.test)"

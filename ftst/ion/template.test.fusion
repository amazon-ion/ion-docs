(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


// Contant macros; Literals of various types

(check_expansion
  (quote_top null n::null
             true bool::null.bool
             76 inttt::null.int
             "string" null.string a::"string" b::c::null.string)
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro nul          () null.null)
                                 (macro nul_ann      () n::null)
                                 (macro bol          () true)
                                 (macro bol_ann_null () bool::null.bool)
                                 (macro int          () 76)
                                 (macro int_ann_null () inttt::null.int)
                                 (macro str          () "string")
                                 (macro str_null     () null.string)
                                 (macro str_ann      () a::"string")
                                 (macro str_ann_null () b::c::null.string)))
                             (macro_table M))
             ('#$:nul') ('#$:nul_ann')
             ('#$:bol') ('#$:bol_ann_null')
             ('#$:int') ('#$:int_ann_null')
             ('#$:str') ('#$:str_null') ('#$:str_ann') ('#$:str_ann_null')))

// TODO float decimal timestap blob clob

(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro no_param () "")))
                           (macro_table M))
           ('#$:no_param' oops)))


// Single-parameter macros; variable references

(check_expansion
  (quote_top a b)
  (quote11   $ion_encoding::((module M (macro_table (macro val (v) v)))
                             (macro_table M))
             ('#$:val' a) ('#$:val' b)))

(check_eval_fail "Unbound variable: x"
  (quote11   $ion_encoding::((module M (macro_table (macro val (v) x)))
                             (macro_table M))
  // TODO Remove the macro invocation; the above should fail at compile time.
             ('#$:val' null)))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro one_param (v) "")))
                           (macro_table M))
           ('#$:one_param')))

(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro one_param (v) "")))
                           (macro_table M))
           ('#$:one_param' 1 2)))


// Multiple parameters

(check_expansion
  (quote_top a "d")
  (quote11   $ion_encoding::((module M (macro_table (macro first  (v w) v)
                                                    (macro second (v w) w)))
                             (macro_table M))
             ('#$:first'  a "b")
             ('#$:second' c "d")))

(check_eval_fail "Too few arguments"
  (quote11   $ion_encoding::((module M (macro_table (macro first (v w) v)))
                             (macro_table M))
             ('#$:first')))

(check_eval_fail "Too few arguments"
  (quote11   $ion_encoding::((module M (macro_table (macro first (v w) v)))
                             (macro_table M))
             ('#$:first' 1)))

(check_eval_fail "Too many arguments"
  (quote11   $ion_encoding::((module M (macro_table (macro first (v w) v)))
                             (macro_table M))
             ('#$:first' 1 2 3)))


// Nontrivial parameter specs

(check_expansion
  (quote_top a)
  (quote11   $ion_encoding::((module M (macro_table (macro val ((v)) v)))
                             (macro_table M))
             ('#$:val' a)))


// Cardinality checks

(check_eval_fail "No value provided for parameter"
  (quote11 $ion_encoding::((module M (macro_table (macro i (v) v))) (macro_table M))
           ('#$:i' ('#$:values'))))
(check_eval_fail "More than one value provided for parameter"
  (quote11 $ion_encoding::((module M (macro_table (macro i (v) v))) (macro_table M))
           ('#$:i' ('#$:values' 1 2))))


// Zero-or-one cardinality

(check_expansion
  (quote_top a b 1 c d 2)
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v?)] v)))
                           (macro_table M))
           a ('#$:m')
           b ('#$:m' 1)
           c ('#$:m' ('#$:values'))
           d ('#$:m' ('#$:values' 2))))

(check_expansion
  (quote_top a [1, 2] b [3])
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v?), w] [v, w])))
                           (macro_table M))
           a ('#$:m' 1 2)
           b ('#$:m' ('#$:values') 3)))

(check_eval_fail "More than one value provided for parameter"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v?)] v))) (macro_table M))
           ('#$:m' ('#$:values' 1 2))))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v?), w] [v, w])))
                           (macro_table M))
           ('#$:m' 1)))


// One-or-more cardinality

(check_expansion
  (quote_top a 1 b 2 c 3 4)
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v+)] v)))
                           (macro_table M))
           a ('#$:m' 1)
           b ('#$:m' ('#$:values' 2))
           c ('#$:m' ('#$:values' 3 4))))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v+)] v)))
                           (macro_table M))
           ('#$:m')))

(check_eval_fail "No value provided for parameter"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v+)] v)))
                           (macro_table M))
           ('#$:m' ('#$:values'))))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v+), w] [v, w])))
                           (macro_table M))
           ('#$:m' 1)))

(check_eval_fail "No value provided for parameter" // for w
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v+), w] [v, w])))
                           (macro_table M))
           ('#$:m' 1 ('#$:values'))))


// Zero-or-more cardinality

(check_expansion
  (quote_top a b 1 c d 2 e 3 4)
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v*)] v)))
                           (macro_table M))
           a ('#$:m')
           b ('#$:m' 1)
           c ('#$:m' ('#$:values'))
           d ('#$:m' ('#$:values' 2))
           e ('#$:m' ('#$:values' 3 4))))

(check_expansion
  (quote_top a [1] b [2, 3] c [4, 5, 6])
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v*), w] [v, w])))
                           (macro_table M))
           a ('#$:m' ('#$:values') 1)
           b ('#$:m' ('#$:values' 2) 3)
           c ('#$:m' ('#$:values' 4 5) 6)))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v*), w] [v, w])))
                           (macro_table M))
           ('#$:m' 1)))

(check_eval_fail "No value provided for parameter" // for w
  (quote11 $ion_encoding::((module M (macro_table (macro m [(v*), w] [v, w])))
                           (macro_table M))
           ('#$:m' 1 ('#$:values'))))


// Rest parameters

(check_expansion
  (quote_top a b 1 c 2 3 d)
  (quote11   $ion_encoding::((module M (macro_table (macro vals ((v ...)) v)))
                             (macro_table M))
             a ('#$:vals') b ('#$:vals' 1) c ('#$:vals' 2 3) d))



// List quasi-literals

(check_expansion
  (quote_top c0::[] [1] [1, 2] a1::[1, a, 2]
             [1, [a], 2, 3] [1, [[a]], 2, r1, r2, 3])
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro c0  ()         c0::[])
                                 (macro c1  ()         [1])
                                 (macro c2  ()         [1, 2])
                                 (macro a1  (v)        a1::[1, v, 2])
                                 (macro a1r (v (r...)) [1, [v], 2, r, 3])))
                             (macro_table M))
             ('#$:c0') ('#$:c1') ('#$:c2')
             ('#$:a1' a)
             ('#$:a1r' a) ('#$:a1r' [a] r1 r2)))


"SUCCESS (template.test)"

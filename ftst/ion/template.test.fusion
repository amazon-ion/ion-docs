(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


// Contant macros; Literals of various types

(check_expansion
  (quote_top null n::null
             true bool::null.bool
             76 inttt::null.int
             "string" null.string a::"string" b::c::null.string)
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro nul          () null.null)
                                 (macro nul_ann      () n::null)
                                 (macro bol          () true)
                                 (macro bol_ann_null () bool::null.bool)
                                 (macro int          () 76)
                                 (macro int_ann_null () inttt::null.int)
                                 (macro str          () "string")
                                 (macro str_null     () null.string)
                                 (macro str_ann      () a::"string")
                                 (macro str_ann_null () b::c::null.string)))
                             (macro_table M))
             ('#$:nul') ('#$:nul_ann')
             ('#$:bol') ('#$:bol_ann_null')
             ('#$:int') ('#$:int_ann_null')
             ('#$:str') ('#$:str_null') ('#$:str_ann') ('#$:str_ann_null')))

// TODO float decimal timestap blob clob

(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro no_param () "")))
                           (macro_table M))
           ('#$:no_param' oops)))


// Single-parameter macros; variable references

(check_expansion
  (quote_top a b)
  (quote11   $ion_encoding::((module M (macro_table (macro val (v) v)))
                             (macro_table M))
             ('#$:val' a) ('#$:val' b)))

(check_eval_fail "Unbound variable: x"
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro val (v) x)))
                             (macro_table M))
  // TODO Remove the macro invocation; the above should fail at compile time.
             ('#$:val' null)))

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro one_param (v) "")))
                           (macro_table M))
           ('#$:one_param')))

(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro one_param (v) "")))
                           (macro_table M))
           ('#$:one_param' 1 2)))


// Multiple parameters

(check_expansion
  (quote_top a "d")
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro first  (v w) v)
                                 (macro second (v w) w)))
                             (macro_table M))
             ('#$:first'  a "b")
             ('#$:second' c "d")))

(check_eval_fail "Too few arguments"
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro first (v w) v)))
                             (macro_table M))
             ('#$:first')))

(check_eval_fail "Too few arguments"
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro first (v w) v)))
                             (macro_table M))
             ('#$:first' 1)))

(check_eval_fail "Too many arguments"
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro first (v w) v)))
                             (macro_table M))
             ('#$:first' 1 2 3)))


// Nontrivial parameter specs

(check_expansion
  (quote_top a)
  (quote11   $ion_encoding::((module M (macro_table (macro val ((v)) v)))
                             (macro_table M))
             ('#$:val' a)))

(check_eval_fail "Unexpected elements in param-spec:"
  (quote11 $ion_encoding::((module M (macro_table (macro vals ((v null)) ""))))))


// Rest parameters

(check_expansion
  (quote_top a b 1 c 2 3 d)
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro vals ((v ...)) v)))
                             (macro_table M))
             a ('#$:vals') b ('#$:vals' 1) c ('#$:vals' 2 3) d))

// rest-spec is not in final position
(check_eval_fail "Unexpected elements in param-spec:"
  (quote11 $ion_encoding::((module M (macro_table (macro vals ((v ...) w) ""))))))


"SUCCESS (template.test)"

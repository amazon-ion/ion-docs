(require "/ion_model/testing/dsl")


// Ion 1.1 uses $ion_literal as a top-level `quote`.
(in11 (toplevel '#$11' '#$11'::'#$11' '#$11'::1)
      (produces $ion_literal $ion_literal 1))

// It also works in text.
(in11 (toplevel $ion_literal $ion_literal::$ion_literal $ion_literal::1)
  (produces $ion_literal $ion_literal 1))

// But literals are _only_ recognized at top level.
(in11 (toplevel ['#$11',             '#$11'::'#$11',       $ion_literal::1])
      (produces [$ion_literal, $ion_literal::$ion_literal, $ion_literal::1]))

// No such effects in 1.0, even with the same SID.
(in10 (toplevel $ion_symbol_table::{symbols:["$ion_literal"]})
      (toplevel '#$10'             '#$10'::'#$10')
      (produces $ion_literal $ion_literal::$ion_literal))


// Top-level `$ion_literal::$ion_symbol_table::{}` is an error.
(in11 (toplevel $ion_literal::$ion_symbol_table::{})
      (signals "Cannot use literal $ion_symbol_table struct as application data"))

(in11 (toplevel [$ion_literal::$ion_symbol_table::{}])
      (produces [$ion_literal::$ion_symbol_table::{}]))


"SUCCESS (literal.test)"

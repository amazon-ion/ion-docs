// Macros can use other macros as parameter shape.

(require "/ion_model/testing/dsl")


(in11 (mactab (macro m ((vs values!)) {m:[vs]}))
      (then (toplevel ('#$:m' (1)))
            (produces {m:[1]}))
      (then (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:' (1))))
            (signals "Unexpected argument group"))
      (then (toplevel ('#$:m' ('#$:void')))
            (signals "Expected sexp with macro arguments, found an eexp"))
      (then (toplevel ('#$:m' 1))
            (signals "Expected sexp with macro arguments"))
      (then (toplevel ('#$:m' ()))
            (signals "No value provided for parameter"))
      (then (toplevel ('#$:m' (1 2 3)))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' (1) (2 3)))
            (signals "Too many arguments")))

(in11 (mactab (macro m ((vs make_list...)) {m:vs}))
      (then (toplevel ('#$:m'))
            (produces {}))
      (then (toplevel ('#$:m' 1 2))
            (signals "Expected sexp with macro arguments"))
      (then (toplevel ('#$:m' ('#$:void')))
            (signals "Expected sexp with macro arguments, found an eexp"))
      (then (toplevel ('#$:m' ()))
            (produces {m:[]}))
      (then (toplevel ('#$:m' (1 2 3)))
            (produces {m:[1, 2, 3]}))
      (then (toplevel ('#$:m' (1) (2 3)))
            (produces {m:[2,3], m:[1]}))
      (each (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' (1 2) ('#$:' 3)))
            (toplevel ('#$:m' (1 2) ('#$:' 3) ()))
            (signals "Unexpected argument group")))

(in11 (mactab (macro m ((vs make_list...+)) {m:vs}))
      (then (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (then (toplevel ('#$:m' 1 2))
            (signals "Expected sexp with macro arguments"))
      (then (toplevel ('#$:m' ('#$:void')))
            (signals "Expected sexp with macro arguments, found an eexp"))
      (then (toplevel ('#$:m' ()))
            (produces {m:[]}))
      (then (toplevel ('#$:m' (1 2 3)))
            (produces {m:[1, 2, 3]}))
      (then (toplevel ('#$:m' (1) (2 3)))
            (produces {m:[1], m:[2, 3]}))
      (each (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' (1 2) ('#$:' 3)))
            (toplevel ('#$:m' (1 2) ('#$:' 3) ()))
            (signals "Unexpected argument group")))

// Using :values as a parameter shape leads to some interesting things.
(in11 (mactab (macro m ((vs values...+)) {m:[vs]}))
      (then (toplevel ('#$:m' ()))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' (1 2 3)))
            (toplevel ('#$:m' (1) (2 3)))
            (produces {m:[1, 2, 3]})))

(require "/ion_model/testing/dsl")


// void
(in11 (each (toplevel 1 ('#$:$ion:void') 2)
            (toplevel 1 ('#$:$ion:0')    2)
            (toplevel 1 ('#$:void')      2)
            (produces 1                  2)))

// TODO should this stay true?
(in11 (toplevel 1 ('#$:$ion:void' true ('#$:void' false)) 2)
      (produces 1 2))


// values

(in11 (each (toplevel 1 ('#$:$ion:values') 2)
            (toplevel 1 ('#$:$ion:1')      2)
            (toplevel 1 ('#$:values')      2)
            (produces 1                    2))
      (each (toplevel 1 ('#$:$ion:values' a) 2)
            (toplevel 1 ('#$:$ion:1'      a) 2)
            (toplevel 1 ('#$:values'      a) 2)
            (produces 1                   a  2))
      (each (toplevel 1 ('#$:$ion:values' a b) 2)
            (toplevel 1 ('#$:$ion:1'      a b) 2)
            (toplevel 1 ('#$:values'      a b) 2)
            (produces 1                   a b  2)))


// make_string

// TODO Error when argument isn't text

(in11 (each (toplevel ('#$:make_string'))
            (toplevel ('#$:make_string' ""))
            (toplevel ('#$:make_string' ''))
            (produces ""))
      // accepts both strings and symbols
      (each (toplevel ('#$:make_string' "a" "b"))
            (toplevel ('#$:make_string'  a   b ))
            (toplevel ('#$:make_string' "a"  b ))
            (toplevel ('#$:make_string'  a  "b"))
            (produces "ab"))
      // null.string and null.symbol act like ""
      (each (toplevel ('#$:make_string' null.string "ab" null.symbol ""))
            (toplevel ('#$:make_string' "a" null.string 'b' null.symbol))
            (toplevel ('#$:make_string' null.symbol "a" null.string "b"))
            (produces "ab")))


// make_symbol

// TODO Error when argument isn't text

(in11 (each (toplevel ('#$:make_symbol'))
            (toplevel ('#$:make_symbol' ""))
            (toplevel ('#$:make_symbol' ''))
            (produces ''))
      // accepts both strings and symbols
      (each (toplevel ('#$:make_symbol' "a" "b"))
            (toplevel ('#$:make_symbol'  a   b ))
            (toplevel ('#$:make_symbol' "a"  b ))
            (toplevel ('#$:make_symbol'  a  "b"))
            (produces 'ab'))
      // null.string and null.symbol act like ""
      (each (toplevel ('#$:make_symbol' null.string "ab" null.symbol ""))
            (toplevel ('#$:make_symbol' "a" null.string 'b' null.symbol))
            (toplevel ('#$:make_symbol' null.symbol "a" null.string "b"))
            (produces 'ab')))


// make_list

(in11 (toplevel ('#$:$ion:make_list') ('#$:$ion:make_list' 1 2))
      (produces [] [1, 2]))

// flattening of rest-args
// TODO move elsewhere
(in11 (toplevel ('#$:$ion:make_list' 1 ('#$:values' 2 3) 4))
      (produces [1, 2, 3, 4]))


// make_sexp

(in11 (toplevel ('#$:$ion:make_sexp') ('#$:$ion:make_sexp' 1 2))
      (produces () (1 2)))

// flattening of rest-args
// TODO move elsewhere
(in11 (toplevel ('#$:$ion:make_sexp' 1 ('#$:values' 2 3) 4))
      (produces (1 2 3 4)))


// annotate

// Existing annotations are preserved.
(in11 (then (toplevel ('#$:annotate' ('#$:') x))
            (produces x))
      (each (toplevel ('#$:annotate' ('#$:') a::b::v))
            (toplevel ('#$:annotate' ('#$:' a)   b::v))
            (toplevel ('#$:annotate' ('#$:' a b)    v))
            (produces a::b::v)))

// Both string and symbols are accepted as annotations
(in11 (each (toplevel ('#$:annotate' ('#$:' a "b")         c::d::true))
            (toplevel ('#$:annotate' ('#$:' "a" "b" c "d")       true))
            (produces a::b::c::d::true))
      // Even empties
      (then (toplevel ('#$:annotate' ('#$:' '' "") null))
            (produces ''::''::null)))

// But not nulls.
(in11 (toplevel ('#$:annotate' ('#$:' null.string) 1))
      (signals ":$ion:annotate doesn't accept null.string"))
(in11 (toplevel ('#$:annotate' ('#$:' null.symbol) 1))
      (signals ":$ion:annotate doesn't accept null.symbol"))

// Or other types
(in11 (each (toplevel ('#$:annotate' ('#$:' 0) 1))
            (toplevel ('#$:annotate' ('#$:' ["a"]) 1))
            (toplevel ('#$:annotate' ('#$:' "a" false) 1))
            (signals "Not a text value")))

// Annotations on the annotation-args are discarded
(in11 (then (toplevel ('#$:annotate' ('#$:' a::b) 1))
            (produces b::1))
      (then (toplevel ('#$:annotate' ('#$:' a::b::"c" d::e) f::2))
            (produces c::e::f::2)))


"SUCCESS (system_macros.test)"

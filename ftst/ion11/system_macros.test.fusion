(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
  "/ion_model/testing/dsl"
)


// void

(check_expansion
  (quote_top 1 2 3 4)
  (quote11 1 ('#$:$ion:void') 2 ('#$:$ion:1') 3 ('#$:void') 4))
(check_expansion
  (quote_top 1 2)
  (quote11 1 ('#$:$ion:void' true ('#$:void' false)) 2))


// values

(check_expansion
  (quote_top 1 2)
  (quote11 1 ('#$:$ion:values') 2))
(check_expansion
  (quote_top 1 2)
  (quote11 1 ('#$:values') 2))
(check_expansion
  (quote_top 1 2 3 4)
  (quote11 1 ('#$:$ion:values' 2 3) 4))
(check_expansion
  (quote_top 1 2 3 4)
  (quote11 1 ('#$:values' 2 3) 4))


// make_string

(check_expansion
  (quote_top "" "str" "sym")
  (quote11
    ('#$:make_string') ('#$:make_string' "str") ('#$:make_string' sym)))

(check_expansion
  (quote_top "ab" "ab" "ab" "ab")
  (quote11
    ('#$:make_string' "a" "b") ('#$:make_string' a  b)
    ('#$:make_string' "a"  b ) ('#$:make_string' a "b")))

// null.string and null.symbol act like ""
(check_expansion
  (quote_top "" "" "")
  (quote11
    ('#$:make_string' null.string) ('#$:make_string' null.symbol)
    ('#$:make_string' null.string "" null.symbol)))
(check_expansion
  (quote_top "ab" "ab" "ab")
  (quote11
    ('#$:make_string' null.string "ab" null.symbol "")
    ('#$:make_string' "a" null.string "b" null.symbol)
    ('#$:make_string' null.symbol "a" null.string "b")))


// make_symbol

(check_expansion
  (quote_top '' str sym)
  (quote11
    ('#$:make_symbol') ('#$:make_symbol' "str") ('#$:make_symbol' sym)))

(check_expansion
  (quote_top ab ab ab ab)
  (quote11
    ('#$:make_symbol' "a" "b") ('#$:make_symbol' a  b)
    ('#$:make_symbol' "a"  b ) ('#$:make_symbol' a "b")))

// null.string and null.symbol act like ""
(check_expansion
  (quote_top '' '' '')
  (quote11
    ('#$:make_symbol' null.string) ('#$:make_symbol' null.symbol)
    ('#$:make_symbol' null.string "" null.symbol)))
(check_expansion
  (quote_top ab ab ab)
  (quote11
    ('#$:make_symbol' null.string "ab" null.symbol "")
    ('#$:make_symbol' "a" null.string "b" null.symbol)
    ('#$:make_symbol' null.symbol "a" null.string "b")))


// make_list

(check_expansion
  (quote_top [] [1, 2])
  (quote11 ('#$:$ion:make_list') ('#$:$ion:make_list' 1 2)))
(check_expansion
  (quote_top [1, 2, 3, 4])
  (quote11 ('#$:$ion:make_list' 1 ('#$:values' 2 3) 4)))


// make_sexp

(check_expansion
  (quote_top () (1 2))
  (quote11 ('#$:$ion:make_sexp') ('#$:$ion:make_sexp' 1 2)))
(check_expansion
  (quote_top (1 2 3 4))
  (quote11 ('#$:$ion:make_sexp' 1 ('#$:values' 2 3) 4)))


// annotate

// Existing annotations are preserved.
(in11 (then (toplevel ('#$:annotate' [] x))
            (produces x))
      (each (toplevel ('#$:annotate' [] a::b::v))
            (toplevel ('#$:annotate' [a]   b::v))
            (toplevel ('#$:annotate' [a, b]   v))
            (produces a::b::v)))

// Both string and symbols are accepted as annotations
(in11 (each (toplevel ('#$:annotate' [a, "b"]     c::d::true))
            (toplevel ('#$:annotate' ["a", "b", c, "d"] true))
            (produces a::b::c::d::true)))

// But not nulls.
(in11 (toplevel ('#$:annotate' [null.string] 1))
      (signals ":$ion:annotate doesn't accept null.string"))
(in11 (toplevel ('#$:annotate' [null.symbol] 1))
      (signals ":$ion:annotate doesn't accept null.symbol"))

// Or other types
(in11 (each (toplevel ('#$:annotate' [0] 1))
            (toplevel ('#$:annotate' [["a"]] 1))
            (signals "Not a text value")))

// Annotations on the annotation-args are discarded
(in11 (then (toplevel ('#$:annotate' [a::b] 1))
            (produces b::1))
      (then (toplevel ('#$:annotate' [a::b::"c", d::e] f::2))
            (produces c::e::f::2)))


"SUCCESS (system_macros.test)"

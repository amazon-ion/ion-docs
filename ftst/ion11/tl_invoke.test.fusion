// Tests covering template language (TL) macro invocations.

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
)


(check_eval_fail "No such macro: noSuchMacro"
  (quote11 $ion_encoding::((module M (macro_table (macro m [] (noSuchMacro)))))))

(with_mactab ((macro m      [] "m")
              (macro m_wrap [] (m)))
  (document ('#$:m_wrap'))
  (produces "m"))


(with_mactab ((macro m  [(p!)] ["m", p])
              (macro m1 [(p!)] (m p))
              (macro m2 [(p?)] (m p))
              (macro m3 [(p*)] (m p))
              (macro m4 [(p+)] (m p)))
  (document ('#$:m1' a) ('#$:m2' b) ('#$:m3' c) ('#$:m4' d))
  (produces ["m",    a] ["m",    b] ["m",    c] ["m",    d])
  (document ('#$:m2'))
  (signals "No value provided for parameter")
  (document ('#$:m3'))
  (signals "No value provided for parameter")
  (document ('#$:m3' ('#$:values' a b)))
  (signals "More than one value provided for parameter")
  (document ('#$:m4' ('#$:values' a b)))
  (signals "More than one value provided for parameter"))

(with_mactab ((macro m  [(p?)] ["m", p])
              (macro m0 []     (m))
              (macro m1 [(p!)] (m p))
              (macro m2 [(p?)] (m p)))
  (document ('#$:m0') ('#$:m1' a) ('#$:m2') ('#$:m2' a))
  (produces ["m"]     ["m", a]    ["m"]     ["m", a]))

(with_mactab ((macro m  [(p*)] ["m", p])
              (macro m0 []     (m)))
  (document ('#$:m0'))
  (produces ["m"]))

(with_mactab ((macro m  [(v...)] ["m", v])
              (macro m0 []       (m))
              (macro m1 [p]      (m p))
              (macro m2 [p]      (m p 2))
              (macro mr [(r...)] (m 1 r 2)))
  (document ('#$:m0') ('#$:m1' a) ('#$:m2' a))
  (produces ["m"]     ["m", a]    ["m", a, 2] )
  (document ('#$:mr')   ('#$:mr' a)    ('#$:mr' a b))
  (produces ["m", 1, 2] ["m", 1, a, 2] ["m", 1, a, b, 2]))


// Qualified references

(with_mactab ((macro m [(p...)] (':$ion:values' 1 p 2))
              (macro n [(p...)] (':$ion:1'      3 p 4)))
  (document ('#$:m' a b) ('#$:n' c d))
  (produces 1 a b 2      3 c d 4))

(with_encoding ((module M (macro_table (macro m [] "m")))
                (module U (macro_table (macro u [] [(':M:m'), (':M:0')])))  // No `use` needed!
                (module V (use M)
                          (macro_table (macro v [] [(':M:m'), (':M:0')])))  // But it's allowed.
                (macro_table U V))
  (document ('#$:u')   ('#$:v'))
  (produces ["m", "m"] ["m", "m"]))


// Local references

(with_mactab ((macro m [] "m")
              (macro n [] [(':m'), (':0')]))
  (document ('#$:n'))
  (produces ["m", "m"]))

// Local names shodow `use`d names.
(with_encoding ((module M1 (macro_table (macro m [] "M1")))
                (module M2 (use M1)
                           (macro_table (macro m [] "M2")
                                        (macro n [] (':m'))))
                (macro_table M2))
  (document ('#$:n'))
  (produces "M2"))

// Can't self-reference
(with_mactab ((macro m [] (':m')))
  (document)
  (signals "No such macro declared in this module: :m"))
(with_mactab ((macro m [] (':0')))
  (document)
  (signals "Invalid macro address: :0"))

// Can't forward-reference
(with_mactab ((macro m [] (':2'))
              (macro n [] "n")
              (macro o [] "o"))
  (document)
  (signals "Invalid macro address: :2"))

// Can't reference system macros this way.
(with_mactab ((macro _ [] (':values')))
  (document)
  (signals "No such macro declared in this module: :values"))

// Can't reference `use`d names this way.
(with_encoding ((module M1 (macro_table (macro m [] "M1")))
                (module M2 (use M1)
                           (macro_table (macro _ [] (':m')))))
  (document)
  (signals "No such macro declared in this module: :m"))


// Arity checking

(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [p]    1) (macro w [] (m)))))))
(check_eval_fail "Too few arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [p, q] 1) (macro w [] (m 1)))))))
(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m []     1) (macro w [] (m 1)))))))
(check_eval_fail "Too many arguments"
  (quote11 $ion_encoding::((module M (macro_table (macro m [p]    1) (macro w [] (m 1 2)))))))


"SUCCESS (tl_invoke.test)"

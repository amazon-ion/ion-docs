// Tests covering template language (TL) macro invocations.

(require "/ion_model/testing/dsl")


// Bare references (no leading colon)
// TODO:[ALIAS] bare refs to alias

(in11 (mactab (macro m [] (noSuchMacro)))
      (signals "No such macro: noSuchMacro"))

(in11 (mactab (macro m      [] "m")
              (macro m_wrap [] (m)))
      (toplevel ('#$:m_wrap'))
      (produces "m"))

// Local macros shadow system macros
(in11 (mactab (macro values [] "local")
              (macro n [] (values)))
      (then (toplevel ('#$:$ion:values' "system")) // Precondition for this test
            (produces "system"))
      (then (toplevel ('#$:n'))
            (produces "local")))


// Invocation cardinality and grouping

(in11 (mactab (macro m  [(v!)] v)
              (macro m1 []     (m)))
      (signals "Too few arguments"))

(in11 (mactab (macro m  [(v!)] v)
              (macro m1 []     (m (;))))
      (signals "Unexpected argument group"))

(in11 (mactab (macro m  [(v!)] v)
              (macro m1 [(v...)] (m v)))
      (each (toplevel ('#$:m1'))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m1' 1))
            (produces 1))
      (each (toplevel ('#$:m1' 1 2))
            (signals "More than one value provided for parameter")))


(in11 (mactab (macro m  [(v?)] v)
              (macro m1 []       (m))
              (macro m2 []       (m (;)))
              (macro m3 [(v...)] (m v))
              (macro m4 [(v...)] (m (; v))))
      (each (toplevel ('#$:m1'))
            (toplevel ('#$:m2'))
            (toplevel ('#$:m3'))
            (toplevel ('#$:m4'))
            (produces))
      (each (toplevel ('#$:m3' 1))
            (toplevel ('#$:m4' 1))
            (produces 1))
      (each (toplevel ('#$:m3' 1 2))
            (toplevel ('#$:m4' 1 2))
            (signals "More than one value provided for parameter")))


(in11 (mactab (macro m  [(v*)] v)
              (macro m1 [] (m (; 1 (; 2)))))
      (signals "Unexpected argument group"))

(in11 (mactab (macro m  [(v*)] v)
              (macro m1 []       (m))
              (macro m2 []       (m (;)))
              (macro m3 [(v...)] (m v))
              (macro m4 [(v...)] (m (; v)))
              (macro m5 [(v...)] (m (; (values v)))))
      (each (toplevel ('#$:m1'))
            (toplevel ('#$:m2'))
            (toplevel ('#$:m3'))
            (toplevel ('#$:m4'))
            (toplevel ('#$:m5'))
            (produces))
      (each (toplevel ('#$:m3' 1))
            (toplevel ('#$:m4' 1))
            (toplevel ('#$:m5' 1))
            (produces 1))
      (each (toplevel ('#$:m3' 1 2))
            (toplevel ('#$:m4' 1 2))
            (toplevel ('#$:m5' 1 2))
            (produces 1 2)))


(in11 (mactab (macro m  [(v+)] v)
              (macro m1 []     (m)))
      (signals "Too few arguments"))
(in11 (mactab (macro m  [(v+)] v)
              (macro m1 [] (m (; 1 (; 2)))))
      (signals "Unexpected argument group"))

(in11 (mactab (macro m  [(v+)] v)
              (macro m1 []       (m (;)))
              (macro m2 [(v...)] (m v))
              (macro m3 [(v...)] (m (; v)))
              (macro m4 [(v...)] (m (; (values v)))))
      (each (toplevel ('#$:m1'))
            (toplevel ('#$:m2'))
            (toplevel ('#$:m3'))
            (toplevel ('#$:m4'))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m2' 1))
            (toplevel ('#$:m3' 1))
            (toplevel ('#$:m4' 1))
            (produces 1))
      (each (toplevel ('#$:m2' 1 2))
            (toplevel ('#$:m3' 1 2))
            (toplevel ('#$:m4' 1 2))
            (produces 1 2)))


(in11 (mactab (macro m  [(v...)] v)
              (macro m1 [] (m (;))))
      (signals "Unexpected argument group"))
(in11 (mactab (macro m  [(v...)] v)
              (macro m1 [] (m 1 (;))))
      (signals "Unexpected argument group"))

(in11 (mactab (macro m  [(v...)] v)
              (macro m1 []       (m))
              (macro m2 [(v...)] (m v))
              (macro m3 [(v...)] (m v v)))
      (each (toplevel ('#$:m1'))
            (toplevel ('#$:m2'))
            (toplevel ('#$:m3'))
            (produces))
      (each (toplevel ('#$:m2' 1))
            (produces 1))
      (each (toplevel ('#$:m3' 1 2))
            (produces 1 2 1 2)))


(in11 (mactab (macro m  [(v...+)] v)
              (macro m1 [] (m (;))))
      (signals "Unexpected argument group"))
(in11 (mactab (macro m  [(v...+)] v)
              (macro m1 [] (m 1 (;))))
      (signals "Unexpected argument group"))
(in11 (mactab (macro m  [(v...+)] v)
              (macro m1 [] (m)))
      (signals "Too few arguments"))

(in11 (mactab (macro m  [(v...+)] v)
              (macro m1 [(v...)] (m v))
              (macro m2 [(v...)] (m v v)))
      (each (toplevel ('#$:m1'))
            (toplevel ('#$:m2'))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m1' 1))
            (produces 1))
      (each (toplevel ('#$:m2' 1 2))
            (produces 1 2 1 2)))


// Qualified references

(in11 (mactab (macro m [(p...)] (':$ion:values' 1 p 2))
              (macro n [(p...)] (':$ion:1'      3 p 4)))
  (toplevel ('#$:m' a b) ('#$:n' c d))
  (produces 1 a b 2      3 c d 4))

(in11 (encoding (module M (macro_table (macro m [] "m")))
                (module U (macro_table (macro u [] [(':M:m'), (':M:0')])))  // No `use` needed!
                (module V (use M)
                          (macro_table (macro v [] [(':M:m'), (':M:0')])))  // But it's allowed.
                (macro_table U V))
      (toplevel ('#$:u')   ('#$:v'))
      (produces ["m", "m"] ["m", "m"]))


// Local references

(in11 (mactab (macro m [] "m")
              (macro n [] [(':m'), (':0')]))
      (toplevel ('#$:n'))
      (produces ["m", "m"]))

// Local names shodow `use`d names.
(in11 (encoding (module M1 (macro_table (macro m [] "M1")))
                (module M2 (use M1)
                           (macro_table (macro m [] "M2")
                                        (macro n [] (':m'))))
                (macro_table M2))
      (toplevel ('#$:n'))
      (produces "M2"))

// Can't self-reference
(in11 (mactab (macro m [] (':m')))
      (signals "No such macro declared in this module: :m"))
(in11 (mactab (macro m [] (':0')))
      (signals "Invalid macro address: :0"))

// Can't forward-reference
(in11 (mactab (macro m [] (':2'))
              (macro n [] "n")
              (macro o [] "o"))
      (signals "Invalid macro address: :2"))

// Can't reference system macros this way.
(in11 (mactab (macro _ [] (':values')))
      (signals "No such macro declared in this module: :values"))

// Can't reference `use`d names this way.
(in11 (encoding (module M1 (macro_table (macro m [] "M1")))
                (module M2 (use M1)
                           (macro_table (macro _ [] (':m')))))
      (signals "No such macro declared in this module: :m"))

// TODO:[ALIAS] ... or aliases


// Malformed macro references in templates

(in11 (each (mactab (macro _ [] (':')))
            (mactab (macro _ [] ('::')))
            (mactab (macro _ [] (':1:')))
            (mactab (macro _ [] (':$ion:')))
            (mactab (macro m [] 0)
                    (macro _ [] ('::m')))
            (mactab (macro m [] 0)
                    (macro _ [] ('m:')))
            (signals "Malformed macro-ref:")))


// Arity checking

(in11
  (each (mactab (macro m [p]    1) (macro w [] (m)))
        (mactab (macro m [p, q] 1) (macro w [] (m 1)))
        (signals "Too few arguments"))
  (each (mactab (macro m []     1) (macro w [] (m 1)))
        (mactab (macro m [p]    1) (macro w [] (m 1 2)))
        (signals "Too many arguments")))


"SUCCESS (tl_invoke.test)"

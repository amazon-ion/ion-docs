// Tests E-expression macro invocations with primitive args.

(require "/ion_model/testing/dsl")


// TODO test invalid type declaration

(in11 (mactab (macro m ((i uint8)) [i]))
      (then (toplevel ('#$:m' 0) ('#$:m' 1) ('#$:m' 255))
            (produces [0] [1] [255]))
      (each (toplevel ('#$:m' ('#$:values' 0)))
            (signals "E-expression not allowed for argument of tagless encoding"))
      (each (toplevel ('#$:m' ann::0))
            (signals "Annotation not allowed for argument of tagless encoding"))
      (each (toplevel ('#$:m' null))
            (toplevel ('#$:m' null.int))
            (toplevel ('#$:m' -1))
            (toplevel ('#$:m' 256))
            (signals "Invalid uint8 argument")))

(in11 (mactab (macro m ((i uint8*)) [i]))
      (then (toplevel ('#$:m' 0) ('#$:m' 1) ('#$:m' 255))
            (produces [0]        [1]        [255]))
      (each (toplevel ('#$:m' ('#$:' 0 1 255)))
            (toplevel ('#$:m' 0 1 255))                         // Implicit rest
            (produces [0, 1, 255]))
      (each (toplevel ('#$:m' ann::0))
            (toplevel ('#$:m' 0 1 ann::2))
            (signals "Annotation not allowed for argument of tagless encoding")))

// E-expression shape failures are signalled even when param is unused
(in11 (each (mactab (macro m ((i uint8*)) [i]))
            (mactab (macro m ((i uint8*)) false))
            (then (each (toplevel ('#$:m' ('#$:values' 0)))
                        (toplevel ('#$:m' 0 ('#$:values' 0)))
                        (signals "E-expression not allowed for argument of tagless encoding"))
                  (each (toplevel ('#$:m' null))
                        (toplevel ('#$:m' null.int))
                        (toplevel ('#$:m' -1))
                        (toplevel ('#$:m' 256))
                        (signals "Invalid uint8 argument")))))

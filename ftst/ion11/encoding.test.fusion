(require "/ion_model/testing/dsl")


// Top-level macro_table

(in11 (toplevel $ion_encoding::((macro_table))
                ('#$:$ion:values' aoeui) ('#$:values' dhtns))
      (produces aoeui dhtns))

// FIXME [MAC-ID] These shouldn't fail, the unqualified reference is unambiguous.
(in11 (each (toplevel $ion_encoding::((macro_table $ion)))
            (toplevel $ion_encoding::((macro_table $ion $ion)))
            (then (toplevel ('#$:$ion:values' aoeui) ('#$:values' dhtns))
                  (signals "Ambiguous macro-ref: :values"))))
                //(produces aoeui dhtns)

(in11 (encoding (macro_table M))
      (signals "Module not in scope: M"))
(in11 (encoding (macro_table ''))
      (signals "Module not in scope:"))

(in11 (each (encoding (macro_table "M"))
            (encoding (macro_table 1))
            (signals "Expected a symbol:")))


// Inline modules

(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 2)
                                  (symbol_table ["m"] N))
                                (symbol_table M)))
      (then (toplevel '#$12' '#$14')
            (produces m b))
      (then (toplevel '#$15')
            (signals "Invalid symbol address:")))

(in11 (toplevel $ion_encoding::((module M
                                  (load M "abcs" 2)        // Note same name
                                  (symbol_table ["m"] M))
                                (symbol_table M)))
      (then (toplevel '#$12' '#$14')
            (produces m b))
      (then (toplevel '#$15')
            (signals "Invalid symbol address:")))

(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 1)
                                  (load N "mnop" 1)        // Shadows previous
                                  (symbol_table N))
                                (symbol_table M)))
      (then (toplevel '#$12')
            (produces m))
      (then (toplevel '#$13')
            (signals "Invalid symbol address:")))

// Inner `load` not visible to top-level.
(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 1)
                                  (symbol_table N))
                                (symbol_table N)))
      (signals "Module not in scope: N"))

// TODO:[LOAD-MACRO]

// Inline module macro_table

(in11 (toplevel $ion_encoding::((module M (macro_table))))
      (produces))

(in11 (toplevel $ion_encoding::((module M (macro_table))
                                (macro_table M))
                ('#$:M:mac'))
      (signals "No such macro: :M:mac"))

(in11 (toplevel $ion_encoding::((module M (macro_table $ion))
                                (macro_table M))
                ('#$:M:make_symbol' "sah" weet)
                ('#$:M:3'           "sah" weet))
      (produces sahweet sahweet))


// Macro addresses

(in11 (toplevel $ion_encoding::((module M (macro_table $ion))
                                (macro_table M))
//              ('#$:make_symbol' ('#$:values' "a" b) ('#$:void' x) c)  // TODO [MAC-ID]
                ('#$:M:3'         ('#$:M:1'    "a" b) ('#$:M:0'  x) c)
                ('#$:3'           ('#$:1'      "a" b) ('#$:0'    x) c))
      (produces abc abc))

(in11 (mactab (macro M1 () "M1")
              (macro M2 () "M2")
              $ion)
      (toplevel ('#$:0') ('#$:1') ('#$:M:0') ('#$:M:1') [('#$:2'), ('#$:M:2')])
      (produces "M1"     "M2"     "M1"       "M2"       [/*void*/   /*void*/ ]))


// Modules not in macro_table are not accessible

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:M:mac'))
      (signals "Module not in scope: M"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:M:0'))
      (signals "Module not in scope: M"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:mac'))
      (signals "No such macro: :mac"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:0'))
      (signals "Invalid macro address: :0"))

// TODO test addresses when there's multiple modules.
// TODO more tests for out-of-bounds macro addresses


"SUCCESS (encoding.test)"

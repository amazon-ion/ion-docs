(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
  "/ion_model/testing/dsl"
)


// Non-sexps pass through
(check_expansion
  (quote_top first $ion_encoding::[] second)
  (quote11   first $ion_encoding::[] second))

(check_expansion
  (quote_top first $ion_encoding::{} second)
  (quote11   first $ion_encoding::{} second))

// Encoding directives are elided from app view
(check_expansion
  (quote_top first second)
  (quote11   first $ion_encoding::() $ion_encoding::null.sexp second))


// Local symbols

(check_expansion_and_bounds 12
  (quote_top a b)
  (quote11   $ion_encoding::((symbol_table ["a"] ["b"])) '#$11' '#$12'))


// Exact-match imports

(check_expansion_and_bounds 11
  (quote_top a)
  (quote11 $ion_encoding::((load abc "abcs" 1)
                           (symbol_table abc))
    '#$11'))

(check_expansion_and_bounds 14
  (quote_top a m o)
  (quote11 $ion_encoding::((load mno "mnop" 3)
                           (load abc "abcs" 1)
                           (symbol_table abc mno))
    '#$11' '#$12' '#$14'))

// Absent shared symbol
(check_expansion_and_bounds 14
  // FIXME [SYMTAB-COMPOSE] symbol identity should be mnop#1
  (quote_top '#$mno#1' n)
  (quote11 $ion_encoding::((load mno "mnop" 4) (symbol_table mno)) '#$11' '#$12'))


// Name shadowing
(check_expansion_and_bounds 14
  (quote_top m n o x)
  (quote11 $ion_encoding::((load m "mnop" 4)
                           (load m "mnop" 3)
                           (symbol_table m ["x"]))
    '#$11' '#$12' '#$13' '#$14'))

// Mix and match imported and local symbols

(check_expansion_and_bounds 18
  (quote_top l1 l2 a l3 m n o l4)
  (quote11 $ion_encoding::((load mno "mnop" 3)
                           (load abc "abcs" 1)
                           (symbol_table ["l1", "l2"] abc ["l3"] mno ["l4"]))
    '#$11' '#$12' '#$13' '#$14' '#$15' '#$16' '#$17' '#$18'))


// Retention

(check_eval_fail "Module not in scope: A"
  (quote11 $ion_encoding::((load A "abcs" 1)
                           (symbol_table ["l1"] A))
           $ion_encoding::((symbol_table ["l2"] A))))

(check_expansion_and_bounds 12
  (quote_top l2 a)
  (quote11 $ion_encoding::((load A "abcs" 1) (symbol_table ["l1"] A))
           $ion_encoding::((retain *)        (symbol_table ["l2"] A))
           '#$11' '#$12'))

(check_expansion_and_bounds 12
  (quote_top a i a)
  (quote11 $ion_encoding::((load A "abcs" 1))
           $ion_encoding::((retain A)
                           (module I (symbol_table ["i"]))
                           (symbol_table A))
           '#$11'
           $ion_encoding::((retain I A A)
                           (symbol_table I A))
           '#$11' '#$12'))

(check_eval_fail "Module not in scope: M"
  (quote11 $ion_encoding::((load A "abcs" 1)
                           (load M "mnop" 3))
           $ion_encoding::((retain A)
                           (symbol_table M))))


// Top-level macro_table

(check_expansion
  (quote_top aoeui dhtns)
  (quote11   $ion_encoding::((macro_table))
             ('#$:$ion:values' aoeui) ('#$:values' dhtns)))

// FIXME [MAC-ID] These shouldn't fail, the unqualified reference is unambiguous.
(check_eval_fail "Ambiguous macro-ref: :values"
//(quote_top aoeui dhtns)
  (quote11   $ion_encoding::((macro_table $ion))
             ('#$:$ion:values' aoeui) ('#$:values' dhtns)))
(check_eval_fail "Ambiguous macro-ref: :values"
//(quote_top aoeui dhtns)
  (quote11   $ion_encoding::((macro_table $ion $ion))
             ('#$:$ion:values' aoeui) ('#$:values' dhtns)))

(in11 (encoding (macro_table M))
      (signals "Module not in scope: M"))
(in11 (encoding (macro_table ''))
      (signals "Module not in scope:"))

(in11 (each (encoding (macro_table "M"))
            (encoding (macro_table 1))
            (signals "Expected a symbol:")))


// Inline modules

(check_expansion_and_bounds 10
  (quote_top)
  (quote11   $ion_encoding::((module h))))

(check_expansion_and_bounds 11
  (quote_top h1)
  (quote11   $ion_encoding::((module h (symbol_table ["h1"]))
                             (symbol_table h))
             '#$11'))

(check_expansion_and_bounds 12
  (quote_top h1 h1)
  (quote11   $ion_encoding::((module h (symbol_table ["h1"]))
                             (symbol_table h h))
             '#$11' '#$12'))

(check_expansion_and_bounds 13
  (quote_top m b)
  (quote11   $ion_encoding::((module M
                               (load N "abcs" 2)
                               (symbol_table ["m"] N))
                             (symbol_table M))
             '#$11' '#$13'))

(check_expansion_and_bounds 13
  (quote_top m b)
  (quote11   $ion_encoding::((module M
                               (load M "abcs" 2)        // Note same name
                               (symbol_table ["m"] M))
                             (symbol_table M))
             '#$11' '#$13'))

(check_expansion_and_bounds 11
  (quote_top m)
  (quote11   $ion_encoding::((module M
                               (load N "abcs" 1)
                               (load N "mnop" 1)        // Shadows previous
                               (symbol_table N))
                             (symbol_table M))
             '#$11'))

// Inner `load` not visible to top-level.
(check_eval_fail "Module not in scope: N"
  (quote11   $ion_encoding::((module M
                               (load N "abcs" 1)
                               (symbol_table N))
                             (symbol_table N))))

// TODO:[LOAD-MACRO]

// Inline module macro_table

(check_expansion
  (quote_top)
  (quote11   $ion_encoding::((module M (macro_table)))))

(check_eval_fail "No such macro: :M:mac"
  (quote11   $ion_encoding::((module M (macro_table))
                             (macro_table M))
             ('#$:M:mac')))

(check_expansion
  (quote_top sahweet sahweet)
  (quote11   $ion_encoding::((module M (macro_table $ion))
                             (macro_table M))
             ('#$:M:make_symbol' "sah" weet)
             ('#$:M:3'           "sah" weet)))


// Macro addresses

(check_expansion
  (quote_top abc abc)
  (quote11   $ion_encoding::((module M (macro_table $ion))
                             (macro_table M))
//           ('#$:make_symbol' ('#$:values' "a" b) ('#$:void' x) c)  // TODO [MAC-ID]
             ('#$:M:3'         ('#$:M:1'    "a" b) ('#$:M:0'  x) c)
             ('#$:3'           ('#$:1'      "a" b) ('#$:0'    x) c)))

(with_mactab ((macro M1 () "M1")
              (macro M2 () "M2")
              $ion)
  (document ('#$:0') ('#$:1') ('#$:M:0') ('#$:M:1') [('#$:2'), ('#$:M:2')])
  (produces "M1"     "M2"     "M1"       "M2"       [/*void*/   /*void*/ ]))


// Modules not in macro_table are not accessible

(check_eval_fail "Module not in scope: M"
  (quote11   $ion_encoding::((module M (macro_table (macro mac [] 1)))
                             (macro_table))
             ('#$:M:mac')))

(check_eval_fail "Module not in scope: M"
  (quote11   $ion_encoding::((module M (macro_table (macro mac [] 1)))
                             (macro_table))
             ('#$:M:0')))

(check_eval_fail "No such macro: :mac"
  (quote11   $ion_encoding::((module M (macro_table (macro mac [] 1)))
                             (macro_table))
             ('#$:mac')))

(check_eval_fail "Invalid macro address: :0"
  (quote11   $ion_encoding::((module M (macro_table (macro mac [] 1)))
                             (macro_table))
             ('#$:0')))

// TODO test addresses when there's multiple modules.
// TODO more tests for out-of-bounds macro addresses


"SUCCESS (encoding.test)"

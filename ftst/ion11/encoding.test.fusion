(require "/ion_model/testing/dsl")


// Non-sexps pass through
(in11
      (then (toplevel 1 $ion_encoding::null 2)
            (produces 1 $ion_encoding::null 2))
      (then (toplevel 1 $ion_encoding::12   2)
            (produces 1 $ion_encoding::12   2))
      (then (toplevel 1 $ion_encoding::[]   2)
            (produces 1 $ion_encoding::[]   2))
      (then (toplevel 1 $ion_encoding::{}   2)
            (produces 1 $ion_encoding::{}   2)))

// Encoding directives are elided from app view
(in11 (toplevel first $ion_encoding::() $ion_encoding::null.sexp second)
      (produces first second))


// Local symbols

(in11 (toplevel $ion_encoding::((symbol_table ["a"] ["b"])))
      (then (toplevel '#$11' '#$12')
            (produces a b))
      (then (toplevel '#$13')
            (signals "Invalid symbol address: 13")))


// Exact-match imports
(in11 (toplevel $ion_encoding::((load abc "abcs" 1)
                                (symbol_table abc)))
      (then (toplevel '#$11')
            (produces a))
      (then (toplevel '#$12')
            (signals "Invalid symbol address: 12")))

(in11 (toplevel $ion_encoding::((load mno "mnop" 3)
                                (load abc "abcs" 1)
                                (symbol_table abc mno)))
      (then (toplevel '#$11' '#$12' '#$14')
            (produces a m o))
      (then (toplevel '#$15')
            (signals "Invalid symbol address: 15")))


// Absent shared symbol
(in11 (toplevel $ion_encoding::((load mno "mnop" 4)
                                (symbol_table mno)))
      (then (toplevel '#$11' '#$12')
            (produces '#$mnop#1' n)))

// Module name shadowing
(in11 (toplevel $ion_encoding::((load m "mnop" 4)
                                (load m "mnop" 3)
                                (symbol_table m ["x"])))
      (then (toplevel '#$11' '#$12' '#$13' '#$14')
            (produces m n o x))
      (then (toplevel '#$15')
            (signals "Invalid symbol address: 15")))


// Mix and match imported and local symbols
(in11 (toplevel $ion_encoding::((load mno "mnop" 3)
                                (load abc "abcs" 1)
                                (symbol_table ["l1", "l2"] abc ["l3"] mno ["l4"])))
      (then (toplevel '#$11' '#$12' '#$13' '#$14' '#$15' '#$16' '#$17' '#$18')
            (produces l1 l2 a l3 m n o l4))
      (then (toplevel '#$19')
            (signals "Invalid symbol address: 19")))


// Retention
(in11 (toplevel $ion_encoding::((load A "abcs" 1)
                                (symbol_table ["l1"] A))
                $ion_encoding::((symbol_table ["l2"] A))) // No `retains` clause
      (signals "Module not in scope: A"))

(in11 (toplevel $ion_encoding::((load A "abcs" 1) (symbol_table ["l1"] A))
                $ion_encoding::((retain *)        (symbol_table ["l2"] A))
                '#$11' '#$12')
      (produces l2 a))

(in11 (toplevel $ion_encoding::((load A "abcs" 1))
                $ion_encoding::((retain A)
                                (module I (symbol_table ["i"]))
                                (symbol_table A))
                '#$11'
                $ion_encoding::((retain I A A)
                                (symbol_table I A))
                '#$11' '#$12')
      (produces a i a))


(in11 (toplevel $ion_encoding::((load A "abcs" 1)
                                (load M "mnop" 3))
                $ion_encoding::((retain A)
                                (symbol_table M)))
      (signals "Module not in scope: M"))


// Top-level macro_table

(in11 (toplevel $ion_encoding::((macro_table))
                ('#$:$ion:values' aoeui) ('#$:values' dhtns))
      (produces aoeui dhtns))

// FIXME [MAC-ID] These shouldn't fail, the unqualified reference is unambiguous.
(in11 (each (toplevel $ion_encoding::((macro_table $ion)))
            (toplevel $ion_encoding::((macro_table $ion $ion)))
            (then (toplevel ('#$:$ion:values' aoeui) ('#$:values' dhtns))
                  (signals "Ambiguous macro-ref: :values"))))
                //(produces aoeui dhtns)

(in11 (encoding (macro_table M))
      (signals "Module not in scope: M"))
(in11 (encoding (macro_table ''))
      (signals "Module not in scope:"))

(in11 (each (encoding (macro_table "M"))
            (encoding (macro_table 1))
            (signals "Expected a symbol:")))


// Inline modules

(in11 (toplevel $ion_encoding::((module h)))
      (produces)
  )

(in11 (toplevel $ion_encoding::((module h (symbol_table ["h1"]))
                                (symbol_table h)))
      (then (toplevel '#$11')
            (produces h1))
      (then (toplevel '#$12')
            (signals "Invalid symbol address: 12")))

(in11 (toplevel $ion_encoding::((module h (symbol_table ["h1"]))
                                (symbol_table h h)))
      (then (toplevel '#$11' '#$12')
            (produces h1 h1))
      (then (toplevel '#$13')
            (signals "Invalid symbol address: 13")))

(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 2)
                                  (symbol_table ["m"] N))
                                (symbol_table M)))
      (then (toplevel '#$11' '#$13')
            (produces m b))
      (then (toplevel '#$14')
            (signals "Invalid symbol address: 14")))

(in11 (toplevel $ion_encoding::((module M
                                  (load M "abcs" 2)        // Note same name
                                  (symbol_table ["m"] M))
                                (symbol_table M)))
      (then (toplevel '#$11' '#$13')
            (produces m b))
      (then (toplevel '#$14')
            (signals "Invalid symbol address: 14")))

(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 1)
                                  (load N "mnop" 1)        // Shadows previous
                                  (symbol_table N))
                                (symbol_table M)))
      (then (toplevel '#$11')
            (produces m))
      (then (toplevel '#$12')
            (signals "Invalid symbol address: 12")))

// Inner `load` not visible to top-level.
(in11 (toplevel $ion_encoding::((module M
                                  (load N "abcs" 1)
                                  (symbol_table N))
                                (symbol_table N)))
      (signals "Module not in scope: N"))

// TODO:[LOAD-MACRO]

// Inline module macro_table

(in11 (toplevel $ion_encoding::((module M (macro_table))))
      (produces))

(in11 (toplevel $ion_encoding::((module M (macro_table))
                                (macro_table M))
                ('#$:M:mac'))
      (signals "No such macro: :M:mac"))

(in11 (toplevel $ion_encoding::((module M (macro_table $ion))
                                (macro_table M))
                ('#$:M:make_symbol' "sah" weet)
                ('#$:M:3'           "sah" weet))
      (produces sahweet sahweet))


// Macro addresses

(in11 (toplevel $ion_encoding::((module M (macro_table $ion))
                                (macro_table M))
//              ('#$:make_symbol' ('#$:values' "a" b) ('#$:void' x) c)  // TODO [MAC-ID]
                ('#$:M:3'         ('#$:M:1'    "a" b) ('#$:M:0'  x) c)
                ('#$:3'           ('#$:1'      "a" b) ('#$:0'    x) c))
      (produces abc abc))

(in11 (mactab (macro M1 () "M1")
              (macro M2 () "M2")
              $ion)
      (toplevel ('#$:0') ('#$:1') ('#$:M:0') ('#$:M:1') [('#$:2'), ('#$:M:2')])
      (produces "M1"     "M2"     "M1"       "M2"       [/*void*/   /*void*/ ]))


// Modules not in macro_table are not accessible

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:M:mac'))
      (signals "Module not in scope: M"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:M:0'))
      (signals "Module not in scope: M"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:mac'))
      (signals "No such macro: :mac"))

(in11 (toplevel $ion_encoding::((module M (macro_table (macro mac () 1)))
                                (macro_table))
                ('#$:0'))
      (signals "Invalid macro address: :0"))

// TODO test addresses when there's multiple modules.
// TODO more tests for out-of-bounds macro addresses


"SUCCESS (encoding.test)"

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/testing"
  "/ion_model/model"
  "/ion_model/testing"
  "/ion_model/testing/dsl"
)


// Ensure that malformed templates are signaled when they are encountered,
// not delayed until the module is installed or macro is invoked.
(check_eval_fail "Malformed template:"
  (quote11 $ion_encoding::((module M (macro_table (macro m () ()))))))


// Contant macros; Literals of various types

(check_expansion
  (quote_top null n::null
             true bool::null.bool
             76 inttt::null.int
             "string" null.string a::"string" b::c::null.string)
  (quote11   $ion_encoding::((module M
                               (macro_table
                                 (macro nul          () null.null)
                                 (macro nul_ann      () n::null)
                                 (macro bol          () true)
                                 (macro bol_ann_null () bool::null.bool)
                                 (macro int          () 76)
                                 (macro int_ann_null () inttt::null.int)
                                 (macro str          () "string")
                                 (macro str_null     () null.string)
                                 (macro str_ann      () a::"string")
                                 (macro str_ann_null () b::c::null.string)))
                             (macro_table M))
             ('#$:nul') ('#$:nul_ann')
             ('#$:bol') ('#$:bol_ann_null')
             ('#$:int') ('#$:int_ann_null')
             ('#$:str') ('#$:str_null') ('#$:str_ann') ('#$:str_ann_null')))

// TODO float decimal timestap blob clob

(with_mactab ((macro m () 0))
  (document ('#$:m'))
  (produces 0)
  (document ('#$:m' 1))
  (signals "Too many arguments")
  (document ('#$:m' 1 2))
  (signals "Too many arguments"))


// Single-parameter macros; variable references

(with_mactab ((macro val (v) v))
  (document ('#$:val' a) ('#$:val' b))
  (produces a b)
  (document ('#$:val'))
  (signals "Too few arguments")
  (document ('#$:val' 1 2))
  (signals "Too many arguments"))

(with_mactab ((macro _ (v) x))
  (document)
  (signals "Unbound variable: x"))


// Multiple parameters

(with_mactab ((macro first  (v w) v)
              (macro second (v w) w))
  (document ('#$:first'  a "b")
            ('#$:second' c "d"))
  (produces a "d")
  (document ('#$:first'))
  (signals "Too few arguments")
  (document ('#$:first' 1))
  (signals "Too few arguments")
  (document ('#$:first' 1 2 3))
  (signals "Too many arguments"))


// Nontrivial parameter specs

(check_expansion
  (quote_top a)
  (quote11   $ion_encoding::((module M (macro_table (macro val (v) v)))
                             (macro_table M))
             ('#$:val' a)))


// Exactly-one cardinality

// TODO:[EACH-FORK] test variant signatures; EACH only allows one extension.
(in11 (mactab
        (macro m (v!) v))
      (each (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:' 1) 2))             // Hidden: too many args
            (toplevel ('#$:m' ('#$:' 1 2)))
            (signals "Unexpected argument group"))
      (each (toplevel ('#$:m' ('#$:void')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' ('#$:values' 1 2)))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:void') 2))       // Hidden: no value
            (toplevel ('#$:m' ('#$:values' 1 2) 2)) // Hidden: more than one value
            (signals "Too many arguments")))


// Zero-or-one cardinality

(in11 (mactab
        (macro m (v?) v))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:values')))
            (produces))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))   // TODO should this be allowed? No group in binary
            (toplevel ('#$:m' ('#$:values' 1)))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:values' 1 2)))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' 1 ('#$:values')))
            (toplevel ('#$:m' ('#$:' 1 2) 3))
            (toplevel ('#$:m' ('#$:values') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v? w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 2))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:') 2))
            (toplevel ('#$:m' ('#$:values') 2))
            (produces [2]))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:' 1) 2))
            (toplevel ('#$:m' ('#$:values' 1) 2))
            (produces [1, 2]))
      (each (toplevel ('#$:m' ('#$:' 1 2) 3))
            (toplevel ('#$:m' ('#$:values' 1 2) 3))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' 1 2 ('#$:values')))
            (signals "Too many arguments")))


// One-or-more cardinality

(in11 (mactab
        (macro m (v+) v))
      (then (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:')))        // TODO:[PLUS-GROUP] Wrong error?
            (toplevel ('#$:m' ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:values' 1)))
            (toplevel ('#$:m' 1 ('#$:values')))    // Implicit rest
            (toplevel ('#$:m' ('#$:values') 1))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:' 1 2)))
            (toplevel ('#$:m' ('#$:values' 1 2)))
            (toplevel ('#$:m' 1 2))                // Implicit rest
            (produces 1 2))
      (each (toplevel ('#$:m' ('#$:') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v+ w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 1))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:') 2))
            (toplevel ('#$:m' ('#$:values') 2))
            (toplevel ('#$:m' 1 ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' 1 x))
            (toplevel ('#$:m' ('#$:' 1) x))
            (toplevel ('#$:m' ('#$:values' 1) x))
            (produces [1, x]))
      (each (toplevel ('#$:m' ('#$:' 1 2) x))
            (toplevel ('#$:m' ('#$:values' 1 2) x))
            (produces [1, 2, x]))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' ('#$:' 1 2) 3 4))
            (signals "Too many arguments")))


// Zero-or-more cardinality

(in11 (mactab
        (macro m (v*) v))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:values')))
            (produces))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:values' 1)))
            (toplevel ('#$:m' ('#$:values') 1))   // Implicit rest
            (toplevel ('#$:m' 1 ('#$:values')))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:' 1 2)))
            (toplevel ('#$:m' ('#$:values' 1 2)))
            (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:values' 1) ('#$:values' 2)))
            (produces 1 2))
      (each (toplevel ('#$:m' ('#$:') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v* w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 1))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' 1 ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' ('#$:') x))
            (toplevel ('#$:m' ('#$:values') x))
            (produces [x]))
      (each (toplevel ('#$:m' 1 x))
            (toplevel ('#$:m' ('#$:' 1) x))
            (toplevel ('#$:m' ('#$:values' 1) x))
            (produces [1, x]))
      (each (toplevel ('#$:m' ('#$:' 1 2) x))
            (toplevel ('#$:m' ('#$:values' 1 2) x))
            (produces [1, 2, x]))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' ('#$:') 1 2))
            (toplevel ('#$:m' ('#$:values') 1 2))
            (toplevel ('#$:m' 1 ('#$:values') 2))
            (signals "Too many arguments")))


// List quasi-literals

(in11 (mactab (macro n  () a::null.list)
              (macro e  () b::[])
              (macro v1 () [1])
              (macro v2 () [1, c::2]))
      (toplevel ('#$:n')      ('#$:e')  ('#$:v1')  ('#$:v2'))
      (produces a::null.list  b::[]     [1]        [1, c::2]))

(in11 (mactab (macro m1 (v)       a::[1, v, 2])
              (macro m2 (v r*)    [1, [v], 2, r, 3]))
      (toplevel ('#$:m1' a)   ('#$:m2' a)     ('#$:m2' [a] r1 r2))
      (produces a::[1, a, 2]  [1, [a], 2, 3]  [1, [[a]], 2, r1, r2, 3]))


(in11 (mactab (macro _ () [1, 2, v]))
      (signals "Unbound variable: v"))


// Struct quasi-literals

(in11 (mactab (macro n  () a::null.struct)
              (macro e  () b::{})
              (macro f1 () {n: (literal v)})
              (macro f2 () {n: (literal v), n:2}))
      (toplevel ('#$:n')       ('#$:e') ('#$:f1') ('#$:f2'))
      (produces a::null.struct b::{}   {n:v}     {n:2, n:v}))

// Template in field-value position can returns non-singular results.
(in11 (mactab (macro m (v*) {n:v}))
      (toplevel ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' ('#$:values' 1 2)))
      (produces {}       {n:1}      {n:2, n:1}   {n:1, n:2}))

(in11 (mactab (macro m (v*) {n1:v, n2:v}))
      (toplevel ('#$:m') ('#$:m' 1)   ('#$:m' 1 2))
      (produces {}       {n1:1, n2:1} {n1:2, n2:1, n2:2, n1:1}))


(in11 (mactab (macro _ () {n: v}))
      (signals "Unbound variable: v"))


// Special forms: literal

(check_expansion
  (quote_top [a::(), literal] [1, (values 2 3), (literal v)] [a, v])
  (quote11 $ion_encoding::((module M
                             (macro_table (macro m ()  [(literal a::()), (literal literal)])
                                          (macro n ()  (literal [1, (values 2 3), (literal v)]))
                                          (macro o (v) [v, (literal v)])))
                           (macro_table M))
           ('#$:m') ('#$:n') ('#$:o' a)))

(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (literal)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (literal 1 2)))))))


// Special form: if_void

(with_mactab ((macro m (v*)
                (if_void v true false)))
  (document ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
  (produces true     false      false        false))

// Ensure that the unselected clause isn't evaluated.
(with_mactab ((macro m (p*) (if_void p true (make_string null))))
  (document ('#$:m'))
  (produces true)
  (document ('#$:m' 1))
  (signals "Not a text value"))
(with_mactab ((macro m (p*) (if_void p (make_string null) false)))
  (document ('#$:m'))
  (signals "Not a text value")
  (document ('#$:m' 1))
  (produces false))


// Try new testing forms; still awkward.
(with_mactab ((macro m () (if_void)))
  (document)
  (signals "Malformed if_void form"))

(check_eval_fail "Malformed if_void form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void)))))))
(check_eval_fail "Malformed if_void form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void 1)))))))
(check_eval_fail "Malformed if_void form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void 1 2)))))))
(check_eval_fail "Malformed if_void form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void 1 2 3 4)))))))

// Ensure malformed subforms are cought at compile-time.
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void (literal) 2 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void 1 (literal) 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_void 1 2 (literal))))))))


// Special form: if_single

(with_mactab ((macro m (v*)
                (if_single v true false)))
  (document ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
  (produces false    true       false        false))

// Ensure that the unselected clause isn't evaluated.
(with_mactab ((macro m (p*) (if_single p true (make_string null))))
  (document ('#$:m'))
  (signals "Not a text value")
  (document ('#$:m' 1))
  (produces true))
(with_mactab ((macro m (p*) (if_single p (make_string null) false)))
  (document ('#$:m'))
  (produces false)
  (document ('#$:m' 1))
  (signals "Not a text value"))

(check_eval_fail "Malformed if_single form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single)))))))
(check_eval_fail "Malformed if_single form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single 1)))))))
(check_eval_fail "Malformed if_single form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single 1 2)))))))
(check_eval_fail "Malformed if_single form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single 1 2 3 4)))))))

// Ensure malformed subforms are cought at compile-time.
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single (literal) 2 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single 1 (literal) 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_single 1 2 (literal))))))))


// Special form: if_multi

(with_mactab ((macro m (v*)
                (if_multi v true false)))
  (document ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
  (produces false    false      true         true))

// Ensure that the unselected clause isn't evaluated.
(with_mactab ((macro m (p*) (if_multi p true (make_string null))))
  (document ('#$:m'))
  (signals "Not a text value")
  (document ('#$:m' 1 2))
  (produces true))
(with_mactab ((macro m (p*) (if_multi p (make_string null) false)))
  (document ('#$:m'))
  (produces false)
  (document ('#$:m' 1 2))
  (signals "Not a text value"))

(check_eval_fail "Malformed if_multi form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi)))))))
(check_eval_fail "Malformed if_multi form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi 1)))))))
(check_eval_fail "Malformed if_multi form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi 1 2)))))))
(check_eval_fail "Malformed if_multi form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi 1 2 3 4)))))))

// Ensure malformed subforms are cought at compile-time.
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi (literal) 2 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi 1 (literal) 3)))))))
(check_eval_fail "Malformed literal clause"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (if_multi 1 2 (literal))))))))


// Special form: for

// No bindings, no iteration
(with_mactab ((macro m (as *)
                (for []
                  as)))
  (document ('#$:m'))
  (produces)
  (document ('#$:m' 1 2))
  (produces))

// Single binding
(with_mactab ((macro m (as *)
                (for [(a as)]
                  [a])))
  (document ('#$:m'))
  (produces)
  (document ('#$:m' 1 2))
  (produces [1] [2]))

// Multiple bindings
(with_mactab ((macro m (as* bs*)
                (for [(a as), (b bs)]
                  [a, b])))
  (document ('#$:m'))
  (produces)
  (document ('#$:m' 1))
  (produces)
  (document ('#$:m' 1 2))
  (produces [1, 2])
  (document ('#$:m' ('#$:values' 1 2) ('#$:values' 3 4)))
  (produces [1, 3] [2, 4])
  // Uneven lengths
  (document ('#$:m' 1 ('#$:values' 2 3)) ('#$:m' ('#$:values' 1 2) 3))
  (produces [1, 2]                       [1, 3])
  // sequences are not decomposed
  (document ('#$:m' [1, 2] (3 4)))
  (produces [[1, 2], (3 4)]))

// Shadowing parameter names
(with_mactab ((macro m (a* b*)
                (for [(a a)]
                  [a, b])))  // b is inlined!
  (document ('#$:m' 1))
  (produces [1])
  (document ('#$:m' 1 2))
  (produces [1, 2])
  (document ('#$:m' 1 ('#$:values' 2 3)))
  (produces [1, 2, 3])
  (document ('#$:m' ('#$:values' 1 2) 3))
  (produces [1, 3] [2, 3])
  (document ('#$:m' ('#$:values' 1 2) ('#$:values' 3 4)))
  (produces [1, 3, 4] [2, 3, 4]))

// TODO [DUPE-NAME] reject duplicate variable names

// Bound streams do not need to be parameter references
(with_mactab ((macro m (a*) (for [(f "f1")] [f, a])))
  (document ('#$:m') ('#$:m' 1 2))
  (produces ["f1"]   ["f1", 1, 2]))

(with_mactab ((macro m (a*) (for [(f (for [(g a)] ["g=", g]))] ["f=", f])))
  (document ('#$:m' 1 2))
  (produces ["f=", ["g=", 1]] ["f=", ["g=", 2]]))

(with_mactab ((macro m (a*) (for [(f (void))] [f, a])))
  (document ('#$:m') ('#$:m' 1 2))
  (produces))

(with_mactab ((macro m (a*) (for [(f (values "f1" a "f2"))] [f, a])))
  (document ('#$:m')       ('#$:m' 1))
  (produces ["f1"] ["f2"]  ["f1", 1] [1, 1] ["f2", 1]))


(check_eval_fail "Malformed `for` form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for)))))))
(check_eval_fail "Malformed `for` form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [])))))))
(check_eval_fail "Malformed `for` form"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [] 1 2)))))))

(check_eval_fail "Malformed `for` binding pair"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [()] 1)))))))
(check_eval_fail "Malformed `for` binding pair"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [(v)] 1)))))))
(check_eval_fail "Malformed `for` binding pair"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [(v 1 2)] 1)))))))

// Malformed sub-templates are detected at compile-time.
(check_eval_fail "Unbound variable: x"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [(v x)] 1)))))))
(check_eval_fail "Unbound variable: x"
  (quote11 $ion_encoding::((module M (macro_table (macro m () (for [(v 1)] x)))))))

// Propagate runtime failure in bound-expression
(with_mactab ((macro m (p*) (for [(f (values 1 (make_symbol p) 2))] f)))
  (document ('#$:m' "a" null "b"))
  (signals "Not a text value"))    // for null

// Propagate runtime failure in body-expression
(with_mactab ((macro m (p*) (for [(f p)] (make_symbol p))))
  (document ('#$:m' "a" null "b"))
  (signals "Not a text value"))    // for null


"SUCCESS (template.test)"

(require "/ion_model/testing/dsl")


// Ensure that malformed templates are signaled when they are encountered,
// not delayed until the module is installed or macro is invoked.
(ion_1_1
  (encoding (module M (macro_table (macro m () ()))))
  (signals "Malformed template:"))


// Contant macros; Literals of various types

(ion_1_1
  (encoding (module M
              (macro_table
                (macro nul          () null.null)
                (macro nul_ann      () n::null)
                (macro bol          () true)
                (macro bol_ann_null () bool::null.bool)
                (macro int          () 76)
                (macro int_ann_null () inttt::null.int)
                (macro str          () "string")
                (macro str_null     () null.string)
                (macro str_ann      () a::"string")
                (macro str_ann_null () b::c::null.string)))
            (macro_table M))
  (toplevel ('#$:nul') ('#$:nul_ann')
            ('#$:bol') ('#$:bol_ann_null')
            ('#$:int') ('#$:int_ann_null')
            ('#$:str') ('#$:str_null') ('#$:str_ann') ('#$:str_ann_null'))
  (produces null n::null
            true bool::null.bool
            76 inttt::null.int
            "string" null.string a::"string" b::c::null.string))

// TODO float decimal timestap blob clob

(ion_1_1
  (mactab (macro m () 0))
  (then (toplevel ('#$:m'))
        (produces 0))
  (each (toplevel ('#$:m' 1))
        (toplevel ('#$:m' 1 2))
        (signals "Too many arguments")))


// Single-parameter macros; variable references

(ion_1_1
  (mactab (macro val (v) v))
  (then (toplevel ('#$:val' a) ('#$:val' b))
        (produces a b))
  (then (toplevel ('#$:val'))
        (signals "Too few arguments"))
  (then (toplevel ('#$:val' 1 2))
        (signals "Too many arguments")))


(ion_1_1 (mactab (macro _ (v) x))
         (signals "Unbound variable: x"))


// Multiple parameters

(ion_1_1 (mactab (macro first  (v w) v)
                 (macro second (v w) w))
  (then (toplevel ('#$:first'  a "b")
                  ('#$:second' c "d"))
        (produces a "d"))
  (each (toplevel ('#$:first'))
        (toplevel ('#$:first' 1))
        (signals "Too few arguments"))
  (then (toplevel ('#$:first' 1 2 3))
        (signals "Too many arguments")))


// Nontrivial parameter specs

(ion_1_1
  (encoding (module M (macro_table (macro val (v) v)))
            (macro_table M))
  (toplevel ('#$:val' a))
  (produces a))


// Exactly-one cardinality

(in11 (mactab
        (macro m (v!) v))
      (each (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:' 1) 2))             // Hidden: too many args
            (toplevel ('#$:m' ('#$:' 1 2)))
            (signals "Unexpected argument group"))
      (each (toplevel ('#$:m' ('#$:void')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' ('#$:values' 1 2)))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:void') 2))       // Hidden: no value
            (toplevel ('#$:m' ('#$:values' 1 2) 2)) // Hidden: more than one value
            (signals "Too many arguments")))


// Zero-or-one cardinality

(in11 (mactab
        (macro m (v?) v))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:values')))
            (produces))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))   // TODO should this be allowed? No group in binary
            (toplevel ('#$:m' ('#$:values' 1)))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:values' 1 2)))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' 1 ('#$:values')))
            (toplevel ('#$:m' ('#$:' 1 2) 3))
            (toplevel ('#$:m' ('#$:values') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v? w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 2))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:') 2))
            (toplevel ('#$:m' ('#$:values') 2))
            (produces [2]))
      (each (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:' 1) 2))
            (toplevel ('#$:m' ('#$:values' 1) 2))
            (produces [1, 2]))
      (each (toplevel ('#$:m' ('#$:' 1 2) 3))
            (toplevel ('#$:m' ('#$:values' 1 2) 3))
            (signals "More than one value provided for parameter"))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' 1 2 ('#$:values')))
            (signals "Too many arguments")))


// One-or-more cardinality

(in11 (mactab
        (macro m (v+) v))
      (then (toplevel ('#$:m'))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:')))        // TODO:[PLUS-GROUP] Wrong error?
            (toplevel ('#$:m' ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:values' 1)))
            (toplevel ('#$:m' 1 ('#$:values')))    // Implicit rest
            (toplevel ('#$:m' ('#$:values') 1))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:' 1 2)))
            (toplevel ('#$:m' ('#$:values' 1 2)))
            (toplevel ('#$:m' 1 2))                // Implicit rest
            (produces 1 2))
      (each (toplevel ('#$:m' ('#$:') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v+ w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 1))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' ('#$:') 2))
            (toplevel ('#$:m' ('#$:values') 2))
            (toplevel ('#$:m' 1 ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' 1 x))
            (toplevel ('#$:m' ('#$:' 1) x))
            (toplevel ('#$:m' ('#$:values' 1) x))
            (produces [1, x]))
      (each (toplevel ('#$:m' ('#$:' 1 2) x))
            (toplevel ('#$:m' ('#$:values' 1 2) x))
            (produces [1, 2, x]))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' ('#$:' 1 2) 3 4))
            (signals "Too many arguments")))


// Zero-or-more cardinality

(in11 (mactab
        (macro m (v*) v))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' ('#$:')))
            (toplevel ('#$:m' ('#$:values')))
            (produces))
      (each (toplevel ('#$:m' 1))
            (toplevel ('#$:m' ('#$:' 1)))
            (toplevel ('#$:m' ('#$:values' 1)))
            (toplevel ('#$:m' ('#$:values') 1))   // Implicit rest
            (toplevel ('#$:m' 1 ('#$:values')))
            (produces 1))
      (each (toplevel ('#$:m' ('#$:' 1 2)))
            (toplevel ('#$:m' ('#$:values' 1 2)))
            (toplevel ('#$:m' 1 2))
            (toplevel ('#$:m' ('#$:values' 1) ('#$:values' 2)))
            (produces 1 2))
      (each (toplevel ('#$:m' ('#$:') 1))
            (signals "Too many arguments")))

(in11 (mactab
        (macro m (v* w) [v, w]))
      (each (toplevel ('#$:m'))
            (toplevel ('#$:m' 1))
            (signals "Too few arguments"))
      (each (toplevel ('#$:m' 1 ('#$:values')))
            (signals "No value provided for parameter"))
      (each (toplevel ('#$:m' ('#$:') x))
            (toplevel ('#$:m' ('#$:values') x))
            (produces [x]))
      (each (toplevel ('#$:m' 1 x))
            (toplevel ('#$:m' ('#$:' 1) x))
            (toplevel ('#$:m' ('#$:values' 1) x))
            (produces [1, x]))
      (each (toplevel ('#$:m' ('#$:' 1 2) x))
            (toplevel ('#$:m' ('#$:values' 1 2) x))
            (produces [1, 2, x]))
      (each (toplevel ('#$:m' 1 2 3))
            (toplevel ('#$:m' ('#$:') 1 2))
            (toplevel ('#$:m' ('#$:values') 1 2))
            (toplevel ('#$:m' 1 ('#$:values') 2))
            (signals "Too many arguments")))


// List quasi-literals

(in11 (mactab (macro n  () a::null.list)
              (macro e  () b::[])
              (macro v1 () [1])
              (macro v2 () [1, c::2]))
      (toplevel ('#$:n')      ('#$:e')  ('#$:v1')  ('#$:v2'))
      (produces a::null.list  b::[]     [1]        [1, c::2]))

(in11 (mactab (macro m1 (v)       a::[1, v, 2])
              (macro m2 (v r*)    [1, [v], 2, r, 3]))
      (toplevel ('#$:m1' a)   ('#$:m2' a)     ('#$:m2' [a] r1 r2))
      (produces a::[1, a, 2]  [1, [a], 2, 3]  [1, [[a]], 2, r1, r2, 3]))


(in11 (mactab (macro _ () [1, 2, v]))
      (signals "Unbound variable: v"))


// Struct quasi-literals

(in11 (mactab (macro n  () a::null.struct)
              (macro e  () b::{})
              (macro f1 () {n: (literal v)})
              (macro f2 () {n: (literal v), n:2}))
      (toplevel ('#$:n')       ('#$:e') ('#$:f1') ('#$:f2'))
      (produces a::null.struct b::{}   {n:v}     {n:2, n:v}))

// Template in field-value position can returns non-singular results.
(in11 (mactab (macro m (v*) {n:v}))
      (toplevel ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' ('#$:values' 1 2)))
      (produces {}       {n:1}      {n:2, n:1}   {n:1, n:2}))

(in11 (mactab (macro m (v*) {n1:v, n2:v}))
      (toplevel ('#$:m') ('#$:m' 1)   ('#$:m' 1 2))
      (produces {}       {n1:1, n2:1} {n1:2, n2:1, n2:2, n1:1}))


(in11 (mactab (macro _ () {n: v}))
      (signals "Unbound variable: v"))


// Special forms: literal

(ion_1_1
  (encoding (module M
              (macro_table (macro m ()  [(literal a::()), (literal literal)])
                           (macro n ()  (literal [1, (values 2 3), (literal v)]))
                           (macro o (v) [v, (literal v)])))
            (macro_table M))
  (toplevel ('#$:m')         ('#$:n')                       ('#$:o' a))
  (produces [a::(), literal] [1, (values 2 3), (literal v)] [a, v]))

(ion_1_1
  (each (encoding (module M (macro_table (macro m () (literal)))))
        (encoding (module M (macro_table (macro m () (literal 1 2)))))
        (signals "Malformed literal clause")))


// Special form: if_void

(ion_1_1 (mactab (macro m (v*)
                   (if_void v true false)))
  (toplevel ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
  (produces true     false      false        false))

// Ensure that the unselected clause isn't evaluated.
(ion_1_1 (mactab (macro m (p*)
                   (if_void p true (make_string null))))
  (then (toplevel ('#$:m'))
        (produces true))
  (then (toplevel ('#$:m' 1))
        (signals "Not a text value")))

(ion_1_1 (mactab (macro m (p*)
                   (if_void p (make_string null) false)))
  (then (toplevel ('#$:m'))
        (signals "Not a text value"))
  (then (toplevel ('#$:m' 1))
        (produces false)))

(ion_1_1
  (each (mactab (macro m () (if_void)))
        (mactab (macro m () (if_void 1)))
        (mactab (macro m () (if_void 1 2)))
        (mactab (macro m () (if_void 1 2 3 4)))
        (signals "Malformed if_void form"))
  (each "malformed subexpressions are cought at compile-time"
        (mactab (macro m () (if_void (literal) 2 3)))
        (mactab (macro m () (if_void 1 (literal) 3)))
        (mactab (macro m () (if_void 1 2 (literal))))
        (signals "Malformed literal clause")))


// Special form: if_single

(ion_1_1 "if_single"

  (then "happy path"
    (mactab (macro m (v*)
              (if_single v true false)))
    (toplevel ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
    (produces false    true       false        false))

  (then "then-clause isn't evaluated unless selected"
    (mactab (macro m (p*)
              (if_single p (make_string null) false)))
    (then (toplevel ('#$:m'))
          (produces false))
    (then (toplevel ('#$:m' 1))
          (signals "Not a text value")))

  (then "else-clause isn't evaluated unless selected"
    (mactab (macro m (p*)
              (if_single p true (make_string null))))
    (then (toplevel ('#$:m'))
          (signals "Not a text value"))
    (then (toplevel ('#$:m' 1))
          (produces true)))

  (each "arity errors are caught at compile-time"
    (mactab (macro m () (if_single)))
    (mactab (macro m () (if_single 1)))
    (mactab (macro m () (if_single 1 2)))
    (mactab (macro m () (if_single 1 2 3 4)))
    (signals "Malformed if_single form"))

  (each "malformed subexpressions are caught at compile-time"
    (mactab (macro m () (if_single (literal) 2 3)))
    (mactab (macro m () (if_single 1 (literal) 3)))
    (mactab (macro m () (if_single 1 2 (literal))))
    (signals "Malformed literal clause")))


// Special form: if_multi

(ion_1_1 "if_multi"

  (then "happy path"
    (mactab (macro m (v*)
              (if_multi v true false)))
    (toplevel ('#$:m') ('#$:m' 1) ('#$:m' 1 2) ('#$:m' 1 2 3))
    (produces false    false      true         true))

  (then "then-clause isn't evaluated unless selected"
    (mactab (macro m (p*)
              (if_multi p (make_string null) false)))
    (then (toplevel ('#$:m'))
          (produces false))
    (then (toplevel ('#$:m' 1 2))
          (signals "Not a text value")))

  (then "else-clause isn't evaluated unless selected"
    (mactab (macro m (p*)
              (if_multi p true (make_string null))))
    (then (toplevel ('#$:m'))
          (signals "Not a text value"))
    (then (toplevel ('#$:m' 1 2))
          (produces true)))

  (each "arity errors are caught at compile-time"
    (mactab (macro m () (if_multi)))
    (mactab (macro m () (if_multi 1)))
    (mactab (macro m () (if_multi 1 2)))
    (mactab (macro m () (if_multi 1 2 3 4)))
    (signals "Malformed if_multi form"))

  (each "malformed subexpressions are caught at compile-time"
    (mactab (macro m () (if_multi (literal) 2 3)))
    (mactab (macro m () (if_multi 1 (literal) 3)))
    (mactab (macro m () (if_multi 1 2 (literal))))
    (signals "Malformed literal clause")))


// Special form: for

(ion_1_1 "for loops"
  (then "do nothing if no bindings"
    (mactab (macro m (as*)
              (for []
                as)))
    (each (toplevel ('#$:m'))
          (toplevel ('#$:m' 1 2))
          (produces)))

  (then "handle one binding"
    (mactab (macro m (as*)
              (for [(a as)]
                [a])))
    (then (toplevel ('#$:m'))
          (produces))
    (then (toplevel ('#$:m' 1 2))
          (produces [1] [2])))

  (then "handle multiple bindings"
    (mactab (macro m (as* bs*)
              (for [(a as), (b bs)]
                [a, b])))
    (then (toplevel ('#$:m'))
          (produces))
    (then (toplevel ('#$:m' 1 2))
          (produces [1, 2]))
    (then (toplevel ('#$:m' ('#$:values' 1 2) ('#$:values' 3 4)))
          (produces [1, 3] [2, 4]))
    (then "with uneven length"
      (then (toplevel ('#$:m' 1))
            (produces))
      (then (toplevel ('#$:m' 1 ('#$:values' 2 3)))
            (produces [1, 2]))
      (then (toplevel ('#$:m' ('#$:values' 1 2) 3))
            (produces [1, 3])))

    (then "sequences are not decomposed"
      (toplevel ('#$:m' [1, 2] (3 4)))
      (produces [[1, 2], (3 4)])))

  (then "shadow parameter names"
    (mactab (macro m (a* b*)
              (for [(a a)]
                [a, b])))  // b is inlined!
    (then (toplevel ('#$:m' 1))
      (produces [1]))
    (then (toplevel ('#$:m' 1 2))
      (produces [1, 2]))
    (then (toplevel ('#$:m' 1 ('#$:values' 2 3)))
      (produces [1, 2, 3]))
    (then (toplevel ('#$:m' ('#$:values' 1 2) 3))
      (produces [1, 3] [2, 3]))
    (then (toplevel ('#$:m' ('#$:values' 1 2) ('#$:values' 3 4)))
     (produces [1, 3, 4] [2, 3, 4])))

  // TODO [DUPE-NAME] reject duplicate variable names

  // Bound streams do not need to be parameter references
  (then (mactab (macro m (a*)
                  (for [(f "f1")]
                    [f, a])))
        (toplevel ('#$:m') ('#$:m' 1 2))
        (produces ["f1"]   ["f1", 1, 2]))
  (then (mactab (macro m (a*) (for [(f (for [(g a)] ["g=", g]))] ["f=", f])))
        (toplevel ('#$:m' 1 2))
        (produces ["f=", ["g=", 1]] ["f=", ["g=", 2]]))
  (then (mactab (macro m (a*) (for [(f (void))]
                                [f, a])))
        (toplevel ('#$:m') ('#$:m' 1 2))
        (produces))
  (then (mactab (macro m (a*) (for [(f (values "f1" a "f2"))]
                                [f, a])))
        (toplevel ('#$:m')       ('#$:m' 1))
        (produces ["f1"] ["f2"]  ["f1", 1] [1, 1] ["f2", 1]))

  (each "arity errors are caught at compile-time"
    (mactab (macro m () (for)))
    (mactab (macro m () (for [])))
    (mactab (macro m () (for [] 1 2)))
    (signals "Malformed `for` form"))
  (each "malformed binding-pairs are caught at compile-time"
    (mactab (macro m () (for [()] 1)))
    (mactab (macro m () (for [(v)] 1)))
    (mactab (macro m () (for [(v 1 2)] 1)))
    (signals "Malformed `for` binding pair"))
  (each "malformed subexpressions are caught at compile-time"
    (mactab (macro m () (for [(v x)] 1)))
    (mactab (macro m () (for [(v 1)] x)))
    (signals "Unbound variable: x"))
  (then "propagate runtime failure in bound-expression"
    (mactab (macro m (p*) (for [(f (values 1 (make_symbol p) 2))] f)))
    (toplevel ('#$:m' "a" null "b"))
    (signals "Not a text value"))   // for null
  (then "propagate runtime failure in body-expression"
    (mactab (macro m (p*) (for [(f p)] (make_symbol p))))
    (toplevel ('#$:m' "a" null "b"))
    (signals "Not a text value"))    // for null
)


"SUCCESS (template.test)"

(require "/ion_model/testing/dsl")


(in10 (toplevel ('#$:nomod:mac'))
      (signals "Eexp not allowed in Ion 1.0"))

(in11 (toplevel ('#$:nomod:mac'))
      (signals "Module not in scope: nomod"))

(in11 (toplevel ('#$:$ion:mac'))
      (signals "No such macro: :$ion:mac"))

(in11 (toplevel ('#$:$ion:99'))
      (signals "Invalid macro address: :$ion:99"))


// Sequence inlining

(in11 (toplevel [1, ('#$:$ion:values' 2 3), ('#$:$ion:values'), 4])
      (produces [1,                   2, 3,                     4]))

(in11 (toplevel (1 ('#$:$ion:values' 2 3) ('#$:$ion:values') 4))
      (produces (1                   2 3                     4)))


// Argument group shapes

// TODO Use `each`
//(in11 (each (toplevel ('#$:annotate' ()  1))
//            (toplevel ('#$:annotate' ann 1)))
//      (signals "Expected grouping list"))

(in11 (toplevel ('#$:annotate' () 1))
      (signals "Expected grouping list"))
(in11 (toplevel ('#$:annotate' ann 1))
      (signals "Expected grouping list"))

// Inlining into a group
(in11 (toplevel ('#$:annotate' [('#$:values' a b)] 1))
      (produces a::b::1))


"SUCCESS (macro.test)"

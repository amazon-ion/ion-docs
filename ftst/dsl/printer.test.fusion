(require
  "/fusion/experimental/check"
  "/fusion/experimental/syntax"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/printing"
  "/fusioncontrib/denotation/printing/latex"
  "/fusioncontrib/denotation/printing/unicode"
  "/fusioncontrib/denotation/private/util"
  "/model1"

  (only_in "/fusion/private/io" with_output_to_string)
)


(define_binary_check (check_same_text expected actual)
  (=== expected actual))

(define_check (check_printing printer expected value)
  (check_same_text expected
    (with_output_to_string (printer value))))


(define default_printer
  (make_printer))

(check_printing default_printer "{{{void}}}"   (void))
(check_printing default_printer "true"         true)
(check_printing default_printer "123"          123)
(check_printing default_printer "\"\""         "")
(check_printing default_printer "\"hello\""    "hello")
(check_printing default_printer "''"           (quote ''))
//(check_printing default_printer "'true'"       (quote true))  // FIXME bug in write?
(check_printing default_printer "[123, \"x\"]" [123, "x"])

// By default, base-domain values are ejected and displayed.
(check_printing default_printer "true"   (inject_into B true))
(check_printing default_printer "1646"   (inject_into Z 1646))
(check_printing default_printer "\"hi\"" (inject_into S "hi"))


//==============================================================================
// Unicode printing

(define_check (check_unicode expected v)
  (check_printing uniprinter expected v))

(check_unicode "true"  (inject_into B true))
(check_unicode "false" (inject_into B false))

(check_unicode "1646" (inject_into Z 1646))

(check_unicode "id(a) = a" id)
(check_unicode "stamp(t, v) = inStamped(⟨t, v⟩)" stamp)
(check_unicode "Stamped_time(s) = s↓0" Stamped_time)
(check_unicode "select_ints(vs) = (filter vs λv.v ∈ Z)" select_ints)

(check_unicode
  "filter(vs, p) = IF #vs = 0 THEN ⟨⟩ ELSE IF (p vs↓0) THEN ⟨vs↓0⟩§(filter vs†1 p) ELSE (filter vs†1 p) ENDIF ENDIF"
  filter)


(define_model Tiny
  (dom Nada = "nothing")
  (dom Single = "single")
  (dom B = (^ is_bool))
  (dom I = (^ is_int) "integers")
  (dom U = (+ B I))
  (dom V = (+ U Single))
  (dom 'V?' = (+ V Nada))

  (dom Tuple = (* U B Single))
  (dom Func = (-> U Tuple B))

  (fn f Func (u t) (let [(x u), (s true)] s))

  (fn add  ((i0 I) (i1 I)   -> I)    (+ i0 i1))
  (fn sub  ((i0 I) (i1 I)   -> I)    (- i0 i1))
  (fn lt   ((i0 I) (i1 I)   -> I)    (< i0 i1))
  (fn eq   ((i0 I) (i1 I)   -> I)    (=== i0 i1))
  (fn gt   ((i0 I) (i1 I)   -> I)    (> i0 i1))
  (fn len  ((us 'U*')       -> I)    (seq_length us))
  (fn cons ((u U) (us 'U*') -> 'U*') (seq_prepend u us))
  (fn incr ((i I)           -> I)    (+ i (inject_into I 1)))
  (fn b2u  ((b B)           -> U)    (lift_to U b))
  (fn i2u  ((i I)           -> U)    (lift i U))
  (fn i2v  ((i I)           -> V)    (lift i U V))
  (fn u2b  ((u U)           -> B)    (lower_to B u))
  (fn u2i  ((u U)           -> I)    (lower u I))
  (fn v2i  ((v V)           -> I)    (lower v U I))

  (fn 'v2v?' ((v V)        -> 'V?')  (lift v 'V?'))
)

(check_unicode '''\
Domains
=======
Nada = <nothing>
Single = <single>
B = <null.string>
I = <integers>
U = B + I
V = U + Single
V? = V + Nada
Tuple = U * B * Single
Func = U * Tuple -> B

Functions
=========
f(u, t) = LET x = u ; s = true IN s ENDLET
add(i0, i1) = i0 + i1
sub(i0, i1) = i0 - i1
lt(i0, i1) = i0 < i1
eq(i0, i1) = i0 = i1
gt(i0, i1) = i0 > i1
len(us) = #us
cons(u, us) = ⟨u⟩§us
incr(i) = i + inI(1)
b2u(b) = inU(b)
i2u(i) = inU(i)
i2v(i) = inV(inU(i))
u2b(u) = u|B
u2i(u) = u|I
v2i(v) = v|U|I
v2v?(v) = inV?(v)
'''
  Tiny)


//==============================================================================
// LaTeX printing

(define_model Tricksy
  (dom B = (^ is_bool))
  (dom I = (^ is_int))
  (dom '$V?' = (+ B I))

  (fn 'i2$v?' (('i$?' I) -> '$V?') (lift_to '$V?' (lower_to '$V?' 'i$?')))
)

(define_check (check_latex expected v)
  (check_printing latexprint expected v))

(check_latex "\\mbox{\\bf true}"  (inject_into B true))
(check_latex "\\mbox{\\bf false}" (inject_into B false))

(check_latex "1646" (inject_into Z 1646))

(check_latex
  '''\\mbox{\\it i2\\$v?\\/}(\\mbox{\\it i\\$?\\/}) = \\newline\n'''
  '''\\mbox{\\it{in}\\small \\mbox{\\bf \\$V?}}(\\mbox{\\it i\\$?\\/}\\mid_{\\mbox{\\tiny \\mbox{\\bf \\$V?}}})'''
  'i2$v?')

(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/private/boolean"
  "/fusioncontrib/denotation/private/domain"
  "/fusioncontrib/denotation/private/tuple"
  "/fusioncontrib/denotation/testing"
  "/model1")


(expect_syntax_error
  (define_model Bad
    (dom Bs = (*))))    // Must have at least one subform in tuple

(define_model Ok
  (dom BWrap = (* B)))  // Single-element tuple is ok


(check_true (domain_is  stamped_int_val Stamped))
(check_true (element_of stamped_int_val Stamped))


// tuple

(expect_arity_error (tuple))
(expect_arity_error (tuple Stamped))
(expect_arity_error (tuple Stamped int_any_val))
(expect_arity_error (tuple Stamped t_val))
(expect_arity_error (tuple Stamped stamped_int_val))


(let [(bw (tuple BWrap TRUE))]
  (check element_of bw BWrap)
  (check_same TRUE (ith bw 0)))

(let [(bw (tuple BWrap true))]   // Auto-injection
  (check element_of bw BWrap)
  (check_true (eject (ith bw 0))))

(let [(v (tuple Point2d 0 1))]   // Auto-injection
  (check element_of v Point2d)
  (check_same 0 (eject (ith v 0)))
  (check_same 1 (eject (ith v 1))))


(check_bottom "19" (tuple Stamped (wrong 19) int_any_val))  // 1st arg strict
(check_bottom "20" (tuple Stamped t_val      (wrong 20)))   // 2nd arg strict

(expect_argument_error (tuple z_val z_rep))        // 1st arg isn't a domain
(expect_argument_error (tuple Z     z_rep))        // 1st arg isn't a tuple domain

(expect_argument_error (tuple Stamped int_any_val int_any_val))  // int_any_val ∉ T
(expect_argument_error (tuple Stamped t_val z_val))              // z ∉ Any
(expect_argument_error (tuple Stamped t_val z_val))              // z ∉ Any
(expect_argument_error (tuple Point2d z_val int_num_val))        // 3rd arg is above target domain


// tuple_values

(expect_argument_error (tuple_values (seq 'Z*')))   // arg isn't a tuple

(let_values [((t v) (tuple_values stamped_int_val))]
  (check_same t_val t)
  (check_same int_any_val v))


// tuple_ith

(check ident t_val       (tuple_ith stamped_int_val 0))
(check ident int_any_val (tuple_ith stamped_int_val 1))

(check_bottom "1720" (tuple_ith (wrong 1720) 0))                // strict on 1st arg
(check_bottom "1721" (tuple_ith stamped_int_val (wrong 1721)))  // strict on 2nd arg


// Field accessors

(define_model Accessors
  (dom IWrap = (* I::num))
  (dom IB    = (* I::num B::bool))
  (dom BI    = (* B I::num)))

(check_same (quote num)          (. (tuple_domain_field_names IWrap) 0))
(check_same (quote num)          (. (tuple_domain_field_names IB)    0))
(check_same (quote bool)         (. (tuple_domain_field_names IB)    1))
(check_same (quote null.symbol)  (. (tuple_domain_field_names BI)    0))
(check_same (quote num)          (. (tuple_domain_field_names BI)    1))


(let [(v (tuple IWrap 16))]
  (check_same 16 (eject (ith v 0)))
  (check_same 16 (eject (IWrap_num v))))

(let [(v (tuple IB 19 true))]
  (check_same 19   (eject (IB_num v)))
  (check_same true (eject (IB_bool v))))

(expect_argument_error (IB_num (tuple IWrap 49)))
(expect_argument_error (BI_num (tuple IB -9 true)))


(define_model AccessorsCanForwardReference
  (dom Forward = (* Later::later))
  (dom Later = (= LATER)))

(tuple Forward LATER)


"SUCCESS (tuple.test)"

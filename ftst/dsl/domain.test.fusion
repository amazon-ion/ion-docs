(require
  "/fusion/experimental/check"
  "/fusion/experimental/syntax"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/private/domain"
  "/fusioncontrib/denotation/testing"
  "/model1")


//====================
// Singleton domains

(check_pred is_domain_value SINGLE)

(check_true (domain_is  SINGLE Single))
(check_true (element_of SINGLE Single))

(check bound_identifier_equal (quote_syntax SINGLE) (singleton_const_id Single))


//====================
// Base domain values

(check_false (domain_is  z_rep Z))        // 1st arg is not a domain value
(check_false (element_of z_rep Z))

(check_true (domain_is  z_val Z))
(check_true (element_of z_val Z))
(check === z_rep (eject z_val))

(check_true  (domain_is  t_val T))
(check_true  (element_of t_val T))

(check_false (domain_is  int_any_val Z))
(check_true  (element_of int_any_val Z))

// eject
(expect_argument_error (eject 1))              // not a domain value
(expect_argument_error (eject int_exact_val))  // not a base domain value


"SUCCESS (domain.test)"

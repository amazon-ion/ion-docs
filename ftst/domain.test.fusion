(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/private/domain"
  "/fusioncontrib/denotation/private/sequence"
  "/fusioncontrib/denotation/testing"
  "/model1")



// Base domain values

(check_false (element_of z_rep Z))

(check_true (element_of z_val Z))
(check === z_rep (eject z_val))

(check_false (element_of t_val Any))
(check_true  (element_of t_val T))

(expect_argument_error (eject 1))              // not a domain value
(expect_argument_error (eject int_exact_val))  // not a base domain value


//====================
// Union domain values

// element_of
(check_true (element_of int_exact_val Exact))
(check_true (element_of dec_exact_val Exact))
(check_true (element_of int_any_val   Any))
(check_true (element_of int_any_val   Num))
(check_true (element_of int_any_val   Z))     // Sees "through" union domains.


// lift_to
(expect_argument_error (lift_to t_val z_val))  // 1st arg is not a domain
(expect_argument_error (lift_to Z z_rep))      // 1st arg is not a union domain
(expect_argument_error (lift_to Exact z_rep))  // 2nd arg isn't a domain value
(expect_argument_error (lift_to Exact s_val))  // 2nd arg isn't a subdomain value

(expect_argument_error (lift_to Num int_num_val)) // 2nd arg is same as the target domain
(expect_argument_error (lift_to Num int_any_val)) // 2nd arg is "above" the target domain


// subdomain
(check_same Z  (subdomain int_exact_val))

(expect_argument_error (subdomain z_val))


// unwrap
(check_same z_val (unwrap int_exact_val))

(expect_argument_error (unwrap z_val))


// lower_to
(expect_argument_error (lower_to t_val t_val))   // 1st arg is not a domain
(expect_argument_error (lower_to Any 12))        // 2nd arg isn't a domain value at all
(expect_argument_error (lower_to Any t_val))     // 2nd arg isn't a union-domain value
(expect_argument_error (lower_to S   int_num_val)) // 2nd arg is a union value, but wrong subdomain
(expect_argument_error (lower_to Num int_num_val)) // 2nd arg is already in target domain
(expect_argument_error (lower_to Z   int_any_val)) // 2nd are is two unions above target domain


//======================
// Product domain values

(check_true (element_of stamped_int_val Stamped))

(expect_argument_error (tuple z_val z_rep))        // 1st arg isn't a domain
(expect_argument_error (tuple Z     z_rep))        // 1st arg isn't a product domain

(expect_argument_error (tuple Stamped int_any_val))        // Arity mismatch
(expect_argument_error (tuple Stamped t_val))
(expect_argument_error (tuple Stamped stamped_int_val))
(expect_argument_error (tuple Stamped int_any_val int_any_val))  // int_any_val ∉ T
(expect_argument_error (tuple Stamped t_val z_val))              // z ∉ Any
(expect_argument_error (tuple Stamped t_val z_val))              // z ∉ Any
(expect_argument_error (tuple Point2d z_val int_num_val))        // 3rd arg is above target domain


// tuple_values

(expect_argument_error (tuple_values (seq 'Z*')))   // arg isn't a tuple

(let_values [((t v) (tuple_values stamped_int_val))]
  (check_same t_val t)
  (check_same int_any_val v))


(check ident t_val       (ith stamped_int_val 0))
(check ident int_any_val (ith stamped_int_val 1))


//======================
// Sequence domains

(check_pred is_seq_domain 'Z*')
(check = "Z*" (domain_name 'Z*'))
(check_same Z (seq_domain_subdomain 'Z*'))


(define empty_Zs (seq 'Z*'))
(check_pred is_seq       empty_Zs)
(check_pred seq_is_empty empty_Zs)

(define z0 (inject_into Z 0))
(define z1 (inject_into Z 1))
(define z2 (inject_into Z 2))
(define Z012 (seq 'Z*' z0 z1 z2))

(check_pred is_seq Z012)
(check_false (seq_is_empty Z012))
(check_same z0 (ith Z012 0))
(check_same z2 (ith Z012 2))

(expect_argument_error (seq Z))       // 1st arg isn't a seq domain
(expect_argument_error (seq 'Z*' 0))  // 2nd arg isn't a domain value
(expect_argument_error (seq 'Z*' int_any_val))   // 2nd arg is "above" the sequence type


(expect_argument_error (seq_is_empty stamped_int_val))  // arg isn't a sequence

(expect_argument_error (ith int_any_val 0))      // 1st arg isn't a sequence
(expect_argument_error (ith empty_Zs 0))         // 2nd arg out of range

(expect_argument_error (seq_tail Z))             // arg isn't a sequence



// seq_prepend

(let [(s1 (seq_prepend z_val empty_Zs))]
  (check === 1 (seq_length s1))
  (check_same z_val (seq_head s1)))

(expect_argument_error (seq_prepend z_val z_val))       // 2nd arg isn't a sequence
(expect_argument_error (seq_prepend empty_Zs empty_Zs)) // 1st arg is wrong type
(expect_argument_error (seq_prepend int_any_val empty_Zs)) // 1st arg is above target domain


// seq_append

(let [(v (seq_append empty_Zs empty_Zs))]
  (check_is_seq_of Z v)
  (check_pred seq_is_empty v))

(expect_argument_error (seq_append (inject_into Z 0) empty_Zs)) // 1st arg isn't a sequence
(expect_argument_error (seq_append empty_Zs (inject_into Z 0))) // 2nd arg isn't a sequence
(expect_argument_error (seq_append empty_Zs (seq 'Any*')))      // Args have different element type


// seq_truncate

(let [(s0 (seq_truncate Z012 0))]
  (check_same 0 (seq_length s0)))
(let [(s1 (seq_truncate Z012 1))]
  (check_same 1 (seq_length s1))
  (check_same z0 (ith s1 0)))
(let [(s2 (seq_truncate Z012 2))]
  (check_same 2 (seq_length s2))
  (check_same z0 (ith s2 0))
  (check_same z1 (ith s2 1)))
(let [(s3 (seq_truncate Z012 3))]
  (check_same 3 (seq_length s3))
  (check_same z0 (ith s3 0))
  (check_same z1 (ith s3 1))
  (check_same z2 (ith s3 2)))

(expect_argument_error (seq_truncate z_val 0))  // 1st arg isn't a sequence
(expect_argument_error (seq_truncate Z012 "0")) // 2nd arg isn't an int
(expect_argument_error (seq_truncate Z012 -1))  // 2nd arg is too small
(expect_argument_error (seq_truncate Z012 4))   // 2nd arg is too large


//======================
// Function domains

(define_check (check_argdomains expected_args func_dom)
  (let [(arg_doms (func_domain_argdomains func_dom))]
    (check_pred is_list arg_doms)
    (check === expected_args arg_doms)))

// Single argument (union)
(check_argdomains [Exact] (make_func_domain null.string "desc" Exact  T))
(check_argdomains [Exact] (make_func_domain null.string "desc" [Exact] T))

// Single argument (product)
(check_argdomains [Stamped] (make_func_domain null.string "desc"  Stamped  T))
(check_argdomains [Stamped] (make_func_domain null.string "desc" [Stamped] T))

// Multiple arguments
(check_argdomains [Z, Any] (make_func_domain null.string "desc" [Z, Any] Stamped))

// Anonymous product domain not allowed.
(expect_argument_error
  (make_func_domain null.string "desc"
    (make_product_domain null.string "desc" (|| [T, Any])) T))


"SUCCESS (domain.test)"

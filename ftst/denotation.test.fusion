(require
  "/fusion/experimental/check"
  "/fusioncontrib/denotation"
  "/fusioncontrib/denotation/private/domain"
  "/fusioncontrib/denotation/testing"
)


(expect_syntax_error
  (define_model Bad
    (dom T = "T")
    (dom TT = (+ T T))))  // Duplicate subdomain in +

(expect_syntax_error
  (define_model Bad
    (dom T = "T")
    (dom Tx = (* T))))    // Must have more than one in product

(expect_syntax_error
  (define_model Bad
    (dom T = "T")
    (dom Ts = (** T T)))) // Must have exactly one in sequence

(expect_syntax_error
  (define_model Bad
    (dom T = "T")
    (dom Tx = (-> T))))    // Must have more than one in function

(expect_syntax_error
  (define_model Bad
    (dom T = "T")
    (dom Tx = (- T T))))    // Undefined operator


(require "/model1")

(check_pred is_model  M1)
(check_pred is_domain Z)
(check_pred is_domain D)
(check_pred is_domain Exact)
(check_pred is_domain Stamped)
(check_pred is_domain Any2Any)

(check === "dummy" (domain_description Dummy))
(check === "Integers" (domain_description Z))
(check === "All Values" (domain_description Any))
(check === "A timestamped value" (domain_description Stamped))
(check === "A predicate function" (domain_description Pred))



//==========
// Functions

(check_pred is_fn id)
(check_same int_any_val (id int_any_val))
(expect_argument_error (id 21))       // Wrong argument type
(expect_argument_error (id t_val))    // Wrong argument type

(check_pred is_fn stamp)
(expect_arity_error (stamp))
(check_true (element_of (stamp t_val int_any_val) Stamped))


// We can turn a plain Fusion function into a type-checked domain function.
(define_fn identity_fn Any2Any (v) v)
(check_pred is_fn identity_fn)
(check_same int_any_val (identity_fn int_any_val))

(expect_argument_error (identity_fn 21))       // Wrong argument type
(expect_argument_error (identity_fn t_val))    // Wrong argument type

(define_fn bad_pred Pred (v) v)
(expect_result_error (bad_pred Any_true))      // Returns an Any, not a B


// Now a real-ish function
(define_fn convert_Num_to_Exact ((v Num) -> Exact)  // Assumes v ∈ Exact
  (lift_to Exact (lower_to Z v)))                   // TODO handle D as well

(let [(converted (convert_Num_to_Exact int_num_val))]
  (check_true (element_of converted Exact))
  (check_same z_val (lower_to Z converted)))

(expect_argument_error (convert_Num_to_Exact int_any_val))

(expect_syntax_error (fn bad_identity Any2Any identity))  // Missing argument declaration


// Functions over product domains require one argument in that domain.

(define_fn project_x Projection (point)
  (product_domain_element Point2d point 0))
(let [(p (tuple Point2d (inject_into Z 17) (inject_into Z 39)))]
  (check === 17 (eject (project_x p))))

(define_fn stamped_time ((stamped Stamped) -> T)
  (product_domain_element Stamped stamped 0))
(check_same t_val (stamped_time stamped_int_val))

// Even though <T, Any> matches Stamped, we need a proper domain value for strong typing.
(expect_arity_error (stamped_time t_val int_any_val))


// Multi-arg function

(define_fn make_point2d ((x Z) (y Z) -> Point2d)
  (tuple Point2d x y))
(lets [(x (inject_into Z 18)),
       (y (inject_into Z 50)),
       (p (make_point2d x y))]
  (check ident x (product_domain_element Point2d p 0))
  (check ident y (product_domain_element Point2d p 1)))

(expect_argument_error (make_point2d int_any_val z_val))  // 1st arg is wrong type
(expect_argument_error (make_point2d z_val int_any_val))  // 2nd arg is wrong type


// Local functions

(define (mk_Any v)
  (lift_to Any
    (cond ((is_bool   v) (inject_into B v))
          ((is_int    v) (lift_to Num (inject_into Z v)))
          ((is_string v) (inject_into S v)))))

(define (eject_any a)
  (eject (let [(rep (domain_value_rep a))]
           (if (element_of rep Num)
             (domain_value_rep rep)
             rep))))

(define (eject_Anys anys)
  (map eject_any (seq_to_sexp anys)))

(define anys (apply seq 'Any*' (map mk_Any [1, true, 2, "hi", "by", 3])))

(check === (quote (1 2 3))
  (eject_Anys (select_ints anys)))  // select_ints has a local Pred fn

(expect_syntax_error (mk_fn))                   // Too few subforms
(expect_syntax_error (mk_fn Pred))
(expect_syntax_error (mk_fn Pred (arg)))
(expect_syntax_error (mk_fn Pred (arg) true_val true_val)) // Too many subforms

(expect_syntax_error (mk_fn (Pred) (a) true_val))      // Malformed domain name
(expect_syntax_error (mk_fn Pred arg true_val))        // Args not a sexp
(expect_syntax_error (mk_fn Pred null.sexp true_val))  // Args are invalid sexp


//==========
// Misc cases

(expect_argument_error (element_of t_val int_any_val))     // 2nd arg not a domain


"SUCCESS (denotation.test)"
